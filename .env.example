# Sanity Configuration
PUBLIC_SANITY_PROJECT_ID=k4t36b6u
PUBLIC_SANITY_DATASET=production

# Write Token (Generate at manage.sanity.io -> API -> Tokens)
# This token needs 'Editor' or 'Admin' permissions.
SANITY_WRITE_TOKEN=your_token_here

# Google Books API Key (Optional but highly recommended for better coverage)
# Generate at console.cloud.google.com -> Enable 'Books API' -> Create API Key
GOOGLE_BOOKS_API_KEY=your_google_key_here
