# Sanity Configuration
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
PUBLIC_SANITY_DATASET=production

# Write Token (Generate at manage.sanity.io -> API -> Tokens)
# Required for migration/sync scripts (Editor or Admin permissions)
SANITY_WRITE_TOKEN=your_sanity_write_token

# Contact Form Verification & Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=Website Contact <contact@yourdomain.tld>
CONTACT_EMAIL=you@yourdomain.tld

# JWT secret used to sign double-opt-in contact verification tokens (required in production)
JWT_SECRET=replace_with_long_random_secret

# Optional Chrome/Puppeteer executable override for scripts/generate-cv-pdf.mjs and scripts/generate-og-image.mjs
PUPPETEER_EXECUTABLE_PATH=

# Google Books API Key (Optional, used by library cover sync scripts)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Optional Analytics: Umami Cloud Hobby ($0/mo, cookieless)
# Set ONLY in Netlify Production scope so preview/branch/localhost traffic stays untracked
PUBLIC_UMAMI_WEBSITE_ID=
