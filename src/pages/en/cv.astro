---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvDocument from '../../components/CvDocument.astro';
import { getCvData } from '../../lib/sanity';

const cvData = await getCvData('en');
const pageTitle = "Curriculum Vitae (CV)";
const pageDescription = `Academic Curriculum Vitae (CV) of ${cvData.personalInfo?.name || "Marlon Müller"} – Engineering Science at TUM, Odonatum e.V., experience, skills, and downloadable PDF.`;
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  backgroundEffect="grid" 
  accentColor="primary"
  showFooter={true}
>
  <div class="min-h-screen pt-20 pb-16 flex justify-center">
    <CvDocument cvData={cvData} locale="en" />
  </div>
</BaseLayout>
