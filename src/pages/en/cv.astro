---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvDocument from '../../components/CvDocument.astro';
import { getCvData } from '../../lib/sanity';
import { useTranslations } from '../../i18n/utils';

const cvData = await getCvData('en');
const t = useTranslations('en');
const pageTitle = `${cvData.personalInfo.name} — Curriculum Vitae (CV)`;
---

<BaseLayout 
  title={pageTitle} 
  backgroundEffect="grid" 
  accentColor="primary"
  showFooter={true}
>
  <main class="min-h-screen pt-20 pb-16 flex justify-center">
    <CvDocument cvData={cvData} locale="en" />
  </main>
</BaseLayout>
