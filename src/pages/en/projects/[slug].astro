---
import ProjectDetailPage from "../../../components/ProjectDetailPage.astro";
import { getProjectBySlug } from "../../../lib/sanity";

const { slug } = Astro.params;
const projectData = await getProjectBySlug(slug, "en");

if (!projectData) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
---

<ProjectDetailPage lang="en" slug={slug} projectData={projectData} />
