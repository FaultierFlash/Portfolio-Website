---
// src/pages/about.astro
import Layout from "../../layouts/BaseLayout.astro";
// Import TextFadeIn instead of CharacterFadeInScroll
import TextFadeIn from "../../components/TextFadeIn.astro"; // Ensure this path is correct

const pageTitle = "About Me";

// --- Text Content (retained from your version) ---
const introText = `Hello! I'm a passionate web developer based near Munich, Germany, with a deep love for creating beautiful, functional, and user-centric digital experiences. With a strong background in modern web technologies and a keen eye for detail, I strive to bridge the gap between technical implementation and exceptional user interface design.`;
const journeyTitle = "My Journey Into Code";
const journeyText = `My fascination with the web began years ago, initially sparked by curiosity about how websites were built. This curiosity quickly evolved into a dedicated pursuit. I started with the fundamentals – HTML semantic structure and CSS styling – before diving into the dynamic world of JavaScript. The ability to bring static pages to life with interactivity was captivating. Over time, I've embraced powerful frameworks and tools like Astro, React, Node.js, and TypeScript, continuously honing my skills to build more complex and performant applications. Every project is a learning opportunity, pushing me to explore new techniques and refine my craft.`;
const philosophyTitle = "My Development Philosophy";
const philosophyText = `I believe that the best websites are not just functional, but also intuitive and enjoyable to use. My approach centers around three core principles: 
1.  **User-Centricity:** Understanding the end-user's needs and goals is paramount. I focus on creating interfaces that are easy to navigate and accessible to everyone.
2.  **Performance:** A fast and responsive website is crucial for user satisfaction and SEO. I prioritize clean code, optimized assets, and efficient loading strategies.
3.  **Clean Code & Maintainability:** Writing well-structured, readable, and maintainable code is essential for long-term project success and collaboration. I adhere to best practices and strive for elegance in implementation.`;
const skillsIntroText = `What I Do & Technologies I Use`;
const skillsList = [
  "Build responsive, accessible, and performant websites using Astro, HTML, CSS, and JavaScript/TypeScript.",
  "Develop dynamic web applications and UI components with React and its ecosystem (Context, Zustand, etc.).",
  "Create and consume RESTful APIs using Node.js and Express.",
  "Manage databases (like PostgreSQL or MongoDB) for data persistence.",
  "Implement effective styling solutions with Tailwind CSS, Sass, or CSS Modules.",
  "Utilize Git for version control and collaborate effectively within development teams.",
  "Optimize web performance focusing on Core Web Vitals and efficient loading.",
  "Continuously learn and adapt to the ever-evolving landscape of web technologies.",
];
const contactIntroText = `Let's Connect`;
const contactText = `I'm always excited about new challenges, collaborations, and interesting projects. Whether you have a specific idea in mind, need help with an existing project, or just want to chat about technology, feel free to <a href="/contact" class="animated-link">reach out</a>! Let's build something amazing together.`;

// --- Animation Settings for TextFadeIn ---
// These will apply to the blocks and words within the TextFadeIn component.
const blockStagger = 100; // ms delay between each paragraph, heading, list item, etc.
const firstWordBaseDelay = 20; // ms base delay for the first word in any animated block.
const perWordDelay = 30; // ms incremental delay for subsequent words within a block.
---

<Layout title={pageTitle}>
  <section class="about-section">
    <div class="container">
      {/* Wrap all animatable content in a single TextFadeIn component */}
      <TextFadeIn
        targetSelectors="h1, h2, p, li"
        {/* Elements to animate as blocks */}
        blockStaggerDelay={blockStagger}
        baseDelay={firstWordBaseDelay}
        wordDelay={perWordDelay}
      >
        {/* --- Title --- */}
        <h1 class="title">{pageTitle}</h1>

        {/* --- Intro Paragraph --- */}
        <p class="intro">{introText}</p>

        {/* --- My Journey Section --- */}
        <h2 class="subtitle">{journeyTitle}</h2>
        <p>{journeyText}</p>

        {/* --- My Philosophy Section --- */}
        <h2 class="subtitle">{philosophyTitle}</h2>
        {
          /* The <p> tag will be processed by TextFadeIn.
            The TextFadeIn script handles splitting text with <br> or simple text.
            For complex HTML within the paragraph (like strong, em), TextFadeIn treats them as single "words".
        */
        }
        <p set:html={philosophyText.replace(/\n/g, "<br />")} />

        {/* --- What I Do Section --- */}
        <h2 class="subtitle">{skillsIntroText}</h2>
        <ul class="skills-list">
          {
            /* Each <li> will be an animated block, and its text content will have word animations */
          }
          {skillsList.map((item) => <li>{item}</li>)}
        </ul>

        {/* --- Get in Touch Section --- */}
        <h2 class="subtitle">{contactIntroText}</h2>
        {
          /* The <p> tag will be an animated block.
            TextFadeIn will process its content, treating the <a> tag as a single animatable "word".
        */
        }
        <p set:html={contactText} />
      </TextFadeIn>
    </div>
  </section>

  {/* --- Page Specific Styles (Adjusted) --- */}
  <style>
    .about-section {
      padding: 4rem 1rem 6rem;
      font-family: "Raleway", sans-serif; /* Default font for this section */
      line-height: 1.7;
      color: var(--color-text);
      overflow-x: hidden; /* Prevent horizontal scroll during animation */
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
    }
    /* Apply styling classes directly to HTML elements */
    .title {
      /* Was on CharacterFadeInScroll, now on h1 */
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      text-align: center;
      color: var(--color-primary);
    }
    .intro {
      /* Was on CharacterFadeInScroll, now on p */
      font-size: 1.25rem;
      margin-bottom: 4rem;
      text-align: center;
      color: var(--color-secondary);
      font-weight: 400;
    }
    .subtitle {
      /* Was on CharacterFadeInScroll, now on h2 */
      font-size: 2rem;
      font-weight: 500;
      margin-top: 3.5rem;
      margin-bottom: 1.5rem;
      border-bottom: 2px solid var(--color-border);
      padding-bottom: 0.5rem;
      color: var(--color-text); /* Ensures subtitle color is consistent */
    }

    /* General paragraph and list spacing, TextFadeIn doesn't add margins itself */
    p,
    ul.skills-list {
      /* Target specific ul or all ul if desired */
      margin-bottom: 1.5rem; /* Default spacing, can be overridden by more specific classes like .intro */
    }
    ul.skills-list {
      margin-bottom: 3rem; /* More space after skills list */
    }

    .skills-list {
      list-style: none;
      padding-left: 0;
      /* margin-bottom is handled by the general ul rule above or can be specific here */
    }
    .skills-list li {
      margin-bottom: 0.9rem;
      padding-left: 1.7rem;
      position: relative;
      font-size: 1.1rem;
      /* TextFadeIn will wrap the text content of <li> in spans for animation */
    }
    .skills-list li::before {
      content: "◆";
      position: absolute;
      left: 0;
      top: 0.1em; /* Adjust for vertical alignment with text */
      color: var(--color-primary);
      font-size: 0.9em;
    }

    /* Styles for links, including the one in contactText */
    p a,
    a.animated-link {
      /* Target links in paragraphs and the specific class if used */
      color: var(--color-accent);
      text-decoration: none;
      font-weight: 500; /* Make links stand out a bit */
      position: relative;
      transition: color 0.3s ease;
    }
    p a::after,
    a.animated-link::after {
      content: "";
      position: absolute;
      width: 100%;
      height: 2px;
      bottom: -2px; /* Position underline slightly below text */
      left: 0;
      background-color: var(--color-accent);
      transform: scaleX(0);
      transform-origin: bottom right;
      transition: transform 0.3s ease-out;
    }
    p a:hover,
    a.animated-link:hover {
      color: var(--color-primary);
    }
    p a:hover::after,
    a.animated-link:hover::after {
      transform: scaleX(1);
      transform-origin: bottom left;
      background-color: var(--color-primary);
    }

    /* Styles for philosophyText newlines */
    /* If philosophyText is long, ensure proper line breaking and spacing */
    p[set\\:html] br {
      /* Target <br> tags generated from newlines */
      margin-bottom: 0.5em; /* Add a bit of space after a forced break */
      display: block; /* Ensure <br> acts as a block for margin */
      content: ""; /* Required for ::before/::after on <br>, but margin on <br> itself is better */
    }
  </style>
</Layout>
