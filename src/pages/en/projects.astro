---
// projects.astro
import Layout from "../../layouts/BaseLayout.astro";
import ProjectWheel from "../../components/ProjectWheel/index.astro";

import { getProjects, urlFor } from "../../lib/sanity";

// Default/Fallback projects
import projectImage1 from "../../assets/project3.jpg";
import projectImage2 from "../../assets/project2.jpg";
import projectImage3 from "../../assets/project1.jpg";

const defaultProjects = [
  {
    title: "Analytics Dashboard",
    description: "Real-time data visualization platform",
    image: projectImage1,
    url: "/projects/analytics-dashboard",
  },
  {
    title: "Blog Platform",
    description: "Modern content management system",
    image: projectImage2,
    url: "/projects/blog-platform",
  },
  {
    title: "Community Forum",
    description: "Engagement-focused discussion board",
    image: projectImage3,
    url: "/projects/community-forum",
  },
];

const lang = Astro.currentLocale || "en";
const sanityProjectsData = await getProjects(lang);

const sanityProjects = sanityProjectsData.map((p: any) => ({
  title: p.title,
  description: p.description,
  image: { src: p.mainImage ? urlFor(p.mainImage).width(800).url() : "" },
  url: p.link || `/${lang}/projects/${p.slug.current}`,
}));

const projects = sanityProjects.length > 0 ? sanityProjects : defaultProjects;
---

<Layout title="Projects">
  <main>
    <h1>My Projects</h1>
    <p>Scroll down to explore projects</p>

    <div class="content pt-8">
      <section class="intro text-center">
        <h2>Welcome to my project showcase</h2>
        <p>Explore my interactive project wheel below.</p>
      </section>
    </div>

    <!-- Project wheel component at the bottom -->
    <ProjectWheel projects={projects} />
  </main>
</Layout>

<style>
  main {
    max-width: 80vw;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 3rem;
  }

  .content {
    min-height: 20vh; /* Reduced from 100vh to show the wheel faster */
    padding-bottom: 10vh; /* Reduced padding */
  }

  section {
    margin-bottom: 2rem;
  }

  h2 {
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  p {
    font-family: "Raleway", sans-serif;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.6;
  }
</style>
