---
// projects.astro
import Layout from "../../layouts/BaseLayout.astro";
import ProjectWheel from "../../components/ProjectWheel.astro";

// Example projects data
const projects = [
  {
    title: "Analytics Dashboard",
    description: "Real-time data visualization platform",
    imageUrl: "../../assets/project1.jpg",
    url: "/projects/analytics-dashboard",
  },
  {
    title: "Blog Platform",
    description: "Modern content management system",
    imageUrl: "../../assets/project2.jpg",
    url: "/projects/blog-platform",
  },
  {
    title: "Community Forum",
    description: "Engagement-focused discussion board",
    imageUrl: "../../assets/project3.jpg",
    url: "/projects/community-forum",
  },
  // Add more projects as needed
];
---

<Layout title="Projects">
  <main>
    <h1>My Projects</h1>
    <p>Scroll down to explore projects</p>

    <div class="content">
      <!-- Your main page content goes here -->
      <section class="intro">
        <h2>Welcome to my project showcase</h2>
        <p>
          Here you'll find various projects I've worked on. Keep scrolling to
          the bottom to explore my project wheel.
        </p>
      </section>

      <!-- Add some content to allow scrolling -->
      <section class="spacing-section">
        <h2>About My Projects</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit...</p>
        <!-- Add more content as needed -->
      </section>
    </div>

    <!-- Project wheel component at the bottom -->
    <ProjectWheel projects={projects} />
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 3rem;
  }

  .content {
    min-height: 100vh;
    padding-bottom: 50vh; /* Space for the wheel */
  }

  section {
    margin-bottom: 4rem;
  }

  .spacing-section {
    min-height: 60vh;
  }

  h2 {
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  p {
    font-family: "Raleway", sans-serif;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.6;
  }
</style>
