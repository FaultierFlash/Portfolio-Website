---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, type Locale } from "../../i18n/utils";
import { getBooks, getLibrarySettings, getTranslationOverrides } from "../../lib/sanity";
import BookArchive from "../../components/BookArchive.astro";

const lang = Astro.currentLocale as Locale;

const [books, settings, overrides] = await Promise.all([
  getBooks(),
  getLibrarySettings(),
  getTranslationOverrides(lang),
]);
const t = useTranslations(lang, overrides);

const rawTitle = (lang === 'de' ? settings?.titleDe : settings?.titleEn) || t("nav.library");
const pageTitle = rawTitle ? rawTitle.replace(/Libary/g, 'Library').replace(/libary/g, 'library') : "Library";
const pageSubtitle = lang === 'de' ? settings?.subtitleDe : settings?.subtitleEn;
const backgroundEffect = settings?.backgroundEffect || "grid";
const accentColor = settings?.accentColor || "primary";
---

<BaseLayout 
  title={pageTitle} 
  backgroundEffect={backgroundEffect} 
  accentColor={accentColor}
  topographyConfig={settings?.topographyConfig}
>
  <div class="library-page-container">
    <BookArchive books={books} locale={lang} title={pageTitle} subtitle={pageSubtitle} />
  </div>
</BaseLayout>

<style>
  .library-page-container {
    min-height: 100vh;
    padding-bottom: 5rem;
  }
</style>
