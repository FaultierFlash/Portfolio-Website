---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CvDocument from '../../components/CvDocument.astro';
import { getCvData } from '../../lib/sanity';

const cvData = await getCvData('de');
const pageTitle = "Lebenslauf (CV)";
const pageDescription = `Akademischer Lebenslauf von ${cvData.personalInfo?.name || "Marlon Müller"} – Ingenieurwissenschaften an der TUM, Odonatum e.V., Erfahrung, Kompetenzen und PDF-Export.`;
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  backgroundEffect="grid" 
  accentColor="primary"
  showFooter={true}
>
  <div class="min-h-screen pt-20 pb-16 flex justify-center">
    <CvDocument cvData={cvData} locale="de" />
  </div>
</BaseLayout>
