---
import Layout from "../../../layouts/BaseLayout.astro";
import jwt from "jsonwebtoken";

export const prerender = false; // SSR required

const token = Astro.url.searchParams.get("token");
let isValid = false;

if (token) {
    try {
        const secret =
            import.meta.env.JWT_SECRET || (typeof process !== 'undefined' ? process.env.JWT_SECRET : undefined) || "dev-secret-do-not-use-in-prod";
        const decoded = jwt.verify(token, secret) as any;
        isValid = !!decoded;
    } catch (error) {
        isValid = false;
    }
}
---

<Layout title="Verifizierung | Kontakt">
    <div
        class="flex flex-col items-center justify-center min-h-[60vh] p-4 text-center"
    >
        <div
            id="verify-card"
            class="max-w-md w-full bg-slate-900 border border-slate-700 rounded-lg p-8 shadow-2xl relative overflow-hidden transition-all duration-300"
        >
            {/* Decorative background glow */}
            <div
                id="card-glow"
                class="absolute top-0 left-0 w-full h-1 bg-blue-500 transition-colors duration-300"
            >
            </div>

            <h1 id="card-title" class="text-2xl font-bold mb-4 font-mono text-white">
                Kontaktanfrage verifizieren
            </h1>

            <p id="card-message" class="mb-8 text-gray-300">
                {isValid 
                    ? "Bitte klicke auf den Button unten, um zu bestätigen, dass du deine Nachricht an Marlon Müller senden möchtest."
                    : "Ungültiger oder abgelaufener Verifizierungstoken. Bitte versuche, das Formular erneut abzusenden."}
            </p>

            <div class="flex flex-col gap-4 items-center">
                {isValid && (
                    <button
                        id="confirm-btn"
                        class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded transition-colors shadow-lg cursor-pointer"
                    >
                        Bestätigen & Nachricht senden
                    </button>
                )}
                
                <a
                    href={`/${Astro.currentLocale || ""}`}
                    class="inline-block px-6 py-2 bg-white text-black font-semibold rounded hover:bg-gray-200 transition-colors cursor-pointer"
                >
                    Zur Startseite
                </a>
            </div>
        </div>
    </div>

    {isValid && (
        <script define:vars={{ token }}>
            const confirmBtn = document.getElementById("confirm-btn");
            const cardGlow = document.getElementById("card-glow");
            const cardTitle = document.getElementById("card-title");
            const cardMessage = document.getElementById("card-message");

            let isSending = false;

            confirmBtn?.addEventListener("click", async () => {
                if (isSending) return;
                isSending = true;

                confirmBtn.disabled = true;
                confirmBtn.innerText = "Wird gesendet...";
                confirmBtn.style.opacity = "0.5";
                confirmBtn.style.cursor = "not-allowed";

                try {
                    const response = await fetch("/api/contact/verify", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ token })
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        throw new Error(data.message || "Verifizierung fehlgeschlagen.");
                    }

                    // Success state
                    cardGlow.className = "absolute top-0 left-0 w-full h-1 bg-green-500";
                    cardTitle.innerText = "Nachricht gesendet";
                    cardMessage.innerText = data.message || "Deine Nachricht wurde erfolgreich verifiziert und gesendet!";
                    confirmBtn.remove();
                } catch (error) {
                    // Error state
                    cardGlow.className = "absolute top-0 left-0 w-full h-1 bg-red-500";
                    cardTitle.innerText = "Verifizierung fehlgeschlagen";
                    cardMessage.innerText = error.message || "Etwas ist schiefgelaufen. Bitte versuche es noch einmal.";
                    
                    isSending = false;
                    confirmBtn.disabled = false;
                    confirmBtn.innerText = "Bestätigen & Nachricht senden";
                    confirmBtn.style.opacity = "1";
                    confirmBtn.style.cursor = "pointer";
                }
            });
        </script>
    )}
</Layout>
