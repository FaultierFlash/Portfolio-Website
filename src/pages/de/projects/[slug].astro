---
import ProjectDetailPage from "../../../components/ProjectDetailPage.astro";
import { getProjectBySlug } from "../../../lib/sanity";

const { slug } = Astro.params;
const projectData = await getProjectBySlug(slug, "de");

if (!projectData) {
  Astro.response.status = 404;
  return Astro.rewrite("/404?lang=de");
}
---

<ProjectDetailPage lang="de" slug={slug} projectData={projectData} />
