      height: 100% !important;
      padding: 0 !important;
      align-items: stretch !important;
    }

    .contact-terminal-wrapper #terminal {
      position: relative !important;
      --terminal-position: relative !important;
      width: 100% !important;
      height: 100% !important;
      min-width: 0 !important;
      min-height: 0 !important;
      max-width: 100% !important;
      max-height: 100% !important;
      top: auto !important;
      left: auto !important;
      margin: 0 !important;
    }
  }
</style>

<script>
  function initializeScrollLogic() {
    const container = document.querySelector('.scroll-container');
    if (!container) return;

    let maxTimelineZIndex = 100;
    let allowPushAway = true;
    setTimeout(() => {
        allowPushAway = false;
    }, 1500);

    // Up/Down button navigation
    const upBtns = document.querySelectorAll('.nav-up-btn');
    const downBtns = document.querySelectorAll('.nav-down-btn');
    const scrollDownBtn = document.getElementById('scroll-down-btn');

    const scrollToSection = (offset: number) => {
        const sections = document.querySelectorAll('.scroll-section');
        let currentSectionIndex = 0;
        
        let minDistance = Infinity;
        sections.forEach((sec, idx) => {
            const distance = Math.abs(sec.getBoundingClientRect().top);
            if (distance < minDistance) {
                minDistance = distance;
                currentSectionIndex = idx;
            }
        });

        const targetIndex = Math.max(0, Math.min(sections.length - 1, currentSectionIndex + offset));
        sections[targetIndex].scrollIntoView({ behavior: 'smooth' });
    };

    upBtns.forEach(btn => btn.addEventListener('click', () => scrollToSection(-1)));
    downBtns.forEach(btn => btn.addEventListener('click', () => scrollToSection(1)));
    if (scrollDownBtn) scrollDownBtn.addEventListener('click', () => scrollToSection(1));

    // Timeline Horizontal Scroll Hijack
    const timelineSection = document.querySelector('.timeline-section');
    const timelineContainer = document.getElementById('timeline-scroll-area');
    const titleHeader = document.querySelector('.timeline-header') as HTMLElement;

    // Boundary Scroll Buffer State
    let boundaryScrollAccumulator = 0;
    const BOUNDARY_THRESHOLD = 200; // threshold in pixels
    let lastScrollDirection = 0;
    let boundaryTimeoutId: any = null;

    const shouldBlockBoundaryScroll = (deltaY: number) => {
        if (!timelineContainer) return false;
        const maxScroll = timelineContainer.scrollWidth - timelineContainer.clientWidth;
        const isAtLeft = timelineContainer.scrollLeft <= 0;
        const isAtRight = timelineContainer.scrollLeft >= maxScroll - 1;
        
        const direction = deltaY > 0 ? 1 : -1;
        
        if (direction !== lastScrollDirection) {
            boundaryScrollAccumulator = 0;
            lastScrollDirection = direction;
        }
        
        if (boundaryTimeoutId) {
            clearTimeout(boundaryTimeoutId);
        }
        boundaryTimeoutId = setTimeout(() => {
            boundaryScrollAccumulator = 0;
        }, 500);
        
        if (isAtLeft && direction === -1) {
            boundaryScrollAccumulator += Math.abs(deltaY);
            if (boundaryScrollAccumulator < BOUNDARY_THRESHOLD) {
                return true;
            }
        } else if (isAtRight && direction === 1) {
            boundaryScrollAccumulator += Math.abs(deltaY);
            if (boundaryScrollAccumulator < BOUNDARY_THRESHOLD) {
                return true;
            }
        } else {
            boundaryScrollAccumulator = 0;
        }
        
        return false;
    };

    let titleMaskRafId: number | null = null;
    function updateTitleMask() {
        if (titleMaskRafId !== null) return;
        titleMaskRafId = requestAnimationFrame(() => {
            titleMaskRafId = null;
            if (!titleHeader || !timelineContainer) return;
            
            const activeCards = document.querySelectorAll('.timeline-parent-card.active, .timeline-milestone-card.active');
            if (activeCards.length === 0) {
                titleHeader.style.maskImage = '';
                titleHeader.style.webkitMaskImage = '';
                return;
            }
            
            const titleRect = titleHeader.getBoundingClientRect();
            const titleCenterX = titleRect.left + titleRect.width / 2;
            const titleCenterY = titleRect.top + titleRect.height / 2;
            
            let closestCard: HTMLElement | null = null;
            let minDist = Infinity;
            let closestCardCenterX = 0;
            let closestCardCenterY = 0;
            
            activeCards.forEach(el => {
                const card = el as HTMLElement;
                const cardRect = card.getBoundingClientRect();
                const cardCenterX = cardRect.left + cardRect.width / 2;
                const cardCenterY = cardRect.top + cardRect.height / 2;
                
                const dist = Math.hypot(cardCenterX - titleCenterX, cardCenterY - titleCenterY);
                if (dist < minDist) {
                    minDist = dist;
                    closestCard = card;
                    closestCardCenterX = cardCenterX;
                    closestCardCenterY = cardCenterY;
                }
            });
            
            if (minDist > 550) {
                titleHeader.style.maskImage = '';
                titleHeader.style.webkitMaskImage = '';
                return;
            }
            
            const relativeX = closestCardCenterX - titleRect.left;
            const relativeY = closestCardCenterY - titleRect.top;
            
            const maskStr = `radial-gradient(circle 240px at ${relativeX}px ${relativeY}px, transparent 0px, transparent 130px, black 240px)`;
            titleHeader.style.maskImage = maskStr;
            titleHeader.style.webkitMaskImage = maskStr;
        });
    }

    function pushCardHorizontally(card: HTMLElement) {
        if (!allowPushAway) return;
        if (timelineContainer && timelineContainer.scrollLeft > 10) return;
        if (card.hasAttribute('data-drag-x')) return;
        
        const item = card.closest('.timeline-item') as HTMLElement;
        if (item && item.classList.contains('translate-x-12')) return;

        const isTopCard = card.classList.contains('bottom-1/2');
        if (!isTopCard) return;

        const titleH2 = titleHeader ? titleHeader.querySelector('h2') : null;
        if (!titleH2) return;

        const titleWidth = titleH2.getBoundingClientRect().width || 320;
        const cardRect = card.getBoundingClientRect();
        if (cardRect.width === 0) return;
        const cardWidth = cardRect.width;

        const screenWidth = window.innerWidth;
        const screenCenter = screenWidth / 2;
        const cardCenterX = cardRect.left + cardWidth / 2;
        const distToCenter = cardCenterX - screenCenter;

        const safetyMargin = 30; // 30px spacing between card and title text
        const minCenterDist = titleWidth / 2 + safetyMargin + cardWidth / 2;

        if (Math.abs(distToCenter) < minCenterDist) {
            const targetDist = distToCenter >= 0 ? minCenterDist : -minCenterDist;
            const pushX = targetDist - distToCenter;

            card.style.setProperty('--drag-x', `${pushX}px`);
            card.setAttribute('data-drag-x', pushX.toString());

            if (item) {
                let line: SVGElement | null = null;
                if (card.classList.contains('timeline-parent-card')) {
                    line = item.querySelector('.line-parent') as SVGElement;
                } else {
                    const itemIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[1];
                    const evtIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[2];
                    if (itemIdx && evtIdx) {
                        line = item.querySelector(`.line-milestone-${itemIdx}-${evtIdx}`) as SVGElement;
                    }
                }
                if (line) {
                    const origX2 = parseFloat(line.getAttribute('data-original-x2') || '0');
                    line.setAttribute('x2', (origX2 + pushX).toString());
                }
            }
        }
    }

    function initPushAway() {
        const activeCardsOnLoad = document.querySelectorAll('.timeline-parent-card.active, .timeline-milestone-card.active');
        activeCardsOnLoad.forEach(card => {
            pushCardHorizontally(card as HTMLElement);
        });
    }

    if (timelineSection && timelineContainer && window.innerWidth >= 768) {
        timelineSection.addEventListener('wheel', (e) => {
            const wheelEvent = e as WheelEvent;
            
            // If the wheel event is within an active info card, let the card's own wheel listener handle it
            const target = wheelEvent.target as HTMLElement;
            const card = target && target.closest('.timeline-parent-card, .timeline-milestone-card') as HTMLElement;
            if (card) {
                return;
            }
            
            const maxScroll = timelineContainer.scrollWidth - timelineContainer.clientWidth;
            
            // Apply boundary buffer
            if (shouldBlockBoundaryScroll(wheelEvent.deltaY)) {
                wheelEvent.preventDefault();
                return;
            }

            // Allow vertical native scrolling down ONLY if we hit the right boundary
            if (wheelEvent.deltaY > 0 && timelineContainer.scrollLeft >= maxScroll - 1) {
                return;
            }
            // Allow vertical native scrolling up ONLY if we hit the left boundary
            if (wheelEvent.deltaY < 0 && timelineContainer.scrollLeft <= 0) {
               return;
            }

            // Otherwise, we intercept and scroll horizontally
            wheelEvent.preventDefault();
            timelineContainer.scrollLeft += wheelEvent.deltaY;
        }, { passive: false });

        // --- Timeline Reveal Animation ---
        const timelineTrack = document.getElementById('timeline-track');
        const movingArrow = document.getElementById('moving-arrow');
        const actualMarker = document.getElementById('actual-present-marker');
        let maxRevealPos = 0; // High-water mark relative to timeline track

        function updateReveal() {
            if (!timelineTrack || !movingArrow || !actualMarker || window.innerWidth < 768) return;
            
            if (maxRevealPos === 0) {
                maxRevealPos = window.innerWidth * 0.75;
            }

            const trackRect = timelineTrack.getBoundingClientRect();
            const actualX = actualMarker.getBoundingClientRect().left;
            
            const targetWallScreenX = window.innerWidth * 0.75;
            const currentWallRevealPos = targetWallScreenX - trackRect.left;
            
            // Update high-water mark, capping at the actual end of timeline
            const actualEndPos = actualX - trackRect.left;
            
            if (currentWallRevealPos > maxRevealPos) {
                 maxRevealPos = currentWallRevealPos;
            }
            if (maxRevealPos > actualEndPos) {
                 maxRevealPos = actualEndPos;
            }
            
            timelineTrack.style.setProperty('--reveal-pos', `${maxRevealPos}px`);
            
            const futureLine = document.getElementById('future-line');
            if (futureLine && timelineSection) {
                futureLine.style.left = `${actualX}px`;
                const actualRect = actualMarker.getBoundingClientRect();
                const sectionRect = timelineSection.getBoundingClientRect();
                const relativeTop = actualRect.top - sectionRect.top + (actualRect.height / 2);
                futureLine.style.top = `${relativeTop}px`;
            }
            
            const pastContainer = document.getElementById('timeline-revealed-past');
            const arrowShape = movingArrow.querySelector('svg');
            if (maxRevealPos >= actualEndPos - 1) {
                pastContainer?.classList.add('fully-revealed');
                arrowShape?.classList.remove('text-primary');
                arrowShape?.classList.add('text-gray-400', 'dark:text-gray-600');
                document.getElementById('scanner-laser-1')?.classList.add('opacity-0');
                document.getElementById('scanner-laser-2')?.classList.add('opacity-0');
            } else {
                pastContainer?.classList.remove('fully-revealed');
                arrowShape?.classList.add('text-primary');
                arrowShape?.classList.remove('text-gray-400', 'dark:text-gray-600');
                document.getElementById('scanner-laser-1')?.classList.remove('opacity-0');
                document.getElementById('scanner-laser-2')?.classList.remove('opacity-0');
            }
        }
        
        timelineContainer.addEventListener('scroll', updateReveal);
        timelineContainer.addEventListener('scroll', updateTitleMask);
        window.addEventListener('resize', () => {
            updateReveal();
            updateTitleMask();
        });
        updateReveal();
        initPushAway();
        updateTitleMask();
        setTimeout(() => {
            updateReveal();
            initPushAway();
            updateTitleMask();
        }, 100);
        setTimeout(() => {
            initPushAway();
            updateTitleMask();
        }, 1200);
        
        // --- Timeline Intersection Animations ---
        const timelineItems = document.querySelectorAll('.timeline-item');
        if (timelineItems.length > 0) {
            const itemObserver = new IntersectionObserver((entries, obs) => {
                // Determine how many items are entering at once to stagger them nicely
                const entering = entries.filter(e => e.isIntersecting);
                entering.forEach((entry, idx) => {
                    setTimeout(() => {
                        entry.target.classList.remove('opacity-0', 'translate-x-12');
                        entry.target.classList.add('opacity-100', 'translate-x-0');
                    }, idx * 100); 
                    obs.unobserve(entry.target);
                });
            }, {
                root: timelineContainer, 
                rootMargin: '0px 200px 0px 200px', // Trigger slightly ahead of view
                threshold: 0.1
            });

            timelineItems.forEach(item => {
                itemObserver.observe(item);
                item.addEventListener('transitionend', () => {
                    const activeCards = item.querySelectorAll('.timeline-parent-card.active, .timeline-milestone-card.active');
                    activeCards.forEach(card => {
                        pushCardHorizontally(card as HTMLElement);
                    });
                    updateTitleMask();
                });
            });
        }

        // --- Draggable & Toggleable Timeline Card Logic ---
        
        // Helper to toggle active status and reset card coordinates on drag close
        function openCard(card: HTMLElement) {
            card.classList.add('active');
            
            // Highlight line and make it visible
            const item = card.closest('.timeline-item') as HTMLElement;
            if (item) {
                item.classList.add('has-active-card');
                maxTimelineZIndex++;
                item.style.zIndex = maxTimelineZIndex.toString();
                if (card.classList.contains('timeline-parent-card')) {
                    const line = item.querySelector('.line-parent');
                    line?.classList.add('visible');
                } else {
                    const itemIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[1];
                    const evtIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[2];
                    if (itemIdx && evtIdx) {
                        const line = item.querySelector(`.line-milestone-${itemIdx}-${evtIdx}`);
                        line?.classList.add('visible');
                    }
                }
            }
            updateTitleMask();
        }

        function closeCard(card: HTMLElement) {
            card.classList.remove('active');
            resetCardDrag(card);
            
            // Hide line
            const item = card.closest('.timeline-item') as HTMLElement;
            if (item) {
                const otherActiveCards = item.querySelectorAll('.timeline-parent-card.active, .timeline-milestone-card.active');
                if (otherActiveCards.length === 0) {
                    item.classList.remove('has-active-card');
                    item.style.zIndex = '';
                }
                if (card.classList.contains('timeline-parent-card')) {
                    const line = item.querySelector('.line-parent');
                    line?.classList.remove('visible', 'highlighted');
                } else {
                    const itemIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[1];
                    const evtIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[2];
                    if (itemIdx && evtIdx) {
                        const line = item.querySelector(`.line-milestone-${itemIdx}-${evtIdx}`);
                        line?.classList.remove('visible', 'highlighted');
                    }
                }
            }
            updateTitleMask();
        }

        function resetCardDrag(card: HTMLElement) {
            card.style.removeProperty('--drag-x');
            card.style.removeProperty('--drag-y');
            card.style.transform = '';
            card.style.transition = '';
            card.removeAttribute('data-drag-x');
            card.removeAttribute('data-drag-y');
            card.classList.remove('dragging');
            
            const item = card.closest('.timeline-item') as HTMLElement;
            if (!item) return;
            
            if (card.classList.contains('timeline-parent-card')) {
                const line = item.querySelector('.line-parent') as SVGElement;
                if (line) {
                    const origX2 = line.getAttribute('data-original-x2');
                    const origY2 = line.getAttribute('data-original-y2');
                    if (origX2) line.setAttribute('x2', origX2);
                    if (origY2) line.setAttribute('y2', origY2);
                }
            } else {
                const itemIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[1];
                const evtIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[2];
                if (itemIdx && evtIdx) {
                    const line = item.querySelector(`.line-milestone-${itemIdx}-${evtIdx}`) as SVGElement;
                    if (line) {
                        const origX2 = line.getAttribute('data-original-x2');
                        const origY2 = line.getAttribute('data-original-y2');
                        if (origX2) line.setAttribute('x2', origX2);
                        if (origY2) line.setAttribute('y2', origY2);
                    }
                }
            }
        }

        // Initialize visible state for cards starting with 'active' class
        const activeCards = document.querySelectorAll('.timeline-parent-card.active, .timeline-milestone-card.active');
        activeCards.forEach(card => {
            const item = card.closest('.timeline-item') as HTMLElement;
            if (item) {
                item.classList.add('has-active-card');
                if (card.classList.contains('timeline-parent-card')) {
                    const line = item.querySelector('.line-parent');
                    line?.classList.add('visible');
                } else {
                    const itemIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[1];
                    const evtIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[2];
                    if (itemIdx && evtIdx) {
                        const line = item.querySelector(`.line-milestone-${itemIdx}-${evtIdx}`);
                        line?.classList.add('visible');
                    }
                }
            }
        });

        // 1. Toggle on click of Timeline capsule/point
        const capsulesAndPoints = document.querySelectorAll('.timeline-parent-capsule, .timeline-parent-point');
        capsulesAndPoints.forEach(trigger => {
            trigger.addEventListener('click', (e) => {
                const item = trigger.closest('.timeline-item') as HTMLElement;
                if (!item) return;
                const card = item.querySelector('.timeline-parent-card') as HTMLElement;
                if (!card) return;
                
                const isActive = card.classList.contains('active');
                if (isActive) {
                    closeCard(card);
                } else {
                    openCard(card);
                }
            });
        });

        // 2. Toggle on click of milestone pin
        const milestonePins = document.querySelectorAll('.milestone-pin');
        milestonePins.forEach(pin => {
            pin.addEventListener('click', (e) => {
                e.stopPropagation();
                const item = pin.closest('.timeline-item') as HTMLElement;
                if (!item) return;
                const itemIdx = pin.getAttribute('data-item-idx');
                const evtIdx = pin.getAttribute('data-evt-idx');
                const card = item.querySelector(`.milestone-card-${itemIdx}-${evtIdx}`) as HTMLElement;
                if (!card) return;

                const isActive = card.classList.contains('active');
                if (isActive) {
                    closeCard(card);
                } else {
                    openCard(card);
                }
            });
        });

        // 3. Bind close button inside cards
        const closeBtns = document.querySelectorAll('.close-card-btn');
        closeBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const card = btn.closest('.timeline-parent-card, .timeline-milestone-card') as HTMLElement;
                if (card) {
                    closeCard(card);
                }
            });
        });

        // 3.5 Bring card to front on click/touch & handle wheel scroll event
        const timelineCards = document.querySelectorAll('.timeline-parent-card, .timeline-milestone-card');
        timelineCards.forEach(el => {
            const card = el as HTMLElement;
            
            const bringToFront = () => {
                const item = card.closest('.timeline-item') as HTMLElement;
                if (item) {
                    maxTimelineZIndex++;
                    item.style.zIndex = maxTimelineZIndex.toString();
                }
            };
            card.addEventListener('mousedown', bringToFront);
            card.addEventListener('touchstart', bringToFront);
            
            card.addEventListener('wheel', (e) => {
                const wheelEvent = e as WheelEvent;
                const scrollablePara = card.querySelector('.custom-scrollbar') as HTMLElement;
                
                if (scrollablePara && scrollablePara.scrollHeight > scrollablePara.clientHeight) {
                    const atTop = scrollablePara.scrollTop <= 0;
                    const atBottom = scrollablePara.scrollTop + scrollablePara.clientHeight >= scrollablePara.scrollHeight - 1;
                    
                    if (wheelEvent.deltaY > 0 && !atBottom) {
                        scrollablePara.scrollTop += wheelEvent.deltaY;
                        wheelEvent.preventDefault();
                        return;
                    }
                    if (wheelEvent.deltaY < 0 && !atTop) {
                        scrollablePara.scrollTop += wheelEvent.deltaY;
                        wheelEvent.preventDefault();
                        return;
                    }

                    // If the card has a scrollbar and we hit the boundaries (top/bottom),
                    // prevent default scroll behavior so it does NOT scroll the main timeline/page.
                    wheelEvent.preventDefault();
                    return;
                }
                
                const maxScroll = timelineContainer.scrollWidth - timelineContainer.clientWidth;
                
                // Apply boundary buffer
                if (shouldBlockBoundaryScroll(wheelEvent.deltaY)) {
                    wheelEvent.preventDefault();
                    return;
                }

                if (wheelEvent.deltaY > 0 && timelineContainer.scrollLeft >= maxScroll - 1) {
                    return;
                }
                if (wheelEvent.deltaY < 0 && timelineContainer.scrollLeft <= 0) {
                    return;
                }
                
                wheelEvent.preventDefault();
                timelineContainer.scrollLeft += wheelEvent.deltaY;
            }, { passive: false });
        });

        // 4. Highlight lines on card hover
        timelineItems.forEach(el => {
            const item = el as HTMLElement;
            
            // Parent card hover highlights
            const parentCard = item.querySelector('.timeline-parent-card');
            const parentLines = item.querySelectorAll('.line-parent');
            
            const highlightParent = (val: boolean) => {
                parentLines.forEach(l => {
                    if (val) l.classList.add('highlighted');
                    else l.classList.remove('highlighted');
                });
            };
            if (parentCard) {
                parentCard.addEventListener('mouseenter', () => highlightParent(true));
                parentCard.addEventListener('mouseleave', () => highlightParent(false));
            }

            // Milestone pin and card highlights
            const pins = item.querySelectorAll('.milestone-pin');
            pins.forEach(pin => {
                const itemIdx = pin.getAttribute('data-item-idx');
                const evtIdx = pin.getAttribute('data-evt-idx');
                if (itemIdx !== null && evtIdx !== null) {
                    const mCard = item.querySelector(`.milestone-card-${itemIdx}-${evtIdx}`);
                    const mLines = item.querySelectorAll(`.line-milestone-${itemIdx}-${evtIdx}`);

                    const highlightMilestone = (val: boolean) => {
                        mLines.forEach(l => {
                            if (val) l.classList.add('highlighted');
                            else l.classList.remove('highlighted');
                        });
                    };

                    pin.addEventListener('mouseenter', () => highlightMilestone(true));
                    pin.addEventListener('mouseleave', () => highlightMilestone(false));
                    if (mCard) {
                        mCard.addEventListener('mouseenter', () => highlightMilestone(true));
                        mCard.addEventListener('mouseleave', () => highlightMilestone(false));
                    }
                }
            });
        });

        // 5. Card Drag Handle Event Listeners (Mouse & Touch)
        const dragHandles = document.querySelectorAll('.drag-handle');
        dragHandles.forEach(handle => {
            let startX = 0;
            let startY = 0;
            let initialDragX = 0;
            let initialDragY = 0;
            let card: HTMLElement | null = null;
            let line: SVGElement | null = null;
            let lineX2Baseline = 0;
            let lineY2Baseline = 0;
            let isDragging = false;

            const onMouseMove = (e: MouseEvent) => {
                if (!isDragging || !card) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                const newDragX = initialDragX + dx;
                const newDragY = initialDragY + dy;
                
                card.style.setProperty('--drag-x', `${newDragX}px`);
                card.style.setProperty('--drag-y', `${newDragY}px`);
                card.setAttribute('data-drag-x', newDragX.toString());
                card.setAttribute('data-drag-y', newDragY.toString());

                if (line) {
                    line.setAttribute('x2', (lineX2Baseline + dx).toString());
                    line.setAttribute('y2', (lineY2Baseline + dy).toString());
                }
                updateTitleMask();
            };

            const onMouseUp = () => {
                if (!isDragging) return;
                isDragging = false;
                if (card) {
                    card.style.transition = '';
                    card.classList.remove('dragging');
                }
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            };

            handle.addEventListener('mousedown', (e) => {
                const mouseEvent = e as MouseEvent;
                if (mouseEvent.button !== 0) return; // Left click only
                
                card = handle.closest('.timeline-parent-card, .timeline-milestone-card') as HTMLElement;
                if (!card) return;
                
                e.preventDefault();
                e.stopPropagation();
                
                startX = mouseEvent.clientX;
                startY = mouseEvent.clientY;
                initialDragX = parseFloat(card.getAttribute('data-drag-x') || '0');
                initialDragY = parseFloat(card.getAttribute('data-drag-y') || '0');
                
                card.style.transition = 'none'; // Disable animations during active drag
                card.classList.add('dragging');
                isDragging = true;

                const item = card.closest('.timeline-item') as HTMLElement;
                if (item) {
                    maxTimelineZIndex++;
                    item.style.zIndex = maxTimelineZIndex.toString();

                    // Find corresponding line
                    if (card.classList.contains('timeline-parent-card')) {
                        line = item.querySelector('.line-parent') as SVGElement;
                    } else {
                        const itemIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[1];
                        const evtIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[2];
                        if (itemIdx && evtIdx) {
                            line = item.querySelector(`.line-milestone-${itemIdx}-${evtIdx}`) as SVGElement;
                        }
                    }
                    if (line) {
                        lineX2Baseline = parseFloat(line.getAttribute('x2') || '0');
                        lineY2Baseline = parseFloat(line.getAttribute('y2') || '0');
                    }
                }

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });

            // Touch Drag Support
            const onTouchMove = (e: TouchEvent) => {
                if (!isDragging || !card) return;
                const touch = e.touches[0];
                const dx = touch.clientX - startX;
                const dy = touch.clientY - startY;
                const newDragX = initialDragX + dx;
                const newDragY = initialDragY + dy;
                
                card.style.setProperty('--drag-x', `${newDragX}px`);
                card.style.setProperty('--drag-y', `${newDragY}px`);
                card.setAttribute('data-drag-x', newDragX.toString());
                card.setAttribute('data-drag-y', newDragY.toString());

                if (line) {
                    line.setAttribute('x2', (lineX2Baseline + dx).toString());
                    line.setAttribute('y2', (lineY2Baseline + dy).toString());
                }
                updateTitleMask();
            };

            const onTouchEnd = () => {
                if (!isDragging) return;
                isDragging = false;
                if (card) {
                    card.style.transition = '';
                    card.classList.remove('dragging');
                }
                document.removeEventListener('touchmove', onTouchMove);
                document.removeEventListener('touchend', onTouchEnd);
            };

            handle.addEventListener('touchstart', (e) => {
                card = handle.closest('.timeline-parent-card, .timeline-milestone-card') as HTMLElement;
                if (!card) return;
                
                e.stopPropagation();
                
                const touch = (e as TouchEvent).touches[0];
                startX = touch.clientX;
                startY = touch.clientY;
                initialDragX = parseFloat(card.getAttribute('data-drag-x') || '0');
                initialDragY = parseFloat(card.getAttribute('data-drag-y') || '0');
                
                card.style.transition = 'none';
                card.classList.add('dragging');
                isDragging = true;

                const item = card.closest('.timeline-item') as HTMLElement;
                if (item) {
                    maxTimelineZIndex++;
                    item.style.zIndex = maxTimelineZIndex.toString();

                    // Find corresponding line
                    if (card.classList.contains('timeline-parent-card')) {
                        line = item.querySelector('.line-parent') as SVGElement;
                    } else {
                        const itemIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[1];
                        const evtIdx = card.className.match(/milestone-card-(\d+)-(\d+)/)?.[2];
                        if (itemIdx && evtIdx) {
                            line = item.querySelector(`.line-milestone-${itemIdx}-${evtIdx}`) as SVGElement;
                        }
                    }
                    if (line) {
                        lineX2Baseline = parseFloat(line.getAttribute('x2') || '0');
                        lineY2Baseline = parseFloat(line.getAttribute('y2') || '0');
                    }
                }

                document.addEventListener('touchmove', onTouchMove, { passive: true });
                document.addEventListener('touchend', onTouchEnd);
            });
        });
    }

    // --- Mobile Timeline Strip Logic ---
    if (timelineSection && window.innerWidth < 768) {
        const mobileCards = document.querySelectorAll('.mobile-timeline-card');
        const milestoneCards = document.querySelectorAll('.mobile-milestone-card');
        const stripDots = document.querySelectorAll('.mobile-strip-dot');
        const stripSpans = document.querySelectorAll('.mobile-strip-span');
        
        const mobileStrip = document.getElementById('mobile-strip');
        const scrollContainer = document.querySelector('.scroll-container');
        
        if (mobileCards.length > 0 && stripDots.length > 0 && mobileStrip && scrollContainer) {
            let activeParentIdx = -1;
            let activeMilestoneKey = '';
            let animatingTitle = '';
            let animationTimeoutId: any = null;
            
            function updateDynamicTitle() {
                const titleEl = document.getElementById('mobile-strip-title-text');
                if (!titleEl || !mobileStrip) return;
                
                if (activeParentIdx < 0) {
                    titleEl.classList.remove('active');
                    animatingTitle = '';
                    if (animationTimeoutId) {
                        clearTimeout(animationTimeoutId);
                        animationTimeoutId = null;
                    }
                    return;
                }
                
                const card = mobileCards[activeParentIdx];
                if (!card) return;
                
                const newTitle = card.getAttribute('data-title') || '';
                
                // If the new title is already what we are animating/displaying, ensure active and return
                if (newTitle === animatingTitle) {
                    titleEl.classList.add('active');
                    return;
                }
                
                // Clear any pending transition
                if (animationTimeoutId) {
                    clearTimeout(animationTimeoutId);
                }
                
                animatingTitle = newTitle;
                
                // Slide down and fade out current title
                titleEl.classList.remove('active');
                
                animationTimeoutId = setTimeout(() => {
                    titleEl.textContent = newTitle;
                    // Slide up and fade in new title
                    titleEl.classList.add('active');
                    animationTimeoutId = null;
                }, 200);
            }

            function updateStripHighlight(parentIdx: number, milestoneIdx: number) {
                const newKey = `${parentIdx}-${milestoneIdx}`;
                if (newKey === activeMilestoneKey && parentIdx === activeParentIdx) return;
                activeParentIdx = parentIdx;
                activeMilestoneKey = newKey;
                
                // Update dots highlight
                stripDots.forEach((dot) => {
                    const el = dot as HTMLElement;
                    const dParent = parseInt(el.getAttribute('data-parent-idx') || '-1');
                    const dMilestone = parseInt(el.getAttribute('data-milestone-idx') || '-1');
                    const dotType = el.getAttribute('data-dot-type');
                    const isParent = dotType === 'parent';
                    const baseSize = isParent ? 10 : 6;
                    
                    const isActiveParent = dParent === parentIdx && parentIdx >= 0;
                    const isActiveMilestone = dParent === parentIdx && dMilestone === milestoneIdx && milestoneIdx >= 0 && parentIdx >= 0;
                    
                    if (isActiveMilestone) {
                        // Currently focused milestone — big glow
                        el.style.width = '14px';
                        el.style.height = '14px';
                        el.style.opacity = '1';
                        el.style.boxShadow = '0 0 0 3px rgba(255,255,255,0.8), 0 0 10px currentColor';
                        el.style.zIndex = '15';
                    } else if (isActiveParent && isParent) {
                        // Active parent dot — enlarged ring
                        el.style.width = '14px';
                        el.style.height = '14px';
                        el.style.opacity = '1';
                        el.style.boxShadow = '0 0 0 3px rgba(255,255,255,0.8), 0 0 8px currentColor';
                        el.style.zIndex = '14';
                    } else if (isActiveParent) {
                        // Sibling milestones of active parent — slightly brighter
                        el.style.width = (baseSize + 2) + 'px';
                        el.style.height = (baseSize + 2) + 'px';
                        el.style.opacity = '0.9';
                        el.style.boxShadow = '';
                        el.style.zIndex = '11';
                    } else {
                        // Inactive
                        el.style.width = baseSize + 'px';
                        el.style.height = baseSize + 'px';
                        el.style.opacity = isParent ? '1' : '0.5';
                        el.style.boxShadow = '';
                        el.style.zIndex = isParent ? '10' : '9';
                    }
                });

                // Highlight range capsules (spans) for parent entries
                stripSpans.forEach((span) => {
                    const el = span as HTMLElement;
                    const dParent = parseInt(el.getAttribute('data-span-parent-idx') || '-1');
                    if (dParent === parentIdx && parentIdx >= 0) {
                        el.style.opacity = '0.85';
                        el.style.height = '8px';
                    } else {
                        el.style.opacity = '0.2';
                        el.style.height = '4px';
                    }
                });

                updateDynamicTitle();
            }
            
            function handleScroll() {
                if (!scrollContainer || !mobileStrip) return;
                const containerRect = scrollContainer.getBoundingClientRect();
                const stripHeight = mobileStrip.getBoundingClientRect().height;
                
                // The activation line is just below the sticky strip
                const activationLine = containerRect.top + stripHeight + 40;
                
                let activeIdx = -1;
                mobileCards.forEach((card, idx) => {
                    const rect = card.getBoundingClientRect();
                    if (rect.top <= activationLine && rect.bottom >= activationLine) {
                        activeIdx = idx;
                    }
                });
                
                // If center is not inside any card, determine if we are above the timeline or below it
                if (activeIdx < 0 && mobileCards.length > 0) {
                    const firstRect = mobileCards[0].getBoundingClientRect();
                    if (firstRect.top > activationLine) {
                        // Above the timeline (e.g. in hero)
                        activeIdx = -1;
                    } else {
                        // Check if below the timeline (e.g. in footer/contact)
                        const lastRect = mobileCards[mobileCards.length - 1].getBoundingClientRect();
                        if (lastRect.bottom < activationLine) {
                            activeIdx = -1;
                        } else {
                            // Currently in a gap between cards inside the timeline — keep the card that has already crossed active
                            for (let i = mobileCards.length - 1; i >= 0; i--) {
                                const rect = mobileCards[i].getBoundingClientRect();
                                if (rect.top <= activationLine) {
                                    activeIdx = i;
                                    break;
                                }
                            }
                        }
                    }
                }
                
                let activeMIdx = -1;
                if (activeIdx >= 0) {
                    milestoneCards.forEach((mCard) => {
                        const rect = mCard.getBoundingClientRect();
                        // Highlight milestone dot when its card crosses the activation line area
                        if (rect.top <= activationLine + 40 && rect.bottom >= activationLine - 40) {
                            const pIdx = parseInt(mCard.getAttribute('data-parent-idx') || '-1');
                            const mIdx = parseInt(mCard.getAttribute('data-milestone-idx') || '-1');
                            if (pIdx === activeIdx) {
                                activeMIdx = mIdx;
                            }
                        }
                    });
                }
                
                updateStripHighlight(activeIdx, activeMIdx);
            }
            
            // Dot click → scroll to card
            stripDots.forEach(dot => {
                dot.addEventListener('click', () => {
                    const el = dot as HTMLElement;
                    const pIdx = parseInt(el.getAttribute('data-parent-idx') || '0');
                    const mIdx = parseInt(el.getAttribute('data-milestone-idx') || '-1');
                    
                    const containerRect = scrollContainer.getBoundingClientRect();
                    const stripHeight = mobileStrip.getBoundingClientRect().height;
                    
                    if (mIdx >= 0) {
                        // Scroll to specific milestone card
                        const target = document.querySelector(`.mobile-milestone-card[data-parent-idx="${pIdx}"][data-milestone-idx="${mIdx}"]`) as HTMLElement;
                        if (target) {
                            const targetRect = target.getBoundingClientRect();
                            // Center the milestone card below the strip
                            const targetScrollTop = scrollContainer.scrollTop + (targetRect.top - containerRect.top) - stripHeight - 20;
                            scrollContainer.scrollTo({
                                top: targetScrollTop,
                                behavior: 'smooth'
                            });
                            return;
                        }
                    }
                    
                    // Scroll to parent card
                    const card = mobileCards[pIdx] as HTMLElement;
                    if (card) {
                        const cardRect = card.getBoundingClientRect();
                        const targetScrollTop = scrollContainer.scrollTop + (cardRect.top - containerRect.top) - stripHeight - 10;
                        scrollContainer.scrollTo({
                            top: targetScrollTop,
                            behavior: 'smooth'
                        });
                    }
                });
            });

            // Listen to scroll to update dynamic highlights and title ticker
            scrollContainer.addEventListener('scroll', handleScroll);
            
            handleScroll();
        }
    }

    // Library Section Horizontal Scroll Support (if needed)
    // Currently vertical snap works best for the Library layout

    // --- Accent Color Observer: update CSS vars as project slides scroll into view ---
    const colorMap = (window as any).__accentColorMap || {
      primary: { main: '#FF7D1A', bg: 'rgba(255,125,26,0.15)', border: 'rgba(255,125,26,0.5)' },
      blue:    { main: '#3b82f6', bg: 'rgba(59,130,246,0.15)',  border: 'rgba(59,130,246,0.5)' },
      green:   { main: '#22c55e', bg: 'rgba(34,197,94,0.15)',   border: 'rgba(34,197,94,0.5)'  },
      purple:  { main: '#a855f7', bg: 'rgba(168,85,247,0.15)',  border: 'rgba(168,85,247,0.5)' },
      rose:    { main: '#f43f5e', bg: 'rgba(244,63,94,0.15)',   border: 'rgba(244,63,94,0.5)'  },
      gray:    { main: '#6b7280', bg: 'rgba(107,114,128,0.15)', border: 'rgba(107,114,128,0.5)'},
    };

    function setAccentColor(colorKey: string) {
      const c = colorMap[colorKey] || colorMap.primary;
      document.documentElement.style.setProperty('--color-project-accent', c.main);
      document.documentElement.style.setProperty('--color-project-accent-bg', c.bg);
      document.documentElement.style.setProperty('--color-project-accent-border', c.border);
    }

      const projectSections = document.querySelectorAll('.project-section[data-accent-color]');
      if (projectSections.length > 0) {
        const accentObserver = new IntersectionObserver((entries) => {
          let best: IntersectionObserverEntry | null = null;
          entries.forEach(entry => {
          if (entry.isIntersecting && (!best || (entry as any).intersectionRatio > (best as any).intersectionRatio)) {
            best = entry;
          }
        });
        if (best) setAccentColor(((best as any).target as HTMLElement).dataset.accentColor || 'primary');
        }, { threshold: [0.4, 0.6, 0.8] });
  
        const nonProjectSections = document.querySelectorAll('.hero-section, .timeline-section');
      const resetObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) setAccentColor('primary');
        });
      }, { threshold: 0.5 });

      projectSections.forEach(s => accentObserver.observe(s));
      nonProjectSections.forEach(s => resetObserver.observe(s));
    }

    // Dynamic measurement of footer height for mobile contact subpage
    function setupMobileContactLayout() {
      const footer = document.querySelector('.footer-section') as HTMLElement | null;
      const contactSection = document.querySelector('.contact-section') as HTMLElement | null;
      if (!footer) return;

      const updateFooterHeight = () => {
        if (window.innerWidth <= 767) {
          const h = footer.offsetHeight || 120;
          document.documentElement.style.setProperty('--mobile-footer-height', `${h}px`);
        } else {
          document.documentElement.style.removeProperty('--mobile-footer-height');
        }
      };

      updateFooterHeight();
      window.addEventListener('resize', updateFooterHeight);

      if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => {
          updateFooterHeight();
        });
        ro.observe(footer);
      }

      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', () => {
          if (window.innerWidth <= 767 && contactSection) {
            const vvHeight = window.visualViewport?.height || window.innerHeight;
            const isKeyboardOpen = vvHeight < window.innerHeight * 0.75;
            if (isKeyboardOpen) {
              const availH = Math.max(200, vvHeight - 60);
              contactSection.style.height = `${availH}px`;
              contactSection.style.minHeight = `${availH}px`;
              contactSection.style.maxHeight = `${availH}px`;
            } else {
              contactSection.style.height = '';
              contactSection.style.minHeight = '';
              contactSection.style.maxHeight = '';
              updateFooterHeight();
            }
          }
        });
      }
    }

    setupMobileContactLayout();
  }

  // Handle Astro page transitions
  document.addEventListener('astro:page-load', initializeScrollLogic);
</script>

