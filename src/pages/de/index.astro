                        btn?.classList.remove("max-md:opacity-100", "max-md:pointer-events-auto");
                    }
                }, { threshold: 0.1 });
                const target = document.getElementById("mobile-timeline-end");
                if(target) obs.observe(target);
            });
        </script>
    </section>
    )}

