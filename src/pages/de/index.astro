                            </div>
                        )}



                    </div>
                )})}
                    </div>
                </div>
            </div>
        </div>        {/* --- MOBILE VERTICAL TIMELINE --- */}
        <div class="block md:hidden w-full relative z-20" id="mobile-timeline">
            {/* Sticky Mini Timeline Strip */}
            <div class="mobile-strip-bar sticky bg-white/95 dark:bg-slate-950/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 px-4 pt-4 pb-6" id="mobile-strip" style="top: 0;">
                <div class="relative w-full" style="height: 64px;">
                    {/* Vertical Year Grid Lines */}
                    {yearMarkers.map((marker) => (
