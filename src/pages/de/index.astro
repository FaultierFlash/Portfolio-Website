import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, type Locale } from "../../i18n/utils";
import { getTranslationOverrides, getHomePageData, getProjects, urlFor } from "../../lib/sanity";
import DynamicBackground from "../../components/DynamicBackground.astro";
import HomeSpinWheel from "../../components/HomeSpinWheel.astro";
import TerminalContactForm from "../../components/TerminalContactForm.astro";
import Footer from "../../components/Footer.astro";

const lang = Astro.currentLocale as Locale;
const [overrides, homeData, allProjects] = await Promise.all([
  getTranslationOverrides(lang),
  getHomePageData(lang),
  getProjects(lang),
]);
const t = useTranslations(lang, overrides);
const featuredProjects = homeData?.featuredProjects || [];
const timelineItems = (homeData?.timeline || []).map((item: any) => {
    if (item.milestoneEvents) {
        return {
            ...item,
            milestoneEvents: item.milestoneEvents.slice().sort((a: any, b: any) => 
                new Date(a.date).getTime() - new Date(b.date).getTime()
            )
        };
    }
    return item;
});
const showSpinWheel = homeData?.showSpinWheel !== false;
const featuredSlugs = new Set(featuredProjects.map((p: any) => p.slug.current));
const nonFeaturedProjects = (allProjects || []).filter((p: any) => !featuredSlugs.has(p.slug.current));

// --- Timescale Math Logic ---
// We lock the timeline container strictly to the user-defined bounds.
const timelineStartDate = homeData?.timelineStartDate ? new Date(homeData.timelineStartDate) : new Date('2020-01-01');
const timelineEndDate = homeData?.timelineEndDate ? new Date(homeData.timelineEndDate) : new Date(); // present

const PX_PER_YEAR = homeData?.timelineScale || 400;
const MS_PER_YEAR = 1000 * 60 * 60 * 24 * 365.25;

const totalDurationMs = timelineEndDate.getTime() - timelineStartDate.getTime();
const totalYears = totalDurationMs / MS_PER_YEAR;

// Calculate the total track width based on the CMS slider
const timelineWidthPx = Math.max(1000, totalYears * PX_PER_YEAR);

const today = new Date();
const presentOffsetMs = today.getTime() - timelineStartDate.getTime();
const presentLeftPct = Math.max(0, Math.min(100, (presentOffsetMs / totalDurationMs) * 100));

// Helper to calc left position % and width % based on dates across the clamped track
function getTimescaleStyles(item: any) {
    const sDate = new Date(item.startDate);
    const today = new Date();
    const isActuallyOngoing = item.isOngoing && (!item.endDate || new Date(item.endDate) >= today);
    const eDate = isActuallyOngoing ? timelineEndDate : (item.endDate ? new Date(item.endDate) : sDate);

    // If item ends before our timeline even begins, skip it
    if (eDate.getTime() < timelineStartDate.getTime()) {
        return { isVisible: false, leftPercentage: 0, left: "0%", width: "0px", isActuallyOngoing: false, isDuration: false };
    }

    // No clamping! Render true negative start coords so the overflow clips it naturally
    const offsetMs = sDate.getTime() - timelineStartDate.getTime();
    const leftPercentage = (offsetMs / totalDurationMs) * 100;

    const isDuration = !!item.endDate || isActuallyOngoing;
    let widthPercentage = 0;
    if (isDuration) {
        // Render true widths without clamps
        const durationMs = eDate.getTime() - sDate.getTime();
        widthPercentage = Math.max(0.5, (durationMs / totalDurationMs) * 100); 
    }

    // Convert left percentage to pixel padding for off-screen items
    const textOffsetPx = leftPercentage < 0 ? Math.abs(leftPercentage / 100) * timelineWidthPx + 16 : 0;

    return {
        isVisible: true,
        textOffsetPx,
        left: `${leftPercentage}%`,
        width: isDuration ? `${widthPercentage}%` : "auto",
        isActuallyOngoing,
        isDuration
    };
}

function getMobileRowIdx(item: any) {
    const isDuration = !!item.endDate || item.isOngoing;
    const pos = item.verticalPosition;
    if (pos === 'far-above') return 0;
    if (pos === 'above') return 1;
    if (pos === 'below') return 3;
    if (pos === 'far-below') return 4;
    
    // Default fallback if verticalPosition is undefined/empty
    if (isDuration) {
        return 1; // Default duration is 'above'
    } else {
        return 2; // Default point is centered
    }
}


// Generate background Year Markers for the X-Axis
const yearMarkers = [];
const startYear = timelineStartDate.getFullYear();
const endYear = timelineEndDate.getFullYear();
for (let y = startYear; y <= endYear; y++) {
    const markerDate = new Date(`${y}-01-01`);
    if (markerDate >= timelineStartDate && markerDate <= timelineEndDate) {
         const offsetMs = markerDate.getTime() - timelineStartDate.getTime();
         const leftPct = (offsetMs / totalDurationMs) * 100;
         yearMarkers.push({ year: y, left: `${leftPct}%` });
    }
}

// Color mapper
type ColorClasses = { bg: string, bgSolid?: string, border: string, text: string, textDark: string, textSolid?: string, dot: string, shadow: string, btn: string, tagBg: string, hex: string };
const colors: Record<string, ColorClasses> = {
    primary: { 
        bg: 'bg-primary/20 dark:bg-primary/30', 
        bgSolid: 'bg-primary', 
        border: 'border-primary', 
        text: 'text-slate-900 dark:text-white', 
        textDark: 'dark:text-slate-100', 
        btn: 'bg-primary hover:bg-orange-600 focus:ring-orange-300 dark:focus:ring-800 text-white', 
        tagBg: 'bg-primary/20 dark:bg-primary/20',
        textSolid: 'text-slate-900 dark:text-white',
        dot: 'bg-primary',
        shadow: 'shadow-[0_0_15px_rgba(255,125,26,0.6)]',
        hex: '#FF7D1A'
    },
    blue: { 
        bg: 'bg-blue-500/20 dark:bg-blue-500/30', 
        bgSolid: 'bg-blue-600 shadow-[0_2px_10px_rgba(37,99,235,0.3)]',
        border: 'border-blue-500', 
        text: '!text-black', 
        textDark: 'dark:!text-blue-100', 
        textSolid: 'text-white',
        dot: 'bg-blue-500', 
        shadow: 'shadow-[0_0_15px_rgba(59,130,246,0.6)]', 
        btn: 'bg-blue-600 hover:bg-blue-700 focus:ring-blue-300 dark:focus:ring-blue-800 text-white', 
        tagBg: 'bg-blue-500/15 dark:bg-blue-500/20',
        hex: '#3b82f6'
    },
    green: { 
        bg: 'bg-green-500/20 dark:bg-green-500/30', 
        bgSolid: 'bg-green-600 shadow-[0_2px_10px_rgba(22,163,74,0.3)]',
        border: 'border-green-500', 
        text: '!text-black', 
        textDark: 'dark:!text-green-100', 
        textSolid: 'text-white',
        dot: 'bg-green-500', 
        shadow: 'shadow-[0_0_15px_rgba(34,197,94,0.6)]', 
        btn: 'bg-green-600 hover:bg-green-700 focus:ring-green-300 dark:focus:ring-green-800 text-white', 
        tagBg: 'bg-green-500/15 dark:bg-green-500/20',
        hex: '#22c55e'
    },
    purple: { 
        bg: 'bg-purple-500/20 dark:bg-purple-500/30', 
        bgSolid: 'bg-purple-600 shadow-[0_2px_10px_rgba(147,51,234,0.3)]',
        border: 'border-purple-500', 
        text: '!text-black', 
        textDark: 'dark:!text-purple-100', 
        textSolid: 'text-white',
        dot: 'bg-purple-500', 
        shadow: 'shadow-[0_0_15px_rgba(168,85,247,0.6)]', 
        btn: 'bg-purple-600 hover:bg-purple-700 focus:ring-purple-300 dark:focus:ring-purple-800 text-white', 
        tagBg: 'bg-purple-500/15 dark:bg-purple-500/20',
        hex: '#a855f7'
    },
    rose: { 
        bg: 'bg-rose-500/20 dark:bg-rose-500/30', 
        bgSolid: 'bg-rose-600 shadow-[0_2px_10px_rgba(225,29,72,0.3)]',
        border: 'border-rose-500', 
        text: '!text-black', 
        textDark: 'dark:!text-rose-100', 
        textSolid: 'text-white',
        dot: 'bg-rose-500', 
        shadow: 'shadow-[0_0_15px_rgba(244,63,94,0.6)]', 
        btn: 'bg-rose-600 hover:bg-rose-700 focus:ring-rose-300 dark:focus:ring-rose-800 text-white', 
        tagBg: 'bg-rose-500/15 dark:bg-rose-500/20',
        hex: '#f43f5e'
    },
    gray: { 
        bg: 'bg-gray-500/20 dark:bg-gray-500/30', 
        bgSolid: 'bg-gray-700 shadow-[0_2px_10px_rgba(55,65,81,0.3)]',
        border: 'border-gray-500', 
        text: '!text-gray-950', 
        textDark: 'dark:!text-gray-200', 
        textSolid: 'text-white',
        dot: 'bg-gray-500', 
        shadow: 'shadow-[0_0_15px_rgba(107,114,128,0.6)]', 
        btn: 'bg-gray-700 hover:bg-gray-800 focus:ring-gray-300 dark:focus:ring-gray-800 text-white', 
        tagBg: 'bg-gray-500/15 dark:bg-gray-500/20',
        hex: '#6b7280'
    },
};

// --- Overlap Resolution for Timeline Widget Cards ---
interface TimelineWidget {
    id: string;
    targetX: number;
    x: number;
}

const topWidgets: TimelineWidget[] = [];
const bottomWidgets: TimelineWidget[] = [];

const registerWidget = (id: string, targetX: number, isTop: boolean) => {
    const w = { id, targetX, x: targetX };
    if (isTop) {
        topWidgets.push(w);
    } else {
        bottomWidgets.push(w);
    }
};

timelineItems.forEach((item: any, itemIdx: number) => {
    const styles = getTimescaleStyles(item);
    if (!styles.isVisible) return;

    const isDuration = styles.isDuration;
    // Default to above for duration items (matches CSS default of -translate-y-12)
    const isTopHalf = item.verticalPosition === 'far-above' || item.verticalPosition === 'above' || (!item.verticalPosition && isDuration);
    
    const leftPct = parseFloat(styles.left);
    const widthPct = isDuration ? parseFloat(styles.width) : 0;
    
    const visibleStartPct = Math.max(0, leftPct);
    const visibleEndPct = isDuration ? Math.min(100, leftPct + widthPct) : leftPct;
    const parentTargetPct = isDuration ? (visibleStartPct + visibleEndPct) / 2 : leftPct;
    const parentTargetX = (parentTargetPct / 100) * timelineWidthPx;
    
    const hasWidget = !!(item.widgetImage || item.widgetButtonLabel || item.widgetButtonLink || item.description || item.relatedProject?.description);
    if (hasWidget) {
        registerWidget(`parent-${itemIdx}`, parentTargetX, isTopHalf);
    }
    
    if (item.milestoneEvents) {
        item.milestoneEvents.forEach((evt: any, evtIdx: number) => {
            const subWidgetImage = evt.widgetImage || evt.relatedProject?.mainImage;
            const subWidgetDesc = evt.description || evt.relatedProject?.description;
            const subWidgetBtnLabel = evt.widgetButtonLabel || (evt.relatedProject ? (lang === 'de' ? 'Projekt ansehen' : 'View Project') : '');
            const subWidgetBtnLink = evt.widgetButtonLink || (evt.relatedProject ? `/${lang}/projects/${evt.relatedProject.slug.current}` : '');
            const hasSubWidget = !!(subWidgetImage || subWidgetBtnLabel || subWidgetBtnLink || subWidgetDesc);
            
            if (hasSubWidget) {
                const evtDate = new Date(evt.date);
                const sDate = new Date(item.startDate);
                const today = new Date();
                const isActuallyOngoing = item.isOngoing && (!item.endDate || new Date(item.endDate) >= today);
                const eDate = isActuallyOngoing ? timelineEndDate : new Date(item.endDate);
                
                let evtPct = 0;
                if (eDate.getTime() > sDate.getTime()) {
                    evtPct = ((evtDate.getTime() - sDate.getTime()) / (eDate.getTime() - sDate.getTime())) * 100;
                }
                evtPct = Math.max(0, Math.min(100, evtPct));
                
                const milestoneTargetPct = leftPct + (evtPct / 100) * widthPct;
                const milestoneTargetX = (milestoneTargetPct / 100) * timelineWidthPx;
                
                registerWidget(`milestone-${itemIdx}-${evtIdx}`, milestoneTargetX, isTopHalf);
            }
        });
    }
});

const CARD_WIDTH_WITH_GAP = 280;
const resolvePositions = (widgets: TimelineWidget[]) => {
    widgets.sort((a, b) => a.targetX - b.targetX);
    
    for (let pass = 0; pass < 50; pass++) {
        let hasOverlap = false;
        for (let i = 0; i < widgets.length - 1; i++) {
            let left = widgets[i];
            let right = widgets[i + 1];
            let dist = right.x - left.x;
            if (dist < CARD_WIDTH_WITH_GAP) {
                let overlap = CARD_WIDTH_WITH_GAP - dist;
                left.x -= overlap / 2;
                right.x += overlap / 2;
                hasOverlap = true;
            }
        }
        
        if (widgets.length > 0) {
            const margin = CARD_WIDTH_WITH_GAP / 2;
            if (widgets[0].x < margin) {
                widgets[0].x = margin;
            }
            if (widgets[widgets.length - 1].x > timelineWidthPx + 120) {
                widgets[widgets.length - 1].x = timelineWidthPx + 120;
            }
        }
        
        if (!hasOverlap) break;
    }
};

resolvePositions(topWidgets);
resolvePositions(bottomWidgets);

const widgetAdjustedXMap: Record<string, number> = {};
[...topWidgets, ...bottomWidgets].forEach(w => {
    widgetAdjustedXMap[w.id] = w.x;
});

// --- Mobile Timeline Strip Pre-computation ---
const sortedTimelineItems = timelineItems.slice().sort((a: any, b: any) => 
    new Date(a.startDate).getTime() - new Date(b.startDate).getTime()
);

// Build a flat list of all events (parents + milestones) for the strip dots
interface MobileStripEvent {
    type: 'parent' | 'milestone';
    parentIdx: number;
    milestoneIdx: number; // -1 for parent
    date: Date;
    pct: number;
    title: string;
    colorKey: string;
    rowIdx: number;
}
const mobileStripEvents: MobileStripEvent[] = [];
sortedTimelineItems.forEach((item: any, pIdx: number) => {
    const startDate = new Date(item.startDate);
    const pct = Math.max(2, Math.min(98, ((startDate.getTime() - timelineStartDate.getTime()) / totalDurationMs) * 100));
    const colorKey = item.relatedProject?.accentColor || item.color || 'primary';
    const rowIdx = getMobileRowIdx(item);
    mobileStripEvents.push({ type: 'parent', parentIdx: pIdx, milestoneIdx: -1, date: startDate, pct, title: item.title, colorKey, rowIdx });
    if (item.milestoneEvents) {
        item.milestoneEvents.forEach((evt: any, mIdx: number) => {
            const evtDate = new Date(evt.date);
            const evtPct = Math.max(2, Math.min(98, ((evtDate.getTime() - timelineStartDate.getTime()) / totalDurationMs) * 100));
            const evtColorKey = evt.relatedProject?.accentColor || evt.color || item.color || 'primary';
            mobileStripEvents.push({ type: 'milestone', parentIdx: pIdx, milestoneIdx: mIdx, date: evtDate, pct: evtPct, title: evt.title, colorKey: evtColorKey, rowIdx });
        });
    }
});
mobileStripEvents.sort((a, b) => a.date.getTime() - b.date.getTime());
