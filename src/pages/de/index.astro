<BaseLayout hidePageScrollbar={true}>
  <div class="scroll-container">
    {/* Section 1: Introduction */}
    <section class="scroll-section hero-section relative flex flex-col items-center justify-center min-h-[100vh]">
      <DynamicBackground 
        effect={homeData?.backgroundEffect || "none"} 
        config={homeData?.backgroundEffect === 'solar' ? homeData?.solarConfig : homeData?.topographyConfig}
        isAbsolute={true} 
      />
      
      <div class="z-10 text-center px-4 max-w-4xl pt-4 pb-24 md:py-0">
        <h1 class="text-3xl sm:text-4xl md:text-6xl font-extrabold mb-3 md:mb-6 tracking-tight">
          {homeData?.heroTitle || t("page.home.title")}
        </h1>
        <p class="text-base sm:text-lg md:text-2xl mb-4 md:mb-8 font-bold opacity-90">
          {homeData?.heroSubtitle || t("page.home.description")}
        </p>

        {homeData?.profileImage && (
          <img
            src={urlFor(homeData.profileImage).width(300).height(300).auto('format').quality(85).url()}
            alt={homeData.heroTitle || "Profile"}
            width="224"
            height="224"
            fetchpriority="high"
            decoding="async"
            class="mx-auto rounded-full w-28 h-28 sm:w-36 sm:h-36 md:w-56 md:h-56 object-cover shadow-2xl mb-4 md:mb-8 border-4 border-white dark:border-gray-800"
          />
        )}

        {homeData?.aboutText && (
          <p class="text-sm sm:text-base md:text-lg max-w-2xl mx-auto mb-4 md:mb-10 leading-relaxed font-black opacity-80">
            {homeData.aboutText}
          </p>
        )}
      </div>

      {featuredProjects.length > 0 && (
        <button id="scroll-down-btn" class="absolute bottom-6 md:bottom-16 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 md:gap-2 group cursor-pointer p-1.5 md:p-2 z-20" aria-label="Scroll to projects">
           <span class="text-xs font-bold tracking-widest uppercase text-slate-800 dark:text-slate-400 group-hover:text-primary transition-colors">Reise beginnen</span>
           <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce text-slate-800 dark:text-slate-400 group-hover:text-primary transition-colors"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
        </button>
      )}
    </section>

    {/* Section 1.5: Timeline */}
    {timelineItems.length > 0 && (
    <section class="scroll-section timeline-section relative flex flex-col justify-center min-h-[100vh] w-full" id="timeline">
        <DynamicBackground effect="grid" isAbsolute={true} />
        
        <div class="timeline-header relative md:absolute pt-8 md:pt-0 md:top-24 w-full text-center z-10 pointer-events-none px-4">
            <h2 class="text-3xl md:text-5xl font-black heading-font w-fit mx-auto">Meine Reise</h2>
            <p class="hidden md:block text-slate-600 dark:text-slate-400 mt-2 uppercase tracking-widest text-sm font-black">Hover über ein Event für Details</p>
            <p class="block md:hidden text-slate-600 dark:text-slate-400 mt-2 uppercase tracking-widest text-center text-[10px] font-black">Scrollen zum Erkunden · Tippe auf Punkte zum Navigieren</p>
        </div>        
        <div class="timeline-container hidden md:flex w-full overflow-x-auto items-center relative h-full no-scrollbar cursor-grab active:cursor-grabbing z-20" id="timeline-scroll-area" style="transform: translateY(-45px);">
            {/* The Track Canvas */}
            <div class="timeline-track flex flex-row items-center relative h-full shrink-0" id="timeline-track" style={`width: ${timelineWidthPx}px; min-width: ${timelineWidthPx}px; margin: 0 25vw 0 0;`}>
                
                <div id="timeline-revealed-future" class="absolute inset-y-0 z-0 pointer-events-none" style="left: -50vw; right: 0;">
                    <div class="absolute inset-y-0" style="left: 50vw; right: 0;">
                        <div class="absolute top-1/2 -translate-y-1/2 opacity-50 border-t-2 border-dashed border-gray-500 dark:border-gray-400 z-0" style="left: -50vw; width: calc(100% + 50vw);"></div>

                        {/* Wireframe Year Markers */}
                        {yearMarkers.map((marker) => (
                            <div class="absolute top-1/2 -translate-y-1/2 flex flex-col items-center" style={`left: ${marker.left};`}>
                                <div class="w-0 h-6 border-l-2 border-dashed border-gray-500 dark:border-gray-400"></div>
                                <span class="text-xs font-black opacity-30 mt-2 absolute top-full">{marker.year}</span>
                            </div>
                        ))}

                        {/* Wireframe Timeline Items */}
                        {timelineItems.map((item: any, itemIdx: number) => {
                            const styles = getTimescaleStyles(item);
                            if (!styles.isVisible) return null;
                            const isDuration = styles.isDuration;
                            
                            const verticalMap: any = {
                                'far-above': '-translate-y-24',
                                'above': '-translate-y-12',
                                'below': 'translate-y-[58px]',
                                'far-below': 'translate-y-[106px]'
                            };
                            const verticalOffset = isDuration ? (verticalMap[item.verticalPosition] || '-translate-y-12') : '';

                            const hasWidget = !!(item.widgetImage || item.widgetButtonLabel || item.widgetButtonLink || item.description || item.relatedProject?.description);
                            const isTopHalf = item.verticalPosition === 'far-above' || item.verticalPosition === 'above' || (!item.verticalPosition && isDuration);

                            const leftPct = parseFloat(styles.left);
                            const widthPct = isDuration ? parseFloat(styles.width) : 0;

                            const visibleStartPct = Math.max(0, leftPct);
                            const visibleEndPct = isDuration ? Math.min(100, leftPct + widthPct) : leftPct;
                            const parentTargetPct = isDuration ? (visibleStartPct + visibleEndPct) / 2 : leftPct;
                            const parentTargetX = (parentTargetPct / 100) * timelineWidthPx;

                            const capsuleCenterPct = leftPct + (isDuration ? widthPct / 2 : 0);
                            const visibleOffsetPct = parentTargetPct - capsuleCenterPct;
                            const visibleOffsetPx = (visibleOffsetPct / 100) * timelineWidthPx;

                            const parentId = `parent-${itemIdx}`;
                            const parentAdjustedX = widgetAdjustedXMap[parentId] !== undefined ? widgetAdjustedXMap[parentId] : parentTargetX;
                            const parentDx = parentAdjustedX - parentTargetX;

                            const verticalMapPx: any = {
                                'far-above': -96,
                                'above': -48,
                                'below': 58,
                                'far-below': 106
                            };
                            const y1 = isDuration ? (verticalMapPx[item.verticalPosition] || -48) : 0;
                            const y2 = isTopHalf ? -130 : 140;

                            return (
                                <div class="absolute top-1/2 pointer-events-none opacity-40" style={`left: ${styles.left}; width: ${isDuration ? styles.width : '0px'}; transform: translate(0, -50%);`}>
                                    <svg class="absolute pointer-events-none overflow-visible z-0" style="left: 50%; top: 50%; width: 1px; height: 1px; overflow: visible;">
                                        {isDuration && (
                                            <line 
                                                x1="0" 
                                                y1="0" 
                                                x2="0" 
                                                y2={y1} 
                                                class="timeline-wireframe-line opacity-40"
                                            />
                                        )}
                                        {hasWidget && (
                                            <line 
                                                x1={visibleOffsetPx} 
                                                y1={y1} 
                                                x2={parentDx + visibleOffsetPx} 
                                                y2={y2} 
                                                class="timeline-wireframe-line opacity-40"
                                            />
                                        )}
                                    </svg>
                                    
                                    {isDuration && (
                                        <div class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-gray-500 dark:bg-gray-400 z-10"></div>
                                    )}

                                    {isDuration ? (
                                        <div class={`relative w-full h-8 rounded-full border-2 border-dashed border-gray-500 dark:border-gray-400 ${verticalOffset}`}></div>
                                    ) : (
                                        <div class={`relative w-6 h-6 -translate-x-1/2 rounded-full border-[2px] border-dashed border-gray-500 dark:border-gray-400 block ${verticalOffset}`}></div>
                                    )}
                                </div>
                            );
                        })}
                    </div>
                </div>

                <div id="actual-present-marker" class="absolute top-1/2 flex items-center -translate-y-1/2 z-20" style={`left: ${presentLeftPct}%;`}>
                    <span class="absolute bottom-full left-0 ml-[4px] mb-1 font-bold text-gray-500 tracking-widest uppercase text-xs border border-gray-400 dark:border-gray-600 rounded-full px-3 py-1 backdrop-blur-md bg-white/80 dark:bg-black/80 shadow-sm whitespace-nowrap">Heute</span>
                </div>

                <div id="moving-arrow" class="absolute top-1/2 flex items-center -translate-y-1/2 z-40 pointer-events-none -translate-x-full" style="left: var(--reveal-pos, 75vw);">
                    <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-primary transition-colors duration-300 relative z-10">
                        <path d="M0 0L8 6L0 12V0Z" fill="currentColor"/>
                    </svg>
                    {/* Scanner Laser */}
                    <div id="scanner-laser-1" class="absolute right-[0px] top-1/2 -translate-y-1/2 w-[1px] h-48 bg-gradient-to-b from-transparent via-primary/50 dark:via-primary/40 to-transparent z-0 transition-opacity duration-300"></div>
