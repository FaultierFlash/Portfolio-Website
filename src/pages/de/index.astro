                                                )}
                                            </div>
                                            {subWidgetBtnLink && subWidgetBtnLabel && (
                                                <a 
                                                    href={subWidgetBtnLink} 
                                                    class={`text-[10px] font-bold text-center py-1.5 px-3 rounded-lg border-[1.5px] ${ec.border} ${ec.text} ${ec.textDark || ''} hover:bg-slate-50 dark:hover:bg-slate-800/50 transition duration-300 mt-0.5`}
                                                >
                                                    {subWidgetBtnLabel}
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                </>
                            );
                        })}

                        {isDuration ? (
                            <EventWrapper class={`timeline-parent-capsule relative w-full h-8 rounded-full px-4 bg-white/40 dark:bg-slate-950/40 border-[2px] ${c.border} text-slate-800 dark:text-slate-200 backdrop-blur-md transition-all duration-300 flex items-center cursor-pointer pointer-events-auto hover:bg-white/60 dark:hover:bg-slate-950/60 hover:${c.shadow} ${verticalOffset} z-20`}>
                                <h4 class={`flex-1 min-w-0 text-sm font-bold whitespace-nowrap overflow-hidden text-ellipsis relative z-10 text-slate-900 dark:text-slate-100 pointer-events-none`} style={(styles.textOffsetPx || 0) > 0 ? `padding-left: ${styles.textOffsetPx || 0}px` : ''}>{item.title}</h4>
                                {styles.isActuallyOngoing && <div class={`shrink-0 absolute -right-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full ${c.dot} animate-pulse z-10 ${c.shadow}`}></div>}
                                
                                {/* Milestone Pins */}
                                {item.milestoneEvents && item.milestoneEvents.map((evt: any, evtIdx: number) => {
                                    const evtDate = new Date(evt.date);
                                    const sDate = new Date(item.startDate);
                                    const eDate = styles.isActuallyOngoing ? timelineEndDate : new Date(item.endDate);
                                    let evtPct = 0;
                                    if (eDate.getTime() > sDate.getTime()) {
                                        evtPct = ((evtDate.getTime() - sDate.getTime()) / (eDate.getTime() - sDate.getTime())) * 100;
