                                                        ${urlFor(subWidgetImage).width(240).auto('format').quality(80).url()} 240w,
                                                        ${urlFor(subWidgetImage).width(480).auto('format').quality(85).url()} 480w,
                                                        ${urlFor(subWidgetImage).width(720).auto('format').quality(85).url()} 720w
