        </button>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const obs = new IntersectionObserver((entries) => {
                    const btn = document.getElementById("mobile-next-btn");
                    if (window.innerWidth >= 768) return; // Only process hiding logic strictly on Mobile viewport!
                    if(entries[0].isIntersecting) {
                        btn?.classList.remove("max-md:opacity-0", "max-md:pointer-events-none");
                        btn?.classList.add("max-md:opacity-100", "max-md:pointer-events-auto");
