                    </div>

                    {/* Statically render 5 background lanes (staff lines matching the 5 stack rows) */}
                    {[0, 1, 2, 3, 4].map((r) => (
                        <div 
                            class={`absolute left-0 right-0 h-[1px] pointer-events-none ${r === 2 ? 'bg-slate-300 dark:bg-slate-700/80 h-[2px]' : 'bg-slate-100 dark:bg-slate-800/40'}`}
                            style={`top: ${r * 14 + 4}px;`}
                        ></div>
                    ))}

                    {/* Duration capsules positioned on their CMS-mapped rowIdx */}
                    {sortedTimelineItems.map((item: any, pIdx: number) => {
                        const startDate = new Date(item.startDate);
                        const startMs = startDate.getTime() - timelineStartDate.getTime();
                        const leftPct = Math.max(0, Math.min(100, (startMs / totalDurationMs) * 100));

                        const today = new Date();
                        const isActuallyOngoing = item.isOngoing && (!item.endDate || new Date(item.endDate) >= today);
                        const endDate = isActuallyOngoing ? new Date() : (item.endDate ? new Date(item.endDate) : startDate);
                        const endMs = endDate.getTime() - timelineStartDate.getTime();
                        const endPct = Math.max(0, Math.min(100, (endMs / totalDurationMs) * 100));
                        
                        const widthPct = Math.max(1.5, endPct - leftPct);
                        const resolvedColor = item.relatedProject?.accentColor || item.color || 'primary';
                        const c = colors[resolvedColor] || colors.primary;
                        const rowIdx = getMobileRowIdx(item);
                        const rowTop = rowIdx * 14;

                        return (
                            <div 
                                class="mobile-strip-span absolute rounded-full transition-all duration-300 opacity-20 pointer-events-none"
                                style={`left: ${leftPct}%; width: ${widthPct}%; height: 4px; top: ${rowTop + 4}px; transform: translateY(-50%); background-color: ${c.hex};`}
                                data-span-parent-idx={pIdx}
                            ></div>
                        );
                    })}

                    {/* Event dots positioned on their CMS-mapped rowIdx */}
                    {mobileStripEvents.map((evt, globalIdx) => {
                        const dc = colors[evt.colorKey] || colors.primary;
                        const isParent = evt.type === 'parent';
                        const size = isParent ? 10 : 6;
                        const rowTop = evt.rowIdx * 14;
                        return (
                            <button
                                class={`mobile-strip-dot absolute rounded-full ${dc.dot} transition-all duration-300 cursor-pointer -translate-x-1/2 -translate-y-1/2 ${isParent ? 'border-2 border-white dark:border-slate-900 shadow-sm z-10' : 'z-[9] opacity-70'}`}
                                style={`left: ${evt.pct}%; top: ${rowTop + 4}px; width: ${size}px; height: ${size}px;`}
                                data-strip-idx={globalIdx}
                                data-parent-idx={evt.parentIdx}
                                data-milestone-idx={evt.milestoneIdx}
