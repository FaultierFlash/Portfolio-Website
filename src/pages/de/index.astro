                            const subWidgetTitle = evt.title;
                            const subWidgetDesc = evt.description || evt.relatedProject?.description;
                            const subWidgetBtnLabel = evt.widgetButtonLabel || (evt.relatedProject ? (lang === 'de' ? 'Projekt ansehen' : 'View Project') : '');
