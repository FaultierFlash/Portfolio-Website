                                                        {evt.relatedProject ? (lang === 'de' ? 'Zugehöriges Projekt' : 'Related Project') : (lang === 'de' ? 'Meilenstein' : 'Milestone')}
                                                    </span>
                                                    <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400 whitespace-nowrap bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">
                                                        {new Date(evt.date).toLocaleDateString(lang, { month: 'short', year: 'numeric' })}
                                                    </span>
                                                </div>
                                                <h4 class="text-sm font-black text-slate-900 dark:text-white leading-tight mt-1">{subWidgetTitle}</h4>
                                                {subWidgetDesc && (
