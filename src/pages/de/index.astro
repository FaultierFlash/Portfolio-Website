                    const widgetBtnLabel = item.widgetButtonLabel || (item.relatedProject ? (lang === 'de' ? 'Projekt ansehen' : 'View Project') : '');
                    const widgetBtnLink = item.widgetButtonLink || (item.relatedProject ? `/${lang}/projects/${item.relatedProject.slug.current}` : '');

                    const mobileTimeframe = (() => {
                        const start = new Date(item.startDate).toLocaleDateString(lang, { month: 'short', year: 'numeric' });
                        if (!isDuration) return start;
                        const end = isActuallyOngoing 
                            ? (lang === 'de' ? 'Heute' : 'Present') 
                            : (item.endDate ? new Date(item.endDate).toLocaleDateString(lang, { month: 'short', year: 'numeric' }) : '');
                        return end ? `${start} — ${end}` : start;
                    })();

                    return (
                        <div class={`mobile-timeline-card relative border-l-[3px] ${c.border} bg-[var(--color-card-bg)] border border-[var(--color-card-border)] rounded-2xl p-5 shadow-lg transition-all flex flex-col gap-3`} data-timeline-idx={idx} data-title={item.title}>
                            {eventHref && <a href={eventHref} class="absolute inset-0 z-10 rounded-2xl"></a>}
                            
                            {widgetImage && (
                                <img 
                                    src={urlFor(widgetImage).width(800).auto('format').quality(85).url()} 
                                    srcset={`
                                        ${urlFor(widgetImage).width(400).auto('format').quality(80).url()} 400w,
                                        ${urlFor(widgetImage).width(800).auto('format').quality(85).url()} 800w,
                                        ${urlFor(widgetImage).width(1200).auto('format').quality(85).url()} 1200w
                                    `}
                                    sizes="(max-width: 640px) calc(100vw - 40px), 600px"
                                    alt={widgetTitle}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-auto rounded-xl"
                                />
                            )}

                            <div class="flex flex-col">
                                <div class="flex items-center gap-2 mb-1">
                                    <div class={`w-2 h-2 rounded-full ${c.dot} shrink-0`}></div>
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">
                                        {mobileTimeframe}
                                    </span>
                                    {isActuallyOngoing && (
                                        <span class={`text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-full ${c.bg} text-slate-700 dark:text-slate-200`}>{lang === 'de' ? 'Aktiv' : 'Active'}</span>
                                    )}
                                </div>
                                <h3 class="text-lg font-black text-[var(--color-text)] leading-tight">{widgetTitle}</h3>
                                {widgetDesc && <p class="text-sm border-t border-[var(--color-card-border)] pt-3 mt-3 text-[var(--color-text-dim)] font-medium leading-relaxed">{widgetDesc}</p>}
                            </div>

                            {widgetBtnLink && widgetBtnLabel && (
                                <a 
                                    href={widgetBtnLink} 
                                    class={`text-[10px] font-bold text-center py-1.5 px-3 rounded-lg border-[1.5px] ${c.border} text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition duration-300 mt-1 relative z-20`}
                                >
                                    {widgetBtnLabel}
                                </a>
                            )}
                            
                            {item.milestoneEvents && item.milestoneEvents.length > 0 && (
                                <div class="mt-3 pt-3 border-t border-black/5 dark:border-white/5 flex flex-col gap-3 relative z-20">
                                    <span class="text-[10px] uppercase font-black tracking-widest" style={`color: ${c.hex}`}>{lang === 'de' ? 'Meilensteine' : 'Milestones'}</span>
                                    {item.milestoneEvents.map((evt: any, mIdx: number) => {
                                        const subEventHref = evt.relatedProject ? `/${lang}/projects/${evt.relatedProject.slug.current}` : undefined;
                                        const subWidgetImage = evt.widgetImage || evt.relatedProject?.mainImage;
                                        const subWidgetDesc = evt.description || evt.relatedProject?.description;
                                        const subWidgetBtnLabel = evt.widgetButtonLabel || (evt.relatedProject ? (lang === 'de' ? 'Projekt ansehen' : 'View Project') : '');
                                        const subWidgetBtnLink = evt.widgetButtonLink || (evt.relatedProject ? `/${lang}/projects/${evt.relatedProject.slug.current}` : '');
                                        
                                        const resolvedEvtColor = evt.relatedProject?.accentColor || evt.color || item.color || 'primary';
                                        const ec = colors[resolvedEvtColor] || colors.primary;

                                        return (
                                        <div class="mobile-milestone-card relative flex flex-col gap-2 p-3 bg-black/5 dark:bg-white/5 rounded-xl border border-black/5 dark:border-white/5 group/sub" data-parent-idx={idx} data-milestone-idx={mIdx}>
                                            {subEventHref && !subWidgetBtnLink && <a href={subEventHref} class="absolute inset-0 z-10 rounded-xl"></a>}
                                            {subWidgetImage && (
                                                <img 
                                                    src={urlFor(subWidgetImage).width(600).auto('format').quality(85).url()} 
                                                    srcset={`
