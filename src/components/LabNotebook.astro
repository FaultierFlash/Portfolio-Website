---
// src/components/LabNotebook.astro
// Physical, multi-page engineering notebook simulation with client-side content pagination,
// absolute page numbering, Table of Contents pages, left-side ribbon bookmark navigation,
// rapid page-riffle animations on desktop, and single-page touch-swipe mode on mobile.
import { urlFor } from "../lib/sanity";
import { renderTechnicalMarkdown } from "../lib/markdown";
import "katex/dist/katex.min.css";
import WingAirflowBackground from "./WingAirflowBackground.astro";
import SolarSystemBackground from "./SolarSystemBackground.astro";
import TopographicRipple from "./TopographicRipple.astro";

interface Props {
  entries: any[];
  locale: "en" | "de";
}

const { entries, locale } = Astro.props;

// Pre-render and sanitize markdown (with KaTeX support) and image URLs on the server
const processedEntries = entries.map((entry: any, idx: number) => ({
  ...entry,
  slugCurrent: entry.slug?.current || "",
  renderedBody: entry.body ? renderTechnicalMarkdown(entry.body) : "",
  processedImages: (entry.images || []).map((img: any) => ({
    url: img.asset ? urlFor(img).width(800).auto('format').quality(85).url() : null,
    alt: img.alt || "",
    caption: img.caption || "",
  })),
  interactivePlayground: entry.interactivePlayground || "none",
  initialParams: entry.initialParams || "",
  entryNumber: idx + 1,
}));

const hasAirflowPlayground = processedEntries.some((e: any) => e.interactivePlayground === "airflow");
const hasSolarPlayground = processedEntries.some((e: any) => e.interactivePlayground === "solar");
const hasTopoPlayground = processedEntries.some((e: any) => e.interactivePlayground === "topography");

const t = {
  en: {
    pageHeading: "Lab Notebook",
    emptyTitle: "Notebook Empty",
    emptyMessage: "No entries have been recorded yet. Check back soon.",
    entryLabel: "Entry",
    tocTitle: "Index",
    prevLabel: "Previous page",
    nextLabel: "Next page",
    ofLabel: "of",
    pageLabel: "Page",
    relatedProject: "Related Project",
    tocDate: "Date",
    tocDesc: "Description",
    tocPage: "Page",
    allCategories: "ALL",
    pauseLabel: "Pause",
    playLabel: "Play",
    resetLabel: "Reset",
    playgroundTitle: "Interactive Simulation Lab",
    solverLabel: "Numerical Integrator",
    solverHint: "Compare Euler (energy drift) vs. Symplectic Verlet vs. RK4 stability.",
  },
  de: {
    pageHeading: "Labor-Notizbuch",
    emptyTitle: "Notizbuch leer",
    emptyMessage: "Es wurden noch keine Einträge erfasst. Schau bald wieder vorbei.",
    entryLabel: "Eintrag",
    tocTitle: "Verzeichnis",
    prevLabel: "Vorherige Seite",
    nextLabel: "Nächste Seite",
    ofLabel: "von",
    pageLabel: "Seite",
    relatedProject: "Zugehöriges Projekt",
    tocDate: "Datum",
    tocDesc: "Beschreibung",
    tocPage: "Seite",
    allCategories: "ALLE",
    pauseLabel: "Pause",
    playLabel: "Start",
    resetLabel: "Reset",
    playgroundTitle: "Interaktives Simulations-Labor",
    solverLabel: "Numerischer Integrator",
    solverHint: "Euler-Drift vs. symplektisches Verlet vs. RK4-Stabilität vergleichen.",
  },
};
const labels = t[locale] || t.en;

// Category config for ink stamps
const categoryConfig: Record<string, { icon: string; label: string; color: string }> = {
  experiment: { icon: "🧪", label: "EXP", color: "#2563eb" },
  simulation: { icon: "📊", label: "SIM", color: "#7c3aed" },
  build: { icon: "🔧", label: "BLD", color: "#059669" },
  observation: { icon: "👁", label: "OBS", color: "#d97706" },
  literature: { icon: "📄", label: "LIT", color: "#dc2626" },
  idea: { icon: "💡", label: "IDÉ", color: "#0891b2" },
};
---

<div
  class="notebook-outer"
  id="lab-notebook"
  data-locale={locale}
  data-entries={JSON.stringify(processedEntries)}
  data-category-config={JSON.stringify(categoryConfig)}
  data-labels={JSON.stringify(labels)}
>
  <h1 class="sr-only">{labels.pageHeading}</h1>
  {entries.length === 0 ? (
    <div class="notebook-empty">
      <h2>{labels.emptyTitle}</h2>
      <p>{labels.emptyMessage}</p>
    </div>
  ) : (
    <Fragment>
      {(hasAirflowPlayground || hasSolarPlayground || hasTopoPlayground) && (
        <div id="lab-playground-staging" class="lab-playground-staging" aria-hidden="true">
          {hasAirflowPlayground && (
            <div id="lab-sim-host-airflow" class="lab-sim-host">
              <WingAirflowBackground isAbsolute={true} phase="01" />
            </div>
          )}
          {hasSolarPlayground && (
            <div id="lab-sim-host-solar" class="lab-sim-host">
              <SolarSystemBackground />
            </div>
          )}
          {hasTopoPlayground && (
            <div id="lab-sim-host-topography" class="lab-sim-host">
              <TopographicRipple isAbsolute={true} />
            </div>
          )}
        </div>
      )}

      {/* Physical Bookmark Ribbon Tab */}
      <button
        type="button"
        class="bookmark-ribbon"
        id="bookmark-ribbon"
        title={labels.tocTitle}
        aria-label={labels.tocTitle}
      ></button>

      {/* The Notebook */}
      <div class="notebook" id="notebook-main">
        {/* Left cover edge */}
        <div class="cover-edge left-cover"></div>

        {/* Left Page (or Single Page on Mobile) — includes SSR TOC index fallback for SEO */}
        <div class="page left-page" id="left-page">
          <div class="page-texture"></div>
          <div class="ruled-lines"></div>
          <div class="page-content left-content" id="left-content">
            <div class="toc-page">
              <h2 class="toc-header">{labels.tocTitle}</h2>
              <ul class="toc-items-list">
                {processedEntries.map((entry: any) => (
                  <li class="toc-item-btn">
                    <span class="toc-col-date">{entry.date || ""}</span>
                    <span class="toc-col-desc">{entry.title}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="page-number-label left-page-num" id="left-page-num">1</div>
        </div>

        {/* Spine */}
        <div class="spine"></div>

        {/* Right Page */}
        <div class="page right-page" id="right-page">
          <div class="page-texture"></div>
          <div class="ruled-lines"></div>
          <div class="page-content right-content" id="right-content">
            {processedEntries[0] && (
              <div class="entry-body" set:html={processedEntries[0].renderedBody} />
            )}
          </div>
          <div class="page-number-label right-page-num" id="right-page-num">2</div>
        </div>

        {/* Turning page overlay for 3D animation */}
        <div class="turning-page" id="turning-page">
          <div class="turning-front">
            <div class="page-texture"></div>
            <div class="ruled-lines"></div>
            <div class="page-content right-content" id="turning-front-content"></div>
            <div class="page-number-label right-page-num" id="turning-front-num"></div>
          </div>
          <div class="turning-back">
            <div class="page-texture"></div>
            <div class="ruled-lines"></div>
            <div class="page-content left-content" id="turning-back-content"></div>
            <div class="page-number-label left-page-num" id="turning-back-num"></div>
          </div>
        </div>

        {/* Right cover edge */}
        <div class="cover-edge right-cover"></div>
      </div>

      {/* Navigation */}
      <div class="notebook-nav">
        <button type="button" class="nav-btn prev-btn" id="prev-btn" aria-label={labels.prevLabel} title={labels.prevLabel}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <span class="page-indicator" id="page-indicator"></span>
        <button type="button" class="nav-btn next-btn" id="next-btn" aria-label={labels.nextLabel} title={labels.nextLabel}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </Fragment>
  )}
</div>

<script>
  import { escapeHtml } from "../lib/html";

  let activeKeydownHandler: ((e: KeyboardEvent) => void) | null = null;
  let activeResizeHandler: (() => void) | null = null;
  let activeHashChangeHandler: (() => void) | null = null;

  function reclaimAllPlaygrounds() {
    const staging = document.getElementById("lab-playground-staging");
    if (!staging) return;
    const hostMap: Record<string, string> = {
      airflow: ".airflow-container",
      solar: ".solar-system-container",
      topography: ".topography-container",
    };
    (["airflow", "solar", "topography"] as const).forEach((kind) => {
      const host = document.getElementById(`lab-sim-host-${kind}`);
      const el = document.querySelector(`.playground-canvas-stage ${hostMap[kind]}`);
      if (host && el && !host.contains(el)) {
        host.appendChild(el);
      }
    });
  }

  function cleanupLabNotebook() {
    reclaimAllPlaygrounds();
    if (activeKeydownHandler) {
      document.removeEventListener("keydown", activeKeydownHandler);
      activeKeydownHandler = null;
    }
    if (activeResizeHandler) {
      window.removeEventListener("resize", activeResizeHandler);
      activeResizeHandler = null;
    }
    if (activeHashChangeHandler) {
      window.removeEventListener("hashchange", activeHashChangeHandler);
      activeHashChangeHandler = null;
    }
  }

  function initLabNotebook() {
    cleanupLabNotebook();
    const notebookEl = document.getElementById("lab-notebook");
    if (!notebookEl) return;
    const notebook: HTMLElement = notebookEl;

    const entries = JSON.parse(notebook.dataset.entries || "[]");
    if (!entries.length) return;

    if (notebook.dataset.notebookInit === "true") return;
    notebook.dataset.notebookInit = "true";

    const categoryConfig = JSON.parse(notebook.dataset.categoryConfig || "{}");
    const labels = JSON.parse(notebook.dataset.labels || "{}");
    const locale = notebook.dataset.locale || "en";

    // Preserve chronological order (newest first from Sanity)
    const orderedEntries: any[] = [...entries];

    // DOM references
    const leftContent = document.getElementById("left-content")!;
    const rightContent = document.getElementById("right-content")!;
    const pageIndicator = document.getElementById("page-indicator")!;
    const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("next-btn") as HTMLButtonElement | null;
    
    const leftNumLabel = document.getElementById("left-page-num")!;
    const rightNumLabel = document.getElementById("right-page-num")!;

    const turningPage = document.getElementById("turning-page")!;
    const turningFrontContent = document.getElementById("turning-front-content")!;
    const turningBackContent = document.getElementById("turning-back-content")!;
    const turningFrontNum = document.getElementById("turning-front-num")!;
    const turningBackNum = document.getElementById("turning-back-num")!;

    const ribbonTab = document.getElementById("bookmark-ribbon");

    // Global book layout state
    let bookPages: any[] = [];
    let currentIndex = 0;
    let lastReadPageIndex = 0;
    let isAnimating = false;
    let activeTocCategory = "ALL";
    const slugPageMap = new Map<string, number>();

    function isMobile(): boolean {
      return window.innerWidth <= 768;
    }

    function formatDate(dateStr: string): string {
      if (!dateStr) return "";
      const d = new Date(dateStr + "T00:00:00");
      return d.toLocaleDateString(locale === "de" ? "de-DE" : "en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      });
    }

    function formatTOCDate(dateStr: string): string {
      if (!dateStr) return "";
      const d = new Date(dateStr + "T00:00:00");
      const day = String(d.getDate()).padStart(2, "0");
      const month = String(d.getMonth() + 1).padStart(2, "0");
      const year = String(d.getFullYear()).substring(2);
      return locale === "de" ? `${day}.${month}.${year}` : `${month}/${day}/${year}`;
    }

    // Dynamic pagination algorithm
    function buildBook() {
      const mobileMode = isMobile();
      const contentWidth = mobileMode ? Math.min(window.innerWidth - 64, 460) : 350;

      // Create off-screen measure div
      const measureDiv = document.createElement("div");
      measureDiv.className = "entry-body";
      measureDiv.style.position = "absolute";
      measureDiv.style.top = "-9999px";
      measureDiv.style.left = "-9999px";
      measureDiv.style.width = `${contentWidth}px`;
      measureDiv.style.lineHeight = "28px";
      measureDiv.style.fontSize = "0.9rem";
      measureDiv.style.fontFamily = '"Georgia", serif';
      document.body.appendChild(measureDiv);

      const paginatedEntries = orderedEntries.map((entry) => {
        const imagesHTML = entry.processedImages && entry.processedImages.length > 0
          ? entry.processedImages
            .filter((img: any) => img.url)
            .map(
              (img: any) => `
              <figure class="entry-figure">
                <img src="${escapeHtml(img.url)}" alt="${escapeHtml(img.alt)}" width="350" height="196" loading="lazy" />
                ${img.caption ? `<figcaption>${escapeHtml(img.caption)}</figcaption>` : ""}
              </figure>
            `
            )
            .join("")
          : "";

        const temp = document.createElement("div");
        temp.innerHTML = (entry.renderedBody || "") + imagesHTML;
        const children = Array.from(temp.children);

        const pages: string[] = [];
        let currentHeight = 0;
        const page1Max = mobileMode ? 440 : 380;
        const normalMax = mobileMode ? 520 : 480;

        let currentLimit = page1Max;
        let currentElements: Element[] = [];

        for (let el of children) {
          const clone = el.cloneNode(true) as HTMLElement;
          measureDiv.appendChild(clone);
          const elHeight = clone.offsetHeight;

          if (currentHeight + elHeight > currentLimit) {
            if (currentElements.length > 0) {
              pages.push(currentElements.map((e) => e.outerHTML).join(""));
              currentElements = [];
              currentHeight = 0;
              currentLimit = normalMax;
            }

            if (elHeight > currentLimit) {
              if (el.tagName === "P") {
                const tokens: Node[] = [];
                el.childNodes.forEach((node) => {
                  if (node.nodeType === Node.TEXT_NODE) {
                    (node.textContent || "")
                      .split(/(?<=\. )/)
                      .filter(Boolean)
                      .forEach((part) => tokens.push(document.createTextNode(part)));
                  } else {
                    tokens.push(node.cloneNode(true));
                  }
                });
                let tempP = document.createElement("p");
                measureDiv.innerHTML = "";
                measureDiv.appendChild(tempP);

                for (const token of tokens) {
                  tempP.appendChild(token);
                  if (tempP.offsetHeight > currentLimit - currentHeight && tempP.childNodes.length > 1) {
                    tempP.removeChild(token);
                    if (tempP.textContent?.trim() || tempP.children.length > 0) {
                      currentElements.push(tempP.cloneNode(true) as Element);
                    }
                    pages.push(currentElements.map((e) => e.outerHTML).join(""));
                    currentElements = [];
                    currentHeight = 0;
                    currentLimit = normalMax;

                    tempP = document.createElement("p");
                    tempP.appendChild(token);
                    measureDiv.innerHTML = "";
                    measureDiv.appendChild(tempP);
                  }
                }
                if (tempP.textContent?.trim() || tempP.children.length > 0) {
                  currentElements.push(tempP.cloneNode(true) as Element);
                  currentHeight = tempP.offsetHeight;
                }
              } else {
                currentElements.push(el.cloneNode(true) as Element);
                currentHeight = elHeight;
              }
            } else {
              currentElements.push(el.cloneNode(true) as Element);
              currentHeight = elHeight;
            }
          } else {
            currentElements.push(el.cloneNode(true) as Element);
            currentHeight += elHeight;
          }
          measureDiv.innerHTML = "";
        }

        if (currentElements.length > 0) {
          pages.push(currentElements.map((e) => e.outerHTML).join(""));
        }

        const hasPlayground = entry.interactivePlayground && entry.interactivePlayground !== "none";
        if (pages.length === 0 && !hasPlayground) {
          pages.push("");
        }

        return { entry, pages, hasPlayground };
      });

      document.body.removeChild(measureDiv);

      const visibleTocEntries = orderedEntries.filter(
        (entry) => activeTocCategory === "ALL" || entry.category === activeTocCategory
      );

      // TOC calculation
      const entriesPerPage = mobileMode ? 9 : 11;
      const numTOCPages = Math.max(1, Math.ceil(visibleTocEntries.length / entriesPerPage));
      const tocPageCount = mobileMode ? numTOCPages : numTOCPages + (numTOCPages % 2 === 0 ? 0 : 1);

      let currentAbsolutePageNum = tocPageCount + 1;
      const entryJumpMap = new Map<any, number>();
      slugPageMap.clear();

      const entryPagesList = paginatedEntries.map((pe) => {
        const startAbsPage = currentAbsolutePageNum;
        const pages: any[] = [];

        // Metadata Page
        pages.push({
          type: "metadata",
          entry: pe.entry,
          absolutePageNumber: currentAbsolutePageNum++,
        });

        let jumpAbsPage = startAbsPage;

        // Interactive Playground right beside Metadata on Spread 1 (or immediate target on mobile)
        if (pe.hasPlayground) {
          const playgroundAbsPage = currentAbsolutePageNum++;
          pages.push({
            type: "playground",
            entry: pe.entry,
            playgroundType: pe.entry.interactivePlayground,
            absolutePageNumber: playgroundAbsPage,
          });
          if (mobileMode) {
            jumpAbsPage = playgroundAbsPage;
          }
        }

        // Content Pages
        pe.pages.forEach((html, idx) => {
          pages.push({
            type: "content",
            entryTitle: idx === 0 ? pe.entry.title : undefined,
            contentHTML: html,
            entry: pe.entry,
            absolutePageNumber: currentAbsolutePageNum++,
          });
        });

        // Pad to ensure even spread alignment on desktop
        if (!mobileMode && pages.length % 2 !== 0) {
          pages.push({
            type: "blank",
            absolutePageNumber: currentAbsolutePageNum++,
          });
        }

        entryJumpMap.set(pe.entry, jumpAbsPage);
        if (pe.entry.slugCurrent) {
          slugPageMap.set(pe.entry.slugCurrent, jumpAbsPage);
        }

        return pages;
      });

      const tocItems = visibleTocEntries.map((entry) => ({
        title: entry.title,
        date: formatTOCDate(entry.date),
        slug: entry.slugCurrent || "",
        absolutePageNumber: entryJumpMap.get(entry) || tocPageCount + 1,
      }));

      bookPages = [];

      for (let p = 0; p < tocPageCount; p++) {
        if (p < numTOCPages) {
          const sliceStart = p * entriesPerPage;
          const sliceEnd = sliceStart + entriesPerPage;
          bookPages.push({
            type: "toc",
            tocEntries: tocItems.slice(sliceStart, sliceEnd),
            showFilters: p === 0,
            absolutePageNumber: p + 1,
          });
        } else if (!mobileMode) {
          bookPages.push({
            type: "blank",
            absolutePageNumber: p + 1,
          });
        }
      }

      entryPagesList.forEach((pages) => {
        bookPages = bookPages.concat(pages);
      });
    }

    function getPlaygroundHTML(entry: any): string {
      const kind = entry.interactivePlayground;
      const isDe = locale === "de";
      let initial: Record<string, any> = {};
      if (entry.initialParams) {
        try {
          initial = JSON.parse(entry.initialParams);
        } catch {}
      }

      if (kind === "airflow") {
        const intensity = typeof initial.intensity === "number" ? initial.intensity : 1.0;
        const flutter = typeof initial.flutter === "number" ? initial.flutter : 1.0;
        const cursor = typeof initial.cursorTurbulence === "number" ? initial.cursorTurbulence : 1.0;
        return `
          <div class="playground-page" data-playground-kind="airflow" data-initial-params="${escapeHtml(entry.initialParams || "")}">
            <div class="playground-header">
              <span class="playground-kicker">CFD · 20 Hz MAV</span>
              <div class="playground-actions">
                <button type="button" class="playground-btn pg-toggle-btn">${escapeHtml(labels.pauseLabel || "Pause")}</button>
              </div>
            </div>
            <div class="playground-canvas-stage" id="lab-playground-mount"></div>
            <div class="playground-controls">
              <label class="playground-control-row">
                <span>${isDe ? "Intensität" : "Intensity"}</span>
                <input type="range" min="0.2" max="2.5" step="0.1" value="${intensity}" data-param="intensity" />
                <span class="pg-val tabular-nums">${intensity.toFixed(1)}</span>
              </label>
              <label class="playground-control-row">
                <span>Flutter</span>
                <input type="range" min="0" max="2.5" step="0.1" value="${flutter}" data-param="flutter" />
                <span class="pg-val tabular-nums">${flutter.toFixed(1)}</span>
              </label>
              <label class="playground-control-row">
                <span>${isDe ? "Turbulenz" : "Cursor Wake"}</span>
                <input type="range" min="0" max="2.5" step="0.1" value="${cursor}" data-param="cursorTurbulence" />
                <span class="pg-val tabular-nums">${cursor.toFixed(1)}</span>
              </label>
            </div>
          </div>
        `;
      }

      if (kind === "solar") {
        const speed = typeof initial.speed === "number" ? initial.speed : 1.0;
        const grav = typeof initial.gravityMultiplier === "number" ? initial.gravityMultiplier : 1.0;
        const zoom = typeof initial.zoom === "number" ? initial.zoom : 1.0;
        const integrator = ["symplectic", "euler", "rk4"].includes(initial.integrator) ? initial.integrator : "symplectic";
        return `
          <div class="playground-page" data-playground-kind="solar" data-initial-params="${escapeHtml(entry.initialParams || "")}">
            <div class="playground-header">
              <span class="playground-kicker">${escapeHtml(labels.solverLabel || "Solver")}</span>
              <div class="playground-actions">
                <button type="button" class="playground-btn pg-reset-btn">${escapeHtml(labels.resetLabel || "Reset")}</button>
                <button type="button" class="playground-btn pg-toggle-btn">${escapeHtml(labels.pauseLabel || "Pause")}</button>
              </div>
            </div>
            <div class="playground-canvas-stage" id="lab-playground-mount"></div>
            <div class="playground-solver-group" role="group" aria-label="${escapeHtml(labels.solverLabel || "Numerical Integrator")}">
              <button type="button" class="playground-btn ${integrator === "symplectic" ? "is-active" : ""}" data-integrator="symplectic">Symplectic Verlet</button>
              <button type="button" class="playground-btn ${integrator === "euler" ? "is-active" : ""}" data-integrator="euler">Explicit Euler</button>
              <button type="button" class="playground-btn ${integrator === "rk4" ? "is-active" : ""}" data-integrator="rk4">RK4</button>
            </div>
            <p class="playground-hint">${escapeHtml(labels.solverHint || "")}</p>
            <div class="playground-controls">
              <label class="playground-control-row">
                <span>${isDe ? "Tempo" : "Speed"}</span>
                <input type="range" min="0.1" max="4.0" step="0.1" value="${speed}" data-param="speed" />
                <span class="pg-val tabular-nums">${speed.toFixed(1)}</span>
              </label>
              <label class="playground-control-row">
                <span>${isDe ? "Gravitation" : "Gravity"}</span>
                <input type="range" min="0" max="4.0" step="0.1" value="${grav}" data-param="gravityMultiplier" />
                <span class="pg-val tabular-nums">${grav.toFixed(1)}</span>
              </label>
              <label class="playground-control-row">
                <span>Zoom</span>
                <input type="range" min="0.4" max="2.5" step="0.1" value="${zoom}" data-param="zoom" />
                <span class="pg-val tabular-nums">${zoom.toFixed(1)}</span>
              </label>
            </div>
          </div>
        `;
      }

      if (kind === "topography") {
        const intensity = typeof initial.intensity === "number" ? initial.intensity : 1.0;
        const scale = typeof initial.scale === "number" ? initial.scale : 1.0;
        const source = ["mars-procedural", "mars-olympus", "mars-gale", "earth"].includes(initial.source) ? initial.source : "mars-procedural";
        return `
          <div class="playground-page" data-playground-kind="topography" data-initial-params="${escapeHtml(entry.initialParams || "")}">
            <div class="playground-header">
              <span class="playground-kicker">DEM · Marching Squares</span>
              <div class="playground-actions">
                <button type="button" class="playground-btn pg-toggle-btn">${escapeHtml(labels.pauseLabel || "Pause")}</button>
              </div>
            </div>
            <div class="playground-canvas-stage" id="lab-playground-mount"></div>
            <div class="playground-controls">
              <label class="playground-control-row">
                <span>${isDe ? "Quelle" : "Terrain"}</span>
                <select class="playground-select" data-param="source">
                  <option value="mars-procedural" ${source === "mars-procedural" ? "selected" : ""}>Mars Procedural</option>
                  <option value="mars-olympus" ${source === "mars-olympus" ? "selected" : ""}>Olympus Mons</option>
                  <option value="mars-gale" ${source === "mars-gale" ? "selected" : ""}>Gale Crater</option>
                  <option value="earth" ${source === "earth" ? "selected" : ""}>Earth DEM</option>
                </select>
              </label>
              <label class="playground-control-row">
                <span>${isDe ? "Intensität" : "Intensity"}</span>
                <input type="range" min="0.2" max="3.0" step="0.1" value="${intensity}" data-param="intensity" />
                <span class="pg-val tabular-nums">${intensity.toFixed(1)}</span>
              </label>
              <label class="playground-control-row">
                <span>${isDe ? "Maßstab" : "Scale"}</span>
                <input type="range" min="0.3" max="3.0" step="0.1" value="${scale}" data-param="scale" />
                <span class="pg-val tabular-nums">${scale.toFixed(1)}</span>
              </label>
            </div>
          </div>
        `;
      }

      return "";
    }

    function getPageHTML(page: any): string {
      if (!page || page.type === "blank") return "";

      if (page.type === "toc") {
        const presentCategories = Array.from(new Set(orderedEntries.map((e) => e.category).filter(Boolean)));
        const filterChipsHTML = page.showFilters && presentCategories.length > 1
          ? `
            <div class="toc-filter-bar" role="group" aria-label="Filter Index">
              <button type="button" class="toc-filter-pill ${activeTocCategory === "ALL" ? "is-active" : ""}" data-cat="ALL">${escapeHtml(labels.allCategories || "ALL")}</button>
              ${presentCategories.map((catKey: string) => {
                const cfg = categoryConfig[catKey] || { label: catKey.toUpperCase() };
                return `<button type="button" class="toc-filter-pill ${activeTocCategory === catKey ? "is-active" : ""}" data-cat="${escapeHtml(catKey)}">${escapeHtml(cfg.label)}</button>`;
              }).join("")}
            </div>
          `
          : "";

        const tocItemsHTML = page.tocEntries
          .map(
            (item: any) => `
            <li>
              <button class="toc-item-btn" data-page="${item.absolutePageNumber}" data-slug="${escapeHtml(item.slug || "")}">
                <span class="toc-col-date">${escapeHtml(item.date)}</span>
                <span class="toc-col-desc">${escapeHtml(item.title)}</span>
                <span class="toc-col-page">${escapeHtml(item.absolutePageNumber)}</span>
              </button>
            </li>
          `
          )
          .join("");

        return `
          <div class="toc-page">
            <button type="button" class="page-ribbon" aria-label="${escapeHtml(labels.tocTitle)}"></button>
            <h2 class="toc-header">${labels.tocTitle}</h2>
            ${filterChipsHTML}
            <div class="toc-table">
              <div class="toc-table-header">
                <span class="toc-col-date">${labels.tocDate}</span>
                <span class="toc-col-desc">${labels.tocDesc}</span>
                <span class="toc-col-page">${labels.tocPage}</span>
              </div>
              <ul class="toc-items-list">
                ${tocItemsHTML}
              </ul>
            </div>
          </div>
        `;
      }

      if (page.type === "metadata") {
        const entry = page.entry;
        const cat = categoryConfig[entry.category] || categoryConfig.observation;
        const projectHref = entry.relatedProject?.slug?.current
          ? `/${locale}/projects/${entry.relatedProject.slug.current}`
          : null;

        const tagsHTML = (entry.tags || [])
          .map((tag: string) => `<span class="tag">#${escapeHtml(tag)}</span>`)
          .join("");

        const projectHTML = projectHref
          ? `
          <a href="${escapeHtml(projectHref)}" class="project-link">
            <span class="project-link-label">${escapeHtml(labels.relatedProject)}</span>
            <span class="project-link-title">${escapeHtml(entry.relatedProject.title)} &rarr;</span>
          </a>
        `
          : "";

        return `
          <div class="metadata-page">
            <div class="entry-number">${escapeHtml(labels.entryLabel)} #${escapeHtml(String(entry.entryNumber).padStart(3, "0"))}</div>
            <div class="entry-date">${escapeHtml(formatDate(entry.date))}</div>
            <div class="stamp" style="--stamp-color: ${escapeHtml(cat.color)}">
              <span class="stamp-icon">${escapeHtml(cat.icon)}</span>
              <span class="stamp-label">${escapeHtml(cat.label)}</span>
            </div>
            ${tagsHTML ? `<div class="entry-tags">${tagsHTML}</div>` : ""}
            ${projectHTML}
          </div>
        `;
      }

      if (page.type === "playground") {
        return getPlaygroundHTML(page.entry);
      }

      if (page.type === "content") {
        const titleHTML = page.entryTitle ? `<h2 class="entry-title">${escapeHtml(page.entryTitle)}</h2>` : "";
        return `
          ${titleHTML}
          <div class="entry-body">${page.contentHTML}</div>
        `;
      }

      return "";
    }

    function mountPlaygroundIfPresent() {
      const pgRoot = notebook.querySelector(".playground-page") as HTMLElement | null;
      if (!pgRoot) return;
      const kind = pgRoot.dataset.playgroundKind || "";
      const mountEl = pgRoot.querySelector("#lab-playground-mount") as HTMLElement | null;
      const host = document.getElementById(`lab-sim-host-${kind}`);
      const selectorMap: Record<string, string> = {
        airflow: ".airflow-container",
        solar: ".solar-system-container",
        topography: ".topography-container",
      };
      const simContainer = (host?.querySelector(selectorMap[kind]) || document.querySelector(`.playground-canvas-stage ${selectorMap[kind]}`)) as HTMLElement | null;
      if (!mountEl || !simContainer) return;

      if (!mountEl.contains(simContainer)) {
        mountEl.innerHTML = "";
        mountEl.appendChild(simContainer);
        requestAnimationFrame(() => window.dispatchEvent(new Event("resize")));
      }

      let initial: Record<string, any> = {};
      if (pgRoot.dataset.initialParams) {
        try {
          initial = JSON.parse(pgRoot.dataset.initialParams);
        } catch {}
      }

      const controller =
        kind === "airflow"
          ? (simContainer as any).__airflowController
          : kind === "solar"
          ? (simContainer as any).__solarController
          : (simContainer as any).__topoController;

      if (controller && Object.keys(initial).length > 0) {
        controller.setParams?.(initial);
      }

      const toggleBtn = pgRoot.querySelector(".pg-toggle-btn") as HTMLButtonElement | null;
      const syncToggleText = () => {
        if (!toggleBtn || !controller) return;
        const paused = Boolean(controller.getState?.()?.motion?.isPausedByUser);
        toggleBtn.textContent = paused ? (labels.playLabel || "Play") : (labels.pauseLabel || "Pause");
      };
      syncToggleText();

      toggleBtn?.addEventListener("click", () => {
        controller?.togglePaused?.();
        syncToggleText();
      });

      const resetBtn = pgRoot.querySelector(".pg-reset-btn") as HTMLButtonElement | null;
      resetBtn?.addEventListener("click", () => {
        controller?.reset?.();
      });

      pgRoot.querySelectorAll<HTMLButtonElement>("[data-integrator]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const integrator = btn.dataset.integrator;
          if (!integrator) return;
          pgRoot.querySelectorAll("[data-integrator]").forEach((b) => b.classList.remove("is-active"));
          btn.classList.add("is-active");
          controller?.setParams?.({ integrator });
        });
      });

      pgRoot.querySelectorAll<HTMLInputElement>("input[data-param]").forEach((inputEl) => {
        inputEl.addEventListener("input", () => {
          const key = inputEl.dataset.param;
          if (!key) return;
          const val = parseFloat(inputEl.value);
          const readout = inputEl.parentElement?.querySelector(".pg-val");
          if (readout) readout.textContent = val.toFixed(1);
          controller?.setParams?.({ [key]: val });
        });
      });

      pgRoot.querySelectorAll<HTMLSelectElement>("select[data-param]").forEach((selectEl) => {
        selectEl.addEventListener("change", () => {
          const key = selectEl.dataset.param;
          if (!key) return;
          controller?.setParams?.({ [key]: selectEl.value });
        });
      });
    }

    function updateNavState(isAtStart: boolean, isAtEnd: boolean, isAtToc: boolean) {
      if (prevBtn) {
        prevBtn.classList.toggle("disabled", isAtStart);
        prevBtn.disabled = isAtStart;
      }
      if (nextBtn) {
        nextBtn.classList.toggle("disabled", isAtEnd);
        nextBtn.disabled = isAtEnd;
      }
      notebook.classList.toggle("at-toc", isAtToc);
      notebook.parentElement?.classList.toggle("at-toc", isAtToc);
    }

    function renderView(index: number) {
      reclaimAllPlaygrounds();
      if (isMobile()) {
        currentIndex = Math.max(0, Math.min(index, bookPages.length - 1));
        const activePage = bookPages[currentIndex];

        leftContent.innerHTML = getPageHTML(activePage);
        leftNumLabel.textContent = activePage ? String(activePage.absolutePageNumber) : "";

        pageIndicator.textContent = `${currentIndex + 1} ${labels.ofLabel} ${bookPages.length}`;

        updateNavState(
          currentIndex === 0,
          currentIndex >= bookPages.length - 1,
          currentIndex === 0
        );

        bindTOCLinks();
        mountPlaygroundIfPresent();
      } else {
        currentIndex = Math.max(0, Math.min(Math.floor(index / 2) * 2, Math.max(0, bookPages.length - 2)));
        renderSpread(currentIndex);
      }
    }

    function renderSpread(index: number) {
      reclaimAllPlaygrounds();
      const leftPage = bookPages[index];
      const rightPage = bookPages[index + 1];

      leftContent.innerHTML = getPageHTML(leftPage);
      rightContent.innerHTML = getPageHTML(rightPage);

      leftNumLabel.textContent = leftPage ? String(leftPage.absolutePageNumber) : "";
      rightNumLabel.textContent = rightPage ? String(rightPage.absolutePageNumber) : "";

      bindTOCLinks();
      mountPlaygroundIfPresent();

      const currentSpreadLabel = Math.floor(index / 2) + 1;
      const totalSpreads = Math.ceil(bookPages.length / 2);
      pageIndicator.textContent = `${currentSpreadLabel} ${labels.ofLabel} ${totalSpreads}`;

      updateNavState(index === 0, index >= bookPages.length - 2, index === 0);
    }

    function bindTOCLinks() {
      const btns = notebook.querySelectorAll(".toc-item-btn");
      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const el = btn as HTMLElement;
          const targetPage = parseInt(el.dataset.page || "1", 10);
          const slug = el.dataset.slug;
          if (slug) {
            try {
              history.replaceState(null, "", `#${slug}`);
            } catch {}
          }
          flipToPageIndex(targetPage - 1);
        });
      });

      notebook.querySelectorAll<HTMLButtonElement>(".toc-filter-pill").forEach((pill) => {
        pill.addEventListener("click", () => {
          const cat = pill.dataset.cat || "ALL";
          if (cat === activeTocCategory) return;
          activeTocCategory = cat;
          buildBook();
          renderView(0);
        });
      });

      const ribbon = notebook.querySelector(".page-ribbon");
      if (ribbon) {
        ribbon.addEventListener("click", () => {
          flipToPageIndex(lastReadPageIndex);
        });
      }
    }

    async function flipToPageIndex(targetIndex: number) {
      if (targetIndex < 0 || targetIndex >= bookPages.length || isAnimating) return;

      if (isMobile()) {
        if (targetIndex === currentIndex) return;
        isAnimating = true;
        reclaimAllPlaygrounds();
        try {
          leftContent.style.transition = "opacity 0.15s ease, transform 0.15s ease";
          leftContent.style.opacity = "0";
          leftContent.style.transform = targetIndex > currentIndex ? "translateX(-12px)" : "translateX(12px)";

          await new Promise((r) => setTimeout(r, 150));

          renderView(targetIndex);

          leftContent.style.transform = targetIndex > currentIndex ? "translateX(12px)" : "translateX(-12px)";
          leftContent.offsetHeight;
          leftContent.style.opacity = "1";
          leftContent.style.transform = "translateX(0)";

          await new Promise((r) => setTimeout(r, 150));
        } finally {
          leftContent.style.transition = "";
          leftContent.style.transform = "";
          leftContent.style.opacity = "";
          isAnimating = false;
        }
        return;
      }

      // Desktop 3D Page Turn
      const currentSpread = Math.floor(currentIndex / 2);
      const targetSpread = Math.floor(targetIndex / 2);

      if (currentSpread === targetSpread) return;

      isAnimating = true;
      reclaimAllPlaygrounds();
      const direction = targetSpread > currentSpread ? "next" : "prev";
      const steps = Math.abs(targetSpread - currentSpread);

      try {
        if (steps > 1) {
          turningPage.classList.add("fast-riffle");
        } else {
          turningPage.classList.remove("fast-riffle");
        }

        for (let i = 0; i < steps; i++) {
          const nextIdx = direction === "next" ? currentIndex + 2 : currentIndex - 2;
          const currentLeft = bookPages[currentIndex];
          const currentRight = bookPages[currentIndex + 1];
          const nextLeft = bookPages[nextIdx];
          const nextRight = bookPages[nextIdx + 1];

          await new Promise<void>((resolve) => {
            if (direction === "next") {
              turningFrontContent.innerHTML = getPageHTML(currentRight);
              turningFrontNum.textContent = currentRight ? String(currentRight.absolutePageNumber) : "";

              turningBackContent.innerHTML = getPageHTML(nextLeft);
              turningBackNum.textContent = nextLeft ? String(nextLeft.absolutePageNumber) : "";

              rightContent.innerHTML = getPageHTML(nextRight);
              rightNumLabel.textContent = nextRight ? String(nextRight.absolutePageNumber) : "";
            } else {
              turningFrontContent.innerHTML = getPageHTML(nextRight);
              turningFrontNum.textContent = nextRight ? String(nextRight.absolutePageNumber) : "";

              turningBackContent.innerHTML = getPageHTML(currentLeft);
              turningBackNum.textContent = currentLeft ? String(currentLeft.absolutePageNumber) : "";

              leftContent.innerHTML = getPageHTML(nextLeft);
              leftNumLabel.textContent = nextLeft ? String(nextLeft.absolutePageNumber) : "";
            }

            turningPage.style.display = "block";
            turningPage.offsetHeight;
            turningPage.classList.add("turning", `turn-${direction}`);

            let settled = false;
            let fallbackTimer: ReturnType<typeof setTimeout> | null = null;
            const finishStep = () => {
              if (settled) return;
              settled = true;
              if (fallbackTimer) clearTimeout(fallbackTimer);

              if (direction === "next") {
                leftContent.innerHTML = getPageHTML(nextLeft);
                leftNumLabel.textContent = nextLeft ? String(nextLeft.absolutePageNumber) : "";
              } else {
                rightContent.innerHTML = getPageHTML(nextRight);
                rightNumLabel.textContent = nextRight ? String(nextRight.absolutePageNumber) : "";
              }

              turningPage.classList.remove("turning", `turn-${direction}`);
              turningPage.style.display = "none";
              currentIndex = nextIdx;

              const currentSpreadLabel = Math.floor(currentIndex / 2) + 1;
              const totalSpreads = Math.ceil(bookPages.length / 2);
              pageIndicator.textContent = `${currentSpreadLabel} ${labels.ofLabel} ${totalSpreads}`;

              updateNavState(currentIndex === 0, currentIndex >= bookPages.length - 2, currentIndex === 0);

              resolve();
            };

            turningPage.addEventListener("animationend", finishStep, { once: true });
            fallbackTimer = setTimeout(finishStep, 900);
          });
        }

        bindTOCLinks();
        mountPlaygroundIfPresent();
      } finally {
        turningPage.classList.remove("turning", "turn-next", "turn-prev", "fast-riffle");
        turningPage.style.display = "none";
        isAnimating = false;
      }
    }

    function syncHashLocation() {
      const slug = window.location.hash.replace(/^#/, "").trim();
      if (!slug) return false;
      const absPage = slugPageMap.get(slug);
      if (typeof absPage === "number") {
        renderView(absPage - 1);
        return true;
      }
      return false;
    }

    // Ribbon tab click interaction (when not on TOC page)
    ribbonTab?.addEventListener("click", () => {
      if (currentIndex !== 0) {
        lastReadPageIndex = currentIndex;
        flipToPageIndex(0);
      }
    });

    // Control buttons interaction
    nextBtn?.addEventListener("click", () => {
      const step = isMobile() ? 1 : 2;
      const maxIdx = isMobile() ? bookPages.length - 1 : bookPages.length - 2;
      if (currentIndex < maxIdx) {
        flipToPageIndex(currentIndex + step);
      }
    });

    prevBtn?.addEventListener("click", () => {
      const step = isMobile() ? 1 : 2;
      if (currentIndex > 0) {
        flipToPageIndex(currentIndex - step);
      }
    });

    // Keyboard controls
    activeKeydownHandler = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement | null;
      const activeEl = document.activeElement as HTMLElement | null;
      if (
        target?.tagName === "INPUT" ||
        target?.tagName === "TEXTAREA" ||
        target?.tagName === "SELECT" ||
        target?.isContentEditable ||
        activeEl?.tagName === "INPUT" ||
        activeEl?.tagName === "TEXTAREA" ||
        activeEl?.tagName === "SELECT" ||
        activeEl?.isContentEditable ||
        document.querySelector('[role="dialog"][aria-modal="true"], .cmd-backdrop.open')
      ) {
        return;
      }
      const step = isMobile() ? 1 : 2;
      const maxIdx = isMobile() ? bookPages.length - 1 : bookPages.length - 2;
      if (e.key === "ArrowRight" && currentIndex < maxIdx) {
        flipToPageIndex(currentIndex + step);
      } else if (e.key === "ArrowLeft" && currentIndex > 0) {
        flipToPageIndex(currentIndex - step);
      }
    };
    document.addEventListener("keydown", activeKeydownHandler);

    // Touch Swipe Gestures
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;

    notebook.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true }
    );

    notebook.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].clientX;
        touchEndY = e.changedTouches[0].clientY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;
        
        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY) * 1.3) {
          const step = isMobile() ? 1 : 2;
          const maxIdx = isMobile() ? bookPages.length - 1 : bookPages.length - 2;
          if (diffX < 0 && currentIndex < maxIdx) {
            flipToPageIndex(currentIndex + step);
          } else if (diffX > 0 && currentIndex > 0) {
            flipToPageIndex(currentIndex - step);
          }
        }
      },
      { passive: true }
    );

    // Resize Handler
    let wasMobile = isMobile();
    activeResizeHandler = () => {
      const currentlyMobile = isMobile();
      if (currentlyMobile !== wasMobile) {
        wasMobile = currentlyMobile;
        isAnimating = false;
        buildBook();
        renderView(currentIndex);
      }
    };
    window.addEventListener("resize", activeResizeHandler);

    activeHashChangeHandler = () => {
      syncHashLocation();
    };
    window.addEventListener("hashchange", activeHashChangeHandler);

    // Initialize physical book & honor URL hash deep link
    buildBook();
    if (!syncHashLocation()) {
      renderView(0);
    }
  }

  document.addEventListener("astro:page-load", initLabNotebook);
  document.addEventListener("astro:before-swap", cleanupLabNotebook);
</script>

<style>
  /* ========================================
     NOTEBOOK OUTER CONTAINER
     ======================================== */
  .notebook-outer {
    --paper-color: #faf6f0;
    --paper-line: rgba(165, 145, 120, 0.15);
    --ink-color: #2c2416;
    --ink-secondary: #6b5e4f;
    --cover-color: #5c3d2e;
    --cover-dark: #3a2518;
    --spine-color: #4a2f1f;
    --line-height: 28px;
    --baseline-offset: 21px;

    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    font-family: "Georgia", "Palatino Linotype", "Times New Roman", serif;
  }

  /* ========================================
     EMPTY STATE
     ======================================== */
  .notebook-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-secondary, #64748b);
  }
  .notebook-empty h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text, #334155);
  }

  /* ========================================
     THE NOTEBOOK
     ======================================== */
  .notebook {
    display: flex;
    position: relative;
    perspective: 1800px;
    height: 600px;
  }

  /* Cover edges */
  .cover-edge {
    width: 12px;
    flex-shrink: 0;
    border-radius: 4px;
  }
  .left-cover {
    background: linear-gradient(90deg, var(--cover-dark), var(--cover-color));
    border-radius: 6px 0 0 6px;
    box-shadow: -2px 0 6px rgba(0,0,0,0.2);
  }
  .right-cover {
    background: linear-gradient(90deg, var(--cover-color), var(--cover-dark));
    border-radius: 0 6px 6px 0;
    box-shadow: 2px 0 6px rgba(0,0,0,0.2);
  }

  /* Spine */
  .spine {
    width: 16px;
    flex-shrink: 0;
    background-color: var(--paper-color);
    background-image: linear-gradient(90deg,
      rgba(0,0,0,0.4),
      rgba(0,0,0,0.1) 20%,
      rgba(0,0,0,0.05) 50%,
      rgba(0,0,0,0.1) 80%,
      rgba(0,0,0,0.4)
    );
    position: relative;
    z-index: 2;
  }
  .spine::after {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 100%;
    background: rgba(0,0,0,0.08);
  }

  /* ========================================
     PAGES
     ======================================== */
  .page {
    flex: 1;
    position: relative;
    background-color: var(--paper-color);
    overflow: hidden;
    height: 100%;
  }

  /* Paper texture overlay */
  .page-texture {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse at 20% 50%, rgba(200, 180, 150, 0.04), transparent 50%),
      radial-gradient(ellipse at 80% 30%, rgba(180, 160, 130, 0.03), transparent 40%);
    pointer-events: none;
    z-index: 0;
  }

  .ruled-lines {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent,
      transparent calc(var(--line-height) - 1px),
      var(--paper-line) calc(var(--line-height) - 1px),
      var(--paper-line) var(--line-height)
    );
    background-position: 0 var(--baseline-offset);
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }

  .left-page {
    border-right: none;
    box-shadow: inset -4px 0 8px rgba(0,0,0,0.04);
  }
  .right-page {
    border-left: none;
    box-shadow: inset 4px 0 8px rgba(0,0,0,0.04);
  }

  /* ========================================
     PAGE CONTENT
     ======================================== */
  .page-content {
    position: relative;
    z-index: 1;
    padding: calc(var(--line-height) * 1) 2rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* Left page metadata */
  .left-content {
    display: block;
    text-align: center;
    padding-top: calc(var(--line-height) * 4);
  }

  .entry-number {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-secondary);
    font-family: "Courier New", monospace;
    line-height: var(--line-height);
    margin-bottom: var(--line-height);
  }

  .entry-date {
    font-size: 1rem;
    color: var(--ink-color);
    font-style: italic;
    line-height: var(--line-height);
    margin-bottom: var(--line-height);
  }

  /* Ink stamp */
  .stamp {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 16px;
    border: 3px solid var(--stamp-color, #2563eb);
