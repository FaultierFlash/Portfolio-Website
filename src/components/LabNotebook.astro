---
// src/components/LabNotebook.astro
// Physical, multi-page engineering notebook simulation with client-side content pagination,
// absolute page numbering, Table of Contents pages, left-side ribbon bookmark navigation,
// rapid page-riffle animations on desktop, and single-page touch-swipe mode on mobile.
import { urlFor } from "../lib/sanity";
import { marked } from "marked";

interface Props {
  entries: any[];
  locale: "en" | "de";
}

const { entries, locale } = Astro.props;

// Pre-render markdown and image URLs on the server
const processedEntries = entries.map((entry: any, idx: number) => ({
  ...entry,
  renderedBody: entry.body ? marked.parse(entry.body) : "",
  processedImages: (entry.images || []).map((img: any) => ({
    url: img.asset ? urlFor(img).width(800).auto('format').quality(85).url() : null,
    alt: img.alt || "",
    caption: img.caption || "",
  })),
  entryNumber: idx + 1,
}));

const t = {
  en: {
    emptyTitle: "Notebook Empty",
    emptyMessage: "No entries have been recorded yet. Check back soon.",
    entryLabel: "Entry",
    tocTitle: "Index",
    prevLabel: "Previous page",
    nextLabel: "Next page",
    ofLabel: "of",
    pageLabel: "Page",
    relatedProject: "Related Project",
    tocDate: "Date",
    tocDesc: "Description",
    tocPage: "Page",
  },
  de: {
    emptyTitle: "Notizbuch leer",
    emptyMessage: "Es wurden noch keine Einträge erfasst. Schau bald wieder vorbei.",
    entryLabel: "Eintrag",
    tocTitle: "Verzeichnis",
    prevLabel: "Vorherige Seite",
    nextLabel: "Nächste Seite",
    ofLabel: "von",
    pageLabel: "Seite",
    relatedProject: "Zugehöriges Projekt",
    tocDate: "Datum",
    tocDesc: "Beschreibung",
    tocPage: "Seite",
  },
};
const labels = t[locale] || t.en;

// Category config for ink stamps
const categoryConfig: Record<string, { icon: string; label: string; color: string }> = {
  experiment: { icon: "🧪", label: "EXP", color: "#2563eb" },
  simulation: { icon: "📊", label: "SIM", color: "#7c3aed" },
  build: { icon: "🔧", label: "BLD", color: "#059669" },
  observation: { icon: "👁", label: "OBS", color: "#d97706" },
  literature: { icon: "📄", label: "LIT", color: "#dc2626" },
  idea: { icon: "💡", label: "IDÉ", color: "#0891b2" },
};
---

<div class="notebook-outer" id="lab-notebook">
  {entries.length === 0 ? (
    <div class="notebook-empty">
      <h2>{labels.emptyTitle}</h2>
      <p>{labels.emptyMessage}</p>
    </div>
  ) : (
    <Fragment>
      {/* Physical Bookmark Ribbon Tab */}
      <div class="bookmark-ribbon" id="bookmark-ribbon" title={labels.tocTitle}></div>

      {/* The Notebook */}
      <div class="notebook" id="notebook-main">
        {/* Left cover edge */}
        <div class="cover-edge left-cover"></div>

        {/* Left Page (or Single Page on Mobile) */}
        <div class="page left-page" id="left-page">
          <div class="page-texture"></div>
          <div class="ruled-lines"></div>
          <div class="page-content left-content" id="left-content">
            {/* Populated dynamically */}
          </div>
          <div class="page-number-label left-page-num" id="left-page-num"></div>
        </div>

        {/* Spine */}
        <div class="spine"></div>

        {/* Right Page */}
        <div class="page right-page" id="right-page">
          <div class="page-texture"></div>
          <div class="ruled-lines"></div>
          <div class="page-content right-content" id="right-content">
            {/* Populated dynamically */}
          </div>
          <div class="page-number-label right-page-num" id="right-page-num"></div>
        </div>

        {/* Turning page overlay for 3D animation */}
        <div class="turning-page" id="turning-page">
          <div class="turning-front">
            <div class="page-texture"></div>
            <div class="ruled-lines"></div>
            <div class="page-content right-content" id="turning-front-content"></div>
            <div class="page-number-label right-page-num" id="turning-front-num"></div>
          </div>
          <div class="turning-back">
            <div class="page-texture"></div>
            <div class="ruled-lines"></div>
            <div class="page-content left-content" id="turning-back-content"></div>
            <div class="page-number-label left-page-num" id="turning-back-num"></div>
          </div>
        </div>

        {/* Right cover edge */}
        <div class="cover-edge right-cover"></div>
      </div>

      {/* Navigation */}
      <div class="notebook-nav">
        <button class="nav-btn prev-btn" id="prev-btn" aria-label={labels.prevLabel} title={labels.prevLabel}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <span class="page-indicator" id="page-indicator"></span>
        <button class="nav-btn next-btn" id="next-btn" aria-label={labels.nextLabel} title={labels.nextLabel}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </Fragment>
  )}
</div>

{/* Pass data to client JS */}
<script is:inline define:vars={{
  entriesJSON: JSON.stringify(processedEntries),
  categoryConfigJSON: JSON.stringify(categoryConfig),
  labelsJSON: JSON.stringify(labels),
  localeVal: locale,
}}>
  window.__labNotebookData = {
    entries: JSON.parse(entriesJSON),
    categoryConfig: JSON.parse(categoryConfigJSON),
    labels: JSON.parse(labelsJSON),
    locale: localeVal,
  };
</script>

<script>
  function initLabNotebook() {
    const data = (window as any).__labNotebookData;
    if (!data || !data.entries.length) return;

    const notebook = document.getElementById("lab-notebook")!;
    if (notebook.dataset.notebookInit === "true") return;
    notebook.dataset.notebookInit = "true";

    const { entries, categoryConfig, labels } = data;

    // Fisher-Yates shuffle
    const shuffled = [...entries];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }

    // DOM references
    const leftContent = document.getElementById("left-content")!;
    const rightContent = document.getElementById("right-content")!;
    const pageIndicator = document.getElementById("page-indicator")!;
    const prevBtn = document.getElementById("prev-btn")!;
    const nextBtn = document.getElementById("next-btn")!;
    
    const leftNumLabel = document.getElementById("left-page-num")!;
    const rightNumLabel = document.getElementById("right-page-num")!;

    const turningPage = document.getElementById("turning-page")!;
    const turningFrontContent = document.getElementById("turning-front-content")!;
    const turningBackContent = document.getElementById("turning-back-content")!;
    const turningFrontNum = document.getElementById("turning-front-num")!;
    const turningBackNum = document.getElementById("turning-back-num")!;

    const ribbonTab = document.getElementById("bookmark-ribbon")!;

    // Global book layout state
    let bookPages: any[] = [];
    let currentIndex = 0;
    let lastReadPageIndex = 0;
    let isAnimating = false;

    function isMobile(): boolean {
      return window.innerWidth <= 768;
    }

    function formatDate(dateStr: string): string {
      if (!dateStr) return "";
      const d = new Date(dateStr + "T00:00:00");
      return d.toLocaleDateString(data.locale === "de" ? "de-DE" : "en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      });
    }

    function formatTOCDate(dateStr: string): string {
      if (!dateStr) return "";
      const d = new Date(dateStr + "T00:00:00");
      const day = String(d.getDate()).padStart(2, "0");
      const month = String(d.getMonth() + 1).padStart(2, "0");
      const year = String(d.getFullYear()).substring(2);
      return data.locale === "de" ? `${day}.${month}.${year}` : `${month}/${day}/${year}`;
    }

    // Dynamic pagination algorithm
    function buildBook() {
      const mobileMode = isMobile();
      const contentWidth = mobileMode ? Math.min(window.innerWidth - 64, 460) : 350;

      // Create off-screen measure div
      const measureDiv = document.createElement("div");
      measureDiv.className = "entry-body";
      measureDiv.style.position = "absolute";
      measureDiv.style.top = "-9999px";
      measureDiv.style.left = "-9999px";
      measureDiv.style.width = `${contentWidth}px`;
      measureDiv.style.lineHeight = "28px";
      measureDiv.style.fontSize = "0.9rem";
      measureDiv.style.fontFamily = '"Georgia", serif';
      document.body.appendChild(measureDiv);

      const paginatedEntries = shuffled.map((entry) => {
        // Collect images
        const imagesHTML = entry.processedImages && entry.processedImages.length > 0
          ? entry.processedImages
            .filter((img: any) => img.url)
            .map(
              (img: any) => `
              <figure class="entry-figure">
                <img src="${img.url}" alt="${img.alt}" loading="lazy" />
                ${img.caption ? `<figcaption>${img.caption}</figcaption>` : ""}
              </figure>
            `
            )
            .join("")
          : "";

        const temp = document.createElement("div");
        temp.innerHTML = entry.renderedBody + imagesHTML;
        const children = Array.from(temp.children);

        const pages: string[] = [];
        let currentHeight = 0;
        
        // Page 1 budget is smaller due to the Title
        const page1Max = mobileMode ? 440 : 380;
        const normalMax = mobileMode ? 520 : 480;

        let currentLimit = page1Max;
        let currentElements: Element[] = [];

        for (let el of children) {
          const clone = el.cloneNode(true) as HTMLElement;
          measureDiv.appendChild(clone);
          const elHeight = clone.offsetHeight;

          if (currentHeight + elHeight > currentLimit) {
            if (currentElements.length > 0) {
              pages.push(currentElements.map((e) => e.outerHTML).join(""));
              currentElements = [];
              currentHeight = 0;
              currentLimit = normalMax;
            }

            // Split paragraph by sentences if it exceeds the space
            if (elHeight > currentLimit) {
              if (el.tagName === "P") {
                const sentences = el.innerHTML.split(/(?<=\. )/);
                let tempP = document.createElement("p");
                measureDiv.innerHTML = "";
                measureDiv.appendChild(tempP);

                for (let sentence of sentences) {
                  tempP.innerHTML += sentence;
                  measureDiv.appendChild(tempP);
                  if (tempP.offsetHeight > currentLimit - currentHeight) {
                    tempP.innerHTML = tempP.innerHTML.substring(0, tempP.innerHTML.length - sentence.length);
                    if (tempP.innerHTML.trim()) {
                      currentElements.push(tempP.cloneNode(true) as Element);
                    }
                    pages.push(currentElements.map((e) => e.outerHTML).join(""));
                    currentElements = [];
                    currentHeight = 0;
                    currentLimit = normalMax;

                    tempP = document.createElement("p");
                    tempP.innerHTML = sentence;
                    measureDiv.innerHTML = "";
                    measureDiv.appendChild(tempP);
                  }
                }
                if (tempP.innerHTML.trim()) {
                  currentElements.push(tempP.cloneNode(true) as Element);
                  currentHeight = tempP.offsetHeight;
                }
              } else {
                currentElements.push(el.cloneNode(true) as Element);
                currentHeight = elHeight;
              }
            } else {
              currentElements.push(el.cloneNode(true) as Element);
              currentHeight = elHeight;
            }
          } else {
            currentElements.push(el.cloneNode(true) as Element);
            currentHeight += elHeight;
          }
          measureDiv.innerHTML = "";
        }

        if (currentElements.length > 0) {
          pages.push(currentElements.map((e) => e.outerHTML).join(""));
        }

        if (pages.length === 0) {
          pages.push("");
        }

        return { entry, pages };
      });

      document.body.removeChild(measureDiv);

      // TOC calculation
      const entriesPerPage = mobileMode ? 10 : 12;
      const numTOCPages = Math.ceil(shuffled.length / entriesPerPage);
      const tocPageCount = mobileMode ? numTOCPages : numTOCPages + (numTOCPages % 2 === 0 ? 0 : 1);

      let currentAbsolutePageNum = tocPageCount + 1;
      const entryStartPages: number[] = [];

      const entryPagesList = paginatedEntries.map((pe) => {
        entryStartPages.push(currentAbsolutePageNum);
        const pages: any[] = [];

        // Metadata Page
        pages.push({
          type: "metadata",
          entry: pe.entry,
          absolutePageNumber: currentAbsolutePageNum++
        });

        // Content Page 1
        pages.push({
          type: "content",
          entryTitle: pe.entry.title,
          contentHTML: pe.pages[0],
          entry: pe.entry,
          absolutePageNumber: currentAbsolutePageNum++
        });

        // Next Content Pages
        for (let j = 1; j < pe.pages.length; j++) {
          pages.push({
            type: "content",
            contentHTML: pe.pages[j],
            entry: pe.entry,
            absolutePageNumber: currentAbsolutePageNum++
          });
        }

        // Pad to ensure even spread alignment on desktop
        if (!mobileMode && pages.length % 2 !== 0) {
          pages.push({
            type: "blank",
            absolutePageNumber: currentAbsolutePageNum++
          });
        }

        return pages;
      });

      // Build TOC entries map
      const tocItems = shuffled.map((entry, idx) => ({
        title: entry.title,
        date: formatTOCDate(entry.date),
        absolutePageNumber: entryStartPages[idx]
      }));

      bookPages = [];

      // TOC pages placement
      for (let p = 0; p < tocPageCount; p++) {
        if (p < numTOCPages) {
          const sliceStart = p * entriesPerPage;
          const sliceEnd = sliceStart + entriesPerPage;
          bookPages.push({
            type: "toc",
            tocEntries: tocItems.slice(sliceStart, sliceEnd),
            absolutePageNumber: p + 1
          });
        } else if (!mobileMode) {
          bookPages.push({
            type: "blank",
            absolutePageNumber: p + 1
          });
        }
      }

      // Add entries pages
      entryPagesList.forEach((pages) => {
        bookPages = bookPages.concat(pages);
      });
    }

    function getPageHTML(page: any): string {
      if (!page || page.type === "blank") return "";

      if (page.type === "toc") {
        const tocItemsHTML = page.tocEntries
          .map(
            (item: any) => `
            <li>
              <button class="toc-item-btn" data-page="${item.absolutePageNumber}">
                <span class="toc-col-date">${item.date}</span>
                <span class="toc-col-desc">${item.title}</span>
                <span class="toc-col-page">${item.absolutePageNumber}</span>
              </button>
            </li>
          `
          )
          .join("");

        return `
          <div class="toc-page">
            <div class="page-ribbon"></div>
            <h2 class="toc-header">${labels.tocTitle}</h2>
            <div class="toc-table">
              <div class="toc-table-header">
                <span class="toc-col-date">${labels.tocDate}</span>
                <span class="toc-col-desc">${labels.tocDesc}</span>
                <span class="toc-col-page">${labels.tocPage}</span>
              </div>
              <ul class="toc-items-list">
                ${tocItemsHTML}
              </ul>
            </div>
          </div>
        `;
      }

      if (page.type === "metadata") {
        const entry = page.entry;
        const cat = categoryConfig[entry.category] || categoryConfig.observation;
        const projectHref = entry.relatedProject
          ? `/${data.locale}/projects/${entry.relatedProject.slug.current}`
          : null;

        const tagsHTML = (entry.tags || [])
          .map((tag: string) => `<span class="tag">#${tag}</span>`)
          .join("");

        const projectHTML = projectHref
          ? `
          <a href="${projectHref}" class="project-link">
            <span class="project-link-label">${labels.relatedProject}</span>
            <span class="project-link-title">${entry.relatedProject.title} &rarr;</span>
          </a>
        `
          : "";

        return `
          <div class="metadata-page">
            <div class="entry-number">${labels.entryLabel} #${String(entry.entryNumber).padStart(3, "0")}</div>
            <div class="entry-date">${formatDate(entry.date)}</div>
            <div class="stamp" style="--stamp-color: ${cat.color}">
              <span class="stamp-icon">${cat.icon}</span>
              <span class="stamp-label">${cat.label}</span>
            </div>
            ${tagsHTML ? `<div class="entry-tags">${tagsHTML}</div>` : ""}
            ${projectHTML}
          </div>
        `;
      }

      if (page.type === "content") {
        const titleHTML = page.entryTitle ? `<h2 class="entry-title">${page.entryTitle}</h2>` : "";
        return `
          ${titleHTML}
          <div class="entry-body">${page.contentHTML}</div>
        `;
      }

      return "";
    }

    function renderView(index: number) {
      if (isMobile()) {
        currentIndex = Math.max(0, Math.min(index, bookPages.length - 1));
        const activePage = bookPages[currentIndex];

        leftContent.innerHTML = getPageHTML(activePage);
        leftNumLabel.textContent = activePage ? String(activePage.absolutePageNumber) : "";
        
        pageIndicator.textContent = `${currentIndex + 1} ${labels.ofLabel} ${bookPages.length}`;
        
        prevBtn.classList.toggle("disabled", currentIndex === 0);
        nextBtn.classList.toggle("disabled", currentIndex >= bookPages.length - 1);
        
        bindTOCLinks();
      } else {
        currentIndex = Math.max(0, Math.min(Math.floor(index / 2) * 2, Math.max(0, bookPages.length - 2)));
        renderSpread(currentIndex);
      }
    }

    function renderSpread(index: number) {
      const leftPage = bookPages[index];
      const rightPage = bookPages[index + 1];

      leftContent.innerHTML = getPageHTML(leftPage);
      rightContent.innerHTML = getPageHTML(rightPage);

      leftNumLabel.textContent = leftPage ? String(leftPage.absolutePageNumber) : "";
      rightNumLabel.textContent = rightPage ? String(rightPage.absolutePageNumber) : "";

      bindTOCLinks();

      const currentSpreadLabel = Math.floor(index / 2) + 1;
      const totalSpreads = Math.ceil(bookPages.length / 2);
      pageIndicator.textContent = `${currentSpreadLabel} ${labels.ofLabel} ${totalSpreads}`;

      prevBtn.classList.toggle("disabled", index === 0);
      nextBtn.classList.toggle("disabled", index >= bookPages.length - 2);

      notebook.classList.toggle("at-toc", index === 0);
    }

    function bindTOCLinks() {
      const btns = notebook.querySelectorAll(".toc-item-btn");
      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetPage = parseInt((btn as HTMLElement).dataset.page || "1");
          const targetIndex = targetPage - 1;
          flipToPageIndex(targetIndex);
        });
      });

      const ribbon = notebook.querySelector(".page-ribbon");
      if (ribbon) {
        ribbon.addEventListener("click", () => {
          flipToPageIndex(lastReadPageIndex);
        });
      }
    }

    async function flipToPageIndex(targetIndex: number) {
      if (targetIndex < 0 || targetIndex >= bookPages.length || isAnimating) return;

      if (isMobile()) {
        if (targetIndex === currentIndex) return;
        isAnimating = true;
        
        leftContent.style.transition = "opacity 0.15s ease, transform 0.15s ease";
        leftContent.style.opacity = "0";
        leftContent.style.transform = targetIndex > currentIndex ? "translateX(-12px)" : "translateX(12px)";
        
        await new Promise((r) => setTimeout(r, 150));
        
        renderView(targetIndex);
        
        leftContent.style.transform = targetIndex > currentIndex ? "translateX(12px)" : "translateX(-12px)";
        leftContent.offsetHeight;
        leftContent.style.opacity = "1";
        leftContent.style.transform = "translateX(0)";
        
        await new Promise((r) => setTimeout(r, 150));
        leftContent.style.transition = "";
        leftContent.style.transform = "";
        isAnimating = false;
        return;
      }

      // Desktop 3D Page Turn
      const currentSpread = Math.floor(currentIndex / 2);
      const targetSpread = Math.floor(targetIndex / 2);

      if (currentSpread === targetSpread) return;

      isAnimating = true;
      const direction = targetSpread > currentSpread ? "next" : "prev";
      const steps = Math.abs(targetSpread - currentSpread);

      if (steps > 1) {
        turningPage.classList.add("fast-riffle");
      } else {
        turningPage.classList.remove("fast-riffle");
      }

      for (let i = 0; i < steps; i++) {
        const nextIdx = direction === "next" ? currentIndex + 2 : currentIndex - 2;
        const currentLeft = bookPages[currentIndex];
        const currentRight = bookPages[currentIndex + 1];
        const nextLeft = bookPages[nextIdx];
        const nextRight = bookPages[nextIdx + 1];

        await new Promise<void>((resolve) => {
          if (direction === "next") {
            turningFrontContent.innerHTML = getPageHTML(currentRight);
            turningFrontNum.textContent = currentRight ? String(currentRight.absolutePageNumber) : "";

            turningBackContent.innerHTML = getPageHTML(nextLeft);
            turningBackNum.textContent = nextLeft ? String(nextLeft.absolutePageNumber) : "";

            rightContent.innerHTML = getPageHTML(nextRight);
            rightNumLabel.textContent = nextRight ? String(nextRight.absolutePageNumber) : "";
          } else {
            turningFrontContent.innerHTML = getPageHTML(nextRight);
            turningFrontNum.textContent = nextRight ? String(nextRight.absolutePageNumber) : "";

            turningBackContent.innerHTML = getPageHTML(currentLeft);
            turningBackNum.textContent = currentLeft ? String(currentLeft.absolutePageNumber) : "";

            leftContent.innerHTML = getPageHTML(nextLeft);
            leftNumLabel.textContent = nextLeft ? String(nextLeft.absolutePageNumber) : "";
          }

          turningPage.style.display = "block";
          turningPage.offsetHeight;
          turningPage.classList.add("turning", `turn-${direction}`);

          turningPage.addEventListener(
            "animationend",
            () => {
              if (direction === "next") {
                leftContent.innerHTML = getPageHTML(nextLeft);
                leftNumLabel.textContent = nextLeft ? String(nextLeft.absolutePageNumber) : "";
              } else {
                rightContent.innerHTML = getPageHTML(nextRight);
                rightNumLabel.textContent = nextRight ? String(nextRight.absolutePageNumber) : "";
              }

              turningPage.classList.remove("turning", `turn-${direction}`);
              turningPage.style.display = "none";
              currentIndex = nextIdx;

              const currentSpreadLabel = Math.floor(currentIndex / 2) + 1;
              const totalSpreads = Math.ceil(bookPages.length / 2);
              pageIndicator.textContent = `${currentSpreadLabel} ${labels.ofLabel} ${totalSpreads}`;

              prevBtn.classList.toggle("disabled", currentIndex === 0);
              nextBtn.classList.toggle("disabled", currentIndex >= bookPages.length - 2);

              notebook.classList.toggle("at-toc", currentIndex === 0);

              resolve();
            },
            { once: true }
          );
        });
      }

      bindTOCLinks();
      isAnimating = false;
    }

    // Ribbon tab click interaction (when not on TOC page)
    ribbonTab.addEventListener("click", () => {
      if (currentIndex !== 0) {
        lastReadPageIndex = currentIndex;
        flipToPageIndex(0);
      }
    });

    // Control buttons interaction
    nextBtn.addEventListener("click", () => {
      const step = isMobile() ? 1 : 2;
      const maxIdx = isMobile() ? bookPages.length - 1 : bookPages.length - 2;
      if (currentIndex < maxIdx) {
        flipToPageIndex(currentIndex + step);
      }
    });

    prevBtn.addEventListener("click", () => {
      const step = isMobile() ? 1 : 2;
      if (currentIndex > 0) {
        flipToPageIndex(currentIndex - step);
      }
    });

    // Keyboard controls
    document.addEventListener("keydown", (e) => {
      const step = isMobile() ? 1 : 2;
      const maxIdx = isMobile() ? bookPages.length - 1 : bookPages.length - 2;
      if (e.key === "ArrowRight" && currentIndex < maxIdx) {
        flipToPageIndex(currentIndex + step);
      } else if (e.key === "ArrowLeft" && currentIndex > 0) {
        flipToPageIndex(currentIndex - step);
      }
    });

    // Touch Swipe Gestures
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;

    notebook.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true }
    );

    notebook.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].clientX;
        touchEndY = e.changedTouches[0].clientY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;
        
        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY) * 1.3) {
          const step = isMobile() ? 1 : 2;
          const maxIdx = isMobile() ? bookPages.length - 1 : bookPages.length - 2;
          if (diffX < 0 && currentIndex < maxIdx) {
            flipToPageIndex(currentIndex + step);
          } else if (diffX > 0 && currentIndex > 0) {
            flipToPageIndex(currentIndex - step);
          }
        }
      },
      { passive: true }
    );

    // Resize Handler
    let wasMobile = isMobile();
    window.addEventListener("resize", () => {
      const currentlyMobile = isMobile();
      if (currentlyMobile !== wasMobile) {
        wasMobile = currentlyMobile;
        buildBook();
        renderView(currentIndex);
      }
    });

    // Initialize physical book
    buildBook();
    renderView(0);
  }

  document.addEventListener("astro:page-load", initLabNotebook);
</script>

