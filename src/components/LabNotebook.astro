  .turning-page {
    position: absolute;
    top: 0;
    left: 50%;
    width: calc(50% - 12px);
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
    z-index: 10;
    pointer-events: none;
    display: none;
  }

  .turning-front,
  .turning-back {
    position: absolute;
    top: 0;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 0 2px 2px 0;
    overflow: hidden;
  }
  .turning-front {
    right: 0;
    width: calc(100% - 8px);
    background-color: var(--paper-color);
    box-shadow: -2px 0 8px rgba(0,0,0,0.1);
  }
  .turning-back {
    left: 0;
    width: calc(100% - 8px);
    background-color: var(--paper-color);
    transform: rotateY(180deg);
    box-shadow: 2px 0 8px rgba(0,0,0,0.1);
  }

  .turning-page.turning {
    display: block;
  }
  .turning-page.turn-next {
    animation: turnNext 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .turning-page.turn-prev {
    animation: turnPrev 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /* Rapid riffle animations */
  .turning-page.fast-riffle.turn-next {
    animation: turnNext 0.12s linear forwards;
  }
  .turning-page.fast-riffle.turn-prev {
    animation: turnPrev 0.12s linear forwards;
  }

  @keyframes turnNext {
    0% { transform: rotateY(0deg); }
    100% { transform: rotateY(-180deg); }
  }
  @keyframes turnPrev {
