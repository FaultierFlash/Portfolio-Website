---
// src/components/TextFadeIn.astro
export interface Props {
  targetSelectors?: string;
  baseDelay?: number;
  wordDelay?: number;
  blockStaggerDelay?: number;
}

const {
  targetSelectors = "p, li, h1, h2, h3, h4, h5, h6", // Expanded default selectors
  baseDelay = 10,
  wordDelay = 25,
  blockStaggerDelay = 75,
} = Astro.props;
---

<div
  class="text-fade-in-container"
  data-target-selectors={targetSelectors}
  data-base-delay={baseDelay}
  data-word-delay={wordDelay}
  data-block-stagger-delay={blockStaggerDelay}
>
  <slot />
</div>

<script>
  // Debounce function to limit how often a function can run.
  function debounce(func, wait, immediate) {
    var timeout;
    return function () {
      var context = this,
        args = arguments;
      var later = function () {
        timeout = null;
        if (!immediate) func.apply(context, args);
      };
      var callNow = immediate && !timeout;
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
      if (callNow) func.apply(context, args);
    };
  }

  function processTextFadeInContainer(container) {
    // Exit if already processed and not currently part of an outgoing Astro transition
    if (
      container.dataset.textFadeInProcessed === "true" &&
      !container.classList.contains("astro-transitioning-out")
    ) {
      // console.log('TextFadeIn: Already processed, skipping:', container);
      return;
    }
    // console.log('TextFadeIn: Processing container:', container);

    // Clear processed flag if it's part of an outgoing transition, to allow re-processing on next load
    if (container.classList.contains("astro-transitioning-out")) {
      container.dataset.textFadeInProcessed = "false";
      // Potentially remove 'in-view' and animation classes from children if needed for clean exit
      container.classList.remove("in-view");
      container
        .querySelectorAll(".fade-in-target-element.processed-for-animation")
        .forEach((el) => {
          el.classList.remove("in-view"); // Might not be strictly necessary if element is removed
          // Consider reverting innerHTML if complex interactions are an issue on exit
        });
      return; // Don't process for fade-in if it's transitioning out
    }

    const targetSelectors =
      container.dataset.targetSelectors || "p, li, h1, h2, h3, h4, h5, h6";
    const baseWordDelayForBlock = parseInt(
      container.dataset.baseDelay || "10",
      10
    );
    const wordIncrementDelay = parseInt(
      container.dataset.wordDelay || "25",
      10
    );
    const blockStagger = parseInt(
      container.dataset.blockStaggerDelay || "75",
      10
    );

    const elementsToAnimate = Array.from(
      container.querySelectorAll(targetSelectors)
    );
    // console.log('TextFadeIn: Elements to animate:', elementsToAnimate.length, elementsToAnimate);

    elementsToAnimate.forEach((element, elementIndex) => {
      // Skip if this specific element was already processed (e.g. if script runs multiple times accidentally)
      // and it's not being force-reprocessed due to Astro transitions.
      if (
        element.classList.contains("processed-for-animation") &&
        container.dataset.textFadeInProcessed === "true"
      ) {
        return;
      }

      // Clean previous spans if re-processing (e.g. after content change or for Astro transitions)
      // This is tricky; ideally, Astro View Transitions handle swapping, and this script runs on new content.
      // If an element's *content* changes but the element itself persists, we might need to clear old spans.
      // For now, we assume new elements or full container re-processing.
      // If element.dataset.originalContent is available from a previous run, restore it before re-processing.
      if (element.dataset.originalContent) {
        element.innerHTML = element.dataset.originalContent;
      } else {
        element.dataset.originalContent = element.innerHTML; // Store original content before wrapping
      }

      element.classList.add("fade-in-target-element");
      element.classList.add("processed-for-animation"); // Mark this specific element

      const elementActualBlockAnimationDelay = elementIndex * blockStagger;
      element.style.setProperty(
        "--block-animation-delay",
        `${elementActualBlockAnimationDelay}ms`
      );

      const newChildNodes = [];
      let wordIndexWithinCurrentBlock = 0;

      function processNodeForWordWrapping(node) {
        if (node.nodeType === Node.TEXT_NODE) {
          const words = node.textContent
            .split(/\s+/)
            .filter((word) => word.length > 0);
          const fragment = document.createDocumentFragment();
          words.forEach((word, idx) => {
            const span = document.createElement("span");
            span.className = "fade-in-word";
            span.textContent = word;
            const currentWordEffectiveDelay =
              elementActualBlockAnimationDelay + // Stagger for the block itself
              baseWordDelayForBlock + // Base delay for the first word in this block
              wordIndexWithinCurrentBlock * wordIncrementDelay; // Incremental delay for subsequent words
            span.style.setProperty(
              "--word-animation-delay",
              `${currentWordEffectiveDelay}ms`
            );
            fragment.appendChild(span);
            if (idx < words.length - 1) {
              fragment.appendChild(document.createTextNode(" "));
            }
            wordIndexWithinCurrentBlock++;
          });
          return fragment;
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          // Treat specified inline elements as single "words" for animation timing.
          // Preserve their original structure within the word span.
          if (
            node.matches(
              "strong, em, a, b, i, u, span, code, sub, sup, mark, del, ins"
            )
          ) {
            const wrapperSpan = document.createElement("span");
            wrapperSpan.className = "fade-in-word"; // This node itself acts as a "word"
            const currentWordEffectiveDelay =
              elementActualBlockAnimationDelay +
              baseWordDelayForBlock +
              wordIndexWithinCurrentBlock * wordIncrementDelay;
            wrapperSpan.style.setProperty(
              "--word-animation-delay",
              `${currentWordEffectiveDelay}ms`
            );
            wrapperSpan.appendChild(node.cloneNode(true)); // Clone the original inline element inside
            wordIndexWithinCurrentBlock++;
            return wrapperSpan;
          } else {
            // For other block-level or unrecognized elements, clone them and recursively process their children.
            const clonedElement = node.cloneNode(false); // Shallow clone (tag and attributes only)
            Array.from(node.childNodes).forEach((childNode) => {
              clonedElement.appendChild(processNodeForWordWrapping(childNode));
            });
            return clonedElement;
          }
        } else {
          // Other node types (comments, etc.) - clone them as is.
          return node.cloneNode(true);
        }
      }

      // Process all child nodes of the current element (e.g., p, li, h2).
      const childNodesToProcess = Array.from(element.childNodes);
      childNodesToProcess.forEach((child) => {
        newChildNodes.push(processNodeForWordWrapping(child));
      });

      // Replace content carefully
      element.innerHTML = ""; // Clear existing content
      newChildNodes.forEach((newNode) => {
        element.appendChild(newNode);
      });
    });

    // IntersectionObserver setup (if not already observing this specific container)
    // Use a flag on the container to avoid multiple observers if processTextFadeInContainer is called again.
    if (!container.dataset.observerAttached) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // console.log('TextFadeIn: Container in view:', entry.target);
              entry.target.classList.add("in-view");
              // Optional: Unobserve after first intersection if animation should only play once
              // observer.unobserve(entry.target);
              // container.dataset.observerAttached = "false"; // Allow re-attachment if needed later
            } else {
              // Optional: Remove 'in-view' to allow re-animation if user scrolls away and back
              // entry.target.classList.remove("in-view");
              // This would require elements to reset their opacity/transform if re-animating.
            }
          });
        },
        { threshold: 0.1 } // Trigger when 10% of the container is visible
      );
      observer.observe(container);
      container.dataset.observerAttached = "true";
    }

    container.dataset.textFadeInProcessed = "true"; // Mark this container as processed for this script pass
  }

  const initAllFadeInContainers = debounce(() => {
    // console.log('TextFadeIn: Running initAllFadeInContainers');
    document
      .querySelectorAll(".text-fade-in-container")
      .forEach((container) => {
        // The check inside processTextFadeInContainer will handle if it's already processed.
        processTextFadeInContainer(container);
      });
  }, 50); // Debounce to prevent rapid re-runs during complex load scenarios

  // Astro's View Transitions: astro:page-load is the primary event.
  document.addEventListener("astro:page-load", () => {
    // console.log("TextFadeIn: astro:page-load event triggered.");
    initAllFadeInContainers();
  });

  // Fallback for initial load IF astro:page-load isn't triggered early enough,
  // or for scenarios without View Transitions.
  // The `data-text-fade-in-processed` flag inside processTextFadeInContainer should prevent redundant processing.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllFadeInContainers, {
      once: true,
    });
  } else {
    // Already loaded
    initAllFadeInContainers();
  }
</script>

<style is:global>
  /* Container for the text blocks that will fade in */
  .text-fade-in-container {
    overflow: visible; /* Default, but good to ensure it doesn't clip children unexpectedly */
    display: block; /* Or 'flow-root' if helpful for containing floats, usually 'block' is fine */
  }

  /* Target elements (p, li, h2, etc.) that will contain animated words */
  .fade-in-target-element {
    opacity: 0; /* Initially hidden */
    transform: translateY(0.5em); /* Start slightly offset downwards */
    transition-property: opacity, transform;
    transition-duration: 0.5s; /* Duration for the block itself to fade/slide in */
    transition-timing-function: cubic-bezier(
      0.215,
      0.61,
      0.355,
      1
    ); /* EaseOutCubic */
    /* transition-delay is applied via --block-animation-delay CSS variable */
  }

  /* When the container is in view, the target elements become visible */
  .text-fade-in-container.in-view .fade-in-target-element {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(
      --block-animation-delay,
      0ms
    ); /* Apply stagger for each block */
  }

  /* Ensure list items preserve their markers when processed */
  .fade-in-target-element.processed-for-animation {
    /* These styles help maintain list appearance if they are list items */
    list-style-position: outside !important; /* Try to force if prose or other styles interfere */
    list-style-type: inherit !important;
  }
  /* Specifically for LIs if they are direct targets */
  li.fade-in-target-element.processed-for-animation {
    display: list-item !important; /* Ensure it's treated as a list item */
  }

  /* Individual words within the target elements */
  .fade-in-word {
    display: inline-block; /* Allows transform and respects spaces around it */
    opacity: 0;
    transform: translateY(
      0.7em
    ); /* Start slightly further down than the block */
    /* Individual word animation properties */
    transition-property: opacity, transform;
    transition-duration: 0.6s; /* Slightly longer animation for word emphasis */
    transition-timing-function: cubic-bezier(
      0.215,
      0.61,
      0.355,
      1
    ); /* EaseOutCubic */
    /* transition-delay is applied via --word-animation-delay CSS variable */
    /* Helps with long words not breaking layout if they are the only content of a line */
    max-width: 100%;
    overflow-wrap: break-word;
    /* Fix for potential sub-pixel rendering issues causing slight jumps in some browsers */
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* Words become visible after their parent block is in view and their own delay passes */
  .text-fade-in-container.in-view .fade-in-word {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(
      --word-animation-delay,
      0ms
    ); /* Apply staggered word delay */
  }
</style>
