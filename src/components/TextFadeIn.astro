---
// src/components/TextFadeIn.astro
export interface Props {
  targetSelectors?: string;
  baseDelay?: number;
  wordDelay?: number;
  blockStaggerDelay?: number;
}

const {
  targetSelectors = "p, li, h1, h2, h3, h4, h5, h6", // Expanded default selectors
  baseDelay = 10,
  wordDelay = 25,
  blockStaggerDelay = 75,
} = Astro.props;
---

<div
  class="text-fade-in-container"
  data-target-selectors={targetSelectors}
  data-base-delay={baseDelay}
  data-word-delay={wordDelay}
  data-block-stagger-delay={blockStaggerDelay}
>
  <slot />
</div>

<script>
  // Debounce function to limit how often a function can run.
  function debounce<T extends (...args: any[]) => void>(func: T, wait: number, immediate?: boolean) {
    let timeout: ReturnType<typeof setTimeout> | null = null;
    return function (this: any, ...args: Parameters<T>) {
      const context = this;
      const later = function () {
        timeout = null;
        if (!immediate) func.apply(context, args);
      };
      const callNow = immediate && !timeout;
      if (timeout) clearTimeout(timeout);
      timeout = setTimeout(later, wait);
      if (callNow) func.apply(context, args);
    };
  }

  let activeObservers: IntersectionObserver[] = [];

  function cleanupTextFadeIn() {
    while (activeObservers.length > 0) {
      activeObservers.pop()?.disconnect();
    }
  }

  function processTextFadeInContainer(container: Element) {
    if (!(container instanceof HTMLElement)) return;
    if (
      container.dataset.textFadeInProcessed === "true" &&
      !container.classList.contains("astro-transitioning-out")
    ) {
      return;
    }

    if (container.classList.contains("astro-transitioning-out")) {
      container.dataset.textFadeInProcessed = "false";
      container.classList.remove("in-view");
      container
        .querySelectorAll(".fade-in-target-element.processed-for-animation")
        .forEach((el) => {
          el.classList.remove("in-view");
        });
      return;
    }

    const prefersReducedMotion =
      typeof window !== "undefined" &&
      window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

    const targetSelectors =
      container.dataset.targetSelectors || "p, li, h1, h2, h3, h4, h5, h6";
    const baseWordDelayForBlock = Math.min(
      parseInt(container.dataset.baseDelay || "10", 10),
      40
    );
    const wordIncrementDelay = Math.min(
      parseInt(container.dataset.wordDelay || "20", 10),
      18
    );

    const elementsToAnimate = Array.from(
      container.querySelectorAll(targetSelectors)
    );

    if (prefersReducedMotion) {
      container.classList.add("in-view");
      elementsToAnimate.forEach((el) => {
        if (el instanceof HTMLElement) {
          el.classList.add("fade-in-target-element", "in-view");
        }
      });
      container.dataset.textFadeInProcessed = "true";
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.01, rootMargin: "80px 0px 80px 0px" }
    );
    activeObservers.push(observer);

    elementsToAnimate.forEach((element) => {
      if (!(element instanceof HTMLElement)) return;

      if (
        element.classList.contains("processed-for-animation") &&
        container.dataset.textFadeInProcessed === "true"
      ) {
        return;
      }

      if (element.dataset.originalContent) {
        element.innerHTML = element.dataset.originalContent;
      } else {
        element.dataset.originalContent = element.innerHTML;
      }

      element.classList.add("fade-in-target-element", "processed-for-animation");
      element.style.setProperty("--block-animation-delay", "0ms");

      const newChildNodes: Node[] = [];
      let wordIndexWithinCurrentBlock = 0;

      function processNodeForWordWrapping(node: Node): Node {
        if (node.nodeType === Node.TEXT_NODE) {
          const parts = (node.textContent || "").split(/(\s+)/);
          const fragment = document.createDocumentFragment();
          parts.forEach((part: string) => {
            if (part.length === 0) return;
            if (/^\s+$/.test(part)) {
              fragment.appendChild(document.createTextNode(part));
            } else {
              const span = document.createElement("span");
              span.className = "fade-in-word";
              span.textContent = part;
              const currentWordEffectiveDelay = Math.min(
                300,
                baseWordDelayForBlock + wordIndexWithinCurrentBlock * wordIncrementDelay
              );
              span.style.setProperty(
                "--word-animation-delay",
                `${currentWordEffectiveDelay}ms`
              );
              fragment.appendChild(span);
              wordIndexWithinCurrentBlock++;
            }
          });
          return fragment;
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          if (
            node instanceof Element &&
            node.matches(
              "strong, em, a, b, i, u, span, code, sub, sup, mark, del, ins"
            )
          ) {
            const wrapperSpan = document.createElement("span");
            wrapperSpan.className = "fade-in-word";
            const currentWordEffectiveDelay = Math.min(
              300,
              baseWordDelayForBlock + wordIndexWithinCurrentBlock * wordIncrementDelay
            );
            wrapperSpan.style.setProperty(
              "--word-animation-delay",
              `${currentWordEffectiveDelay}ms`
            );
            wrapperSpan.appendChild(node.cloneNode(true));
            wordIndexWithinCurrentBlock++;
            return wrapperSpan;
          } else {
            const clonedElement = node.cloneNode(false) as Element;
            Array.from(node.childNodes).forEach((childNode) => {
              clonedElement.appendChild(processNodeForWordWrapping(childNode));
            });
            return clonedElement;
          }
        } else {
          return node.cloneNode(true);
        }
      }

      const childNodesToProcess = Array.from(element.childNodes);
      childNodesToProcess.forEach((child) => {
        newChildNodes.push(processNodeForWordWrapping(child));
      });

      element.innerHTML = "";
      newChildNodes.forEach((newNode) => {
        element.appendChild(newNode);
      });

      const rect = element.getBoundingClientRect();
      if (rect.top < window.innerHeight + 80) {
        element.classList.add("in-view");
      } else {
        observer.observe(element);
      }
    });

    container.dataset.observerAttached = "true";
    container.dataset.textFadeInProcessed = "true";
  }

  const initAllFadeInContainers = debounce(() => {
    cleanupTextFadeIn();
    document
      .querySelectorAll(".text-fade-in-container")
      .forEach((container) => {
        processTextFadeInContainer(container);
      });
  }, 50);

  document.addEventListener("astro:page-load", () => {
    initAllFadeInContainers();
  });

  document.addEventListener("astro:before-swap", () => {
    cleanupTextFadeIn();
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllFadeInContainers, {
      once: true,
    });
  } else {
    initAllFadeInContainers();
  }
</script>

<style is:global>
  .text-fade-in-container {
    overflow: visible;
    display: block;
  }

  .fade-in-target-element {
    opacity: 0;
    transform: translateY(0.5em);
    transition-property: opacity, transform;
    transition-duration: 0.4s;
    transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .fade-in-target-element.in-view,
  .text-fade-in-container.in-view .fade-in-target-element {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0ms;
  }

  .fade-in-target-element.processed-for-animation {
    list-style-position: outside !important;
    list-style-type: inherit !important;
  }

  li.fade-in-target-element.processed-for-animation {
    display: list-item !important;
  }

  .fade-in-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.55em);
    transition-property: opacity, transform;
    transition-duration: 0.4s;
    transition-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    max-width: 100%;
    overflow-wrap: break-word;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .fade-in-target-element.in-view .fade-in-word,
  .text-fade-in-container.in-view .fade-in-word {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--word-animation-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in-target-element,
    .fade-in-word {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
