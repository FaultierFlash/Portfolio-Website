---
// src/components/Header.astro
import {
  useTranslations,
  type Locale,
  type LocalizedString,
} from "../i18n/utils";
import Logo from "./Logo.astro";
import HamburgerButton from "./HamburgerButton.astro";
import Navigation from "./Navigation.astro";
import type { PathSegment } from "./Logo.astro";

interface Props {
  currentLocale: Locale;
  t: ReturnType<typeof useTranslations>;
  homePath: string;
  navLinks: { href: string; text: LocalizedString | string }[];
  projectPages: { href: string; text: LocalizedString | string }[];
}

const { currentLocale, t, homePath, navLinks, projectPages } = Astro.props;

// --- Generate Path Segments for Logo with Full Translation ---
const pathSegments: PathSegment[] = [];
const rawPathname = Astro.url.pathname;
console.log("[Header Breadcrumb] Raw Pathname:", rawPathname);

// 1. Add the "~" (home) segment
pathSegments.push({
  text: "~",
  href: homePath,
  ariaLabel: t("nav.logo.ariaLabel") || t("nav.home") || "Home",
});

// 2. Process the rest of the path
const localePrefix = `/${currentLocale}`;
let pathWithoutLocale = rawPathname;

if (rawPathname.startsWith(localePrefix)) {
  pathWithoutLocale = rawPathname.substring(localePrefix.length);
}
if (pathWithoutLocale && !pathWithoutLocale.startsWith("/")) {
  pathWithoutLocale = "/" + pathWithoutLocale;
}
if (pathWithoutLocale.length > 1 && pathWithoutLocale.endsWith("/")) {
  pathWithoutLocale = pathWithoutLocale.slice(0, -1);
}
console.log("[Header Breadcrumb] Path without locale:", pathWithoutLocale);

const slugs = pathWithoutLocale.split("/").filter(Boolean);
console.log("[Header Breadcrumb] Slugs:", JSON.stringify(slugs));

let cumulativePathForLinks = "";
let basePathKeyForTranslations = "paths"; // Start with the base "paths" key

slugs.forEach((slug, index) => {
  console.log(`\n[Header Breadcrumb] Processing slug #${index}: '${slug}'`);
  cumulativePathForLinks += `/${slug}`;
  const isLastSegment = index === slugs.length - 1;
  let segmentText = "";

  // Construct the key for the section title (e.g., "paths.projects._title_")
  const titleKey = `${basePathKeyForTranslations}.${slug}._title_`;
  let translatedTitle = t(titleKey);

  console.log(
    `[Header Breadcrumb] Attempting titleKey: '${titleKey}', result: '${translatedTitle}'`
  );

  if (translatedTitle && translatedTitle !== titleKey) {
    // Check if translation was found and is not the key itself
    segmentText = translatedTitle;
    console.log(
      `[Header Breadcrumb] Used _title_ translation: '${segmentText}'`
    );
  } else {
    // If _title_ not found, try direct slug translation (for leaf nodes like project names)
    const directSlugKey = `${basePathKeyForTranslations}.${slug}`;
    let translatedSlug = t(directSlugKey);
    console.log(
      `[Header Breadcrumb] Attempting directSlugKey: '${directSlugKey}', result: '${translatedSlug}'`
    );

    if (translatedSlug && translatedSlug !== directSlugKey) {
      segmentText = translatedSlug;
      console.log(
        `[Header Breadcrumb] Used direct slug translation: '${segmentText}'`
      );
    } else {
      // Fallback: capitalize the slug
      segmentText = slug
        .replace(/-/g, " ")
        .split(" ")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ");
      console.log(
        `[Header Breadcrumb] No specific translation found, defaulted to capitalized: '${segmentText}'`
      );
    }
  }

  if (!isLastSegment) {
    pathSegments.push({
      text: segmentText,
      href: `${localePrefix}${cumulativePathForLinks}`,
      ariaLabel:
        t("nav.goToLabel", { page: segmentText }) || `Go to ${segmentText}`,
    });
  } else {
    pathSegments.push({
      text: segmentText,
    });
  }
  console.log(
    `[Header Breadcrumb] Added segment: { text: '${segmentText}', isLink: ${!isLastSegment} }`
  );

  // Update the base path for the next level of translation lookup
  basePathKeyForTranslations = `${basePathKeyForTranslations}.${slug}`;
});

const logoContainerAriaLabel =
  t("nav.breadcrumbAriaLabel") || "Current page location breadcrumb";
const toggleMenuLabel = t("nav.toggleMenu") || "Toggle menu";
const mainNavigationLabel = t("nav.mainNavigation") || "Main menu";
const projectsSubmenuLabel = t("dropdown.projects.label") || "Projects submenu";
---

<header class="top-bar" id="main-header">
  <Logo
    pathSegments={pathSegments}
    containerAriaLabel={logoContainerAriaLabel}
  />

  <Navigation
    currentLocale={currentLocale}
    t={t}
    navLinks={navLinks}
    projectPages={projectPages}
    mainNavigationLabel={mainNavigationLabel}
    projectsSubmenuLabel={projectsSubmenuLabel}
  >
    <Fragment slot="hamburger-button">
      <HamburgerButton toggleMenuLabel={toggleMenuLabel} />
    </Fragment>
  </Navigation>
</header>

<style>
  /* Styles specific to the .top-bar layout */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.5rem;
    background-color: var(--color-bg, #fff);
    border-bottom: 1px solid var(--color-border, #e0e0e0);
    color: var(--color-text, #333);
    position: sticky;
    top: 0;
    z-index: 110;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
    height: var(--header-height, 60px);
  }
</style>
