---
// src/components/AudioPlayer.astro
// Glassmorphic Audio Player with Web Audio API Space Ambience Synth
---

<div id="audio-player-widget" class="audio-widget-wrapper docked expand-up align-right" transition:persist="audio-player-widget">
  <!-- Mini Circular Button -->
  <button id="widget-toggle-btn" class="widget-toggle-btn" aria-label="Music Player" title="Play Music">
    <!-- Visualizer Icon (Static or Animated) -->
    <div class="mini-visualizer" id="mini-visualizer">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>
    <!-- Headphones Icon fallback when not playing -->
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="headphones-icon"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
  </button>

  <!-- Expanded Panel -->
  <div class="widget-panel" id="widget-panel">
    <div class="panel-header">
      <span class="now-playing-label">Ambient Soundscape</span>
      <span class="track-title" id="track-title">Space Synth Ambience</span>
    </div>

    <!-- Active Wave Visualizer -->
    <div class="wave-visualizer" id="wave-visualizer">
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
      <div class="wave-bar"></div>
    </div>

    <!-- Controls Row -->
    <div class="controls-row">
      <button id="audio-play-pause-btn" class="play-btn" aria-label="Play/Pause">
        <!-- Play SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="play-icon"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
        <!-- Pause SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="pause-icon hidden"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
      </button>

      <div class="select-volume-container">
        <select id="track-select" class="track-select">
          <option value="synth">🌌 Space Ambience (Synth)</option>
          <option value="lofi">☕ Lofi Chill (Stream)</option>
        </select>

        <div class="volume-container">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="volume-icon"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
          <input type="range" id="volume-slider" min="0" max="1" step="0.05" value="0.4" class="volume-slider" />
        </div>
      </div>
    </div>
  </div>

  <!-- HTML5 Audio Element for streamed track (deferred load on user interaction) -->
  <audio id="html5-audio-element" loop preload="none" data-src="https://upload.wikimedia.org/wikipedia/commons/6/69/Lo-fi_by_PetroVenus.mp3"></audio>
</div>

<script>
  let isPlaying = false;
  let currentTrack = "synth"; // 'synth' or 'lofi'
  let userVolume = 0.4;

  // --- Web Audio Synth Engine ---
  let synthContext: AudioContext | null = null;
  let synthGain: GainNode | null = null;
  let filterNode: BiquadFilterNode | null = null;
  let oscillators: OscillatorNode[] = [];
  let oscillatorGains: GainNode[] = [];
  let chordInterval: any = null;

  // Space Chords: Cmaj9, Am9, Fmaj9, G9
  const chords = [
    [130.81, 164.81, 196.00, 246.94, 293.66], // Cmaj9 (C3, E3, G3, B3, D4)
    [110.00, 130.81, 164.81, 196.00, 246.94], // Am9 (A2, C3, E3, G3, B3)
    [87.31, 110.00, 130.81, 164.81, 196.00],   // Fmaj9 (F2, A2, C3, E3, G3)
    [98.00, 123.47, 146.83, 174.61, 220.00]    // G9 (G2, B2, D3, F3, A3)
  ];
  let currentChordIndex = 0;

  function initSynth() {
    if (synthContext) return;
    const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
    synthContext = new AudioContextClass();

    filterNode = synthContext.createBiquadFilter();
    filterNode.type = "lowpass";
    filterNode.frequency.value = 350;
    filterNode.Q.value = 1.2;

    synthGain = synthContext.createGain();
    synthGain.gain.setValueAtTime(0, synthContext.currentTime);

    filterNode.connect(synthGain);
    synthGain.connect(synthContext.destination);

    // LFO to modulate filter frequency
    const lfo = synthContext.createOscillator();
    const lfoGain = synthContext.createGain();
    lfo.frequency.value = 0.08; // 12 seconds per wave sweep
    lfoGain.gain.value = 200; // Sweep range: 350 +/- 200 Hz
    lfo.connect(lfoGain);
    lfoGain.connect(filterNode.frequency);
    lfo.start();

    // Create 5 permanent oscillators with dedicated gains
    const now = synthContext.currentTime;
    oscillators = [];
    oscillatorGains = [];
    for (let i = 0; i < 5; i++) {
      const osc = synthContext.createOscillator();
      // Alternate waveform for warm detuned feel
      osc.type = i % 2 === 0 ? "triangle" : "sine";
      osc.frequency.setValueAtTime(chords[0][i], now);
      
      const noteGain = synthContext.createGain();
      noteGain.gain.setValueAtTime(0.06, now); // soft volume per note
      
      osc.connect(noteGain);
      noteGain.connect(filterNode);
      osc.start(now);
      
      oscillators.push(osc);
      oscillatorGains.push(noteGain);
    }
  }

  function startSynth() {
    initSynth();
    if (!synthContext || !synthGain) return;
    if (synthContext.state === "suspended") {
      synthContext.resume();
    }

    // Fade in master gain
    synthGain.gain.setValueAtTime(synthGain.gain.value, synthContext.currentTime);
    synthGain.gain.linearRampToValueAtTime(userVolume, synthContext.currentTime + 1.5);

    // Ensure note frequencies and gains are initialized/reset correctly
    const now = synthContext.currentTime;
    oscillators.forEach((osc, idx) => {
      osc.frequency.setValueAtTime(chords[currentChordIndex][idx], now);
    });
    oscillatorGains.forEach((g) => {
      g.gain.setValueAtTime(g.gain.value, now);
      g.gain.linearRampToValueAtTime(0.06, now + 0.5);
    });

    // Start chord progression scheduler
    if (chordInterval) clearInterval(chordInterval);
    chordInterval = setInterval(scheduleNextChord, 8000);
  }

  function stopSynth() {
    if (!synthContext || !synthGain) return;
    synthGain.gain.setValueAtTime(synthGain.gain.value, synthContext.currentTime);
    synthGain.gain.linearRampToValueAtTime(0, synthContext.currentTime + 0.5);
    if (chordInterval) {
      clearInterval(chordInterval);
      chordInterval = null;
    }
    // Suspend audio context dynamically after fade out to save CPU
    setTimeout(() => {
      if (synthContext && !isPlaying && synthContext.state === "running") {
        synthContext.suspend();
      }
    }, 600);
  }

  function scheduleNextChord() {
    if (!synthContext || oscillators.length < 5 || oscillatorGains.length < 5) return;
    currentChordIndex = (currentChordIndex + 1) % chords.length;
    const targetFreqs = chords[currentChordIndex];
    const now = synthContext.currentTime;

    // Fade out note gains over 2 seconds
    oscillatorGains.forEach((g) => {
      g.gain.setValueAtTime(g.gain.value, now);
      g.gain.linearRampToValueAtTime(0, now + 2.0);
    });

    // Update frequencies at 2.1 seconds while silent
    oscillators.forEach((osc, idx) => {
      osc.frequency.setValueAtTime(targetFreqs[idx], now + 2.1);
    });

    // Fade back in over 3 seconds (from 2.1 to 5.1 seconds)
    oscillatorGains.forEach((g) => {
      g.gain.setValueAtTime(0, now + 2.1);
      g.gain.linearRampToValueAtTime(0.06, now + 5.1);
    });
  }

  function updateSynthVolume(vol: number) {
    if (synthGain && synthContext) {
      synthGain.gain.setValueAtTime(synthGain.gain.value, synthContext.currentTime);
      synthGain.gain.linearRampToValueAtTime(vol, synthContext.currentTime + 0.1);
    }
  }

  function updateWidgetPositionClasses(left: number, top: number) {
    const wrapper = document.getElementById("audio-player-widget");
    if (!wrapper) return;

    if (top > window.innerHeight / 2) {
      wrapper.classList.add("expand-up");
      wrapper.classList.remove("expand-down");
    } else {
      wrapper.classList.add("expand-down");
      wrapper.classList.remove("expand-up");
    }

    if (left > window.innerWidth / 2) {
      wrapper.classList.add("align-right");
      wrapper.classList.remove("align-left");
    } else {
      wrapper.classList.add("align-left");
      wrapper.classList.remove("align-right");
    }
  }

  function dockWidget() {
    const widget = document.getElementById("audio-player-widget");
    const placeholder = document.getElementById("audio-widget-placeholder");
    if (!widget) return;

    if (placeholder && widget.parentElement !== placeholder) {
      placeholder.appendChild(widget);
    }

    widget.classList.add("docked");
    widget.classList.remove("floating");
    widget.style.removeProperty("left");
    widget.style.removeProperty("top");
    widget.style.removeProperty("right");
    widget.style.removeProperty("bottom");
    widget.style.removeProperty("position");

    widget.classList.add("expand-up");
    widget.classList.remove("expand-down");
    widget.classList.add("align-right");
    widget.classList.remove("align-left");

    sessionStorage.setItem("audio-widget-docked", "true");
    sessionStorage.removeItem("audio-widget-left");
    sessionStorage.removeItem("audio-widget-top");
    localStorage.removeItem("audio-widget-left");
    localStorage.removeItem("audio-widget-top");
    localStorage.removeItem("audio-widget-docked");
  }

  function floatWidget(left: number, top: number) {
    const widget = document.getElementById("audio-player-widget");
    if (!widget) return;

    if (widget.parentElement !== document.body) {
      document.body.appendChild(widget);
    }

    widget.classList.remove("docked");
    widget.classList.add("floating");

    const buttonSize = window.innerWidth <= 768 ? 44 : 48;
    const minX = 10;
    const minY = 10;
    const maxX = Math.max(minX, window.innerWidth - buttonSize - 10);
    const maxY = Math.max(minY, window.innerHeight - buttonSize - 10);

    const safeLeft = Math.max(minX, Math.min(maxX, left));
    const safeTop = Math.max(minY, Math.min(maxY, top));

    widget.style.left = `${safeLeft}px`;
    widget.style.top = `${safeTop}px`;
    widget.style.right = "auto";
    widget.style.bottom = "auto";

    updateWidgetPositionClasses(safeLeft, safeTop);

    sessionStorage.setItem("audio-widget-docked", "false");
    sessionStorage.setItem("audio-widget-left", `${safeLeft}px`);
    sessionStorage.setItem("audio-widget-top", `${safeTop}px`);
  }

  // --- UI Interactivity ---
  function setupAudioPlayer() {
    const widget = document.getElementById("audio-player-widget");
    const toggleBtn = document.getElementById("widget-toggle-btn");
    const panel = document.getElementById("widget-panel");
    const playPauseBtn = document.getElementById("audio-play-pause-btn");
    const trackSelect = document.getElementById("track-select") as HTMLSelectElement | null;
    const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement | null;
    const audioEl = document.getElementById("html5-audio-element") as HTMLAudioElement | null;
    const trackTitle = document.getElementById("track-title");

    if (!widget || !toggleBtn || !panel || !playPauseBtn || !trackSelect || !volumeSlider || !audioEl) return;

    // Prevent duplicate listener bindings
    if (widget.dataset.audioInitialized === "true") return;
    widget.dataset.audioInitialized = "true";

    const activeWidget = widget;

    // Set initial volume value
    audioEl.volume = userVolume;
    volumeSlider.value = userVolume.toString();

    // Draggable Movability State with Pointer Events
    let isPointerDown = false;
    let hasDragged = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;
    let suppressClickUntil = 0;

    function onPointerDown(e: PointerEvent) {
      if (e.button !== 0 && e.pointerType === 'mouse') return;

      isPointerDown = true;
      hasDragged = false;
      startX = e.clientX;
      startY = e.clientY;

      const rect = activeWidget.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;

      window.addEventListener('pointermove', onPointerMove, { passive: false });
      window.addEventListener('pointerup', onPointerUp);
      window.addEventListener('pointercancel', onPointerCancel);
    }

    function onPointerMove(e: PointerEvent) {
      if (!isPointerDown) return;

      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;
      const dist = Math.hypot(deltaX, deltaY);

      if (!hasDragged && dist > 6) {
        hasDragged = true;

        if (activeWidget.classList.contains("docked")) {
          const rect = activeWidget.getBoundingClientRect();
          activeWidget.classList.remove("docked");
          activeWidget.classList.add("floating");
          if (activeWidget.parentElement !== document.body) {
            document.body.appendChild(activeWidget);
          }
          // Rebase coordinate origin seamlessly without visual jump
          initialLeft = rect.left;
          initialTop = rect.top;
          startX = e.clientX;
          startY = e.clientY;
        }

        // Close expanded panel while dragging
        panel.classList.remove("expanded");
      }

      if (hasDragged) {
        if (e.cancelable) {
          e.preventDefault();
        }

        let currentX = initialLeft + (e.clientX - startX);
        let currentY = initialTop + (e.clientY - startY);

        const buttonSize = window.innerWidth <= 768 ? 44 : 48;
        const minX = 10;
        const minY = 10;
        const maxX = Math.max(minX, window.innerWidth - buttonSize - 10);
        const maxY = Math.max(minY, window.innerHeight - buttonSize - 10);

        currentX = Math.max(minX, Math.min(maxX, currentX));
        currentY = Math.max(minY, Math.min(maxY, currentY));

        // Check snapping distance to footer placeholder
        const placeholder = document.getElementById("audio-widget-placeholder");
        const placeholderRing = placeholder?.querySelector(".placeholder-ring");

        if (placeholder) {
          const pRect = placeholder.getBoundingClientRect();
          const isPlaceholderInView = pRect.top < window.innerHeight && pRect.bottom > 0 && pRect.left < window.innerWidth && pRect.right > 0;
          const snapDist = Math.hypot(currentX - pRect.left, currentY - pRect.top);

          if (isPlaceholderInView && snapDist < 65) {
            placeholderRing?.classList.add("snap-hover");
            currentX = pRect.left;
            currentY = pRect.top;
            activeWidget.classList.add("expand-up");
            activeWidget.classList.remove("expand-down");
            activeWidget.classList.add("align-right");
            activeWidget.classList.remove("align-left");
          } else {
            placeholderRing?.classList.remove("snap-hover");
            updateWidgetPositionClasses(currentX, currentY);
          }
        } else {
          updateWidgetPositionClasses(currentX, currentY);
        }

        activeWidget.style.left = `${currentX}px`;
        activeWidget.style.top = `${currentY}px`;
        activeWidget.style.right = 'auto';
        activeWidget.style.bottom = 'auto';
      }
    }

    function cleanupPointerListeners() {
      isPointerDown = false;
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
      window.removeEventListener('pointercancel', onPointerCancel);
    }

    function onPointerUp(e: PointerEvent) {
      if (!isPointerDown) return;
      const wasDragged = hasDragged;
      cleanupPointerListeners();

      const placeholder = document.getElementById("audio-widget-placeholder");
      const placeholderRing = placeholder?.querySelector(".placeholder-ring");
      const wasSnapHover = placeholderRing?.classList.contains("snap-hover");
      placeholderRing?.classList.remove("snap-hover");

      if (wasDragged) {
        suppressClickUntil = Date.now() + 300;

        let shouldDock = false;
        if (placeholder) {
          const pRect = placeholder.getBoundingClientRect();
          const wRect = activeWidget.getBoundingClientRect();
          const dist = Math.hypot(wRect.left - pRect.left, wRect.top - pRect.top);
          const isPlaceholderInView = pRect.top < window.innerHeight && pRect.bottom > 0 && pRect.left < window.innerWidth && pRect.right > 0;
          if (isPlaceholderInView && (dist < 65 || wasSnapHover)) {
            shouldDock = true;
          }
        }

        if (shouldDock) {
          dockWidget();
        } else {
          floatWidget(parseFloat(activeWidget.style.left) || initialLeft, parseFloat(activeWidget.style.top) || initialTop);
        }
      } else {
        // Pure click/tap action
        panel.classList.toggle("expanded");
      }
    }

    function onPointerCancel() {
      if (!isPointerDown) return;
      cleanupPointerListeners();
      const placeholderRing = document.getElementById("audio-widget-placeholder")?.querySelector(".placeholder-ring");
      placeholderRing?.classList.remove("snap-hover");
      if (hasDragged) {
        suppressClickUntil = Date.now() + 300;
      }
    }

    // Attach pointerdown dragging listener to toggle button
    toggleBtn.addEventListener('pointerdown', onPointerDown);

    // Suppress native click if trailing after drag
    toggleBtn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (Date.now() < suppressClickUntil) {
        return;
      }
      // Note: toggle is executed directly in onPointerUp when not dragged
    });

    // Close panel when clicking outside the widget
    document.addEventListener("click", (e: any) => {
      if (!activeWidget.contains(e.target)) {
        panel.classList.remove("expanded");
      }
    });

    // Deferred audio loading logic: only buffer on first user activity or play request
    function ensureAudioLoaded() {
      if (!audioEl) return;
      if (!audioEl.src && audioEl.dataset.src) {
        audioEl.src = audioEl.dataset.src;
        audioEl.preload = "auto";
        audioEl.load();
      }
      removeInteractionListeners();
    }

    const interactionEvents = ["pointerdown", "mousemove", "scroll", "keydown", "touchstart"];
    function onFirstUserInteraction() {
      ensureAudioLoaded();
    }

    function addInteractionListeners() {
      interactionEvents.forEach((evt) => {
        window.addEventListener(evt, onFirstUserInteraction, { passive: true, once: true });
      });
    }

    function removeInteractionListeners() {
      interactionEvents.forEach((evt) => {
        window.removeEventListener(evt, onFirstUserInteraction);
      });
    }

    addInteractionListeners();

    // Play/Pause Action
    playPauseBtn.addEventListener("click", () => {
      if (isPlaying) {
        pauseAudio();
      } else {
        playAudio();
      }
    });

    // Track Selection
    trackSelect.addEventListener("change", () => {
      const selected = trackSelect.value;
      if (selected === currentTrack) return;

      const wasPlaying = isPlaying;
      if (isPlaying) {
        pauseAudio();
      }

      currentTrack = selected;
      if (trackTitle) {
        trackTitle.textContent = currentTrack === "synth" ? "Space Synth Ambience" : "Lofi Chill Beats";
      }

      if (currentTrack === "lofi") {
        ensureAudioLoaded();
      }

      if (wasPlaying) {
        setTimeout(playAudio, 200);
      }
    });

    // Volume Adjustment
    volumeSlider.addEventListener("input", () => {
      userVolume = parseFloat(volumeSlider.value);
      audioEl.volume = userVolume;
      updateSynthVolume(userVolume);
    });

    function playAudio() {
      isPlaying = true;
      activeWidget.classList.add("playing");
      playPauseBtn?.querySelector(".play-icon")?.classList.add("hidden");
      playPauseBtn?.querySelector(".pause-icon")?.classList.remove("hidden");

      if (currentTrack === "synth") {
        startSynth();
      } else {
        ensureAudioLoaded();
        audioEl?.play().catch((e) => {
          console.warn("Audio play blocked by browser. User interaction needed:", e);
          pauseAudio();
        });
      }
    }

    function pauseAudio() {
      isPlaying = false;
      activeWidget.classList.remove("playing");
      playPauseBtn?.querySelector(".play-icon")?.classList.remove("hidden");
      playPauseBtn?.querySelector(".pause-icon")?.classList.add("hidden");

      if (currentTrack === "synth") {
        stopSynth();
      } else {
        audioEl?.pause();
      }
    }
  }

  // Constrain position during window resize
  window.addEventListener("resize", () => {
    const widget = document.getElementById("audio-player-widget");
    if (!widget || !widget.classList.contains("floating") || !widget.style.left || widget.style.left === "auto") return;

    const left = parseFloat(widget.style.left);
    const top = parseFloat(widget.style.top);
    
    const buttonSize = window.innerWidth <= 768 ? 44 : 48;
    const minX = 10;
    const minY = 10;
    const maxX = Math.max(minX, window.innerWidth - buttonSize - 10);
    const maxY = Math.max(minY, window.innerHeight - buttonSize - 10);
    
    const newLeft = Math.max(minX, Math.min(maxX, left));
    const newTop = Math.max(minY, Math.min(maxY, top));
    
    widget.style.left = `${newLeft}px`;
    widget.style.top = `${newTop}px`;
    
    updateWidgetPositionClasses(newLeft, newTop);
  });

  function initAudioWidget() {
    setupAudioPlayer();

    // Sync UI to current playing state (since widget persists, state variables stay active)
    const widget = document.getElementById("audio-player-widget");
    const playPauseBtn = document.getElementById("audio-play-pause-btn");
    const trackSelect = document.getElementById("track-select") as HTMLSelectElement | null;
    const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement | null;
    const trackTitle = document.getElementById("track-title");

    if (widget && playPauseBtn && trackSelect && volumeSlider) {
      trackSelect.value = currentTrack;
      volumeSlider.value = userVolume.toString();
      if (trackTitle) {
        trackTitle.textContent = currentTrack === "synth" ? "Space Synth Ambience" : "Lofi Chill Beats";
      }

      if (isPlaying) {
        widget.classList.add("playing");
        playPauseBtn.querySelector(".play-icon")?.classList.add("hidden");
        playPauseBtn.querySelector(".pause-icon")?.classList.remove("hidden");
      } else {
        widget.classList.remove("playing");
        playPauseBtn.querySelector(".play-icon")?.classList.remove("hidden");
        playPauseBtn.querySelector(".pause-icon")?.classList.add("hidden");
      }

      // Check session state - default is docked (unless explicitly marked floating)
      const isFloating = sessionStorage.getItem("audio-widget-docked") === "false";
      const savedLeft = sessionStorage.getItem("audio-widget-left");
      const savedTop = sessionStorage.getItem("audio-widget-top");

      if (isFloating && savedLeft && savedTop) {
        floatWidget(parseFloat(savedLeft), parseFloat(savedTop));
      } else {
        dockWidget();
      }
    }
  }

  // Initialize immediately and on view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAudioWidget);
  } else {
    initAudioWidget();
  }
  document.addEventListener("astro:page-load", initAudioWidget);
</script>

<style>
  /* Base widget wrapper styles */
  .audio-widget-wrapper {
    width: 48px;
    height: 48px;
    z-index: 100;
    font-family: inherit;
    touch-action: none;
    position: relative;
  }

  /* Position when docked in placeholder */
  .audio-widget-wrapper.docked {
    position: relative !important;
    left: auto !important;
    top: auto !important;
    right: auto !important;
    bottom: auto !important;
    z-index: 10;
    width: 48px;
    height: 48px;
  }

  /* Position when floating */
  .audio-widget-wrapper.floating {
    position: fixed !important;
    z-index: 1000;
    width: 48px;
    height: 48px;
  }

  /* Mini Circular Toggle Trigger */
  .widget-toggle-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-bg-elevated, rgba(255, 255, 255, 0.85));
    border: 1px solid var(--color-project-accent-border, rgba(255, 125, 26, 0.2));
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
