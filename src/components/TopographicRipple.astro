---
/**
 * TopographicRipple.astro
 * Renders an interactive topographic contour background using Marching Squares.
 */
interface Props {
  source?: 'earth' | 'mars-olympus' | 'mars-gale' | 'mars-procedural';
  lat?: number;
  lng?: number;
  intensity?: number;
  scale?: number;
  color?: string; // Hex code or CSS variable
  isAbsolute?: boolean;
}

const {
  source = 'mars-procedural',
  lat = 0,
  lng = 0,
  intensity = 1.0,
  scale = 1.0,
  color = 'var(--color-project-accent, var(--color-primary))',
  isAbsolute = false,
} = Astro.props;
---

<div
  class={`topography-container ${isAbsolute ? 'is-absolute' : 'is-fixed'}`}
  data-source={source}
  data-lat={lat}
  data-lng={lng}
  data-intensity={intensity}
  data-scale={scale}
  data-color={color}
  aria-hidden="true"
>
  <canvas class="topo-canvas"></canvas>
</div>

<style>
  .topography-container {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.2;
    background: transparent;
    transition: opacity 0.3s ease;
  }

  .topography-container.is-fixed {
    position: fixed;
  }

  .topography-container.is-absolute {
    position: absolute;
  }

  :global(.dark) .topography-container {
    opacity: 0.5;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { getElevationGrid } from '../utils/topoData';
  import { createCanvasMotionController, type CanvasMotionController, type CanvasMotionState } from '../utils/canvasMotion';

  const activeRenderers: TopoRenderer[] = [];

  class TopoRenderer {
    container: HTMLElement;
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    grid: number[][] = [];
    rippleGrid: number[][] = [];
    gridSize = 40;
    cellSize = 0;
    width = 0;
    height = 0;

    mouseX = -9999;
    mouseY = -9999;
    targetMouseX = -9999;
    targetMouseY = -9999;
    resolvedColor = '#FF7D1A';
    destroyed = false;
    motion: CanvasMotionController | null = null;
    source = 'mars-procedural';
    lat = 0;
    lng = 0;
    intensity = 1.0;
    scale = 1.0;
    onResize: () => void;
    onMouseMove: (e: MouseEvent) => void;

    constructor(container: HTMLElement) {
      this.container = container;
      this.canvas = container.querySelector('canvas')!;
      this.ctx = this.canvas.getContext('2d', { alpha: true })!;
      this.source = container.dataset.source || 'mars-procedural';
      this.lat = parseFloat(container.dataset.lat || '0');
      this.lng = parseFloat(container.dataset.lng || '0');
      this.intensity = parseFloat(container.dataset.intensity || '1.0');
      this.scale = parseFloat(container.dataset.scale || '1.0');

      this.onResize = () => {
        this.resize();
        if (this.grid.length > 0) this.draw();
      };
      this.onMouseMove = (e: MouseEvent) => {
        const rect = this.canvas.getBoundingClientRect();
        this.targetMouseX = e.clientX - rect.left;
        this.targetMouseY = e.clientY - rect.top;
      };

      window.addEventListener('resize', this.onResize);
      window.addEventListener('mousemove', this.onMouseMove);

      this.resolveColor();

      this.motion = createCanvasMotionController(container, {
        threshold: 0.05,
        onThemeChange: () => {
          this.resolveColor();
          if (this.grid.length > 0) this.draw();
        },
        step: (_nowMs, deltaMs, state) => this.stepFrame(deltaMs, state),
      });

      (container as any).__topoController = {
        setParams: async (params: { source?: string; intensity?: number; scale?: number; lat?: number; lng?: number }) => {
          let reloadGrid = false;
          if (typeof params.intensity === 'number') this.intensity = Math.max(0.1, Math.min(5, params.intensity));
          if (typeof params.scale === 'number' && params.scale !== this.scale) {
            this.scale = Math.max(0.1, Math.min(10, params.scale));
            reloadGrid = true;
          }
          if (params.source && params.source !== this.source) {
            this.source = params.source;
            reloadGrid = true;
          }
          if (typeof params.lat === 'number' && params.lat !== this.lat) {
            this.lat = params.lat;
            reloadGrid = true;
          }
          if (typeof params.lng === 'number' && params.lng !== this.lng) {
            this.lng = params.lng;
            reloadGrid = true;
          }
          if (reloadGrid) {
            await this.init();
          } else if (this.grid.length > 0) {
            this.draw();
          }
        },
        togglePaused: () => this.motion?.togglePaused() ?? false,
        getState: () => ({
          source: this.source,
          intensity: this.intensity,
          scale: this.scale,
          lat: this.lat,
          lng: this.lng,
          motion: this.motion?.getState(),
        }),
      };

      this.init();
    }

    resolveColor() {
      const raw = this.container.dataset.color || 'var(--color-project-accent, var(--color-primary))';
      if (!raw.includes('var(')) {
        this.resolvedColor = raw;
        return;
      }
      const styles = getComputedStyle(this.container);
      const accent =
        styles.getPropertyValue('--color-project-accent').trim() ||
        styles.getPropertyValue('--color-primary').trim() ||
        '#FF7D1A';
      this.resolvedColor = accent;
    }

    async init() {
      try {
        this.grid = await getElevationGrid({
          source: this.source as any,
          latitude: this.lat,
          longitude: this.lng,
          gridSize: this.gridSize,
          scale: this.scale,
        });
      } catch {
        // Fallback handled in util
      }

      if (this.destroyed || !document.contains(this.canvas)) return;

      this.rippleGrid = Array(this.gridSize)
        .fill(0)
        .map(() => Array(this.gridSize).fill(0));

      this.resize();
      if (this.grid.length > 0) {
        this.draw();
      }
      this.motion?.kick();
    }

    resize() {
      this.width = this.container.clientWidth || window.innerWidth;
      this.height = this.container.clientHeight || window.innerHeight;
      this.canvas.width = this.width;
      this.canvas.height = this.height;
      this.cellSize = Math.max(this.width, this.height) / (this.gridSize - 1);
    }

    stepFrame(deltaMs: number, state: CanvasMotionState) {
      if (this.destroyed || !document.contains(this.canvas)) {
        this.destroy();
        return;
      }
      if (this.grid.length === 0) return;

      const interpRate = Math.min(1, 0.1 * (deltaMs / 16.67) * state.speedMultiplier + 0.02);
      if (this.targetMouseX > -9000) {
        this.mouseX += (this.targetMouseX - this.mouseX) * interpRate;
        this.mouseY += (this.targetMouseY - this.mouseY) * interpRate;
      }

      this.updateRipples(deltaMs, state);
      this.draw();
    }

    updateRipples(deltaMs: number, state: CanvasMotionState) {
      const mouseCol = Math.floor(this.mouseX / this.cellSize);
      const mouseRow = Math.floor(this.mouseY / this.cellSize);
      const radius = 5;
      const decay = Math.pow(0.95, Math.max(0.2, deltaMs / 16.67) * state.speedMultiplier);

      for (let y = 0; y < this.gridSize; y++) {
        for (let x = 0; x < this.gridSize; x++) {
          this.rippleGrid[y][x] *= decay;

          const dx = x - mouseCol;
          const dy = y - mouseRow;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < radius) {
            this.rippleGrid[y][x] += (radius - dist) * 2 * state.cursorMultiplier;
          }
        }
      }
    }

    getContourValue(x: number, y: number) {
      if (x < 0 || y < 0 || x >= this.gridSize || y >= this.gridSize) return 0;
      return (this.grid[y]?.[x] ?? 0) + (this.rippleGrid[y]?.[x] ?? 0);
    }

    draw() {
      this.ctx.clearRect(0, 0, this.width, this.height);
      this.ctx.strokeStyle = this.resolvedColor;
      this.ctx.lineWidth = 1;

      const levels = 8;
      const intensity = Math.max(0.1, this.intensity);

      for (let l = 1; l <= levels; l++) {
        const threshold = l * (20 / intensity);
        this.ctx.beginPath();
        this.ctx.globalAlpha = 0.5 + (l / levels) * 0.5;

        for (let y = 0; y < this.gridSize - 1; y++) {
          for (let x = 0; x < this.gridSize - 1; x++) {
            this.drawMarchingSquare(x, y, threshold);
          }
        }
        this.ctx.stroke();
      }
      this.ctx.globalAlpha = 1.0;
    }

    drawMarchingSquare(x: number, y: number, threshold: number) {
      const v1 = this.getContourValue(x, y);
      const v2 = this.getContourValue(x + 1, y);
      const v3 = this.getContourValue(x + 1, y + 1);
      const v4 = this.getContourValue(x, y + 1);

      let config = 0;
      if (v1 >= threshold) config += 8;
      if (v2 >= threshold) config += 4;
      if (v3 >= threshold) config += 2;
      if (v4 >= threshold) config += 1;

      const px = x * this.cellSize;
      const py = y * this.cellSize;
      const s = this.cellSize;

      const lerp = (v_a: number, v_b: number, t: number) => {
        const diff = v_b - v_a;
        return diff === 0 ? 0.5 : (t - v_a) / diff;
      };

      const top = { x: px + s * lerp(v1, v2, threshold), y: py };
      const right = { x: px + s, y: py + s * lerp(v2, v3, threshold) };
      const bottom = { x: px + s * lerp(v4, v3, threshold), y: py + s };
      const left = { x: px, y: py + s * lerp(v1, v4, threshold) };

      switch (config) {
        case 1:
        case 14:
          this.line(left, bottom);
          break;
        case 2:
        case 13:
          this.line(bottom, right);
          break;
        case 3:
        case 12:
          this.line(left, right);
          break;
        case 4:
        case 11:
          this.line(top, right);
          break;
        case 5:
          this.line(top, left);
          this.line(right, bottom);
          break;
        case 6:
        case 9:
          this.line(top, bottom);
          break;
        case 7:
        case 8:
          this.line(top, left);
          break;
        case 10:
          this.line(top, right);
          this.line(left, bottom);
          break;
      }
    }

    line(p1: { x: number; y: number }, p2: { x: number; y: number }) {
      this.ctx.moveTo(p1.x, p1.y);
      this.ctx.lineTo(p2.x, p2.y);
    }

    destroy() {
      if (this.destroyed) return;
      this.destroyed = true;
      this.motion?.destroy();
      this.motion = null;
      window.removeEventListener('resize', this.onResize);
      window.removeEventListener('mousemove', this.onMouseMove);
      this.container.removeAttribute('data-initialized');
    }
  }

  function cleanupTopoRenderers() {
    while (activeRenderers.length > 0) {
      activeRenderers.pop()?.destroy();
    }
  }

  document.addEventListener('astro:before-swap', cleanupTopoRenderers);
  document.addEventListener('astro:page-load', () => {
    cleanupTopoRenderers();
    const containers = document.querySelectorAll('.topography-container');
    containers.forEach((c) => {
      if (!c.hasAttribute('data-initialized')) {
        c.setAttribute('data-initialized', 'true');
        activeRenderers.push(new TopoRenderer(c as HTMLElement));
      }
    });
  });
</script>
