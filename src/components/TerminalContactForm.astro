---
// src/components/TerminalContactForm.astro
import rawAscii from "./aperture-logo.txt?raw";

// Define the structure of the translations prop
interface TerminalTranslations {
  title: string;
  welcome1: string;
  welcome2: string;
  promptName: string;
  promptEmail: string;
  promptMessageInfo: string;
  editorInfo: string;
  promptConfirm: string;
  errorName: string;
  errorEmail: string;
  errorMessage: string;
  errorConfirm: string;
  errorSending: string; // Template string
  sending: string;
  sentSuccess: string;
  cancelled: string;
  editInfo: string;
  endPrompt: string;
  exitMessage: string;
  confirmDetails: string;
  confirmName: string;
  confirmEmail: string;
  confirmMessage: string;
  confirmEnd: string;
  sendButton: string;
}

interface Props {
  translations: TerminalTranslations;
  projects?: any[];
  currentLocale?: string;
}

const { translations, projects = [], currentLocale = "en" } = Astro.props;

// --- Process ASCII Art File ---
let apertureAsciiProcessed: string[] = ["Error: ASCII Art file not found."]; // Default error message
try {
  apertureAsciiProcessed = rawAscii
    .split("\n")
    .map((line) => (line.trim() === "" ? "" : line.replace(/ /g, "&nbsp;")));
} catch (error) {
  console.error("Error processing ASCII art file:", error);
}
// --- End ASCII Art Processing ---

// Prepare data for the client-side script
const translationsJson = JSON.stringify(translations);
const apertureAsciiJson = JSON.stringify(apertureAsciiProcessed);
const projectsJson = JSON.stringify(projects.map(p => ({ title: p.title, slug: p.slug?.current || p.slug })));
---

{/* --- Added 'dark' class to force dark mode --- */}
<div
  class="component-terminal-wrapper dark flex items-center justify-center w-full p-2 sm:p-4"
>
  {/* Add padding for small screens */}
  {
    /* --- MODIFIED: Changed position to fixed for better dragging context --- */
  }
  <div id="terminal" class="terminal-window">
    {/* --- MODIFIED: Added id to header --- */}
    <div id="terminal-header" class="terminal-header">
      <span class="header-title"
        >{translations.title || "Contact Terminal"}</span
      >
    </div>
    {/* --- Container for output content vs power button --- */}
    <div id="output-container" class="terminal-output-container">
      <canvas id="terminal-matrix-canvas" class="matrix-canvas hidden"></canvas>
      <div id="output" class="terminal-output"></div>
      {/* Power button will be added here by JS */}
    </div>
    <div id="input-area" class="input-area-container">
      {/* Command Line Input */}
      <div id="input-line" class="terminal-input-line focused">
        {/* Prompt text and color set by JS */}
        <span id="prompt" class="prompt prompt-hostname"></span>
        {/* Added prompt-hostname class */}
        <div class="input-wrapper">
          <div id="input-display" class="input-display"></div>
          <input
            type="text"
            id="commandInput"
            class="terminal-input"
            autocomplete="off"
          />
        </div>
      </div>
      {/* Text Area for Message */}
      <div
        id="message-editor"
        class="message-editor-container"
        style="display: none;"
      >
        <div class="editor-info-bar">
          {
            translations.editorInfo ||
              "Enter message (Ctrl+Enter or Button to Send)"
          }
        </div>
        <textarea id="messageInput" class="message-textarea"></textarea>
        <button id="sendButton" class="send-button">
          {translations.sendButton || "Send"}
        </button>
      </div>
    </div>
    {/* --- ADDED: Resize Handle --- */}
    <div id="resize-handle" class="resize-handle"></div>
  </div>
</div>

<style is:global>
  /* Apply Fira Code font specifically to the terminal wrapper */
  .component-terminal-wrapper {
    font-family: "Fira Code", monospace;
  }

  /* Styles for the floating terminal window */
  .terminal-window {
    /* Use fixed positioning by default, but allow override (e.g. for homepage anchoring) */
    position: var(--terminal-position, fixed);
    background-color: var(--term-bg, var(--color-border));
    border: 1px solid var(--term-border, var(--color-accent));
    color: var(--term-text, var(--color-text));
    border-radius: 0.5rem; /* rounded-lg */
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    overflow: hidden; /* Important for containing elements */
    display: flex;
    flex-direction: column;
    font-size: 0.875rem; /* text-sm */
    line-height: 1.25rem;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.2s ease; /* Added transition for shadow */
    z-index: 100; /* Ensure it's above other content */
    min-width: 320px;
    min-height: 250px;
  }
  /* Style when dragging */
  .terminal-window.dragging {
    cursor: grabbing;
    user-select: none; /* Prevent text selection during drag */
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4); /* Enhance shadow when dragging */
  }

  /* --- Force Dark Mode Styles --- */
  .dark .terminal-window {
    background-color: var(--term-bg, var(--color-border));
    border-color: var(--term-border, var(--color-accent));
    color: var(--term-text, var(--color-text));
  }

  /* --- Terminal Theme Definitions --- */
  .terminal-window.theme-classic {
    --term-bg: #030a05;
    --term-text: #39ff14;
    --term-accent: #00ff66;
    --term-border: #004411;
  }
  .terminal-window.theme-amber {
    --term-bg: #0c0600;
    --term-text: #ffb000;
    --term-accent: #ffd700;
    --term-border: #663300;
  }
  .terminal-window.theme-cyberpunk {
    --term-bg: #0b0214;
    --term-text: #00f0ff;
    --term-accent: #ff007f;
    --term-border: #4a0e4e;
  }
  .terminal-window.theme-solar {
    --term-bg: #0f0200;
    --term-text: #ff6600;
    --term-accent: #ffb700;
    --term-border: #6b0000;
  }

  /* --- Scanlines CRT Effect --- */
  .terminal-window.scanlines::after {
    content: " ";
    display: block;
    position: absolute;
    top: 0; left: 0; bottom: 0; right: 0;
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%,
      rgba(0, 0, 0, 0.15) 50%
    );
    background-size: 100% 4px;
    z-index: 99;
    pointer-events: none;
    opacity: 0.4;
  }
  .terminal-window.scanlines {
    animation: terminal-flicker 0.15s infinite;
  }
  @keyframes terminal-flicker {
    0% { opacity: 0.995; }
    50% { opacity: 1; }
    100% { opacity: 0.995; }
  }
  .dark .terminal-header {
    background-color: rgba(0, 0, 0, 0.25);
    border-bottom: 1px solid var(--term-border, rgba(255, 255, 255, 0.1));
    color: var(--term-text, var(--color-text));
    cursor: grab; /* Cursor for dragging */
  }
  .dark .input-area-container {
    border-top: 1px solid var(--term-border, rgba(255, 255, 255, 0.1));
  }
  .dark .editor-info-bar {
    background-color: rgba(0, 0, 0, 0.3);
    color: var(--term-accent, var(--color-secondary));
    border-bottom: 1px solid var(--term-border, rgba(255, 255, 255, 0.05));
  }
  .dark .terminal-output::-webkit-scrollbar-thumb {
    background-color: var(--color-secondary);
    border: 2px solid var(--color-border);
  }
  .dark .terminal-output::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-text);
  }
  .dark .message-textarea::-webkit-scrollbar-thumb {
    background-color: var(--color-secondary);
  }
  @keyframes blink {
    from,
    to {
      background-color: transparent;
      color: inherit;
    }
    50% {
      background-color: var(--term-accent, var(--color-text));
      color: var(--term-bg, var(--color-border));
    }
  }

  /* Header Style */
  .terminal-header {
    padding: 0.5rem 0.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    user-select: none; /* Prevent text selection on header title */
  }
  .header-title {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    pointer-events: none; /* Ensure clicks go to header */
  }

  /* Styles for the output container */
  .terminal-output-container {
    flex-grow: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .matrix-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 80;
    background-color: #000000;
  }
  .matrix-canvas.hidden {
    display: none !important;
  }

  /* Terminal Output Area */
  .terminal-output {
    flex-grow: 1;
    padding: 1rem;
    overflow-y: auto;
    min-height: 100px;
    transition: opacity 0.3s ease;
    opacity: 1;
  }
  .terminal-output.hidden {
    opacity: 0;
    overflow-y: hidden;
  }

  /* Input Area Styles */
  .input-area-container {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    opacity: 1;
    visibility: visible;
  }
  .input-area-container.hidden {
    opacity: 0;
    visibility: hidden;
  }

  /* Normal Command Input Line */
  .terminal-input-line {
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    background-color: var(--term-bg, var(--color-border));
    transition: background-color 0.3s ease;
  }
  .input-wrapper {
    position: relative;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }
  .input-display {
    pointer-events: none;
    white-space: pre-wrap;
    word-break: break-all;
    font-family: inherit;
    font-size: inherit;
    color: var(--term-text, inherit);
    width: 100%;
    padding: 0;
    margin: 0;
    line-height: inherit;
  }
  .input-display .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.25em;
    background-color: var(--term-accent, var(--color-text));
    color: var(--term-bg, var(--color-border));
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
  }
  .input-display .cursor-inactive {
    display: inline-block;
    width: 0.6em;
    height: 1.25em;
    outline: 1px solid var(--term-accent, var(--color-text));
    color: inherit;
    vertical-align: text-bottom;
  }
  .input-display .text-selected {
    background-color: var(--term-accent, var(--color-text));
    color: var(--term-bg, var(--color-border));
  }
  .terminal-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    border: none;
    outline: none;
    color: transparent !important;
    caret-color: transparent !important;
    padding: 0;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }
  .terminal-window .prompt {
    font-weight: bold;
    white-space: pre;
    margin-right: 0.5em;
    /* Color set by JS */
  }

  /* Message Editor Styles */
  .message-editor-container {
    background-color: var(--term-bg, var(--color-border));
    display: flex;
    flex-direction: column;
    min-height: 200px;
    transition: background-color 0.3s ease;
    outline: none;
    transition: outline 0.2s ease-in-out;
    position: relative;
    padding-bottom: 2.5rem;
  }
  .terminal-window .editor-info-bar {
    font-size: 0.7rem;
    padding: 0.25rem 1rem;
    text-align: center;
    flex-shrink: 0;
  }
  .terminal-window .message-textarea {
    flex-grow: 1;
    background-color: transparent;
    border: none;
    outline: none;
    resize: none;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    padding: 0.5rem 1rem;
    width: 100%;
    box-sizing: border-box;
    caret-color: var(--color-text);
    min-height: 150px;
  }
  .terminal-window .message-textarea::-webkit-scrollbar {
    width: 6px;
  }
  .terminal-window .message-textarea::-webkit-scrollbar-track {
    background: transparent;
  }
  .terminal-window .message-textarea::-webkit-scrollbar-thumb {
    border-radius: 3px;
  }

  /* Send Button Style */
  .terminal-window .send-button {
    position: absolute;
    bottom: 0.5rem;
    right: 1rem;
    background-color: var(--color-primary);
    color: white;
    border: none;
    padding: 0.3rem 0.8rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
    z-index: 3;
  }
  .terminal-window .send-button:hover,
  .terminal-window .send-button:focus {
    opacity: 0.9;
  }
  .terminal-window .send-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Output line styles */
  .terminal-window .output-line {
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--term-text, var(--color-text)); /* Default text color */
    margin-bottom: 0.25rem;
    display: flex;
  }
  .terminal-window .output-line .line-prefix {
    color: var(--term-accent, var(--color-primary)); /* Prefix color */
    font-weight: bold;
    white-space: pre;
    flex-shrink: 0;
    margin-right: 0.5em;
  }
  .output-line .line-text {
    flex-grow: 1;
    /* Text color is inherited from .output-line -> .terminal-window */
  }
  .error-text {
    color: var(--term-error, #f44747);
  }
  .success-text {
    color: var(--term-accent, var(--color-accent));
  }
  .user-input-text {
    /* Default color (inherited) */
  }

  /* ASCII Art style */
  .ascii-art {
    white-space: pre !important;
    line-height: 1.1;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
  .ascii-art .line-prefix {
    display: none;
  }
  .ascii-art .line-text {
    white-space: pre !important;
    color: var(--term-accent, var(--color-primary));
  }

  /* Scrollbar styling */
  .terminal-output::-webkit-scrollbar {
    width: 8px;
  }
  .terminal-output::-webkit-scrollbar-track {
    background: transparent;
  }
  .terminal-output::-webkit-scrollbar-thumb {
    border-radius: 4px;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  /* --- Power Button Style --- */
  .power-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: rgba(var(--color-primary-rgb), 0.1);
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    display: flex; /* Use flex to center SVG */
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
    box-shadow: 0 0 10px rgba(var(--color-primary-rgb), 0.3);
  }

  /* CRT Turn Off Animation Classes */
  @keyframes turn-off-x {
    0% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0.005);
    }
  }

  @keyframes turn-off-y {
    0% {
      transform: scaleY(1);
      height: 100%;
    }
    100% {
      transform: scaleY(0.005);
      height: 100%;
    }
  }

  .crt-off {
    animation:
      turn-off-y 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards,
      turn-off-x 0.4s 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  /* When terminal is "off", it looks like a dead screen */
  .terminal-off-state {
    background-color: #050505 !important; /* Very dark screen */
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
    position: relative;
    overflow: hidden; /* Hide content */
  }

  /* Hide internal elements when off */
  .terminal-off-state > *:not(.power-button) {
    display: none !important;
  }

  .power-button.visible {
    opacity: 1;
    visibility: visible;
  }
  .power-button:hover {
    background-color: rgba(var(--color-primary-rgb), 0.2);
    box-shadow: 0 0 20px rgba(var(--color-primary-rgb), 0.6);
  }
  .power-button:active {
    transform: translate(-50%, -50%) scale(0.95);
  }
  .power-button svg {
    width: 50%;
    height: 50%;
    fill: currentColor;
  }

  /* Resize Handle Styles */
  .resize-handle {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 15px;
    height: 15px;
    cursor: se-resize;
    /* Visual indicator for resize handle */
    background: linear-gradient(
      135deg,
      transparent 50%,
      rgba(var(--color-primary-rgb), 0.5) 50%
    );
    border-bottom-right-radius: 0.375rem; /* Match container radius */
    z-index: 101; /* Above terminal content */
    transition: background-color 0.2s ease;
  }
  .resize-handle:hover {
    background-color: rgba(var(--color-accent-rgb), 0.8);
  }

  /* Responsive Adjustments */
  @media (max-width: 640px) {
    .ascii-art {
      display: none;
    }
    .terminal-window {
      width: 100% !important;
      height: 100% !important;
      border: none;
      border-radius: 0;
      box-shadow: none;
      transform: none !important;
      top: 0 !important;
      left: 0 !important;
      position: relative !important;
      font-size: 0.8rem;
    }
    .resize-handle {
      display: none !important;
    }
    .terminal-input-line,
    .message-textarea {
      padding: 0.6rem 0.8rem;
    }
    .output-line {
      margin-bottom: 0.15rem;
    }
    .message-editor-container {
      min-height: 150px;
    }
    .message-textarea {
      min-height: 100px;
    }
  }
</style>

{/* src/components/TerminalContactForm.astro */}
{
  /* --- Frontmatter (Astro props, imports, translationsJson, apertureAsciiJson) remains the same as in your initial project overview --- */
}
<script is:inline define:vars={{ translationsJson, apertureAsciiJson, projectsJson, currentLocale }}>
  // At the VERY TOP of the <script define:vars={{...}}> block:
  console.log(
    "TerminalContactForm Script: Parsed and waiting for DOM/Astro events.",
  );
  // @ts-ignore
  const projects = JSON.parse(projectsJson);
  // @ts-ignore
  const currentLang = currentLocale;

  let currentTerminalCleanup = null;
  let currentWindowResizeHandler = null;
  let initAttemptIdCounter = 0; // Counter for runTerminalSetup attempts

  // Constants
  const HOSTNAME = "GLaDOS";
  const HOSTNAME_SEPARATOR = "~";
  const PROMPT_SYMBOL = "> ";
  const CONFIRM_PROMPT_SYMBOL = "? ";
  const HOSTNAME_PREFIX = `${HOSTNAME}${HOSTNAME_SEPARATOR} `;
  const SMALL_SCREEN_WIDTH = 640;
  const ASCII_LINE_DELAY = 50;
  const POWER_BUTTON_ID = "power-on-btn";
  const MIN_TERMINAL_WIDTH = 320;
  const MIN_TERMINAL_HEIGHT = 250;
  const TOP_BAR_HEIGHT = 60;

  function runTerminalSetup() {
    const currentAttemptId = ++initAttemptIdCounter;
    console.log(
      `TerminalContactForm Script: runTerminalSetup() called. Attempt ID: ${currentAttemptId}`,
    );

    if (typeof currentTerminalCleanup === "function") {
      console.log(
        `[Attempt ${currentAttemptId}] TerminalContactForm Script: Running cleanup for a previous terminal instance's listeners.`,
      );
      currentTerminalCleanup();
      currentTerminalCleanup = null;
    }
    if (typeof currentWindowResizeHandler === "function") {
      window.removeEventListener("resize", currentWindowResizeHandler);
      currentWindowResizeHandler = null;
    }

    const terminalElement = document.getElementById("terminal");
    if (!terminalElement) {
      console.log(
        `[Attempt ${currentAttemptId}] TerminalContactForm Script: Terminal element (id='terminal') not found. No setup will occur.`,
      );
      return;
    }

    console.log(
      `[Attempt ${currentAttemptId}] Checking terminal.dataset.terminalInitialized: '${terminalElement.dataset.terminalInitialized}', current DOM terminalInstanceId: '${terminalElement.dataset.terminalInstanceId}'`,
    );
    if (terminalElement.dataset.terminalInitialized === "true") {
      console.log(
        `[Attempt ${currentAttemptId}] This terminal DOM instance (initialized by attempt ${terminalElement.dataset.terminalInstanceId}) is already marked as initialized. Skipping full re-initialization.`,
      );
      return;
    }

    console.log(
      `[Attempt ${currentAttemptId}] Proceeding with new terminal initialization logic.`,
    );
    terminalElement.dataset.terminalInstanceId = currentAttemptId;

    // Restore saved terminal theme
    const savedTheme = localStorage.getItem("terminal_theme") || "classic";
    terminalElement.classList.remove("theme-classic", "theme-amber", "theme-cyberpunk", "theme-solar");
    terminalElement.classList.add(`theme-${savedTheme}`);

    // Restore saved scanlines
    const savedScanlines = localStorage.getItem("terminal_scanlines") !== "false";
    if (savedScanlines) {
      terminalElement.classList.add("scanlines");
    } else {
      terminalElement.classList.remove("scanlines");
    }

    let localTranslations;
    try {
      if (
        typeof translationsJson === "undefined" ||
        translationsJson === null
      ) {
        throw new Error(
          "translationsJson variable from define:vars is undefined or null.",
        );
      }
      localTranslations = JSON.parse(translationsJson);
      if (typeof localTranslations !== "object" || localTranslations === null) {
        throw new Error("Parsed translations is not an object or is null.");
      }
    } catch (error) {
      console.error(
        `[Attempt ${currentAttemptId}] CRITICAL: Error processing translations JSON for terminal. translationsJson type: ${typeof translationsJson}. Error:`,
        error.message,
      );
      const outputDiv = document.getElementById("output");
      if (outputDiv) {
        outputDiv.innerHTML =
          '<div class="output-line error-text">Error: Terminal configuration data (translations) is corrupted or unavailable. Please refresh.</div>';
      }
      return;
    }

    let localApertureAscii = ["ASCII Art Error: Data not loaded"];
    try {
      if (
        typeof apertureAsciiJson === "undefined" ||
        apertureAsciiJson === null
      ) {
        console.warn(
          `[Attempt ${currentAttemptId}] apertureAsciiJson variable from define:vars is undefined or null. Proceeding without custom ASCII art.`,
        );
      } else {
        localApertureAscii = JSON.parse(apertureAsciiJson);
        if (!Array.isArray(localApertureAscii)) {
          throw new Error("Parsed ASCII art not an array.");
        }
      }
    } catch (error) {
      console.error(
        `[Attempt ${currentAttemptId}] Error parsing ASCII art JSON for terminal. Error:`,
        error.message,
      );
    }

    terminalElement.dataset.terminalInitialized = "true";
    console.log(
      `[Attempt ${currentAttemptId}] Set terminal.dataset.terminalInitialized to 'true'. DOM terminalInstanceId is ${terminalElement.dataset.terminalInstanceId}.`,
    );

    console.log(
      `[Attempt ${currentAttemptId}] Calling initializeTerminalContact().`,
    );
    initializeTerminalContact(
      localTranslations,
      localApertureAscii,
      currentAttemptId,
    );
  }

  function initializeTerminalContact(translations, apertureAscii, initId) {
    console.log(
      `[Attempt ${initId}] TerminalContactForm Script: initializeTerminalContact() started.`,
    );

    const terminalWindow = document.getElementById("terminal");
    const terminalHeader = document.getElementById("terminal-header");
    const outputContainer = document.getElementById("output-container");
    const output = document.getElementById("output");
    const inputAreaContainer = document.getElementById("input-area");
    const inputLine = document.getElementById("input-line");
    const promptElement = document.getElementById("prompt");
    const commandInput = document.getElementById("commandInput");
    const inputDisplay = document.getElementById("input-display");
    const messageEditorContainer = document.getElementById("message-editor");
    const messageInput = document.getElementById("messageInput");
    const sendButton = document.getElementById("sendButton");
    const resizeHandle = document.getElementById("resize-handle");

    const essentialElements = {
      terminalWindow,
      terminalHeader,
      outputContainer,
      output,
      inputAreaContainer,
      inputLine,
      promptElement,
      commandInput,
      inputDisplay,
      messageEditorContainer,
      messageInput,
      sendButton,
      resizeHandle,
    };
    for (const key in essentialElements) {
      if (!essentialElements[key]) {
        console.error(
          `[Attempt ${initId}] TerminalContactForm Script: Essential DOM element '${key}' not found. Aborting initialization.`,
        );
        if (output) {
          output.innerHTML = `<div class="output-line error-text">Error: A critical UI part of the terminal is missing (${key}). Try refreshing.</div>`;
        } else if (terminalWindow) {
          terminalWindow.innerHTML = `<div style="padding:1rem; color:red;">Error: Terminal structure incomplete (${key}). Please refresh.</div>`;
        }
        if (terminalWindow) delete terminalWindow.dataset.terminalInitialized; // Allow re-init if possible
        return;
      }
    }

    let currentStep = 0;
    const formData = { name: "", email: "", message: "" };
    let isTyping = false;
    let isSending = false;
    let isExited = false;
    
    function updateInputDisplay() {
      if (!commandInput || !inputDisplay) return;
      const text = commandInput.value;
      const selStart = commandInput.selectionStart ?? text.length;
      const selEnd = commandInput.selectionEnd ?? text.length;
      const isFocused = document.activeElement === commandInput;

      const escape = (str) =>
        str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");

      if (selStart === selEnd) {
        const before = text.substring(0, selStart);
        const under = text.substring(selStart, selStart + 1) || " ";
        const after = text.substring(selStart + 1);

        const beforeEscaped = escape(before);
        const underEscaped = under === " " ? "&nbsp;" : escape(under);
        const afterEscaped = escape(after);

        const cursorClass = isFocused ? "cursor" : "cursor-inactive";
        inputDisplay.innerHTML = `${beforeEscaped}<span class="${cursorClass}">${underEscaped}</span>${afterEscaped}`;
      } else {
        const before = text.substring(0, selStart);
        const selected = text.substring(selStart, selEnd);
        const after = text.substring(selEnd);

        const beforeEscaped = escape(before);
        const selectedEscaped = escape(selected);
        const afterEscaped = escape(after);

        inputDisplay.innerHTML = `${beforeEscaped}<span class="text-selected">${selectedEscaped}</span>${afterEscaped}`;
      }
    }
    
    // Check if we are on a mobile device to prevent aggressive autofocusing
    let isMobile = false;
    try {
      isMobile = window.innerWidth <= 768 || ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
    } catch (e) {}

    let isDragging = false;
    let dragStartX, dragStartY, initialLeft, initialTop;
    let isResizing = false;
    let resizeStartX, resizeStartY, initialWidth, initialHeight;

    function getTerminalPosition() {
      const rect = terminalWindow.getBoundingClientRect();
      const parent = terminalWindow.offsetParent;
      if (!parent || parent === document.body || parent === document.documentElement) {
        return { left: rect.left, top: rect.top };
      }
      const parentRect = parent.getBoundingClientRect();
      return {
        left: rect.left - parentRect.left,
        top: rect.top - parentRect.top
      };
    }

    function setInitialPositionAndSize() {
      // If the terminal has been manually moved or resized, skip automatic centering/sizing
      if (terminalWindow.dataset.terminalInteracted === "true") return;

      const initialW = Math.min(768, window.innerWidth * 0.9);
      const vh = window.innerHeight;
      const initialH = Math.max(MIN_TERMINAL_HEIGHT, Math.min(650, vh * 0.75));
      terminalWindow.style.width = `${initialW}px`;
      terminalWindow.style.height = `${initialH}px`;
      const viewportHeight = window.innerHeight;
      const viewportWidth = window.innerWidth;
      let newTop = (viewportHeight - initialH) / 2;
      newTop = Math.max(TOP_BAR_HEIGHT, newTop);
      newTop = Math.min(newTop, viewportHeight - initialH - 5);
      let newLeft = (viewportWidth - initialW) / 2;
      newLeft = Math.max(5, newLeft);
      newLeft = Math.min(newLeft, viewportWidth - initialW - 5);
      terminalWindow.style.top = `${newTop}px`;
      terminalWindow.style.left = `${newLeft}px`;
      console.log(
        `[Attempt ${initId}] Initial position set - Top: ${newTop}px, Left: ${newLeft}px, Width: ${initialW}px, Height: ${initialH}px`,
      );
    }
    setInitialPositionAndSize();

    const requiredKeys = [
      "welcome1",
      "welcome2",
      "promptName",
      "promptEmail",
      "promptMessageInfo",
      "editorInfo",
      "promptConfirm",
      "errorName",
      "errorEmail",
      "errorMessage",
      "errorConfirm",
      "errorSending",
      "sending",
      "sentSuccess",
      "cancelled",
      "editInfo",
      "endPrompt",
      "exitMessage",
      "confirmDetails",
      "confirmName",
      "confirmEmail",
      "confirmMessage",
      "confirmEnd",
      "sendButton",
    ];
    const missingKeys = requiredKeys.filter(
      (key) => typeof translations[key] !== "string" || !translations[key],
    );
    if (missingKeys.length > 0) {
      console.error(
        `[Attempt ${initId}] Terminal initialization aborted due to missing translations for keys: ${missingKeys.join(", ")}`,
      );
      addOutputLine(
        `Configuration error: Missing required text for terminal operation (${missingKeys.join(", ")}).`,
        "error",
        false,
      );
      if (commandInput) commandInput.disabled = true;
      if (messageInput) messageInput.disabled = true;
      if (sendButton) sendButton.disabled = true;
      return;
    }

    const prompts = [
      "", // Step 0
      translations.promptName, // Step 1
      translations.promptEmail, // Step 2
      "", // Step 3 (message input, no direct prompt line)
      translations.promptConfirm, // Step 4
      translations.endPrompt, // Step 5
    ];

    function getPrefixText(type) {
      const isSmallScreen = window.innerWidth < SMALL_SCREEN_WIDTH;
      let prefix = "";
      if (type === "prompt" || type === "user") {
        prefix = (isSmallScreen ? "" : HOSTNAME_PREFIX) + PROMPT_SYMBOL;
      } else if (type === "prompt-secondary") {
        prefix = (isSmallScreen ? "" : HOSTNAME_PREFIX) + CONFIRM_PROMPT_SYMBOL;
      } else if (type !== "ascii" && type !== "info-no-prefix") {
        prefix = isSmallScreen ? "" : HOSTNAME_PREFIX;
      }
      return prefix;
    }

    function addOutputLine(text, type = "info", addPrefix = true) {
      if (!output || isExited) return;
      const line = document.createElement("div");
      line.classList.add("output-line");
      const prefixText =
        addPrefix && type !== "info-no-prefix" ? getPrefixText(type) : "";

      const prefixSpan = document.createElement("span");
      prefixSpan.className = "line-prefix";
      if (
        prefixText.includes(HOSTNAME) &&
        !(window.innerWidth < SMALL_SCREEN_WIDTH)
      ) {
        prefixSpan.classList.add("prompt-hostname-prefix");
      }
      prefixSpan.textContent = prefixText;
      line.appendChild(prefixSpan);

      const textSpan = document.createElement("span");
      textSpan.className = "line-text";

      if (type === "ascii") {
        if (
          window.innerWidth >= SMALL_SCREEN_WIDTH &&
          Array.isArray(apertureAscii) &&
          !apertureAscii[0].startsWith("Error")
        ) {
          line.classList.add("ascii-art");
          textSpan.innerHTML = text;
        } else {
          return;
        }
      } else if (type === "html") {
        textSpan.innerHTML = text;
      } else {
        const sanitizedText = String(text)
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
        switch (type) {
          case "error":
            textSpan.innerHTML = `<span class="error-text">Error: ${sanitizedText}</span>`;
            break;
          case "success":
            textSpan.innerHTML = `<span class="success-text">${sanitizedText}</span>`;
            break;
          case "user":
            textSpan.innerHTML = `<span class="user-input-text">${sanitizedText}</span>`;
            break;
          default:
            textSpan.textContent = sanitizedText;
            break;
        }
      }
      line.appendChild(textSpan);
      output.appendChild(line);
      scrollToBottom();
    }

    function typeWriter(text, callback, promptType = "prompt") {
      if (typeof text !== "string") text = String(text);
      if (!commandInput || !messageInput || !output || isExited) {
        if (callback) callback();
        return;
      }
      isTyping = true;
      if (commandInput) commandInput.readOnly = true;

      let i = 0;
      const speed = 30;
      const line = document.createElement("div");
      line.classList.add("output-line");

      const prefixText = getPrefixText(promptType);
      const prefixSpan = document.createElement("span");
      prefixSpan.className = "line-prefix";
      if (
        prefixText.includes(HOSTNAME) &&
        !(window.innerWidth < SMALL_SCREEN_WIDTH)
      ) {
        prefixSpan.classList.add("prompt-hostname-prefix");
      }
      prefixSpan.textContent = prefixText;
      line.appendChild(prefixSpan);

      const textSpan = document.createElement("span");
      textSpan.className = "line-text";
      line.appendChild(textSpan);
      output.appendChild(line);

      function type() {
        try {
          if (i < text.length && !isExited) {
            textSpan.textContent += text.charAt(i);
            i++;
            scrollToBottom();
            setTimeout(type, speed);
          } else {
            isTyping = false;
            if (
              !isExited &&
              (currentStep === 1 ||
                currentStep === 2 ||
                currentStep === 4 ||
                currentStep === 5)
            ) {
              if (commandInput) commandInput.readOnly = false;
            }
            if (callback && !isExited) callback();
          }
        } catch (error) {
          console.error(
            `[Attempt ${initId}] Error during typeWriter's type function:`,
            error,
          );
          isTyping = false;
          if (commandInput) commandInput.readOnly = false;
          if (callback && !isExited) callback();
        }
      }
      type();
    }

    function scrollToBottom() {
      setTimeout(() => {
        if (output && !output.classList.contains("hidden")) {
          output.scrollTo({ top: output.scrollHeight, behavior: "smooth" });
        }
      }, 10);
    }

    function updateCommandPrompt() {
      if (!promptElement || !inputLine || !commandInput || isExited) return;
      const isSmallScreen = window.innerWidth < SMALL_SCREEN_WIDTH;
      const currentPromptSymbol =
        currentStep === 4 ? CONFIRM_PROMPT_SYMBOL : PROMPT_SYMBOL;
      promptElement.textContent =
        (isSmallScreen ? "" : HOSTNAME_PREFIX) + currentPromptSymbol;
      promptElement.style.color = "var(--term-accent, var(--color-primary))";
      if (!isSmallScreen) promptElement.classList.add("prompt-hostname-prefix");
      else promptElement.classList.remove("prompt-hostname-prefix");

      if (document.activeElement === commandInput && !commandInput.disabled && !commandInput.readOnly) {
        inputLine.classList.add("focused");
      } else {
        inputLine.classList.remove("focused");
      }
    }

    function setInputMode(mode, shouldFocus = true) {
      if (
        !inputLine ||
        !messageEditorContainer ||
        !commandInput ||
        !messageInput ||
        isExited
      )
        return;
      if (mode === "editor") {
        inputLine.style.display = "none";
        messageEditorContainer.style.display = "flex";
        messageInput.value = formData.message;
        messageInput.disabled = false;
        commandInput.disabled = true;
        if (shouldFocus && !isMobile) {
          try {
            messageInput.focus({ preventScroll: true });
          } catch (e) {
            console.warn(`[Attempt ${initId}] Failed to focus messageInput`, e);
          }
        }
        setTimeout(() => {
          if (messageInput) messageInput.scrollTop = messageInput.scrollHeight;
        }, 10);
      } else {
        messageEditorContainer.style.display = "none";
        inputLine.style.display = "flex";
        commandInput.disabled = false;
        commandInput.readOnly = false;
        messageInput.disabled = true;
        if (shouldFocus && !isMobile) {
          try {
            commandInput.focus({ preventScroll: true });
          } catch (e) {
            console.warn(`[Attempt ${initId}] Failed to focus commandInput`, e);
          }
        }
      }
      updateCommandPrompt();
    }

    function triggerSendConfirmation() {
      // Allow execution if we are editing a VFS file, even if currentStep isn't 3
      if (
        (currentStep !== 3 && !formData._edTarget) ||
        isSending ||
        isTyping ||
        isExited
      )
        return;
      if (!messageInput || !translations || !messageEditorContainer) return;

      if (formData._edTarget) {
        // Save VFS file instead of message
        const file = getVfsItem(formData._edTarget);
        if (file && file.type === "file") {
          file.content = messageInput.value;
          addOutputLine(`Saved ${formData._edTarget.at(-1)}.`, "success");
        }
        delete formData._edTarget;
        setInputMode("command");
        return;
      }
      formData.message = messageInput.value.trim();
      if (!formData.message) {
        addOutputLine(
          translations.errorMessage || "Message cannot be empty.",
          "error",
        );
        messageEditorContainer.style.outline = "1px solid red";
        setTimeout(() => {
          if (messageEditorContainer) messageEditorContainer.style.outline = "";
        }, 1500);
        try {
          messageInput.focus({ preventScroll: true });
        } catch (e) {}
        return;
      }
      setInputMode("command");
      currentStep = 4;
      displayConfirmation();
    }

    function handleCommand(event) {
      if (
        isExited ||
        event.key !== "Enter" ||
        isTyping ||
        currentStep === 3 ||
        !commandInput ||
        commandInput.disabled ||
        commandInput.readOnly
      )
        return;
      event.preventDefault();
      const command = commandInput.value.trim();
      commandInput.value = "";
      updateInputDisplay();
      if (command) {
        addOutputLine(command, "user");
        processInput(command);
      } else {
        addOutputLine("", currentStep === 4 ? "prompt-secondary" : "prompt");
        if (!isTyping && currentStep !== 3 && currentStep < 5 && !isMobile) {
          try {
            commandInput.focus({ preventScroll: true });
          } catch (e) {}
        }
      }
      updateCommandPrompt();
    }

    function handleTextareaKeys(event) {
      if (isExited) return;
      if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
        event.preventDefault();
        triggerSendConfirmation();
      }
    }

    function focusCommandInput(isUserAction = false) {
      if (isMobile && !isUserAction) {
        updateCommandPrompt();
        return;
      }
      if (
        commandInput &&
        !isExited &&
        currentStep !== 3 &&
        !commandInput.disabled &&
        !commandInput.readOnly
      ) {
        try {
          if (document.activeElement !== commandInput) {
            commandInput.focus({ preventScroll: true });
          }
        } catch (e) {
          console.warn(`[Attempt ${initId}] Could not focus command input:`, e);
        }
      }
      updateCommandPrompt();
    }

    // --- Easter Egg: Virtual File System (VFS) ---
    const vfs = {
      type: "dir",
      name: "/",
      children: [
        {
          type: "file",
          name: "README.txt",
          content:
            "Welcome to the Aperture Science Secret Terminal.\nThis is a hidden segment of the interface.\nFeel free to explore the limited bash-like functionality.\nCommands: ls, cd, cat, help, clear, neofetch, whoami, ed",
        },
        {
          type: "dir",
          name: "usr",
          children: [
            {
              type: "file",
              name: "note.txt",
              content: "The cake is a lie.\n- Rattmann",
            },
            {
              type: "file",
              name: "credits.txt",
              content: "AI Assistant: Antigravity\nDeveloper: FaultierFlash",
            },
          ],
        },
        {
          type: "dir",
          name: "logs",
          children: [
            {
              type: "file",
              name: "system.log",
              content:
                "[2026-03-15 16:45:01] GLaDOS initialized.\n[2026-03-15 16:45:05] Neurotoxin emitters: ONLINE.\n[2026-03-15 16:45:10] Moral core: DISCONNECTED.",
            },
          ],
        },
      ],
    };
    let currentVfsPath = []; // Array of directory names

    function getVfsItem(pathArray) {
      let current = vfs;
      for (const segment of pathArray) {
        if (current.type !== "dir") return null;
        current = current.children.find((child) => child.name === segment);
        if (!current) return null;
      }
      return current;
    }

    // --- Typewriter Sound FX Engine ---
    function playTypewriterSound(isEnter = false) {
      if (localStorage.getItem("terminal_sound_fx") === "false") return;
      try {
        const AudioContextClass = window.AudioContext || window["webkitAudioContext"];
        const ctx = new AudioContextClass();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const filter = ctx.createBiquadFilter();

        filter.type = "highpass";
        filter.frequency.value = isEnter ? 600 : 1200;

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        if (isEnter) {
          osc.type = "triangle";
          osc.frequency.setValueAtTime(220, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(60, ctx.currentTime + 0.08);
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
          osc.start();
          osc.stop(ctx.currentTime + 0.08);
        } else {
          osc.type = "sine";
          osc.frequency.setValueAtTime(1000 + Math.random() * 500, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(250, ctx.currentTime + 0.03);
          gain.gain.setValueAtTime(0.03, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.03);
          osc.start();
          osc.stop(ctx.currentTime + 0.03);
        }
      } catch (e) {}
    }

    // --- Matrix Digital Rain Code Overlay ---
    let matrixInterval = null;
    let isMatrixMode = false;

    function startMatrixRain() {
      const canvas = document.getElementById("terminal-matrix-canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      canvas.classList.remove("hidden");
      isMatrixMode = true;

      // Set canvas size
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;

      const letters = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄ";
      const alphabet = letters.split("");

      const fontSize = 14;
      const columns = Math.floor(canvas.width / fontSize) + 1;

      const rainDrops = [];
      for (let x = 0; x < columns; x++) {
        rainDrops[x] = Math.random() * -100;
      }

      function draw() {
        ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Access the current active theme color
        let activeColor = "#39ff14"; // classic green
        const term = document.getElementById("terminal");
        if (term) {
          if (term.classList.contains("theme-amber")) activeColor = "#ffb000";
          else if (term.classList.contains("theme-cyberpunk")) activeColor = "#ff007f";
          else if (term.classList.contains("theme-solar")) activeColor = "#ff6600";
        }

        ctx.fillStyle = activeColor;
        ctx.font = fontSize + "px monospace";

        for (let i = 0; i < rainDrops.length; i++) {
          const text = alphabet[Math.floor(Math.random() * alphabet.length)];
          const x = i * fontSize;
          const y = rainDrops[i] * fontSize;

          ctx.fillText(text, x, y);

          if (y > canvas.height && Math.random() > 0.975) {
            rainDrops[i] = 0;
          }
          rainDrops[i]++;
        }
      }

      matrixInterval = setInterval(draw, 33);
    }

    function stopMatrixRain() {
      isMatrixMode = false;
      const canvas = document.getElementById("terminal-matrix-canvas");
      if (canvas) {
        canvas.classList.add("hidden");
      }
      if (matrixInterval) {
        clearInterval(matrixInterval);
        matrixInterval = null;
      }
    }

    function resolvePath(basePath, relativePathParts, isAbsolute) {
      let resolved = isAbsolute ? [] : [...basePath];
      for (const part of relativePathParts) {
        if (part === "" || part === ".") {
          continue;
        } else if (part === "..") {
          resolved.pop();
        } else {
          resolved.push(part);
        }
      }
      return resolved;
    }

    function handleTabComplete(event) {
      if (event.key !== "Tab" || isTyping || isExited || !commandInput) return;
      event.preventDefault(); // Stop focus change

      const val = commandInput.value;
      const cursorPosition = commandInput.selectionStart ?? val.length;
      const textBefore = val.substring(0, cursorPosition);
      const textAfter = val.substring(cursorPosition);

      const words = textBefore.trimStart().split(/\s+/);
      const isCommandWord = words.length <= 1 && !textBefore.endsWith(" ");

      if (currentStep === 3) {
        return; // No autocomplete in step 3 (message text area active)
      }

      let matches = [];
      let completionPrefix = "";

      if (currentStep === 4) {
        // Confirmation step
        const typed = words[0] || "";
        const options = ["yes", "no", "edit"];
        matches = options.filter(o => o.startsWith(typed.toLowerCase()));
        completionPrefix = typed;
      } else {
        // Command mode (Step 0, 1, 2, 5)
        if (isCommandWord) {
          const typed = words[0] || "";
          const commands = [
            "ls", "cd", "cat", "ed", "edit", "help", "clear",
            "whoami", "neofetch", "projects", "theme", "scanlines", "matrix",
            "reset", "exit"
          ];
          matches = commands.filter(c => c.startsWith(typed.toLowerCase()));
          completionPrefix = typed;
        } else {
          const trimmed = textBefore.trimStart();
          const leadingSpacesLength = textBefore.length - trimmed.length;
          const firstWordLength = words[0] ? words[0].length : 0;
          const cmd = words[0] ? words[0].toLowerCase() : "";
          const arg = textBefore.substring(leadingSpacesLength + firstWordLength).trimStart();

          if (cmd === "theme") {
            const options = ["classic", "amber", "cyberpunk", "solar"];
            matches = options.filter(o => o.startsWith(arg.toLowerCase()));
            completionPrefix = arg;
          } else if (["cd", "cat", "ed", "edit"].includes(cmd)) {
            const isAbsolute = arg.startsWith("/");
            const pathParts = arg.split("/");
            const segmentPrefix = pathParts.pop() || "";
            const dirPathRelative = pathParts;

            const targetDirArray = resolvePath(currentVfsPath, dirPathRelative, isAbsolute);
            const targetDir = getVfsItem(targetDirArray);

            if (targetDir && targetDir.type === "dir") {
              const children = targetDir.children || [];
              const matchedChildren = children.filter(c => c.name.toLowerCase().startsWith(segmentPrefix.toLowerCase()));
              
              matches = matchedChildren.map(c => {
                const suffix = c.type === "dir" ? "/" : "";
                return c.name + suffix;
              });
              completionPrefix = segmentPrefix;
            }
          }
        }
      }

      if (matches.length === 1) {
        // Single match
        const match = matches[0];
        const toAdd = match.substring(completionPrefix.length);
        
        const newVal = textBefore + toAdd + (match.endsWith("/") ? "" : " ");
        commandInput.value = newVal + textAfter;
        const newCursorPos = newVal.length;
        commandInput.setSelectionRange(newCursorPos, newCursorPos);
        updateInputDisplay();
      } else if (matches.length > 1) {
        // Multiple matches: show them in the terminal output
        addOutputLine(" ", "info-no-prefix", false);
        const matchStr = matches.join("    ");
        addOutputLine(matchStr, "info-no-prefix", false);
        addOutputLine(" ", "info-no-prefix", false);
      }
    }

    async function handleShellCommand(fullInput) {
      const parts = fullInput.trim().split(/\s+/);
      const cmd = parts[0].toLowerCase();
      const args = parts.slice(1);

      switch (cmd) {
        case "help":
          addOutputLine(
            "Available commands: ls, cd, cat, ed, help, clear, neofetch, whoami, reset, exit, projects, theme, scanlines, matrix",
            "info",
          );
          break;

        case "ls":
          const item = getVfsItem(currentVfsPath);
          if (item && item.type === "dir") {
            const list = item.children
              .map(
                (c) =>
                  `${c.type === "dir" ? "DIR " : "FILE"} ${c.name.padEnd(15)}`,
              )
              .join("\n");
            addOutputLine(list || "(empty directory)", "info-no-prefix", false);
          }
          break;

        case "cd":
          if (!args[0] || args[0] === "/" || args[0] === "~") {
            currentVfsPath = [];
          } else if (args[0] === "..") {
            currentVfsPath.pop();
          } else {
            const newPath = [...currentVfsPath, args[0]];
            const target = getVfsItem(newPath);
            if (target && target.type === "dir") {
              currentVfsPath = newPath;
            } else {
              addOutputLine(`cd: no such directory: ${args[0]}`, "error");
            }
          }
          break;

        case "cat":
          if (!args[0]) {
            addOutputLine("usage: cat <filename>", "error");
          } else {
            const filePath = [...currentVfsPath, args[0]];
            const file = getVfsItem(filePath);
            if (file && file.type === "file") {
              addOutputLine(file.content, "info-no-prefix", false);
            } else {
              addOutputLine(`cat: no such file: ${args[0]}`, "error");
            }
          }
          break;

        case "ed":
        case "edit":
          if (!args[0]) {
            addOutputLine("usage: ed <filename>", "error");
          } else {
            const targetPath = [...currentVfsPath, args[0]];
            const targetItem = getVfsItem(targetPath);
            if (targetItem && targetItem.type === "file") {
              addOutputLine(`Opening editor for ${args[0]}...`, "info");
              // Temporarily hijack message editor for VFS editing
              formData._edTarget = targetPath;
              formData.message = targetItem.content;
              setInputMode("editor");
            } else {
              addOutputLine(`ed: file not found or is a directory`, "error");
            }
          }
          break;

        case "clear":
          output.innerHTML = "";
          break;

        case "whoami":
          addOutputLine(formData.name || "subject_test_portal", "success");
          break;

        case "neofetch":
          const info = `
  <span style="color:var(--color-primary)">USER:</span> ${formData.name || "Subject"}
  <span style="color:var(--color-primary)">OS:</span> CakeOS 4.11.88
  <span style="color:var(--color-primary)">HOST:</span> Aperture-Science-Lab
  <span style="color:var(--color-primary)">KERNEL:</span> GLaDOS-v3.0.1
  <span style="color:var(--color-primary)">UPTIME:</span> 9999 days
  <span style="color:var(--color-primary)">SHELL:</span> bash-aperture 1.0
  <span style="color:var(--color-primary)">THEME:</span> Minimalist-Glow
  <span style="color:var(--color-primary)">CPU:</span> Neural Core v7
`;
          addOutputLine(info, "html", false);
          break;

        case "projects":
          if (!projects || projects.length === 0) {
            addOutputLine("No projects found in database.", "info");
          } else {
            addOutputLine("Accessing database... Projects list:", "success");
            projects.forEach(p => {
              const projectLink = `<a href="/${currentLang}/projects/${p.slug}" style="color:var(--term-accent, var(--color-accent)); text-decoration: underline;" target="_blank">${p.title}</a>`;
              addOutputLine(`- ${projectLink}`, "html", false);
            });
          }
          break;

        case "theme":
          if (!args[0]) {
            addOutputLine("Usage: theme &lt;theme-name&gt;", "info");
            addOutputLine("Available themes: classic, amber, cyberpunk, solar", "info");
          } else {
            const targetTheme = args[0].toLowerCase();
            if (["classic", "amber", "cyberpunk", "solar"].includes(targetTheme)) {
              terminalWindow.classList.remove("theme-classic", "theme-amber", "theme-cyberpunk", "theme-solar");
              terminalWindow.classList.add(`theme-${targetTheme}`);
              localStorage.setItem("terminal_theme", targetTheme);
              addOutputLine(`Theme updated to: ${targetTheme}`, "success");
            } else {
              addOutputLine(`Unknown theme: ${targetTheme}. Available: classic, amber, cyberpunk, solar`, "error");
            }
          }
          break;

        case "scanlines":
          const hasScanlines = terminalWindow.classList.toggle("scanlines");
          localStorage.setItem("terminal_scanlines", hasScanlines ? "true" : "false");
          addOutputLine(hasScanlines ? "CRT scanlines enabled." : "CRT scanlines disabled.", "success");
          break;

        case "matrix":
          addOutputLine("Entering matrix code interface... Press any key to exit.", "success");
          setTimeout(() => {
            startMatrixRain();
          }, 500);
          break;

        default:
          return false; // Not a shell command we handle here
      }
      return true;
    }

    function showPowerButton() {
      // Use terminalWindow as container so it stays centered even if content is hidden
      if (!terminalWindow) return;

      let button = document.getElementById(POWER_BUTTON_ID);
      if (!button) {
        button = document.createElement("button");
        button.id = POWER_BUTTON_ID;
        button.className = "power-button";
        button.setAttribute("aria-label", "Restart Terminal");
        button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M0 0h24v24H0V0z" fill="none"/><path d="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.84 3 9.25 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.75-1.23-5.16-3.17-6.83z"/></svg>`;
        button.onclick = resetTerminal;
        terminalWindow.appendChild(button);
      }

      setTimeout(() => button.classList.add("visible"), 800); // Show after CRT anim finishes
    }

    function hidePowerButton() {
      const button = document.getElementById(POWER_BUTTON_ID);
      if (button) {
        button.classList.remove("visible");
        setTimeout(() => button.remove(), 300);
      }
    }

    async function processInput(input) {
      if (!translations || isExited) return;
      const lowerInput = input.toLowerCase();

      // Check for shell commands first (Easter Egg logic)
      if (await handleShellCommand(input)) {
        if (currentStep < 5) focusCommandInput();
        return;
      }

      switch (currentStep) {
        case 1:
          if (input) {
            formData.name = input;
            currentStep++;
            typeWriter(prompts[currentStep], focusCommandInput);
          } else {
            addOutputLine(translations.errorName, "error");
            typeWriter(prompts[currentStep], focusCommandInput);
          }
          break;
        case 2:
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (input && emailRegex.test(input)) {
            formData.email = input;
            currentStep++;
            addOutputLine(translations.promptMessageInfo, "info");
            setInputMode("editor");
          } else {
            addOutputLine(translations.errorEmail, "error");
            typeWriter(prompts[currentStep], focusCommandInput);
          }
          break;
        case 3:
          console.warn(
            `[Attempt ${initId}] processInput called unexpectedly during step 3 (message input).`,
          );
          break;
        case 4:
          if (lowerInput === "yes") {
            addOutputLine(translations.sending, "info");
            isSending = true;
            if (sendButton) sendButton.disabled = true;
            if (commandInput) commandInput.readOnly = true;
            try {
              const response = await fetch("/api/contact/initiate", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ...formData, locale: currentLocale }),
              });

              if (!response.ok) {
                throw new Error(`HTTP error ${response.status}`);
              }

              const data = await response.json();
              addOutputLine(
                data.message ||
                  "Verification email sent. Please check your inbox.",
                "success",
              );

              currentStep = 5;
              typeWriter(prompts[currentStep], focusCommandInput);
            } catch (error) {
              console.error(
                `[Attempt ${initId}] Contact form submission error:`,
                error,
              );
              const errorMsg = (
                translations.errorSending || "Failed to send: {message}"
              ).replace("{message}", error.message || "Unknown error");
              addOutputLine(errorMsg, "error");
              if (commandInput) commandInput.readOnly = false;
              displayConfirmation();
            } finally {
              isSending = false;
            }
          } else if (lowerInput === "no") {
            addOutputLine(translations.cancelled, "info");
            currentStep = 5;
            typeWriter(prompts[currentStep], focusCommandInput);
          } else if (lowerInput === "edit") {
            addOutputLine(translations.editInfo, "info");
            currentStep = 1;
            typeWriter(prompts[currentStep], focusCommandInput);
          } else {
            addOutputLine(translations.errorConfirm, "error");
            typeWriter(
              prompts[currentStep],
              focusCommandInput,
              "prompt-secondary",
            );
          }
          break;
        case 5:
          if (lowerInput === "reset") {
            resetTerminal();
          } else if (lowerInput === "edit" && formData.message) {
            addOutputLine(translations.editInfo, "info");
            currentStep = 1;
            typeWriter(prompts[currentStep], focusCommandInput);
          } else if (lowerInput === "exit") {
            addOutputLine(translations.exitMessage, "info");
            isExited = true;
            if (commandInput) commandInput.disabled = true;
            if (messageInput) messageInput.disabled = true;
            if (sendButton) sendButton.disabled = true;
            if (
              document.activeElement instanceof HTMLElement &&
              terminalWindow?.contains(document.activeElement)
            ) {
              document.activeElement.blur();
            }
            if (inputLine) inputLine.classList.remove("focused");

            // Trigger CRT Animation
            if (terminalHeader) terminalHeader.style.opacity = "0";
            if (resizeHandle) resizeHandle.style.opacity = "0";

            // Animate content collapsing
            outputContainer.classList.add("crt-off");
            // Also animate input container if visible, but essentially we just need the "screen" to collapse
            if (inputAreaContainer) inputAreaContainer.style.opacity = "0";

            setTimeout(() => {
              terminalWindow.classList.add("terminal-off-state");
              showPowerButton();
            }, 800);
          } else {
            typeWriter(prompts[currentStep], focusCommandInput);
          }
          break;
        default:
          console.error(
            `[Attempt ${initId}] Invalid currentStep: ${currentStep}`,
          );
          addOutputLine(
            "An unexpected error occurred. Type 'reset' to start over.",
            "error",
          );
          currentStep = 5;
          if (commandInput) commandInput.disabled = false;
          focusCommandInput();
      }
      if (!isExited && currentStep !== 3) {
        updateCommandPrompt();
      }
    }

    function displayConfirmation() {
      if (!translations || !formData || isExited) return;
      const confirmLines = [
        translations.confirmDetails,
        `  ${(translations.confirmName || "Name:").padEnd(10)} ${formData.name || "(Not provided)"}`,
        `  ${(translations.confirmEmail || "Email:").padEnd(10)} ${formData.email || "(Not provided)"}`,
        `  ${translations.confirmMessage || "Message:"}`,
      ];
      const messageLines = (formData.message || "").trim().split("\n");
      if (!formData.message.trim()) {
        confirmLines.push("    (empty message)");
      } else {
        messageLines.forEach((line) => confirmLines.push(`    ${line || " "}`));
      }
      confirmLines.push(translations.confirmEnd);

      addOutputLine(" ", "info-no-prefix", false);
      confirmLines.forEach((line) =>
        addOutputLine(line, "info-no-prefix", false),
      );
      addOutputLine(" ", "info-no-prefix", false);

      if (prompts[currentStep]) {
        typeWriter(prompts[currentStep], focusCommandInput, "prompt-secondary");
      } else {
        console.error(
          `[Attempt ${initId}] Confirmation prompt missing for step 4.`,
        );
        addOutputLine("Confirm? (yes/no/edit)", "prompt-secondary");
        focusCommandInput();
      }
    }

    function resetTerminal() {
      console.log(`[Attempt ${initId}] resetTerminal() called.`);
      if (
        !output ||
        !commandInput ||
        !messageInput ||
        !terminalWindow ||
        !sendButton ||
        !inputLine ||
        !outputContainer ||
        !inputAreaContainer ||
        !terminalHeader ||
        !resizeHandle
      ) {
        console.error(
          `[Attempt ${initId}] Cannot reset terminal, essential elements missing.`,
        );
        return;
      }
      isExited = false;
      hidePowerButton();

      // Reset State
      terminalWindow.classList.remove("terminal-off-state");
      if (terminalHeader) terminalHeader.style.opacity = "1";
      if (resizeHandle) resizeHandle.style.opacity = "1";
      outputContainer.classList.remove("crt-off");
      inputAreaContainer.style.opacity = "1";

      output.innerHTML = "";
      output.classList.remove("hidden");
      inputAreaContainer.classList.remove("hidden");

      formData.name = "";
      formData.email = "";
      formData.message = "";
      currentStep = 0;
      isSending = false;
      isTyping = false;
        commandInput.value = "";
        updateInputDisplay();

      setInitialPositionAndSize();
      setInputMode("command");

      if (sendButton) sendButton.disabled = false;
      startTerminal();
    }

    function startTerminal() {
      console.log(`[Attempt ${initId}] startTerminal() called.`);
      if (!translations || !translations.welcome1 || !translations.welcome2) {
        addOutputLine(
          "Error: Cannot start terminal - missing welcome text.",
          "error",
          false,
        );
        return;
      }
      if (
        !commandInput ||
        !messageInput ||
        !output ||
        !outputContainer ||
        !inputAreaContainer
      ) {
        console.error(
          `[Attempt ${initId}] Cannot start terminal, essential elements missing for start sequence.`,
        );
        return;
      }

      // Check if terminal already started this session
      if (terminalWindow.dataset.terminalStarted === "true") return;

      // Use Observer to only start typing and focusing when in view
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (
              entry.isIntersecting &&
              terminalWindow.dataset.terminalStarted !== "true"
            ) {
              terminalWindow.dataset.terminalStarted = "true";
              runStartSequence();
              observer.unobserve(terminalWindow);
            }
          });
        },
        { threshold: 0.5 },
      ); // Increased threshold to avoid early triggers
      observer.observe(terminalWindow);
    }

    function runStartSequence() {
      isExited = false;
      hidePowerButton();
      output.classList.remove("hidden");
      inputAreaContainer.classList.remove("hidden");
      output.innerHTML = "";

        commandInput.value = "";
        updateInputDisplay();

      commandInput.disabled = true;
      messageInput.disabled = true;
      isTyping = true;

      let currentDisplayDelay = 0;
      const startupTextInterval = 50;

      function addDelayedLine(text, type, delay, addPrefix = false) {
        setTimeout(() => addOutputLine(text, type, addPrefix), delay);
      }

      if (
        Array.isArray(apertureAscii) &&
        window.innerWidth >= SMALL_SCREEN_WIDTH &&
        !apertureAscii[0].startsWith("Error")
      ) {
        apertureAscii.forEach((line, index) => {
          addDelayedLine(
            line,
            "ascii",
            currentDisplayDelay + index * ASCII_LINE_DELAY,
            false,
          );
        });
        currentDisplayDelay += apertureAscii.length * ASCII_LINE_DELAY;
        addDelayedLine(" ", "info-no-prefix", currentDisplayDelay, false);
        currentDisplayDelay += startupTextInterval * 2;
      } else if (
        apertureAscii &&
        apertureAscii.length > 0 &&
        apertureAscii[0].startsWith("Error")
      ) {
        addDelayedLine(apertureAscii[0], "error", currentDisplayDelay, false);
        currentDisplayDelay += startupTextInterval;
      }

      addDelayedLine(
        "Genetic Lifeform and Disk Operating System",
        "info",
        currentDisplayDelay,
        false,
      );
      currentDisplayDelay += startupTextInterval * 5;
      addDelayedLine("Version 4.11.88", "info", currentDisplayDelay, false);
      currentDisplayDelay += startupTextInterval;
      addDelayedLine("CakeOS detected.", "info", currentDisplayDelay, false);
      currentDisplayDelay += startupTextInterval * 3;
      addDelayedLine(
        "Initializing Aperture Science Contact Interface...",
        "success",
        currentDisplayDelay,
        false,
      );
      currentDisplayDelay += startupTextInterval * 4;

      setTimeout(() => {
        typeWriter(translations.welcome1, () => {
          typeWriter(translations.welcome2, () => {
            currentStep = 1;
            if (prompts[currentStep]) {
              typeWriter(prompts[currentStep], () => {
                commandInput.disabled = false;
                commandInput.readOnly = false;
                isTyping = false;
                focusCommandInput();
              });
            } else {
              addOutputLine("Error: Missing prompt.", "error");
              commandInput.disabled = false;
              commandInput.readOnly = false;
              isTyping = false;
              focusCommandInput();
            }
          });
        });
      }, currentDisplayDelay);
    }

    function dragStart(e) {
      if (
        isExited ||
        e.target === commandInput ||
        e.target === messageInput ||
        e.target === sendButton ||
        (POWER_BUTTON_ID && e.target.closest(`#${POWER_BUTTON_ID}`)) ||
        e.target === resizeHandle
      ) {
        return;
      }
      if (!terminalHeader.contains(e.target) && e.target !== terminalHeader) {
        return;
      }
      isDragging = true;
      terminalWindow.dataset.terminalInteracted = "true";
      terminalWindow.classList.add("dragging");
      document.body.style.userSelect = "none";
      const pos = getTerminalPosition();
      initialLeft = pos.left;
      initialTop = pos.top;
      if (e.type === "touchstart") {
        dragStartX = e.touches[0].clientX;
        dragStartY = e.touches[0].clientY;
        document.addEventListener("touchmove", drag, { passive: false });
        document.addEventListener("touchend", dragEnd);
      } else {
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        document.addEventListener("mousemove", drag);
        document.addEventListener("mouseup", dragEnd);
      }
      e.preventDefault();
    }

    function drag(e) {
      if (!isDragging) return;
      e.preventDefault();
      let currentClientX, currentClientY;
      if (e.type === "touchmove") {
        currentClientX = e.touches[0].clientX;
        currentClientY = e.touches[0].clientY;
      } else {
        currentClientX = e.clientX;
        currentClientY = e.clientY;
      }
      let newLeft = initialLeft + (currentClientX - dragStartX);
      let newTop = initialTop + (currentClientY - dragStartY);
      const maxX = window.innerWidth - terminalWindow.offsetWidth;
      const maxY = window.innerHeight - terminalWindow.offsetHeight;
      newLeft = Math.max(0, Math.min(newLeft, maxX));
      newTop = Math.max(TOP_BAR_HEIGHT, Math.min(newTop, maxY));
      terminalWindow.style.left = `${newLeft}px`;
      terminalWindow.style.top = `${newTop}px`;
    }

    function dragEnd() {
      if (!isDragging) return;
      isDragging = false;
      terminalWindow.classList.remove("dragging");
      document.body.style.userSelect = "";
      document.removeEventListener("mousemove", drag);
      document.removeEventListener("mouseup", dragEnd);
      document.removeEventListener("touchmove", drag);
      document.removeEventListener("touchend", dragEnd);
    }

    function resizeStart(e) {
      if (isExited) return;
      isResizing = true;
      terminalWindow.dataset.terminalInteracted = "true";
      document.body.style.userSelect = "none";
      initialWidth = terminalWindow.offsetWidth;
      initialHeight = terminalWindow.offsetHeight;
      const pos = getTerminalPosition();
      initialLeft = pos.left;
      initialTop = pos.top;
      if (e.type === "touchstart") {
        resizeStartX = e.touches[0].clientX;
        resizeStartY = e.touches[0].clientY;
        document.addEventListener("touchmove", resizeDrag, { passive: false });
        document.addEventListener("touchend", resizeEnd);
      } else {
        resizeStartX = e.clientX;
        resizeStartY = e.clientY;
        document.addEventListener("mousemove", resizeDrag);
        document.addEventListener("mouseup", resizeEnd);
      }
      e.preventDefault();
    }

    function resizeDrag(e) {
      if (!isResizing) return;
      e.preventDefault();
      let currentClientX, currentClientY;
      if (e.type === "touchmove") {
        currentClientX = e.touches[0].clientX;
        currentClientY = e.touches[0].clientY;
      } else {
        currentClientX = e.clientX;
        currentClientY = e.clientY;
      }
      const deltaX = currentClientX - resizeStartX;
      const deltaY = currentClientY - resizeStartY;
      let newWidth = initialWidth + deltaX;
      let newHeight = initialHeight + deltaY;
      newWidth = Math.max(MIN_TERMINAL_WIDTH, newWidth);
      newHeight = Math.max(MIN_TERMINAL_HEIGHT, newHeight);
      const maxW = window.innerWidth - initialLeft;
      const maxH = window.innerHeight - initialTop;
      newWidth = Math.min(newWidth, maxW - 5);
      newHeight = Math.min(newHeight, maxH - 5);
      terminalWindow.style.width = `${newWidth}px`;
      terminalWindow.style.height = `${newHeight}px`;
      scrollToBottom();
    }

    function resizeEnd() {
      if (!isResizing) return;
      isResizing = false;
      document.body.style.userSelect = "";
      document.removeEventListener("mousemove", resizeDrag);
      document.removeEventListener("mouseup", resizeEnd);
      document.removeEventListener("touchmove", resizeDrag);
      document.removeEventListener("touchend", resizeEnd);
    }

    const commandInputFocusHandler = () => {
      if (inputLine && !isExited) inputLine.classList.add("focused");
      updateCommandPrompt();
    };
    const commandInputBlurHandler = () => {
      setTimeout(() => {
        if (
          terminalWindow &&
          !terminalWindow.contains(document.activeElement)
        ) {
          if (inputLine) inputLine.classList.remove("focused");
        }
        updateCommandPrompt();
      }, 0);
    };
    const messageInputFocusHandler = () => {
      if (!isExited && messageEditorContainer)
        messageEditorContainer.style.outline = "1px solid var(--color-primary)";
    };
    const messageInputBlurHandler = () => {
      if (messageEditorContainer) messageEditorContainer.style.outline = "";
    };
    const terminalWindowClickHandler = (e) => {
      if (
        isExited ||
        isDragging ||
        isResizing ||
        isTyping ||
        isSending ||
        e.target === commandInput ||
        e.target === messageInput ||
        e.target === sendButton ||
        e.target === resizeHandle ||
        (POWER_BUTTON_ID && e.target.closest(`#${POWER_BUTTON_ID}`))
      ) {
        return;
      }
      if (terminalHeader && !terminalHeader.contains(e.target)) {
        const targetIsBackground =
          e.target === terminalWindow ||
          e.target === outputContainer ||
          e.target === output ||
          e.target === inputAreaContainer ||
          e.target === messageEditorContainer ||
          e.target === inputLine ||
          e.target.closest(".terminal-input-line");
        if (targetIsBackground) {
          if (
            currentStep === 3 &&
            messageEditorContainer.style.display === "flex"
          ) {
            if (messageInput && !messageInput.disabled)
              try {
                messageInput.focus({ preventScroll: true });
              } catch (err) {}
          } else if (currentStep < 5) {
            if (commandInput && !commandInput.disabled && !commandInput.readOnly) focusCommandInput(true);
          }
        }
      }
    };

    const playKeystroke = (e) => {
      if (["Shift", "Control", "Alt", "Meta", "CapsLock"].includes(e.key)) return;
      playTypewriterSound(e.key === "Enter");
    };

    const globalMatrixKeydownHandler = (e) => {
      if (isMatrixMode) {
        e.preventDefault();
        e.stopPropagation();
        stopMatrixRain();
        focusCommandInput();
      }
    };

    const updateInputDisplayDelayed = () => setTimeout(updateInputDisplay, 0);

    commandInput.addEventListener("input", updateInputDisplay);
    commandInput.addEventListener("keydown", updateInputDisplayDelayed);
    commandInput.addEventListener("keyup", updateInputDisplay);
    commandInput.addEventListener("click", updateInputDisplay);
    commandInput.addEventListener("focus", updateInputDisplay);
    commandInput.addEventListener("blur", updateInputDisplay);
    commandInput.addEventListener("select", updateInputDisplay);
    updateInputDisplay();

    commandInput.addEventListener("keydown", handleTabComplete);
    commandInput.addEventListener("keydown", handleCommand);
    commandInput.addEventListener("keydown", playKeystroke);
    commandInput.addEventListener("focus", commandInputFocusHandler);
    commandInput.addEventListener("blur", commandInputBlurHandler);
    messageInput.addEventListener("keydown", handleTextareaKeys);
    messageInput.addEventListener("keydown", playKeystroke);
    messageInput.addEventListener("focus", messageInputFocusHandler);
    messageInput.addEventListener("blur", messageInputBlurHandler);
    window.addEventListener("keydown", globalMatrixKeydownHandler, true);
    sendButton.addEventListener("click", triggerSendConfirmation);
    terminalHeader.addEventListener("mousedown", dragStart);
    terminalHeader.addEventListener("touchstart", dragStart, {
      passive: false,
    });
    resizeHandle.addEventListener("mousedown", resizeStart);
    resizeHandle.addEventListener("touchstart", resizeStart, {
      passive: false,
    });
    terminalWindow.addEventListener("click", terminalWindowClickHandler);

    let windowResizeTimeout;
    currentWindowResizeHandler = () => {
      clearTimeout(windowResizeTimeout);
      windowResizeTimeout = setTimeout(() => {
        if (!isExited && terminalWindow) {
          const pos = getTerminalPosition();
          const currentLeft = pos.left;
          const currentTop = pos.top;
          const currentWidth = terminalWindow.offsetWidth;
          const currentHeight = terminalWindow.offsetHeight;
          const viewportWidth = window.innerWidth;
          const viewportHeight = window.innerHeight;
          let newLeft = currentLeft;
          let newTop = currentTop;
          if (currentLeft + currentWidth > viewportWidth - 5)
            newLeft = Math.max(5, viewportWidth - currentWidth - 5);
          newLeft = Math.max(5, newLeft);
          if (currentTop + currentHeight > viewportHeight - 5)
            newTop = Math.max(
              TOP_BAR_HEIGHT,
              viewportHeight - currentHeight - 5,
            );
          newTop = Math.max(TOP_BAR_HEIGHT, newTop);
          if (newLeft !== currentLeft || newTop !== currentTop) {
            terminalWindow.style.left = `${newLeft}px`;
            terminalWindow.style.top = `${newTop}px`;
          }
          if (currentStep !== 3) updateCommandPrompt();
        }
      }, 100);
    };
    window.addEventListener("resize", currentWindowResizeHandler);

    setInputMode("command", false);
    startTerminal();

    currentTerminalCleanup = () => {
      console.log(
        `[Attempt ${initId}] TerminalContactForm Script: Running cleanup for terminal instance.`,
      );
      commandInput.removeEventListener("input", updateInputDisplay);
      commandInput.removeEventListener("keydown", updateInputDisplayDelayed);
      commandInput.removeEventListener("keyup", updateInputDisplay);
      commandInput.removeEventListener("click", updateInputDisplay);
      commandInput.removeEventListener("focus", updateInputDisplay);
      commandInput.removeEventListener("blur", updateInputDisplay);
      commandInput.removeEventListener("select", updateInputDisplay);

      commandInput.removeEventListener("keydown", handleTabComplete);
      commandInput.removeEventListener("keydown", handleCommand);
      commandInput.removeEventListener("keydown", playKeystroke);
      commandInput.removeEventListener("focus", commandInputFocusHandler);
      commandInput.removeEventListener("blur", commandInputBlurHandler);
      messageInput.removeEventListener("keydown", handleTextareaKeys);
      messageInput.removeEventListener("keydown", playKeystroke);
      messageInput.removeEventListener("focus", messageInputFocusHandler);
      messageInput.removeEventListener("blur", messageInputBlurHandler);
      window.removeEventListener("keydown", globalMatrixKeydownHandler, true);
      sendButton.removeEventListener("click", triggerSendConfirmation);
      terminalHeader.removeEventListener("mousedown", dragStart);
      terminalHeader.removeEventListener("touchstart", dragStart);
      resizeHandle.removeEventListener("mousedown", resizeStart);
      resizeHandle.removeEventListener("touchstart", resizeStart);
      terminalWindow.removeEventListener("click", terminalWindowClickHandler);

      if (typeof currentWindowResizeHandler === "function") {
        window.removeEventListener("resize", currentWindowResizeHandler);
      }
      document.body.style.userSelect = "";
      console.log(
        `[Attempt ${initId}] Cleanup for terminal instance complete.`,
      );
    };
  }

  document.addEventListener("astro:page-load", (event) => {
    console.log(
      "TerminalContactForm Script: 'astro:page-load' event triggered. Nav type:",
      event.detail?.navigationType,
      " Current readyState:",
      document.readyState,
    );
    runTerminalSetup();
  });

  document.addEventListener("astro:before-swap", () => {
    console.log(
      "TerminalContactForm Script: 'astro:before-swap' event triggered.",
    );
    if (typeof currentTerminalCleanup === "function") {
      currentTerminalCleanup();
      currentTerminalCleanup = null;
    }
    if (typeof currentWindowResizeHandler === "function") {
      window.removeEventListener("resize", currentWindowResizeHandler);
      currentWindowResizeHandler = null;
    }
    const outgoingTerminal = document.getElementById("terminal");
    if (outgoingTerminal) {
      console.log(
        `TerminalContactForm Script: In astro:before-swap, outgoing terminal's initialized flag: ${outgoingTerminal.dataset.terminalInitialized}, instanceId: ${outgoingTerminal.dataset.terminalInstanceId}`,
      );
      delete outgoingTerminal.dataset.terminalInitialized;
      delete outgoingTerminal.dataset.terminalInstanceId;
      console.log(
        "TerminalContactForm Script: Cleared 'terminalInitialized' and 'terminalInstanceId' flags from outgoing terminal.",
      );
    }
  });

  if (document.readyState === "complete") {
    console.log(
      "TerminalContactForm Script: Document already complete at script parse time. Attempting setup if needed.",
    );
    setTimeout(() => {
      const terminalElem = document.getElementById("terminal");
      if (terminalElem && terminalElem.dataset.terminalInitialized !== "true") {
        console.log(
          "TerminalContactForm Script: Fallback for 'complete' readyState - terminal not yet initialized by astro:page-load. Running setup.",
        );
        runTerminalSetup();
      } else if (terminalElem) {
        console.log(
          "TerminalContactForm Script: Fallback for 'complete' readyState - terminal already initialized. Skipping.",
        );
      } else {
        console.log(
          "TerminalContactForm Script: Fallback for 'complete' readyState - no terminal element found. Skipping.",
        );
      }
    }, 50);
  }
</script>

