---
// src/components/TerminalContactForm.astro
import type { FunctionalComponent } from "astro/runtime"; // Optional for typing
import fs from "fs"; // Import Node.js file system module
import path from "path"; // Import Node.js path module
import { fileURLToPath } from "url"; // Helper to get current file path

// Define the structure of the translations prop
interface TerminalTranslations {
  title: string;
  welcome1: string;
  welcome2: string;
  promptName: string;
  promptEmail: string;
  promptMessageInfo: string;
  editorInfo: string;
  promptConfirm: string;
  errorName: string;
  errorEmail: string;
  errorMessage: string;
  errorConfirm: string;
  errorSending: string; // Template string
  sending: string;
  sentSuccess: string;
  cancelled: string;
  editInfo: string;
  endPrompt: string;
  exitMessage: string;
  confirmDetails: string;
  confirmName: string;
  confirmEmail: string;
  confirmMessage: string;
  confirmEnd: string;
  sendButton: string;
}

interface Props {
  translations: TerminalTranslations;
}

const { translations } = Astro.props;

// --- Read and Process ASCII Art File ---
let apertureAsciiProcessed: string[] = ["Error: ASCII Art file not found."]; // Default error message
try {
  const __filename = fileURLToPath(import.meta.url);
  const __dirname = path.dirname(__filename);
  const asciiFilePath = path.join(__dirname, "aperture-logo.txt");
  const rawAscii = fs.readFileSync(asciiFilePath, "utf-8");
  apertureAsciiProcessed = rawAscii
    .split("\n")
    .map((line) => (line.trim() === "" ? "" : line.replace(/ /g, "&nbsp;")));
  // console.log("Successfully loaded and processed ASCII art from file.");
} catch (error) {
  console.error("Error reading ASCII art file:", error);
}
// --- End ASCII Art Processing ---

// Prepare data for the client-side script
const translationsJson = JSON.stringify(translations);
const apertureAsciiJson = JSON.stringify(apertureAsciiProcessed);
---

{/* --- Added 'dark' class to force dark mode --- */}
<div
  class="component-terminal-wrapper dark flex items-center justify-center w-full p-2 sm:p-4"
>
  {/* Add padding for small screens */}
  {
    /* --- MODIFIED: Changed position to fixed for better dragging context --- */
  }
  <div id="terminal" class="terminal-window" style="position: fixed;">
    {/* --- MODIFIED: Added id to header --- */}
    <div id="terminal-header" class="terminal-header">
      <span class="header-title"
        >{translations.title || "Contact Terminal"}</span
      >
    </div>
    {/* --- Container for output content vs power button --- */}
    <div id="output-container" class="terminal-output-container">
      <div id="output" class="terminal-output"></div>
      {/* Power button will be added here by JS */}
    </div>
    <div id="input-area" class="input-area-container">
      {/* Command Line Input */}
      <div id="input-line" class="terminal-input-line focused">
        {/* Prompt text and color set by JS */}
        <span id="prompt" class="prompt prompt-hostname"></span>
        {/* Added prompt-hostname class */}
        <input
          type="text"
          id="commandInput"
          class="terminal-input"
          autocomplete="off"
          autofocus
        />
        <span class="cursor"></span>
      </div>
      {/* Text Area for Message */}
      <div
        id="message-editor"
        class="message-editor-container"
        style="display: none;"
      >
        <div class="editor-info-bar">
          {
            translations.editorInfo ||
              "Enter message (Ctrl+Enter or Button to Send)"
          }
        </div>
        <textarea id="messageInput" class="message-textarea"></textarea>
        <button id="sendButton" class="send-button">
          {translations.sendButton || "Send"}
        </button>
      </div>
    </div>
    {/* --- ADDED: Resize Handle --- */}
    <div id="resize-handle" class="resize-handle"></div>
  </div>
</div>

<style>
  /* --- ADDED: Hide page scrollbar --- */
  :global(html) {
    overflow-y: hidden !important; /* Force hide vertical scrollbar */
  }

  /* Apply Fira Code font specifically to the terminal wrapper */
  .component-terminal-wrapper {
    font-family: "Fira Code", monospace;
  }

  /* Styles for the floating terminal window */
  .terminal-window {
    /* Use fixed positioning, set initial size/position via JS */
    background-color: var(--color-border); /* Use CSS variables */
    border: 1px solid var(--color-accent);
    color: var(--color-text);
    border-radius: 0.5rem; /* rounded-lg */
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    overflow: hidden; /* Important for containing elements */
    display: flex;
    flex-direction: column;
    font-size: 0.875rem; /* text-sm */
    line-height: 1.25rem;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.2s ease; /* Added transition for shadow */
    z-index: 100; /* Ensure it's above other content */
    min-width: 320px;
    min-height: 250px;
  }
  /* Style when dragging */
  .terminal-window.dragging {
    cursor: grabbing;
    user-select: none; /* Prevent text selection during drag */
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4); /* Enhance shadow when dragging */
  }

  /* --- Force Dark Mode Styles --- */
  .dark .terminal-window {
    background-color: var(--color-border);
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  .dark .terminal-header {
    background-color: rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text);
    cursor: grab; /* Cursor for dragging */
  }
  .dark .input-area-container {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .dark .editor-info-bar {
    background-color: rgba(0, 0, 0, 0.2);
    color: var(--color-secondary);
  }
  .dark .terminal-output::-webkit-scrollbar-thumb {
    background-color: var(--color-secondary);
    border: 2px solid var(--color-border);
  }
  .dark .terminal-output::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-text);
  }
  .dark .message-textarea::-webkit-scrollbar-thumb {
    background-color: var(--color-secondary);
  }
  .dark .terminal-input-line .cursor {
    background-color: var(--color-text);
  }
  .dark @keyframes blink {
    from,
    to {
      background-color: transparent;
    }
    50% {
      background-color: var(--color-text);
    }
  }

  /* Header Style */
  .terminal-header {
    padding: 0.5rem 0.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    user-select: none; /* Prevent text selection on header title */
  }
  .header-title {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    pointer-events: none; /* Ensure clicks go to header */
  }

  /* Styles for the output container */
  .terminal-output-container {
    flex-grow: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Terminal Output Area */
  .terminal-output {
    flex-grow: 1;
    padding: 1rem;
    overflow-y: auto;
    min-height: 100px;
    transition: opacity 0.3s ease;
    opacity: 1;
  }
  .terminal-output.hidden {
    opacity: 0;
    overflow-y: hidden;
  }

  /* Input Area Styles */
  .input-area-container {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    opacity: 1;
    visibility: visible;
  }
  .input-area-container.hidden {
    opacity: 0;
    visibility: hidden;
  }

  /* Normal Command Input Line */
  .terminal-input-line {
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    background-color: var(--color-border);
    transition: background-color 0.3s ease;
  }
  .terminal-input {
    background-color: transparent;
    border: none;
    outline: none;
    color: inherit;
    width: 100%;
    caret-color: var(--color-text);
    padding: 0;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    flex-grow: 1;
  }
  .prompt {
    font-weight: bold;
    white-space: pre;
    margin-right: 0.5em;
    /* Color set by JS */
  }

  /* Blinking Cursor */
  .terminal-input-line .cursor {
    display: inline-block;
    width: 8px;
    height: 1.2em;
    animation: blink 1s step-end infinite;
    margin-left: 2px;
    vertical-align: bottom;
    transition: background-color 0.3s ease;
  }
  .terminal-input-line:not(.focused) .cursor {
    display: none;
  }
  .terminal-input:focus {
    caret-color: transparent;
  }

  /* Message Editor Styles */
  .message-editor-container {
    background-color: var(--color-border);
    display: flex;
    flex-direction: column;
    min-height: 200px;
    transition: background-color 0.3s ease;
    outline: none;
    transition: outline 0.2s ease-in-out;
    position: relative;
    padding-bottom: 2.5rem;
  }
  .editor-info-bar {
    font-size: 0.7rem;
    padding: 0.25rem 1rem;
    text-align: center;
    flex-shrink: 0;
  }
  .message-textarea {
    flex-grow: 1;
    background-color: transparent;
    border: none;
    outline: none;
    resize: none;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    padding: 0.5rem 1rem;
    width: 100%;
    box-sizing: border-box;
    caret-color: var(--color-text);
    min-height: 150px;
  }
  .message-textarea::-webkit-scrollbar {
    width: 6px;
  }
  .message-textarea::-webkit-scrollbar-track {
    background: transparent;
  }
  .message-textarea::-webkit-scrollbar-thumb {
    border-radius: 3px;
  }

  /* Send Button Style */
  .send-button {
    position: absolute;
    bottom: 0.5rem;
    right: 1rem;
    background-color: var(--color-primary);
    color: white;
    border: none;
    padding: 0.3rem 0.8rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
    z-index: 3;
  }
  .send-button:hover,
  .send-button:focus {
    opacity: 0.9;
  }
  .send-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Output line styles */
  .output-line {
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--color-text); /* Default text color */
    margin-bottom: 0.25rem;
    display: flex;
  }
  .output-line .line-prefix {
    color: var(--color-primary); /* Prefix color */
    font-weight: bold;
    white-space: pre;
    flex-shrink: 0;
    margin-right: 0.5em;
  }
  .output-line .line-text {
    flex-grow: 1;
    /* Text color is inherited from .output-line -> .terminal-window */
  }
  .error-text {
    color: #f44747;
  }
  .success-text {
    color: var(--color-accent);
  }
  .user-input-text {
    /* Default color (inherited) */
  }

  /* ASCII Art style */
  .ascii-art {
    white-space: pre !important;
    line-height: 1.1;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
  .ascii-art .line-prefix {
    display: none;
  }
  .ascii-art .line-text {
    white-space: pre !important;
    color: var(--color-primary);
  }

  /* Scrollbar styling */
  .terminal-output::-webkit-scrollbar {
    width: 8px;
  }
  .terminal-output::-webkit-scrollbar-track {
    background: transparent;
  }
  .terminal-output::-webkit-scrollbar-thumb {
    border-radius: 4px;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  /* Power Button Styles */
  .power-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: transparent; /* No background */
    color: var(--color-primary); /* Icon color */
    border: 2px solid var(--color-primary); /* Optional: Border for visibility */
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: none; /* Optional: Remove shadow if background is transparent */
    transition:
      background-color 0.2s ease,
      transform 0.2s ease,
      opacity 0.3s ease,
      color 0.2s ease;
    opacity: 0;
    visibility: hidden;
    z-index: 10;
  }
  .power-button.visible {
    opacity: 1;
    visibility: visible;
  }
  .power-button:hover {
    background-color: rgba(
      var(--color-primary-rgb),
      0.1
    ); /* Use RGB version if available, else adjust alpha */
  }
  .power-button:active {
    transform: translate(-50%, -50%) scale(0.95); /* Click effect */
  }
  .power-button svg {
    width: 50%;
    height: 50%;
    fill: currentColor; /* Inherits color (primary) from button */
  }

  /* Resize Handle Styles */
  .resize-handle {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 15px;
    height: 15px;
    background-color: rgba(
      var(--color-accent-rgb),
      0.5
    ); /* Semi-transparent accent */
    border-top: 2px solid var(--color-accent);
    border-left: 2px solid var(--color-accent);
    cursor: nwse-resize; /* Diagonal resize cursor */
    z-index: 101; /* Above terminal content */
    transition: background-color 0.2s ease;
  }
  .resize-handle:hover {
    background-color: rgba(var(--color-accent-rgb), 0.8);
  }

  /* Responsive Adjustments */
  @media (max-width: 640px) {
    .ascii-art {
      display: none;
    }
    /* Terminal window size/position now handled by JS */
    .terminal-window {
      min-width: 280px; /* Adjust min width for small screens */
      min-height: 200px; /* Adjust min height */
    }
    .terminal-window {
      font-size: 0.8rem;
    }
    .terminal-input-line,
    .message-textarea {
      padding: 0.6rem 0.8rem;
    }
    .output-line {
      margin-bottom: 0.15rem;
    }
    .message-editor-container {
      min-height: 150px;
    }
    .message-textarea {
      min-height: 100px;
    }
    .power-button {
      width: 50px;
      height: 50px;
      border-width: 1.5px; /* Adjust border for smaller button */
    }
    .resize-handle {
      width: 12px;
      height: 12px;
    }
  }
</style>

{/* Pass translations and ASCII art to the inline script */}
<script define:vars={{ translationsJson, apertureAsciiJson }}>
  // --- Client-Side Terminal Logic ---

  // Parse the translations passed from Astro props
  let translations;
  try {
    translations = JSON.parse(translationsJson);
    if (typeof translations !== "object" || translations === null) {
      throw new Error("Parsed translations are not a valid object.");
    }
  } catch (error) {
    console.error("CRITICAL: Error parsing translations JSON.", error);
    translations = null;
  }

  // Parse the ASCII art passed from Astro props
  let apertureAscii = ["ASCII Art Error"];
  try {
    apertureAscii = JSON.parse(apertureAsciiJson);
    if (!Array.isArray(apertureAscii)) {
      throw new Error("Parsed ASCII art is not an array.");
    }
  } catch (error) {
    console.error("CRITICAL: Error parsing ASCII art JSON.", error);
  }

  // --- Constants ---
  const HOSTNAME = "GLaDOS";
  const HOSTNAME_SEPARATOR = "~";
  const PROMPT_SYMBOL = "> ";
  const CONFIRM_PROMPT_SYMBOL = "? ";
  const HOSTNAME_PREFIX = `${HOSTNAME}${HOSTNAME_SEPARATOR} `;
  const SMALL_SCREEN_WIDTH = 640;
  const ASCII_LINE_DELAY = 50;
  const POWER_BUTTON_ID = "power-on-btn";
  const MIN_TERMINAL_WIDTH = 320; // Minimum width for resizing
  const MIN_TERMINAL_HEIGHT = 250; // Minimum height for resizing
  const TOP_BAR_HEIGHT = 60; // --- ADDED: Assumed height of the top navigation bar (adjust if needed) ---

  // --- Main Initialization Function ---
  function initializeTerminalContact(translations) {
    // --- Guard Clause: Check if translations loaded ---
    if (!translations) {
      const outputDiv = document.getElementById("output");
      if (outputDiv) {
        outputDiv.innerHTML =
          '<div class="output-line error-text">Error: Terminal configuration failed. Required text is missing.</div>';
      }
      console.error(
        "Terminal initialization aborted: Translations object is null or invalid."
      );
      return;
    }

    // --- DOM Element References ---
    const terminalWindow = document.getElementById("terminal");
    const terminalHeader = document.getElementById("terminal-header");
    const outputContainer = document.getElementById("output-container");
    const output = document.getElementById("output");
    const inputAreaContainer = document.getElementById("input-area");
    const inputLine = document.getElementById("input-line");
    const promptElement = document.getElementById("prompt");
    const commandInput = document.getElementById("commandInput");
    const messageEditorContainer = document.getElementById("message-editor");
    const messageInput = document.getElementById("messageInput");
    const sendButton = document.getElementById("sendButton");
    const resizeHandle = document.getElementById("resize-handle");

    // --- Guard Clause: Check if DOM Elements Exist ---
    const elements = {
      terminalWindow,
      terminalHeader,
      outputContainer,
      output,
      inputAreaContainer,
      inputLine,
      promptElement,
      commandInput,
      messageEditorContainer,
      messageInput,
      sendButton,
      resizeHandle,
    };
    if (Object.values(elements).some((el) => !el)) {
      console.error(
        "One or more terminal DOM elements not found. Aborting initialization."
      );
      if (output) {
        output.innerHTML =
          '<div class="output-line error-text">Error: Critical UI elements missing. Terminal cannot start.</div>';
      }
      return;
    }

    // --- State Variables ---
    let currentStep = 0;
    const formData = { name: "", email: "", message: "" };
    let isTyping = false;
    let isSending = false;
    let isExited = false;
    // Dragging State
    let isDragging = false;
    let dragStartX, dragStartY;
    let initialLeft, initialTop;
    // Resizing State
    let isResizing = false;
    let resizeStartX, resizeStartY;
    let initialWidth, initialHeight;

    // --- Initial Setup ---
    function setInitialPositionAndSize() {
      const initialW = Math.min(768, window.innerWidth * 0.9);
      const vh = window.innerHeight;
      const initialH = Math.max(MIN_TERMINAL_HEIGHT, Math.min(650, vh * 0.75));

      terminalWindow.style.width = `${initialW}px`;
      terminalWindow.style.height = `${initialH}px`;

      // --- MODIFIED: Respect TOP_BAR_HEIGHT for initial position ---
      const initialTopPos = (window.innerHeight - initialH) / 2;
      const initialLeftPos = (window.innerWidth - initialW) / 2;

      terminalWindow.style.top = `${Math.max(TOP_BAR_HEIGHT, initialTopPos)}px`; // Ensure not under top bar
      terminalWindow.style.left = `${Math.max(0, initialLeftPos)}px`; // Ensure not off-screen left
    }
    setInitialPositionAndSize(); // Set initial state

    // --- Validate Required Translation Keys ---
    const requiredKeys = [
      "welcome1",
      "welcome2",
      "promptName",
      "promptEmail",
      "promptMessageInfo",
      "editorInfo",
      "promptConfirm",
      "errorName",
      "errorEmail",
      "errorMessage",
      "errorConfirm",
      "errorSending",
      "sending",
      "sentSuccess",
      "cancelled",
      "editInfo",
      "endPrompt",
      "exitMessage",
      "confirmDetails",
      "confirmName",
      "confirmEmail",
      "confirmMessage",
      "confirmEnd",
      "sendButton",
    ];
    const missingKeys = requiredKeys.filter(
      (key) => typeof translations[key] !== "string" || !translations[key]
    );
    if (missingKeys.length > 0) {
      console.error(
        `Terminal initialization aborted due to missing or invalid translations for keys: ${missingKeys.join(", ")}`
      );
      addOutputLine(
        `Configuration error: Missing required text (${missingKeys.join(", ")}).`,
        "error",
        false
      );
      commandInput.disabled = true;
      messageInput.disabled = true;
      sendButton.disabled = true;
      return;
    }

    // --- Prepare Prompts Array (Validated) ---
    const prompts = [
      "",
      translations.promptName,
      translations.promptEmail,
      "",
      translations.promptConfirm,
      translations.endPrompt,
    ];

    // --- Core Functions ---

    /** Gets the appropriate prefix text based on screen size and type */
    function getPrefixText(type) {
      const isSmallScreen = window.innerWidth < SMALL_SCREEN_WIDTH;
      let prefix = "";
      if (type === "prompt" || type === "user") {
        prefix = (isSmallScreen ? "" : HOSTNAME_PREFIX) + PROMPT_SYMBOL;
      } else if (type === "prompt-secondary") {
        prefix = (isSmallScreen ? "" : HOSTNAME_PREFIX) + CONFIRM_PROMPT_SYMBOL;
      } else if (type !== "ascii" && type !== "info-no-prefix") {
        prefix = isSmallScreen ? "" : HOSTNAME_PREFIX;
      }
      return prefix;
    }

    /** Appends a styled line to the terminal output div. */
    function addOutputLine(text, type = "info", addPrefix = true) {
      if (!output || isExited) return;
      const line = document.createElement("div");
      line.classList.add("output-line");
      const prefixText =
        addPrefix && type !== "info-no-prefix" ? getPrefixText(type) : "";
      const prefixSpan = document.createElement("span");
      prefixSpan.className = "line-prefix"; // CSS applies primary color
      if (
        prefixText.includes(HOSTNAME) &&
        !(window.innerWidth < SMALL_SCREEN_WIDTH)
      ) {
        prefixSpan.classList.add("prompt-hostname-prefix");
      }
      prefixSpan.textContent = prefixText;
      line.appendChild(prefixSpan);
      const textSpan = document.createElement("span");
      textSpan.className = "line-text"; // CSS applies default text color
      if (type === "ascii") {
        if (window.innerWidth >= SMALL_SCREEN_WIDTH) {
          line.classList.add("ascii-art");
          textSpan.innerHTML = text;
        } // ASCII uses primary color via CSS
        else {
          return;
        }
      } else {
        const sanitizedText = String(text)
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
        switch (type) {
          case "error":
            textSpan.innerHTML = `<span class="error-text">Error: ${sanitizedText}</span>`;
            break;
          case "success":
            textSpan.innerHTML = `<span class="success-text">${sanitizedText}</span>`;
            break;
          case "user":
            textSpan.innerHTML = `<span class="user-input-text">${sanitizedText}</span>`;
            break; // Inherits default text color
          default:
            textSpan.textContent = sanitizedText;
            break; // Info/prompts inherit default text color
        }
      }
      line.appendChild(textSpan);
      output.appendChild(line);
      scrollToBottom();
    }

    /** Simulates typing effect for a given text in the output. */
    function typeWriter(text, callback, promptType = "prompt") {
      if (typeof text !== "string") text = String(text);
      if (!commandInput || !messageInput || !output || isExited) {
        if (callback) callback();
        return;
      }
      isTyping = true;
      let i = 0;
      const speed = 30;
      const line = document.createElement("div");
      line.classList.add("output-line");
      const prefixText = getPrefixText(promptType);
      const prefixSpan = document.createElement("span");
      prefixSpan.className = "line-prefix"; // CSS applies primary color
      if (
        prefixText.includes(HOSTNAME) &&
        !(window.innerWidth < SMALL_SCREEN_WIDTH)
      ) {
        prefixSpan.classList.add("prompt-hostname-prefix");
      }
      prefixSpan.textContent = prefixText;
      line.appendChild(prefixSpan);
      const textSpan = document.createElement("span");
      textSpan.className = "line-text";
      line.appendChild(textSpan);
      output.appendChild(line); // CSS applies default text color
      function type() {
        try {
          if (i < text.length && !isExited) {
            textSpan.textContent += text.charAt(i);
            i++;
            scrollToBottom();
            setTimeout(type, speed);
          } else {
            isTyping = false;
            if (callback && !isExited) callback();
          }
        } catch (error) {
          console.error("Error during typeWriter's type function:", error);
          isTyping = false;
          if (callback && !isExited) callback();
        }
      }
      type();
    }

    /** Scrolls the terminal output div to the bottom smoothly. */
    function scrollToBottom() {
      setTimeout(() => {
        if (output && !output.classList.contains("hidden")) {
          output.scrollTo({ top: output.scrollHeight, behavior: "smooth" });
        }
      }, 10);
    }

    /** Updates the command input prompt symbol, color, and focus state. */
    function updateCommandPrompt() {
      if (!promptElement || !inputLine || !commandInput || isExited) return;
      const isSmallScreen = window.innerWidth < SMALL_SCREEN_WIDTH;
      promptElement.textContent =
        (isSmallScreen ? "" : HOSTNAME_PREFIX) + PROMPT_SYMBOL;
      promptElement.style.color = "var(--color-primary)"; // Live input prompt uses primary color
      if (!isSmallScreen) promptElement.classList.add("prompt-hostname-prefix");
      else promptElement.classList.remove("prompt-hostname-prefix");
      if (document.activeElement === commandInput)
        inputLine.classList.add("focused");
      else inputLine.classList.remove("focused");
    }

    /** Switches the input mode between command line and textarea editor. */
    function setInputMode(mode) {
      if (
        !inputLine ||
        !messageEditorContainer ||
        !commandInput ||
        !messageInput ||
        isExited
      ) {
        return;
      }
      if (mode === "editor") {
        inputLine.style.display = "none";
        inputLine.classList.remove("focused");
        messageEditorContainer.style.display = "flex";
        messageInput.value = formData.message;
        messageInput.disabled = false;
        commandInput.disabled = true;
        try {
          messageInput.focus();
        } catch (e) {}
        setTimeout(() => {
          messageInput.scrollTop = messageInput.scrollHeight;
        }, 10);
      } else {
        messageEditorContainer.style.display = "none";
        inputLine.style.display = "flex";
        commandInput.disabled = false;
        messageInput.disabled = true;
        try {
          commandInput.focus();
          inputLine.classList.add("focused");
        } catch (e) {
          inputLine.classList.remove("focused");
        }
        updateCommandPrompt();
      }
    }

    /** Triggered when user finishes message (clicks button or Ctrl+Enter). */
    function triggerSendConfirmation() {
      if (currentStep !== 3 || isSending || isTyping || isExited) return;
      if (!messageInput || !translations || !messageEditorContainer) {
        return;
      }
      formData.message = messageInput.value.trim();
      if (!formData.message) {
        addOutputLine(
          translations.errorMessage || "Message cannot be empty.",
          "error"
        );
        messageEditorContainer.style.outline = "1px solid red";
        setTimeout(() => {
          if (messageEditorContainer) messageEditorContainer.style.outline = "";
        }, 1500);
        try {
          messageInput.focus();
        } catch (e) {}
        return;
      }
      setInputMode("command");
      currentStep = 4;
      displayConfirmation();
    }

    /** Handles Enter key press on the command input line. */
    function handleCommand(event) {
      if (
        isExited ||
        event.key !== "Enter" ||
        isTyping ||
        currentStep === 3 ||
        !commandInput
      ) {
        return;
      }
      event.preventDefault();
      const command = commandInput.value.trim();
      commandInput.value = "";
      if (command) {
        addOutputLine(command, "user");
        processInput(command);
      } else {
        addOutputLine("", "prompt");
        if (!isTyping && currentStep !== 3 && currentStep < 5) {
          try {
            commandInput.focus();
          } catch (e) {}
        }
        updateCommandPrompt();
      }
    }

    /** Handles keyboard shortcuts within the message textarea (Ctrl+Enter). */
    function handleTextareaKeys(event) {
      if (isExited) return;
      if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
        event.preventDefault();
        triggerSendConfirmation();
      }
    }

    /** Focuses the command input safely and ensures it's enabled. */
    function focusCommandInput() {
      if (commandInput && !isExited && currentStep !== 3) {
        try {
          commandInput.disabled = false; // Ensure enabled
          if (document.activeElement !== commandInput) {
            commandInput.focus();
          }
          updateCommandPrompt(); // Ensure cursor state is correct
        } catch (e) {
          console.warn("Could not focus command input:", e);
        }
      }
    }

    /** Creates and shows the power-on button */
    function showPowerButton() {
      if (!outputContainer) return;
      const existingButton = document.getElementById(POWER_BUTTON_ID);
      if (existingButton) existingButton.remove();
      const button = document.createElement("button");
      button.id = POWER_BUTTON_ID;
      button.className = "power-button";
      button.setAttribute("aria-label", "Restart Terminal");
      // Standard Power SVG Icon (transparent background, uses button color for fill)
      button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24"><path d="M0 0h24v24H0V0z" fill="none"/><path d="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.84 3 9.25 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.75-1.23-5.16-3.17-6.83z"/></svg>`;
      button.onclick = resetTerminal;
      outputContainer.appendChild(button);
      setTimeout(() => button.classList.add("visible"), 10);
    }

    /** Hides the power-on button */
    function hidePowerButton() {
      const button = document.getElementById(POWER_BUTTON_ID);
      if (button) {
        button.classList.remove("visible");
        setTimeout(() => button.remove(), 300);
      }
    }

    /** Processes user input from command line based on the current step. */
    async function processInput(input) {
      if (!translations || isExited) return;
      const lowerInput = input.toLowerCase();

      switch (currentStep) {
        case 1: // Name
          if (input) {
            formData.name = input;
            currentStep++;
            typeWriter(prompts[currentStep], focusCommandInput);
          } else {
            addOutputLine(translations.errorName, "error");
            typeWriter(prompts[currentStep], focusCommandInput);
          }
          break;
        case 2: // Email
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (input && emailRegex.test(input)) {
            formData.email = input;
            currentStep++;
            addOutputLine(translations.promptMessageInfo, "info");
            setInputMode("editor");
          } else {
            addOutputLine(translations.errorEmail, "error");
            typeWriter(prompts[currentStep], focusCommandInput);
          }
          break;
        case 3:
          console.warn("processInput called unexpectedly during step 3.");
          break;
        case 4: // Confirmation
          if (lowerInput === "yes") {
            addOutputLine(translations.sending, "info");
            isSending = true;
            if (sendButton) sendButton.disabled = true;
            if (commandInput) commandInput.disabled = true;
            try {
              const response = await fetch("/api/contact", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(formData),
              });
              if (!response.ok) {
                let errorData = { message: `Server error: ${response.status}` };
                try {
                  errorData = await response.json();
                } catch (e) {}
                throw new Error(
                  errorData.message || `HTTP error ${response.status}`
                );
              }
              const data = await response.json();
              addOutputLine(
                data.message || translations.sentSuccess,
                "success"
              );
              currentStep = 5;
              typeWriter(prompts[currentStep], focusCommandInput); // Focus after success prompt
            } catch (error) {
              console.error("Contact form submission error:", error);
              const errorMsg = (
                translations.errorSending || "Failed to send: {message}"
              ).replace("{message}", error.message || "Unknown error");
              addOutputLine(errorMsg, "error");
              if (commandInput) commandInput.disabled = false;
              displayConfirmation();
            } finally {
              // Focus handled by displayConfirmation
              isSending = false;
            }
          } else if (lowerInput === "no") {
            addOutputLine(translations.cancelled, "info");
            currentStep = 5;
            typeWriter(prompts[currentStep], focusCommandInput);
          } // Focus after cancel prompt
          else if (lowerInput === "edit") {
            addOutputLine(translations.editInfo, "info");
            currentStep = 3;
            setInputMode("editor");
          } // Focus handled by setInputMode
          else {
            addOutputLine(translations.errorConfirm, "error");
            typeWriter(
              prompts[currentStep],
              focusCommandInput,
              "prompt-secondary"
            );
          }
          break; // Focus after error prompt
        case 5: // End state
          if (lowerInput === "reset") {
            resetTerminal();
          } // Handles focus internally
          else if (lowerInput === "edit" && formData.message) {
            addOutputLine(translations.editInfo, "info");
            currentStep = 3;
            setInputMode("editor");
          } // Focus handled by setInputMode
          else if (lowerInput === "exit") {
            addOutputLine(translations.exitMessage, "info");
            isExited = true;
            if (commandInput) commandInput.disabled = true;
            if (messageInput) messageInput.disabled = true;
            if (sendButton) sendButton.disabled = true;
            if (
              document.activeElement instanceof HTMLElement &&
              terminalWindow?.contains(document.activeElement)
            ) {
              document.activeElement.blur();
            }
            if (output) output.classList.add("hidden");
            if (inputAreaContainer) inputAreaContainer.classList.add("hidden");
            if (inputLine) inputLine.classList.remove("focused");
            setTimeout(showPowerButton, 350);
          } else {
            typeWriter(prompts[currentStep], focusCommandInput);
          }
          break; // Repeat prompt, focus after
        default:
          console.error(`Invalid currentStep: ${currentStep}`);
          currentStep = 5;
          addOutputLine(
            "An unexpected error occurred. Type 'reset' to start over.",
            "error"
          );
          if (commandInput) commandInput.disabled = false;
          focusCommandInput();
      }
      if (!isExited && currentStep !== 3) {
        updateCommandPrompt();
      }
    }

    /** Displays the collected form data for user confirmation. */
    function displayConfirmation() {
      if (!translations || !formData || isExited) return;
      const confirmLines = [
        translations.confirmDetails,
        `  ${(translations.confirmName || "Name:").padEnd(10)} ${formData.name || "(Not provided)"}`,
        `  ${(translations.confirmEmail || "Email:").padEnd(10)} ${formData.email || "(Not provided)"}`,
        `  ${translations.confirmMessage || "Message:"}`,
      ];
      const messageLines = (formData.message || "").trim().split("\n");
      if (!formData.message.trim()) {
        confirmLines.push("    (empty message)");
      } else {
        messageLines.forEach((line) => confirmLines.push(`    ${line || " "}`));
      }
      confirmLines.push(translations.confirmEnd);
      addOutputLine(" ", "info-no-prefix", false);
      confirmLines.forEach((line) =>
        addOutputLine(line, "info-no-prefix", false)
      );
      addOutputLine(" ", "info-no-prefix", false);
      if (prompts[currentStep]) {
        typeWriter(prompts[currentStep], focusCommandInput, "prompt-secondary");
      } // Focus after prompt
      else {
        console.error("Confirmation prompt missing for step 4.");
        addOutputLine("Confirm? (yes/no/edit)", "prompt-secondary");
        focusCommandInput();
      }
      updateCommandPrompt();
    }

    /** Resets the terminal to its initial state. */
    function resetTerminal() {
      if (
        !output ||
        !commandInput ||
        !messageInput ||
        !terminalWindow ||
        !sendButton ||
        !inputLine ||
        !outputContainer ||
        !inputAreaContainer
      ) {
        return;
      }
      isExited = false;
      hidePowerButton();
      output.innerHTML = "";
      output.classList.remove("hidden");
      inputAreaContainer.classList.remove("hidden");
      formData.name = "";
      formData.email = "";
      formData.message = "";
      currentStep = 0;
      isSending = false;
      isTyping = false;
      // Reset position and size
      setInitialPositionAndSize();
      // Reset input modes
      setInputMode("command");
      sendButton.disabled = false;
      commandInput.disabled = true;
      messageInput.disabled = true;
      startTerminal(); // Handles focus internally after intro
    }

    /** Starts the terminal simulation: displays ASCII, welcome messages and first prompt. */
    function startTerminal() {
      if (!translations || !translations.welcome1 || !translations.welcome2) {
        addOutputLine(
          "Error: Cannot start terminal - missing welcome text.",
          "error",
          false
        );
        return;
      }
      if (!Array.isArray(apertureAscii)) {
        addOutputLine("Warning: ASCII art failed to load.", "error", false);
      }
      if (
        !commandInput ||
        !messageInput ||
        !output ||
        !outputContainer ||
        !inputAreaContainer
      ) {
        return;
      }
      isExited = false;
      hidePowerButton();
      output.classList.remove("hidden");
      inputAreaContainer.classList.remove("hidden");
      output.innerHTML = "";
      commandInput.disabled = true;
      messageInput.disabled = true;
      isTyping = true;
      const startupTextDelay = 50;
      function addStartupLine(text, type = "info", delay, callback) {
        setTimeout(() => {
          addOutputLine(text, type, false);
          if (callback) callback();
        }, delay);
      }
      let currentDelay = 0;
      let asciiDisplayComplete = false;
      if (
        Array.isArray(apertureAscii) &&
        window.innerWidth >= SMALL_SCREEN_WIDTH &&
        !apertureAscii[0].startsWith("Error")
      ) {
        apertureAscii.forEach((line, index) => {
          setTimeout(
            () => {
              addOutputLine(line, "ascii", false);
              if (index === apertureAscii.length - 1) {
                asciiDisplayComplete = true;
                proceedAfterAscii();
              }
            },
            currentDelay + index * ASCII_LINE_DELAY
          );
        });
        currentDelay += apertureAscii.length * ASCII_LINE_DELAY;
      } else {
        asciiDisplayComplete = true;
        proceedAfterAscii();
      }
      function proceedAfterAscii() {
        if (!asciiDisplayComplete) return;
        if (
          Array.isArray(apertureAscii) &&
          window.innerWidth >= SMALL_SCREEN_WIDTH &&
          !apertureAscii[0].startsWith("Error")
        ) {
          setTimeout(
            () => addOutputLine(" ", "info-no-prefix", false),
            currentDelay
          );
          currentDelay += startupTextDelay;
        }
        let bootTextDelay = currentDelay + startupTextDelay;
        addStartupLine(
          "Genetic Lifeform and Disk Operating System",
          "info",
          bootTextDelay
        );
        bootTextDelay += startupTextDelay * 5;
        addStartupLine("Version 4.11.88", "info", bootTextDelay);
        bootTextDelay += startupTextDelay;
        addStartupLine("CakeOS detected.", "info", bootTextDelay);
        bootTextDelay += startupTextDelay * 3;
        addStartupLine(
          "Initializing Aperture Science Contact Interface...",
          "success",
          bootTextDelay
        );
        bootTextDelay += startupTextDelay * 4;
        setTimeout(
          () => {
            typeWriter(translations.welcome1, () => {
              typeWriter(translations.welcome2, () => {
                currentStep = 1;
                if (prompts[currentStep]) {
                  typeWriter(prompts[currentStep], () => {
                    commandInput.disabled = false;
                    focusCommandInput();
                    /* Focus after prompt */ updateCommandPrompt();
                  });
                } else {
                  console.error("Prompt for step 1 (Name) is missing.");
                  addOutputLine("Error: Missing prompt.", "error");
                  isTyping = false;
                  commandInput.disabled = false;
                  focusCommandInput();
                }
              });
            });
          },
          bootTextDelay + startupTextDelay * 2
        );
      }
    }

    // --- Dragging Logic ---
    function dragStart(e) {
      if (
        isExited ||
        e.target === commandInput ||
        e.target === messageInput ||
        e.target === sendButton ||
        e.target.closest(`#${POWER_BUTTON_ID}`) ||
        e.target === resizeHandle
      ) {
        return;
      }
      isDragging = true;
      terminalWindow.classList.add("dragging");
      initialLeft = terminalWindow.offsetLeft;
      initialTop = terminalWindow.offsetTop;

      if (e.type === "touchstart") {
        dragStartX = e.touches[0].clientX;
        dragStartY = e.touches[0].clientY;
      } else {
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        document.addEventListener("mousemove", drag);
        document.addEventListener("mouseup", dragEnd);
      }
      document.addEventListener("touchmove", drag, { passive: false });
      document.addEventListener("touchend", dragEnd);
    }

    function drag(e) {
      if (!isDragging) return;
      e.preventDefault();

      let currentClientX, currentClientY;
      if (e.type === "touchmove") {
        currentClientX = e.touches[0].clientX;
        currentClientY = e.touches[0].clientY;
      } else {
        currentClientX = e.clientX;
        currentClientY = e.clientY;
      }

      let newLeft = initialLeft + (currentClientX - dragStartX);
      let newTop = initialTop + (currentClientY - dragStartY);

      // Boundary checks (viewport)
      const maxX = window.innerWidth - terminalWindow.offsetWidth;
      const maxY = window.innerHeight - terminalWindow.offsetHeight;
      newLeft = Math.max(0, Math.min(newLeft, maxX));
      // --- MODIFIED: Boundary check respects TOP_BAR_HEIGHT ---
      newTop = Math.max(TOP_BAR_HEIGHT, Math.min(newTop, maxY));

      terminalWindow.style.left = `${newLeft}px`;
      terminalWindow.style.top = `${newTop}px`;
    }

    function dragEnd(e) {
      if (!isDragging) return;
      isDragging = false;
      terminalWindow.classList.remove("dragging");
      document.removeEventListener("mousemove", drag);
      document.removeEventListener("mouseup", dragEnd);
      document.removeEventListener("touchmove", drag);
      document.removeEventListener("touchend", dragEnd);
    }
    // --- End Dragging Logic ---

    // --- Resizing Logic ---
    function resizeStart(e) {
      if (isExited) return;
      isResizing = true;
      document.body.style.userSelect = "none";
      initialWidth = terminalWindow.offsetWidth;
      initialHeight = terminalWindow.offsetHeight;

      if (e.type === "touchstart") {
        resizeStartX = e.touches[0].clientX;
        resizeStartY = e.touches[0].clientY;
      } else {
        resizeStartX = e.clientX;
        resizeStartY = e.clientY;
        document.addEventListener("mousemove", resizeDrag);
        document.addEventListener("mouseup", resizeEnd);
      }
      document.addEventListener("touchmove", resizeDrag, { passive: false });
      document.addEventListener("touchend", resizeEnd);
    }

    function resizeDrag(e) {
      if (!isResizing) return;
      e.preventDefault();

      let currentClientX, currentClientY;
      if (e.type === "touchmove") {
        currentClientX = e.touches[0].clientX;
        currentClientY = e.touches[0].clientY;
      } else {
        currentClientX = e.clientX;
        currentClientY = e.clientY;
      }

      const deltaX = currentClientX - resizeStartX;
      const deltaY = currentClientY - resizeStartY;
      let newWidth = initialWidth + deltaX;
      let newHeight = initialHeight + deltaY;
      newWidth = Math.max(MIN_TERMINAL_WIDTH, newWidth);
      newHeight = Math.max(MIN_TERMINAL_HEIGHT, newHeight);
      const maxW = window.innerWidth - terminalWindow.offsetLeft;
      const maxH = window.innerHeight - terminalWindow.offsetTop;
      newWidth = Math.min(newWidth, maxW);
      newHeight = Math.min(newHeight, maxH);

      terminalWindow.style.width = `${newWidth}px`;
      terminalWindow.style.height = `${newHeight}px`;
    }

    function resizeEnd() {
      if (!isResizing) return;
      isResizing = false;
      document.body.style.userSelect = "";
      document.removeEventListener("mousemove", resizeDrag);
      document.removeEventListener("mouseup", resizeEnd);
      document.removeEventListener("touchmove", resizeDrag);
      document.removeEventListener("touchend", resizeEnd);
    }
    // --- End Resizing Logic ---

    // --- Event Listeners Setup ---
    if (commandInput) {
      commandInput.addEventListener("keydown", handleCommand);
      commandInput.addEventListener("focus", () => {
        if (inputLine && !isExited) inputLine.classList.add("focused");
      });
      commandInput.addEventListener("blur", () => {
        setTimeout(() => {
          if (
            terminalWindow &&
            !terminalWindow.contains(document.activeElement)
          ) {
            if (inputLine) inputLine.classList.remove("focused");
          }
        }, 0);
      });
    }
    if (messageInput && messageEditorContainer) {
      messageInput.addEventListener("keydown", handleTextareaKeys);
      messageInput.addEventListener("focus", () => {
        if (!isExited)
          messageEditorContainer.style.outline =
            "1px solid var(--color-primary)";
      });
      messageInput.addEventListener("blur", () => {
        messageEditorContainer.style.outline = "";
      });
    }
    if (sendButton) {
      sendButton.addEventListener("click", triggerSendConfirmation);
    }
    if (
      terminalWindow &&
      outputContainer &&
      inputAreaContainer &&
      messageEditorContainer
    ) {
      terminalWindow.addEventListener("click", (e) => {
        if (
          isExited ||
          isDragging ||
          isResizing ||
          isTyping ||
          isSending ||
          e.target === commandInput ||
          e.target === messageInput ||
          e.target === sendButton ||
          e.target === resizeHandle ||
          e.target.closest(`#${POWER_BUTTON_ID}`)
        ) {
          return;
        }
        if (terminalHeader && !terminalHeader.contains(e.target)) {
          const targetIsBackground =
            e.target === terminalWindow ||
            e.target === outputContainer ||
            e.target === output ||
            e.target === inputAreaContainer ||
            e.target === messageEditorContainer;
          if (targetIsBackground) {
            if (currentStep === 3) {
              if (
                messageInput &&
                document.activeElement !== messageInput &&
                !messageInput.disabled
              ) {
                try {
                  messageInput.focus();
                } catch (err) {}
              }
            } else if (currentStep < 5) {
              if (
                commandInput &&
                document.activeElement !== commandInput &&
                !commandInput.disabled
              ) {
                focusCommandInput();
              }
            }
          }
        }
      });
    }
    // Dragging Event Listeners
    if (terminalHeader) {
      terminalHeader.addEventListener("mousedown", dragStart);
      terminalHeader.addEventListener("touchstart", dragStart, {
        passive: false,
      });
    }
    // Resizing Event Listeners
    if (resizeHandle) {
      resizeHandle.addEventListener("mousedown", resizeStart);
      resizeHandle.addEventListener("touchstart", resizeStart, {
        passive: false,
      });
    }

    // --- Final Initialization Steps ---
    setInputMode("command");
    startTerminal();

    // --- Add listener for window resize (to recenter/adjust if needed) ---
    let windowResizeTimeout;
    window.addEventListener("resize", () => {
      // Renamed timeout variable
      clearTimeout(windowResizeTimeout);
      windowResizeTimeout = setTimeout(() => {
        if (!isExited) {
          // Recalculate boundaries and adjust position if out of bounds
          const currentLeft = terminalWindow.offsetLeft;
          const currentTop = terminalWindow.offsetTop;
          const maxX = window.innerWidth - terminalWindow.offsetWidth;
          const maxY = window.innerHeight - terminalWindow.offsetHeight;

          const newLeft = Math.max(0, Math.min(currentLeft, maxX));
          // --- MODIFIED: Respect TOP_BAR_HEIGHT on window resize ---
          const newTop = Math.max(TOP_BAR_HEIGHT, Math.min(currentTop, maxY));

          if (newLeft !== currentLeft || newTop !== currentTop) {
            terminalWindow.style.left = `${newLeft}px`;
            terminalWindow.style.top = `${newTop}px`;
          }

          if (currentStep !== 3) {
            updateCommandPrompt();
          }
        }
      }, 100);
    });
  } // --- End of initializeTerminalContact ---

  // --- Standard DOM Ready Event Listener ---
  document.addEventListener("DOMContentLoaded", () => {
    if (
      translations &&
      typeof translations === "object" &&
      Array.isArray(apertureAscii)
    ) {
      if (apertureAscii.length === 1 && apertureAscii[0].startsWith("Error:")) {
        console.warn(
          "Initializing terminal without ASCII art due to loading error."
        );
      }
      initializeTerminalContact(translations);
    } else {
      console.error(
        "CRITICAL: Terminal initialization skipped. Translations or ASCII art data failed to load or parse correctly before DOMContentLoaded."
      );
      const outputDiv = document.getElementById("output");
      if (outputDiv) {
        outputDiv.innerHTML =
          '<div class="output-line error-text">Critical Error: Terminal failed to initialize. Check console for details.</div>';
      }
      const terminalDiv = document.getElementById("terminal");
      if (terminalDiv) {
        terminalDiv.style.opacity = "0.5";
        terminalDiv.style.pointerEvents = "none";
      }
    }
  });
</script>
