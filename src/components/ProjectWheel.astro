---
// ProjectWheel.astro
// Define the Project type
interface Project {
  title: string;
  description: string;
  image: any;
  url: string;
}

// You can pass in projects as a prop
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Sort projects alphabetically by title
const sortedProjects = [...projects].sort((a, b) =>
  a.title.localeCompare(b.title)
);

// Group projects by first letter
const groupedProjects = sortedProjects.reduce(
  (acc, project) => {
    const firstLetter = project.title.charAt(0).toUpperCase();
    if (!acc[firstLetter]) {
      acc[firstLetter] = [];
    }
    acc[firstLetter].push(project);
    return acc;
  },
  {} as Record<string, Project[]>
);

/* Create wheel sections from grouped projects */
const letters = Object.keys(groupedProjects).sort();

// Calculate total number of sections needed
let totalProjects = 0;
letters.forEach((letter) => {
  totalProjects += groupedProjects[letter].length;
});

// Calculate angle for each section
const anglePerSection = 360 / totalProjects;

// Pre-calculate positions for each project
const wheelItems = [];
let currentAngle = 0;

letters.forEach((letter) => {
  // Create section header with letter divider
  const letterDivider = {
    type: "divider",
    letter,
    angle: currentAngle,
  };
  wheelItems.push(letterDivider);

  // Add projects in this section
  groupedProjects[letter].forEach((project) => {
    wheelItems.push({
      type: "project",
      startAngle: currentAngle,
      endAngle: currentAngle + anglePerSection,
      midAngle: currentAngle + anglePerSection / 2,
      ...project,
    });
    currentAngle += anglePerSection;
  });
});
---

<div class="project-wheel-container">
  <div id="wheelBox" class="wheel-box">
    <div class="wheel-outer-border"></div>
    <div id="projectWheel" class="project-wheel">
      {
        wheelItems.map((item) => {
          if (item.type === "divider") {
            return (
              <div
                class="letter-divider"
                style={`transform: rotate(${item.angle}deg)`}
              >
                <div class="letter-content">
                  <div class="letter">{item.letter}</div>
                </div>
                <div class="divider-line" />
              </div>
            );
          } else {
            // For project slices
            return (
              <div class="project-slice-container">
                <a href={item.url} class="project-link">
                  <svg
                    viewBox="0 0 100 100"
                    class="project-slice"
                    style={`transform: rotate(${item.startAngle}deg)`}
                  >
                    {/* Create a circular sector/slice */}
                    <defs>
                      <clipPath
                        id={`slice-clip-${item.title.replace(/\s+/g, "-").toLowerCase()}`}
                      >
                        <path
                          d={`M 50,50 L 50,0 A 50,50 0 0,1 ${50 + 50 * Math.sin((anglePerSection * Math.PI) / 180)},${50 - 50 * Math.cos((anglePerSection * Math.PI) / 180)} z`}
                        />
                      </clipPath>
                    </defs>

                    {/* Background slice shape */}
                    <path
                      d={`M 50,50 L 50,0 A 50,50 0 0,1 ${50 + 50 * Math.sin((anglePerSection * Math.PI) / 180)},${50 - 50 * Math.cos((anglePerSection * Math.PI) / 180)} z`}
                      class="slice-shape"
                    />

                    {/* Project image clipped to slice shape */}
                    <image
                      href={item.image.src}
                      x="50"
                      y="0"
                      width="100"
                      height="100"
                      preserveAspectRatio="xMidYMid slice"
                      clip-path={`url(#slice-clip-${item.title.replace(/\s+/g, "-").toLowerCase()})`}
                      class="project-image"
                      transform={`rotate(${anglePerSection / 2} 50 50)`}
                    />

                    {/* Text overlay - positioned in the middle of the slice */}
                    <g
                      class="project-text-overlay"
                      transform={`rotate(${anglePerSection / 2} 50 50)`}
                    >
                      <text
                        x="50"
                        y="30"
                        text-anchor="middle"
                        class="project-title"
                      >
                        {item.title}
                      </text>
                      <text
                        x="50"
                        y="40"
                        text-anchor="middle"
                        class="project-description"
                      >
                        {item.description}
                      </text>
                    </g>
                  </svg>
                </a>
              </div>
            );
          }
        })
      }
    </div>
    <div id="scrollTrack" class="scroll-track">
      <div id="scrollHandle" class="scroll-handle"></div>
    </div>
  </div>
</div>

<script>
  // Client-side JavaScript for wheel rotation
  document.addEventListener("DOMContentLoaded", () => {
    // Get all required elements
    const wheelBox = document.getElementById("wheelBox");
    const projectWheel = document.getElementById("projectWheel");
    const scrollHandle = document.getElementById("scrollHandle");
    const scrollTrack = document.getElementById("scrollTrack");
    const wheelContainer = document.querySelector(".project-wheel-container");

    if (
      !wheelBox ||
      !projectWheel ||
      !scrollHandle ||
      !scrollTrack ||
      !wheelContainer
    )
      return;

    // Get the position of the wheel
    const getWheelPosition = () => {
      const rect = wheelContainer.getBoundingClientRect();
      return rect.top + window.scrollY;
    };

    // Initial wheel position
    let wheelTopPosition = getWheelPosition();

    // Update wheel position on resize
    window.addEventListener("resize", () => {
      wheelTopPosition = getWheelPosition();
    });

    // Wheel parameters
    const trackRadius = scrollTrack.offsetWidth / 2;
    const MAX_ROTATION = 720;

    // Track if we've reached the bottom
    let reachedBottom = false;
    let wheelRotation = 0;
    let lastScrollY = window.scrollY;
    let scrollDelta = 0;

    // Calculate the maximum possible scroll position
    const getMaxScroll = () => {
      return document.documentElement.scrollHeight - window.innerHeight;
    };

    // Function to handle scroll events
    function handleScroll(e) {
      // Current scroll position
      const scrollPos = window.scrollY;
      const windowHeight = window.innerHeight;
      const maxScroll = getMaxScroll();

      // Calculate when wheel should be fully visible (when we reach bottom of page)
      const BOTTOM_THRESHOLD = 5; // Pixels from bottom to consider "reached bottom"
      const hasReachedBottom = maxScroll - scrollPos <= BOTTOM_THRESHOLD;

      // If we've reached the bottom and wheel isn't yet visible, make it visible
      if (hasReachedBottom) {
        // We've reached the bottom, enable wheel spinning mode
        if (!reachedBottom) {
          reachedBottom = true;
          wheelBox.style.transform = "translateX(-50%) translateY(0)";

          // Make sure wheel is fully visible
          projectWheel.style.transform = "translate(-50%, -50%) rotate(0deg)";
          scrollHandle.style.transform = "translate(0, -" + trackRadius + "px)";
        }

        // Calculate scroll delta for wheel rotation when at bottom
        scrollDelta = lastScrollY - scrollPos;
        lastScrollY = scrollPos;

        // Update wheel rotation based on scroll delta
        if (reachedBottom) {
          // Each scroll delta contributes to rotation
          const ROTATION_SPEED = 2; // Adjust this value to control rotation speed
          wheelRotation += scrollDelta * ROTATION_SPEED;

          // Keep rotation within 0-360 range
          wheelRotation = wheelRotation % 360;
          if (wheelRotation < 0) wheelRotation += 360;

          // Apply rotation to wheel
          projectWheel.style.transform = `translate(-50%, -50%) rotate(${wheelRotation}deg)`;

          // Update handle position - reversed direction
          const rotationProgress = wheelRotation / 360;
          const radians = Math.PI / 2 - rotationProgress * 2 * Math.PI;
          const x = Math.cos(radians) * trackRadius;
          const y = Math.sin(radians) * trackRadius;
          scrollHandle.style.transform = `translate(${x}px, ${y}px)`;

          // Prevent default scroll when at bottom
          if (e && e.preventDefault) {
            e.preventDefault();
          }
        }
      } else {
        // Not at bottom yet, standard scrolling behavior
        reachedBottom = false;

        // Calculate how far the wheel should move up
        const wheelFullyVisibleAt = maxScroll;
        const wheelScrollProgress = Math.min(
          1,
          scrollPos / wheelFullyVisibleAt
        );
        const translateY = (1 - wheelScrollProgress) * 50;

        // Update wheel position based on scroll
        wheelBox.style.transform = `translateX(-50%) translateY(${translateY}%)`;

        // Reset wheel rotation
        projectWheel.style.transform = "translate(-50%, -50%) rotate(0deg)";
        scrollHandle.style.transform = "translate(0, -" + trackRadius + "px)";

        // Update last scroll position
        lastScrollY = scrollPos;
      }
    }

    // Initial positioning
    handleScroll();

    // Listen for scroll events
    window.addEventListener("scroll", handleScroll);

    // Handle wheel events to control rotation when at bottom
    window.addEventListener(
      "wheel",
      (e) => {
        if (reachedBottom) {
          e.preventDefault();

          // Use wheel delta to control rotation
          const delta = e.deltaY;
          const WHEEL_SENSITIVITY = 0.1; // Adjust sensitivity

          wheelRotation += delta * WHEEL_SENSITIVITY;
          wheelRotation = wheelRotation % 360;
          if (wheelRotation < 0) wheelRotation += 360;

          // Apply rotation to wheel
          projectWheel.style.transform = `translate(-50%, -50%) rotate(${wheelRotation}deg)`;

          // Update handle position - reversed direction
          const rotationProgress = wheelRotation / 360;
          const radians = Math.PI / 2 - rotationProgress * 2 * Math.PI;
          const x = Math.cos(radians) * trackRadius;
          const y = Math.sin(radians) * trackRadius;
          scrollHandle.style.transform = `translate(${x}px, ${y}px)`;
        }
      },
      { passive: false }
    );

    // Add hover effects for the project slices
    const projectSlices = document.querySelectorAll(".project-slice");
    projectSlices.forEach((slice) => {
      slice.addEventListener("mouseenter", () => {
        slice.classList.add("slice-hover");
      });
      slice.addEventListener("mouseleave", () => {
        slice.classList.remove("slice-hover");
      });
    });
  });
</script>

<style>
  /* Container for the whole wheel component */
  .project-wheel-container {
    position: relative;
    width: 100%;
    height: 100vh; /* Full viewport height */
    overflow: hidden;
    margin: 0 auto; /* Center horizontally */
  }

  /* Box that centers and positions the wheel */
  .wheel-box {
    position: absolute;
    bottom: 0%;
    left: 50%;
    transform: translateX(-50%) translateY(50%); /* Center horizontally and start with wheel half visible */
    width: 0; /* Size is controlled by children */
    height: 0;
    transition: transform 0.3s ease-out;
    margin: 0 auto; /* Center horizontally */
  }

  /* Make sure all elements have the same size and are centered properly */
  .wheel-outer-border,
  .project-wheel,
  .scroll-track {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .wheel-outer-border {
    width: 90vw;
    height: 90vw;
    max-width: 90vh;
    max-height: 90vh;
    border: 2px solid var(--color-border);
    z-index: 1;
  }

  .project-wheel {
    width: 85vw; /* Slightly smaller than outer border */
    height: 85vw;
    max-width: 85vh;
    max-height: 85vh;
    z-index: 2;
    transform-origin: center center; /* Explicitly set transform origin */
    transition: transform 0.3s ease;
  }

  .scroll-track {
    width: 90vw; /* Match outer border */
    height: 90vw;
    max-width: 90vh;
    max-height: 90vh;
    z-index: 5;
    pointer-events: none;
  }

  /* Letter divider styling */
  .letter-divider {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
  }

  .letter-content {
    position: absolute;
    width: 3rem;
    height: 3rem;
    top: 0;
    left: 50%;
    margin-left: -1.5rem; /* Center horizontally */
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    color: white;
    border-radius: 50%;
    z-index: 6;
  }

  .divider-line {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 50%;
    background-color: var(--color-primary);
    transform-origin: bottom center;
    z-index: 4;
  }

  .letter {
    font-size: 1.25rem;
    font-weight: 800;
  }

  /* Project slice styling */
  .project-slice-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
  }

  .project-slice {
    width: 100%;
    height: 100%;
    overflow: visible;
    transform-origin: center;
  }

  .slice-shape {
    fill: rgba(255, 255, 255, 0.2);
    stroke: var(--color-primary);
    stroke-width: 0.5;
  }

  .project-image {
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .project-text-overlay {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-slice:hover .project-image {
    opacity: 0.5;
  }

  .project-slice:hover .project-text-overlay {
    opacity: 1;
  }

  .project-title {
    font-size: 3px;
    font-weight: bold;
    fill: white;
    text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.8);
  }

  .project-description {
    font-size: 2px;
    fill: white;
    text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.8);
  }

  /* Project links */
  .project-link {
    display: block;
    color: var(--color-text);
    text-decoration: none;
    width: 100%;
    height: 100%;
  }

  /* Scroll handle */
  .scroll-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    margin-left: -1rem;
    margin-top: -1rem;
    background-color: var(--color-primary);
    border: 3px solid white;
    border-radius: 50%;
    z-index: 10;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
  }

  /* Hover effect for slices */
  .slice-hover .slice-shape {
    fill: rgba(255, 255, 255, 0.4);
    stroke-width: 1;
  }

  /* Make sure content stays readable on smaller screens */
  @media (max-width: 768px) {
    .project-title {
      font-size: 2.5px;
    }

    .project-description {
      font-size: 1.5px;
    }
  }
</style>
