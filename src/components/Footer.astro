---
// src/components/Footer.astro
import { useTranslations, type Locale } from "../i18n/utils";
import AudioPlayer from "./AudioPlayer.astro";

const currentLocale = (Astro.currentLocale as Locale) || "de";
const t = useTranslations(currentLocale);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <p>&copy; {currentYear} Marlon Müller. All rights reserved.</p>
    <p>
      <a href={`/${currentLocale}/privacy-policy`}>{t("footer.privacy")}</a> |
      <a href={`/${currentLocale}/terms-of-service`}>{t("footer.terms")}</a> |
      <a href={`/${currentLocale}/impressum`}>{t("footer.impressum")}</a>
    </p>
  </div>

  <!-- Subtle placeholder for docking the floating audio player -->
  <div id="audio-widget-placeholder" class="audio-widget-placeholder">
    <div class="placeholder-ring"></div>
    <AudioPlayer />
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(
      --color-bg-elevated,
      var(--color-bg, #f8f9fa)
    ); /* Use a background variable */
    position: relative;
    z-index: 50; /* Ensure it covers the fixed wheel */
    color: var(--color-secondary, #475569); /* Use a secondary text color */
    padding: 1rem 1.5rem 1.15rem;
    text-align: center;
    border-top: 1px solid var(--color-project-accent-border, rgba(255,125,26,0.3));
    transition: border-color 0.5s ease;
    font-size: 0.85rem;
  }

  .footer-content {
    max-width: 800px; /* Limit width for readability */
    margin: 0 auto;
  }

  .footer-content p {
    margin: 0.2rem 0;
  }

  .footer-content a {
    color: var(--color-project-accent, var(--color-primary, #007bff));
    text-decoration: none;
    transition: color 0.5s ease;
  }

  .footer-content a:hover {
    text-decoration: underline;
  }

  /* Audio Widget Placeholder */
  .audio-widget-placeholder {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-ring {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px dashed var(--color-project-accent-border, rgba(255, 125, 26, 0.3));
    background-color: rgba(255, 125, 26, 0.03);
    box-shadow: inset 0 0 8px rgba(255, 125, 26, 0.05);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
    pointer-events: none;
  }

  :global(.dark) .placeholder-ring {
    border-color: rgba(255, 125, 26, 0.2);
    background-color: rgba(0, 0, 0, 0.2);
    box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.3);
  }

  /* Snapping hover state glow - use :global because JS toggles this from AudioPlayer script */
  :global(.placeholder-ring.snap-hover) {
    border-color: var(--color-project-accent, #FF7D1A);
    background-color: rgba(255, 125, 26, 0.15);
    transform: scale(1.1);
    box-shadow: 0 0 12px rgba(255, 125, 26, 0.4);
  }

  /* Mobile Layout - Center-align placeholder below the link lists */
  @media (max-width: 768px) {
    .site-footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      padding: 0.4rem 1rem max(0.85rem, calc(env(safe-area-inset-bottom, 0px) + 0.45rem));
      font-size: 0.75rem;
    }

    .footer-content p {
      margin: 0.1rem 0;
    }

    .audio-widget-placeholder {
      position: relative;
      right: auto;
      top: auto;
      transform: none;
      margin-top: 0.15rem;
      width: 36px;
      height: 36px;
    }

    .placeholder-ring {
      width: 32px;
      height: 32px;
    }
  }
</style>
