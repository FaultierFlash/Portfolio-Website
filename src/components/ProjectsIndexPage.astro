---
import Layout from "../layouts/BaseLayout.astro";
import ProjectWheel from "./ProjectWheel/index.astro";
import { getProjects, getTranslationOverrides, urlFor } from "../lib/sanity";
import { useTranslations, type Locale } from "../i18n/utils";

import projectImage1 from "../assets/project3.jpg";
import projectImage2 from "../assets/project2.jpg";
import projectImage3 from "../assets/project1.jpg";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isDe = lang === "de";

const [sanityProjectsData, overrides] = await Promise.all([
  getProjects(lang),
  getTranslationOverrides(lang),
]);
const t = useTranslations(lang, overrides);

const defaultProjects = isDe
  ? [
      {
        title: "Analytics Dashboard",
        description: "Echtzeit-Datenvisualisierungsplattform",
        image: projectImage1,
        url: `/${lang}/projects/analytics-dashboard`,
        tags: ["Analytics", "Dashboard"],
        accentColor: "primary",
      },
      {
        title: "Blog Platform",
        description: "Modernes Content-Management-System",
        image: projectImage2,
        url: `/${lang}/projects/blog-platform`,
        tags: ["CMS", "Web"],
        accentColor: "blue",
      },
      {
        title: "Community Forum",
        description: "Interaktives Diskussionsforum",
        image: projectImage3,
        url: `/${lang}/projects/community-forum`,
        tags: ["Community", "Fullstack"],
        accentColor: "green",
      },
    ]
  : [
      {
        title: "Analytics Dashboard",
        description: "Real-time data visualization platform",
        image: projectImage1,
        url: `/${lang}/projects/analytics-dashboard`,
        tags: ["Analytics", "Dashboard"],
        accentColor: "primary",
      },
      {
        title: "Blog Platform",
        description: "Modern content management system",
        image: projectImage2,
        url: `/${lang}/projects/blog-platform`,
        tags: ["CMS", "Web"],
        accentColor: "blue",
      },
      {
        title: "Community Forum",
        description: "Engagement-focused discussion board",
        image: projectImage3,
        url: `/${lang}/projects/community-forum`,
        tags: ["Community", "Fullstack"],
        accentColor: "green",
      },
    ];

const sanityProjects = (sanityProjectsData || []).map((p: any) => ({
  title: p.title,
  description: p.description,
  image: { src: p.mainImage ? urlFor(p.mainImage).width(1200).quality(85).auto("format").url() : "" },
  url: `/${lang}/projects/${p.slug.current}`,
  externalUrl: p.link || null,
  tags: p.tags || [],
  accentColor: p.accentColor || "primary",
  slug: p.slug?.current,
  date: p.publishDate || p.timelineDate || null,
  isOngoing: Boolean(p.isOngoing),
  documentCount: typeof p.documentCount === "number" ? p.documentCount : 0,
  galleryCount: typeof p.galleryCount === "number" ? p.galleryCount : 0,
}));

const projects = sanityProjects.length > 0 ? sanityProjects : defaultProjects;
const pageTitle = t("paths.projects._title_") || (isDe ? "Projekte" : "Projects");
const pageDescription = isDe
  ? "Interaktives Projekt-Archiv von Marlon Müller – Ingenieurs-, Robotik-, Hackathon- und Software-Projekte an der TUM."
  : "Interactive project archive of Marlon Müller – engineering, bio-inspired robotics, hackathon prototypes, and software projects at TUM.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  backgroundEffect="grid"
  overrides={overrides}
  projects={sanityProjectsData}
>
  <ProjectWheel projects={projects} lang={lang} />
</Layout>
