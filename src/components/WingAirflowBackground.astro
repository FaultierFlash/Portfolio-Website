---
/**
 * WingAirflowBackground.astro
 * Full-viewport monochrome aerodynamic flow background modeling a 20 Hz horizontal
 * flapping-wing stroke plane (270 mm span, 64 mm constant-arc elastic chord, 120° sweep)
 * with passive aeroelastic pitching (~30° effective AoA at mid-stroke) and subtle
 * black-and-white streamlines disturbed by cursor motion.
 */
interface Props {
  phase?: 'scroll' | '01' | '02' | '03' | '04';
  intensity?: number;
  flutter?: number;
  cursorTurbulence?: number;
  showGhosts?: boolean;
  isAbsolute?: boolean;
}

const {
  phase = 'scroll',
  intensity = 1.0,
  flutter = 1.0,
  cursorTurbulence = 1.0,
  showGhosts = true,
  isAbsolute = false,
} = Astro.props;
---

<div
  class={`airflow-container ${isAbsolute ? 'is-absolute' : 'is-fixed'}`}
  data-phase={phase}
  data-intensity={intensity}
  data-flutter={flutter}
  data-cursor-turbulence={cursorTurbulence}
  data-show-ghosts={showGhosts ? 'true' : 'false'}
  aria-hidden="true"
>
  <canvas class="airflow-canvas"></canvas>
</div>

<style>
  .airflow-container {
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: transparent;
    opacity: 0.24;
    transition: opacity 0.3s ease;
  }

  .airflow-container.is-fixed {
    position: fixed;
  }

  .airflow-container.is-absolute {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  :global(.dark) .airflow-container {
    opacity: 0.45;
  }

  .airflow-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  interface WingPhase {
    id: string;
    name: string;
    tRatio: string;
    phiLabel: string;
    badge: string;
    leX: number;
    leY: number;
    inflowDir: number;
    uSpeed: number;
    downwash: number;
    thetaFn: (s: number) => number;
    levOffset: { dx: number; dy: number; gamma: number };
    wakeOffset: { dx: number; dy: number; gamma: number };
    baseTurb: number;
    pts: { x: number; y: number }[];
    te: { x: number; y: number };
  }

  interface BakedField {
    uArr: Float32Array;
    vArr: Float32Array;
    turbArr: Float32Array;
  }

  const CHORD_SEGS = 18;
  const CHORD_UNIT = 1.0; // Constant physical arc length (represents 64 mm chord)
  const DOM_X = 1.65;
  const DOM_Y = 0.96;
  const GRID_W = 88;
  const GRID_H = 54;

  function buildPhases(): WingPhase[] {
    const defs = [
      {
        id: '01',
        name: 'PRONATION',
        tRatio: 't/T = 0.00',
        phiLabel: 'φ = -60° · α ≈ 78°',
        badge: 'REVERSAL',
        leX: -0.34,
        leY: -0.35,
        inflowDir: -1,
        uSpeed: 0.56,
        downwash: 0.28,
        thetaFn: (s: number) => Math.PI * 0.5 + 0.14 * s - 0.18 * Math.sin(Math.PI * s),
        levOffset: { dx: -0.22, dy: 0.30, gamma: 0.45 },
        wakeOffset: { dx: -0.45, dy: 0.70, gamma: -0.42 },
        baseTurb: 1.15,
      },
      {
        id: '02',
        name: 'MID-FORWARD',
        tRatio: 't/T = 0.25',
        phiLabel: 'φ = 0° · α ≈ 30°',
        badge: 'PEAK BEND + LEV',
        leX: 0.35,
        leY: -0.33,
        inflowDir: -1,
        uSpeed: 1.25,
        downwash: 0.55,
        thetaFn: (s: number) => Math.PI * 0.65 + Math.PI * 0.31 * Math.pow(s, 0.75),
        levOffset: { dx: -0.38, dy: 0.12, gamma: 1.05 },
        wakeOffset: { dx: -0.88, dy: 0.56, gamma: -0.48 },
        baseTurb: 0.78,
      },
      {
        id: '03',
        name: 'SUPINATION',
        tRatio: 't/T = 0.50',
        phiLabel: 'φ = +60° · α ≈ 80°',
        badge: 'RECOIL + SHED',
        leX: 0.34,
        leY: -0.35,
        inflowDir: 1,
        uSpeed: 0.56,
        downwash: 0.30,
        thetaFn: (s: number) => Math.PI * 0.5 - 0.14 * s + 0.18 * Math.sin(Math.PI * s),
        levOffset: { dx: 0.22, dy: 0.30, gamma: -0.48 },
        wakeOffset: { dx: 0.18, dy: 0.72, gamma: 0.45 },
        baseTurb: 1.22,
      },
      {
        id: '04',
        name: 'MID-RETURN',
        tRatio: 't/T = 0.75',
        phiLabel: 'φ = 0° · α ≈ 30°',
        badge: 'MIRROR LIFT',
        leX: -0.35,
        leY: -0.33,
        inflowDir: 1,
        uSpeed: 1.25,
        downwash: 0.55,
        thetaFn: (s: number) => Math.PI * 0.35 - Math.PI * 0.31 * Math.pow(s, 0.75),
        levOffset: { dx: 0.38, dy: 0.12, gamma: -1.05 },
        wakeOffset: { dx: 0.88, dy: 0.56, gamma: 0.48 },
        baseTurb: 0.78,
      },
    ];

    const ds = CHORD_UNIT / CHORD_SEGS;
    return defs.map((d) => {
      const pts: { x: number; y: number }[] = [{ x: d.leX, y: d.leY }];
      let x = d.leX;
      let y = d.leY;
      for (let i = 0; i < CHORD_SEGS; i++) {
        const th = d.thetaFn((i + 0.5) / CHORD_SEGS);
        x += Math.cos(th) * ds;
        y += Math.sin(th) * ds;
        pts.push({ x, y });
      }
      return { ...d, pts, te: pts[pts.length - 1] };
    });
  }

  function closestToWing(px: number, py: number, pts: { x: number; y: number }[]) {
    let minSq = Infinity;
    let cx = 0;
    let cy = 0;
    let tx = 1;
    let ty = 0;
    for (let i = 0; i < pts.length - 1; i++) {
      const a = pts[i];
      const b = pts[i + 1];
      const abx = b.x - a.x;
      const aby = b.y - a.y;
      const lenSq = abx * abx + aby * aby || 1e-6;
      const t = Math.max(0, Math.min(1, ((px - a.x) * abx + (py - a.y) * aby) / lenSq));
      const qx = a.x + t * abx;
      const qy = a.y + t * aby;
      const dSq = (px - qx) ** 2 + (py - qy) ** 2;
      if (dSq < minSq) {
        minSq = dSq;
        cx = qx;
        cy = qy;
        const l = Math.sqrt(lenSq);
        tx = abx / l;
        ty = aby / l;
      }
    }
    const dist = Math.sqrt(minSq);
    const nx = dist > 1e-6 ? (px - cx) / dist : -ty;
    const ny = dist > 1e-6 ? (py - cy) / dist : tx;
    return { dist, cx, cy, nx, ny, tx, ty };
  }

  function bakeField(phase: WingPhase): BakedField {
    const uArr = new Float32Array(GRID_W * GRID_H);
    const vArr = new Float32Array(GRID_W * GRID_H);
    const turbArr = new Float32Array(GRID_W * GRID_H);

    const levX = phase.leX + phase.levOffset.dx;
    const levY = phase.leY + phase.levOffset.dy;
    const wakeX = phase.leX + phase.wakeOffset.dx;
    const wakeY = phase.leY + phase.wakeOffset.dy;

    for (let gy = 0; gy < GRID_H; gy++) {
      const py = ((gy / (GRID_H - 1)) * 2 - 1) * DOM_Y;
      for (let gx = 0; gx < GRID_W; gx++) {
        const px = ((gx / (GRID_W - 1)) * 2 - 1) * DOM_X;
        const idx = gy * GRID_W + gx;

        let u = phase.inflowDir * phase.uSpeed;
        let v = phase.downwash * 0.36;

        const dlx = px - levX;
        const dly = py - levY;
        const rlSq = dlx * dlx + dly * dly + 0.055;
        u += (-dly / rlSq) * phase.levOffset.gamma * 0.22;
        v += (dlx / rlSq) * phase.levOffset.gamma * 0.22;

        const dwx = px - wakeX;
        const dwy = py - wakeY;
        const rwSq = dwx * dwx + dwy * dwy + 0.085;
        u += (-dwy / rwSq) * phase.wakeOffset.gamma * 0.20;
        v += (dwx / rwSq) * phase.wakeOffset.gamma * 0.20;

        // Solid-wall tangential boundary enforcement on curved membrane
        const cl = closestToWing(px, py, phase.pts);
        const barrierR = 0.24;
        if (cl.dist < barrierR) {
          const weight = Math.pow(1 - cl.dist / barrierR, 1.5);
          const uDotN = u * cl.nx + v * cl.ny;
          if (uDotN < 0 || cl.dist < 0.09) {
            u -= uDotN * weight * cl.nx;
            v -= uDotN * weight * cl.ny;
          }
          if (cl.dist < 0.08) {
            const push = (1 - cl.dist / 0.08) * 0.65;
            u += cl.nx * push;
            v += cl.ny * push;
          }
          const uDotT = u * cl.tx + v * cl.ty;
          u += cl.tx * uDotT * 0.22 * weight;
          v += cl.ty * uDotT * 0.22 * weight;
        }

        const isDownstream = (px - phase.leX) * phase.inflowDir > 0.02;
        const wallFade = Math.min(1, Math.max(0, (cl.dist - 0.05) / 0.14));
        const levEnv = Math.exp(-((px - levX) ** 2 + (py - levY) ** 2) / 0.20);
        const teEnv = Math.exp(-((px - phase.te.x) ** 2 + (py - phase.te.y) ** 2) / 0.22);
        const wakeEnv = isDownstream ? Math.exp(-((py - 0.15) ** 2) / 0.35) * 0.7 : 0.06;

        uArr[idx] = u;
        vArr[idx] = v;
        turbArr[idx] = phase.baseTurb * wallFade * (0.04 + 0.95 * levEnv + 0.85 * teEnv + wakeEnv);
      }
    }
    return { uArr, vArr, turbArr };
  }

  let sharedPhases: WingPhase[] | null = null;
  let sharedFields: BakedField[] | null = null;
  let cleanupRegistry: (() => void)[] = [];

  function cleanupAirflowBackgrounds() {
    cleanupRegistry.forEach((fn) => fn());
    cleanupRegistry = [];
  }

  function initAirflowBackgrounds() {
    cleanupAirflowBackgrounds();

    const containers = document.querySelectorAll('.airflow-container');
    if (containers.length === 0) return;

    if (!sharedPhases || !sharedFields) {
      sharedPhases = buildPhases();
      sharedFields = sharedPhases.map((p) => bakeField(p));
    }
    const phases = sharedPhases;
    const fields = sharedFields;

    function sampleField(phaseIdx: number, px: number, py: number) {
      const f = fields[phaseIdx];
      const fx = ((px / DOM_X + 1) * 0.5) * (GRID_W - 1);
      const fy = ((py / DOM_Y + 1) * 0.5) * (GRID_H - 1);
      const x0 = Math.max(0, Math.min(GRID_W - 2, fx | 0));
      const y0 = Math.max(0, Math.min(GRID_H - 2, fy | 0));
      const tx = Math.max(0, Math.min(1, fx - x0));
      const ty = Math.max(0, Math.min(1, fy - y0));

      const i00 = y0 * GRID_W + x0;
      const i10 = i00 + 1;
      const i01 = i00 + GRID_W;
      const i11 = i01 + 1;

      const w00 = (1 - tx) * (1 - ty);
      const w10 = tx * (1 - ty);
      const w01 = (1 - tx) * ty;
      const w11 = tx * ty;

      return {
        u: w00 * f.uArr[i00] + w10 * f.uArr[i10] + w01 * f.uArr[i01] + w11 * f.uArr[i11],
        v: w00 * f.vArr[i00] + w10 * f.vArr[i10] + w01 * f.vArr[i01] + w11 * f.vArr[i11],
        turb: w00 * f.turbArr[i00] + w10 * f.turbArr[i10] + w01 * f.turbArr[i01] + w11 * f.turbArr[i11],
      };
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    containers.forEach((node) => {
      const container = node as HTMLElement;
      const canvas = container.querySelector('.airflow-canvas') as HTMLCanvasElement | null;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const phasePref = (container.dataset.phase || 'scroll') as string;
      const intensity = Math.max(0.15, Math.min(3.0, parseFloat(container.dataset.intensity || '1.0') || 1.0));
      const flutterGain = Math.max(0, Math.min(3.0, parseFloat(container.dataset.flutter || '1.0') || 1.0));
      const cursorTurbulence = Math.max(0, Math.min(3.0, parseFloat(container.dataset.cursorTurbulence || '1.0') || 1.0));
      const showGhosts = container.dataset.showGhosts !== 'false';
      const isAbsolute = container.classList.contains('is-absolute');

      let width = 0;
      let height = 0;
      let isVisible = true;
      let rafId: number | null = null;

      const pointer = { x: -9999, y: -9999, vx: 0, vy: 0, active: false, energy: 0 };

      const resize = () => {
        const rect = container.getBoundingClientRect();
        width = Math.max(1, rect.width || window.innerWidth);
        height = Math.max(1, rect.height || window.innerHeight);
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        if (reducedMotion) renderFrame(0);
      };

      const onPointerMove = (e: PointerEvent) => {
        const rect = canvas.getBoundingClientRect();
        const nx = e.clientX - rect.left;
        const ny = e.clientY - rect.top;
        if (nx >= 0 && nx <= rect.width && ny >= 0 && ny <= rect.height) {
          if (pointer.active) {
            pointer.vx = (nx - pointer.x) * 0.45 + pointer.vx * 0.55;
            pointer.vy = (ny - pointer.y) * 0.45 + pointer.vy * 0.55;
          }
          pointer.x = nx;
          pointer.y = ny;
          pointer.active = true;
          pointer.energy = Math.min(1.5, pointer.energy + 0.25);
        } else {
          pointer.active = false;
        }
      };

      const onTouchMove = (e: TouchEvent) => {
        if (!e.touches.length) return;
        const rect = canvas.getBoundingClientRect();
        const nx = e.touches[0].clientX - rect.left;
        const ny = e.touches[0].clientY - rect.top;
        if (pointer.active) {
          pointer.vx = (nx - pointer.x) * 0.45 + pointer.vx * 0.55;
          pointer.vy = (ny - pointer.y) * 0.45 + pointer.vy * 0.55;
        }
        pointer.x = nx;
        pointer.y = ny;
        pointer.active = true;
        pointer.energy = Math.min(1.5, pointer.energy + 0.25);
      };

      const onPointerLeave = () => {
        pointer.active = false;
      };

      function getActivePhaseIdx(): number {
        if (phasePref === '01') return 0;
        if (phasePref === '02') return 1;
        if (phasePref === '03') return 2;
        if (phasePref === '04') return 3;
        if (isAbsolute) return 1; // Hero/slide absolute cards default to peak mid-forward bend

        const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        if (maxScroll < 120) return 1;
        const progress = Math.max(0, Math.min(1, window.scrollY / maxScroll));
        // Sequence across page height: Mid-Forward -> Supination -> Mid-Return -> Pronation
        if (progress < 0.28) return 1;
        if (progress < 0.56) return 2;
        if (progress < 0.84) return 3;
        return 0;
      }

      function renderFrame(timeSec: number) {
        if (!ctx || !width || !height) return;

        const isDark = document.documentElement.classList.contains('dark');
        // Monochrome grayscale ink: near-black in light mode, crisp white in dark mode
        const ink = isDark ? '248, 250, 252' : '15, 23, 42';
        const subInk = isDark ? '203, 213, 225' : '51, 65, 85';

        ctx.clearRect(0, 0, width, height);

        pointer.energy *= 0.94;
        pointer.vx *= 0.88;
        pointer.vy *= 0.88;

        const scale = Math.min(width / (DOM_X * 1.95), height / (DOM_Y * 1.95));
        const cx = width * 0.5;
        const cy = height * 0.5;
        const halfPhysW = (width * 0.5) / scale;
        const halfPhysH = (height * 0.5) / scale;

        const toScreen = (px: number, py: number) => ({
          x: cx + px * scale,
          y: cy + py * scale,
        });

        const phaseIdx = getActivePhaseIdx();
        const phase = phases[phaseIdx];

        // 1. Streamlines (Black & White / Monochrome CFD Ribbon Bands)
        const seedX = (phase.inflowDir < 0 ? 1 : -1) * Math.min(DOM_X * 0.96, halfPhysW * 0.98);
        const isSmall = width < 768;
        const numLines = isSmall ? 22 : 34;
        const steps = isSmall ? 44 : 58;
        const ds = 0.052;
        const minWallDist = 0.036;

        const lowPath = new Path2D();
        const highPath = new Path2D();
        const wakePath = new Path2D();
        const haloPath = new Path2D();

        const cursorPx = pointer.active ? { px: (pointer.x - cx) / scale, py: (pointer.y - cy) / scale } : null;

        for (let r = 0; r < numLines; r++) {
          const frac = (r + 0.5) / numLines;
          let px = seedX;
          let py = (frac * 2 - 1) * Math.min(DOM_Y * 0.94, halfPhysH * 0.94);
          const seedPhase = r * 1.37;
          let prevSx = 0;
          let prevSy = 0;

          for (let s = 0; s < steps; s++) {
            const sample = sampleField(phaseIdx, px, py);
            let u = sample.u;
            let v = sample.v;
            let turb = sample.turb * flutterGain;

            if (cursorPx && cursorTurbulence > 0) {
              const dx = px - cursorPx.px;
              const dy = py - cursorPx.py;
              const rSq = dx * dx + dy * dy;
              const radSq = 0.34;
              if (rSq < radSq) {
                const falloff = Math.exp(-rSq / (radSq * 0.42));
                const d = Math.sqrt(rSq) + 0.08;
                u += ((-dy / d) * 0.72 * falloff + (pointer.vx / scale) * 0.025 * falloff) * cursorTurbulence;
                v += ((dx / d) * 0.72 * falloff + (pointer.vy / scale) * 0.025 * falloff) * cursorTurbulence;
                turb += (1.1 + pointer.energy * 0.9) * falloff * cursorTurbulence;
              }
            }

            const speed = Math.hypot(u, v) || 1e-4;
            const dirX = u / speed;
            const dirY = v / speed;
            const normX = -dirY;
            const normY = dirX;

            const cl = closestToWing(px, py, phase.pts);
            const wallSafety = Math.min(1, Math.max(0, (cl.dist - minWallDist * 1.4) / 0.14));

            const wave =
              Math.sin(s * 0.42 - timeSec * 9.5 + seedPhase) +
              0.45 * Math.cos(s * 0.78 - timeSec * 15.0 + seedPhase * 1.6);
            const disp = wave * turb * wallSafety * 0.022;

            let plotX = px + normX * disp;
            let plotY = py + normY * disp;

            const clPlot = closestToWing(plotX, plotY, phase.pts);
            if (clPlot.dist < minWallDist) {
              plotX = clPlot.cx + clPlot.nx * minWallDist;
              plotY = clPlot.cy + clPlot.ny * minWallDist;
            }

            const scr = toScreen(plotX, plotY);
            if (s > 0) {
              const isDownstreamWake = (px - phase.leX) * phase.inflowDir > 0.12 && turb > 0.25;
              const isHighSpeed = speed > 1.24 || (cl.dist < 0.22 && speed > 1.0);
              const target = isDownstreamWake ? wakePath : isHighSpeed ? highPath : lowPath;
              target.moveTo(prevSx, prevSy);
              target.lineTo(scr.x, scr.y);
              if (r % 2 === 0) {
                haloPath.moveTo(prevSx, prevSy);
                haloPath.lineTo(scr.x, scr.y);
              }
            }
            prevSx = scr.x;
            prevSy = scr.y;

            px += dirX * ds;
            py += dirY * ds;
            const clNext = closestToWing(px, py, phase.pts);
            if (clNext.dist < minWallDist) {
              px = clNext.cx + clNext.nx * minWallDist;
              py = clNext.cy + clNext.ny * minWallDist;
            }
            if (Math.abs(px) > halfPhysW * 1.06 || Math.abs(py) > halfPhysH * 1.06) break;
          }
        }

        const scaleAlpha = Math.min(1.4, Math.max(0.3, intensity));
        ctx.save();
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        // Soft monochrome stream-sheet halo
        ctx.lineWidth = isSmall ? 3.5 : 5.5;
        ctx.strokeStyle = `rgba(${ink}, ${Math.min(0.18, 0.09 * scaleAlpha)})`;
        ctx.stroke(haloPath);

        // Upstream laminar streamlines
        ctx.lineWidth = 0.95;
        ctx.strokeStyle = `rgba(${subInk}, ${Math.min(0.65, 0.34 * scaleAlpha)})`;
        ctx.stroke(lowPath);

        // High-shear / accelerated over-wing streamlines
        ctx.lineWidth = 1.35;
        ctx.strokeStyle = `rgba(${ink}, ${Math.min(0.85, 0.62 * scaleAlpha)})`;
        ctx.stroke(highPath);

        // Trailing turbulent wake streamlines
        ctx.lineWidth = 1.05;
        ctx.strokeStyle = `rgba(${subInk}, ${Math.min(0.70, 0.44 * scaleAlpha)})`;
        ctx.stroke(wakePath);
        ctx.restore();

        // 2. Ghost Sweep Silhouettes along the Horizontal Stroke Plane
        const drawWingMesh = (wp: WingPhase, isGhost: boolean) => {
          const alpha = isGhost
            ? Math.min(0.35, 0.16 * scaleAlpha)
            : Math.min(0.95, 0.78 * scaleAlpha);

          if (!isGhost) {
            const yPlane = toScreen(0, wp.leY).y;
            ctx.save();
            ctx.beginPath();
            ctx.setLineDash([4, 5]);
            ctx.moveTo(width * 0.08, yPlane);
            ctx.lineTo(width * 0.92, yPlane);
            ctx.strokeStyle = `rgba(${subInk}, ${Math.min(0.35, 0.22 * scaleAlpha)})`;
            ctx.lineWidth = 1;
            ctx.stroke();
            ctx.setLineDash([]);

            // Leading-edge sweep velocity vector arrow
            const le = toScreen(wp.leX, wp.leY);
            const dir = -wp.inflowDir;
            const aLen = Math.min(34, scale * 0.40);
            ctx.beginPath();
            ctx.moveTo(le.x, le.y - 10);
            ctx.lineTo(le.x + dir * aLen, le.y - 10);
            ctx.lineTo(le.x + dir * (aLen - 5.5), le.y - 13);
            ctx.moveTo(le.x + dir * aLen, le.y - 10);
            ctx.lineTo(le.x + dir * (aLen - 5.5), le.y - 7);
            ctx.strokeStyle = `rgba(${ink}, ${Math.min(0.85, 0.65 * scaleAlpha)})`;
            ctx.lineWidth = 1.3;
            ctx.stroke();
            ctx.restore();
          }

          // Flexible 64 mm elastic wing blade polyline
          ctx.save();
          ctx.beginPath();
          wp.pts.forEach((pt, idx) => {
            const s = toScreen(pt.x, pt.y);
            if (idx === 0) ctx.moveTo(s.x, s.y);
            else ctx.lineTo(s.x, s.y);
          });
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.lineWidth = isGhost ? 1.5 : 3.0;
          ctx.strokeStyle = `rgba(${ink}, ${alpha})`;
          ctx.stroke();

          // Effective chord dashed line for mid-stroke (~30° AoA)
          if (!isGhost && (wp.id === '02' || wp.id === '04')) {
            const leS = toScreen(wp.leX, wp.leY);
            const teS = toScreen(wp.te.x, wp.te.y);
            ctx.beginPath();
            ctx.setLineDash([2, 4]);
            ctx.moveTo(leS.x, leS.y);
            ctx.lineTo(teS.x, teS.y);
            ctx.strokeStyle = `rgba(${subInk}, ${Math.min(0.45, 0.32 * scaleAlpha)})`;
            ctx.lineWidth = 1;
            ctx.stroke();
            ctx.setLineDash([]);
          }

          // Carbon leading-edge pivot spar node
          const leP = toScreen(wp.leX, wp.leY);
          ctx.beginPath();
          ctx.arc(leP.x, leP.y, isGhost ? 2.2 : 3.8, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${ink}, ${alpha})`;
          ctx.fill();
          ctx.restore();
        };

        if (showGhosts) {
          phases.forEach((gp, gIdx) => {
            if (gIdx !== phaseIdx) drawWingMesh(gp, true);
          });
        }
        drawWingMesh(phase, false);

        // 3. Minimal Monochrome Corner Annotations (away from foreground center text)
        const hudAlpha = Math.min(0.72, 0.45 * scaleAlpha);
        ctx.save();
        ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
        ctx.fillStyle = `rgba(${ink}, ${hudAlpha})`;
        ctx.textAlign = 'left';
        const padX = isSmall ? 14 : 24;
        const bottomY = height - (isSmall ? 14 : 18);
        ctx.fillText(`${phase.id} ${phase.name} · ${phase.phiLabel}`, padX, bottomY);

        if (!isSmall) {
          ctx.textAlign = 'right';
          ctx.fillText(`b = 270 mm · c = 64 mm · Δφ = 120° · f = 20 Hz · ${phase.tRatio}`, width - padX, bottomY);
        }
        ctx.restore();
      }

      const animate = (now: number) => {
        if (!container.isConnected) {
          cleanupInstance();
          return;
        }
        if (isVisible) {
          renderFrame(now * 0.001);
        }
        rafId = requestAnimationFrame(animate);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          isVisible = entries[0]?.isIntersecting ?? true;
        },
        { threshold: 0.01 }
      );
      observer.observe(container);

      const themeObserver = new MutationObserver(() => {
        if (reducedMotion || !isVisible) renderFrame(performance.now() * 0.001);
      });
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

      function cleanupInstance() {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        observer.disconnect();
        themeObserver.disconnect();
        window.removeEventListener('resize', resize);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('touchmove', onTouchMove);
        window.removeEventListener('blur', onPointerLeave);
      }

      cleanupRegistry.push(cleanupInstance);

      window.addEventListener('resize', resize);
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      window.addEventListener('touchmove', onTouchMove, { passive: true });
      window.addEventListener('blur', onPointerLeave);

      resize();
      if (reducedMotion) {
        renderFrame(0);
      } else {
        rafId = requestAnimationFrame(animate);
      }
    });
  }

  document.addEventListener('astro:page-load', initAirflowBackgrounds);
  document.addEventListener('astro:before-swap', cleanupAirflowBackgrounds);

  if (document.readyState !== 'loading') {
    initAirflowBackgrounds();
  }
</script>
