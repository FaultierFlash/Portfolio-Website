---
import { urlFor } from "../lib/sanity";

interface Props {
  books: any[];
  locale: "en" | "de";
}

const { books, locale } = Astro.props;

// Helper to group books and pre-calculate URLs
const groupBooks = (items: any[]) => {
    const enriched = items.map(book => ({
        ...book,
        coverUrl: book.cover ? urlFor(book.cover).width(400).url() : null
    }));

    const grouped: any[] = [];
    const seriesMap = new Map();

    enriched.forEach(book => {
        if (book.series) {
            if (!seriesMap.has(book.series)) {
                seriesMap.set(book.series, []);
            }
            seriesMap.get(book.series).push(book);
        } else {
            grouped.push({ type: 'single', ...book });
        }
    });

    seriesMap.forEach((seriesBooks, seriesName) => {
        // Sort within series by seriesOrder
        seriesBooks.sort((a: any, b: any) => (a.seriesOrder || 0) - (b.seriesOrder || 0));
        grouped.push({
            type: 'series',
            seriesName,
            books: seriesBooks,
            // Use the first book as the representative
            ...seriesBooks[0]
        });
    });

    return grouped;
};

// Group books for the section
const reading = groupBooks(books.filter(b => b.status === 'reading'));
const finished = groupBooks(books.filter(b => b.status === 'finished'));
const shortlist = groupBooks(books.filter(b => b.status === 'shortlist'));

const t = {
  en: {
    title: "Personal Library",
    subtitle: "A curated archive of technical knowledge, engineering theory, and fiction. This list keeps me accountable and my mind sharp.",
    reading: "Current Focus",
    shortlist: "Shortlist",
    finished: "Archives",
    readReview: "Read Thoughts",
    close: "Close",
    progress: "Progress",
    author: "by",
    rating: "Personal Rating",
    series: "Series",
    physical: "Physical"
  },
  de: {
    title: "Persönliche Bibliothek",
    subtitle: "Ein kuratiertes Archiv aus technischem Wissen, Ingenieurstheorie und Belletristik. Diese Liste hält mich diszipliniert und meinen Geist wach.",
    reading: "Aktueller Fokus",
    shortlist: "Shortliste",
    finished: "Archiv",
    readReview: "Gedanken lesen",
    close: "Schließen",
    progress: "Fortschritt",
    author: "von",
    rating: "Persönliche Bewertung",
    series: "Serie",
    physical: "Physisch"
  }
}[locale] || {
    title: "Personal Library",
    subtitle: "A curated archive of technical knowledge, engineering theory, and fiction.",
    reading: "Current Focus",
    shortlist: "Shortlist",
    finished: "Archives",
    readReview: "Read Thoughts",
    close: "Close",
    progress: "Progress",
    author: "by",
    rating: "Personal Rating",
    series: "Series",
    physical: "Physical"
};

const getReview = (book: any) => locale === 'de' ? book.reviewDe : book.reviewEn;
---

<section id="library" class="relative py-24 px-4 overflow-hidden bg-[var(--color-surface)] backdrop-blur-sm border-t border-b border-black/5 dark:border-white/5">
    <div id="library-container" class="max-w-[1600px] mx-auto relative z-10 transition-all duration-700">
        <div class="mb-16 text-center">
            <h2 class="text-4xl md:text-5xl font-black mb-6 tracking-tight text-[var(--color-text)] uppercase italic">
                {t.title}
            </h2>
            <p class="text-lg text-[var(--color-text-dim)] max-w-2xl mx-auto font-medium leading-relaxed">
                {t.subtitle}
            </p>
        </div>

        <div class="flex flex-col lg:flex-row gap-12 items-start relative">
            {/* --- Main Content Area --- */}
            <div id="library-main-content" class="flex-1 w-full transition-all duration-700 ease-in-out">

        {/* --- Currently Reading --- */}
        {reading.length > 0 && (
            <div class="mb-20">
                <h3 class="text-xs font-black uppercase tracking-[0.3em] mb-10 flex items-center gap-4" style="color: var(--color-project-accent)">
                    <span>{t.reading}</span>
                    <span class="h-[1px] flex-1" style="background-color: var(--color-project-accent-border)"></span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {reading.map(item => {
                        return (
                            <div class="group relative bg-[var(--color-card-bg)] rounded-2xl border border-[var(--color-card-border)] p-6 transition-all hover:shadow-2xl hover:shadow-[var(--color-project-accent)]/5">
                                <div class="flex gap-6">
                                    <div class="w-24 h-36 flex-shrink-0 bg-slate-200 dark:bg-slate-800 rounded-lg overflow-hidden shadow-lg transform group-hover:scale-105 transition-transform duration-500">
                                        {item.cover ? (
                                            <img src={urlFor(item.cover).width(200).url()} alt={item.title} class="w-full h-full object-cover" />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-xs opacity-20 uppercase font-black">No Cover</div>
                                        )}
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="text-lg font-black mb-1 line-clamp-2 text-[var(--color-text)]">{item.title}</h4>
                                        <p class="text-sm text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider mb-4">{t.author} {item.author}</p>
                                        
                                        <div class="space-y-2">
                                            <div class="flex justify-between text-[10px] font-black uppercase tracking-widest" style="color: var(--color-project-accent)">
                                                <span>{t.progress}</span>
                                                <span>{item.progress}%</span>
                                            </div>
                                            <div class="w-full h-1.5 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                                                <div class="h-full transition-all duration-1000" style={`width: ${item.progress}%; background-color: var(--color-project-accent)`}></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        )}

        {/* --- Finished Archives --- */}
        {finished.length > 0 && (
            <div class="mb-20">
                <h3 class="text-xs font-black uppercase tracking-[0.3em] mb-10 flex items-center gap-4" style="color: var(--color-project-accent)">
                    <span>{t.finished}</span>
                    <span class="h-[1px] flex-1 bg-black/10 dark:bg-white/10"></span>
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-8 md:gap-x-6 md:gap-y-12">
                    {finished.map((item: any) => {
                        if (item.type === 'series') {
                            return (
                                <div class="series-container col-span-1 border-none bg-transparent p-0 transition-all duration-500" data-series-id={item.seriesName}>
                                    {/* --- Stack View --- */}
                                    <div class="series-stack-view group relative flex flex-col items-center">
                                        <button 
                                            class="open-series-btn relative w-full aspect-[2/3] transition-all duration-500 hover:-translate-y-2"
                                            data-series-name={item.seriesName}
                                        >
                                            <div class="absolute inset-0 bg-slate-300 dark:bg-slate-700 rounded-xl translate-x-3 -translate-y-3 opacity-40 shadow-sm transition-transform group-hover:translate-x-4 group-hover:-translate-y-4"></div>
                                            <div class="absolute inset-0 bg-slate-400 dark:bg-slate-600 rounded-xl translate-x-1.5 -translate-y-1.5 opacity-60 shadow-md transition-transform group-hover:translate-x-2 group-hover:-translate-y-2"></div>
                                            <div class="absolute inset-0 bg-slate-200 dark:bg-slate-800 rounded-xl overflow-hidden shadow-lg border border-black/5 dark:border-white/5 z-10 transition-transform group-hover:scale-[1.02]">
                                                {item.cover ? (
                                                    <img src={urlFor(item.cover).width(300).url()} alt={item.title} class="w-full h-full object-cover" />
                                                ) : (
                                                    <div class="w-full h-full flex items-center justify-center text-[10px] opacity-20 uppercase font-black">{item.seriesName}</div>
                                                )}
                                            </div>
                                            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center backdrop-blur-[2px] z-20 rounded-xl overflow-hidden" style="background-color: var(--color-project-accent-bg); border: 1px solid var(--color-project-accent-border)">
                                                <span class="text-[12px] font-black uppercase tracking-tight text-[var(--color-text)] mb-2">{item.books.length} Books</span>
                                                <span class="text-[8px] font-black uppercase tracking-widest text-[var(--color-text)] px-3 py-1.5 border border-[var(--color-project-accent-border)] rounded-full">Expand Series</span>
                                            </div>
                                        </button>
                                        <h4 class="mt-4 text-[10px] font-black text-center uppercase tracking-widest" style="color: var(--color-project-accent)">{t.series}</h4>
                                        <h4 class="text-xs font-black text-center line-clamp-1 w-full px-2 opacity-70 group-hover:opacity-100 transition-opacity text-[var(--color-text)]">{item.seriesName}</h4>
                                    </div>

                                    {/* --- Expanded Shelf View --- */}
                                    <div class="series-expanded-view hidden opacity-0 scale-95 transition-all duration-500">
                                        <div class="relative bg-[var(--color-card-bg)] rounded-3xl p-8 md:p-12 border border-[var(--color-project-accent-border)] shadow-inner">
                                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                                                <div>
                                                    <h3 class="text-2xl md:text-3xl font-black text-[var(--color-text)] italic uppercase tracking-tight">
                                                        {item.seriesName}
                                                    </h3>
                                                    <p class="text-[10px] font-black uppercase tracking-[0.3em] mt-1" style="color: var(--color-project-accent)">
                                                        {item.books.length} {t.series} Books
                                                    </p>
                                                </div>
                                                <button class="close-series-btn flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-text)]/5 hover:bg-[var(--color-text)]/10 transition-all text-[10px] font-black uppercase tracking-widest text-[var(--color-text)] border border-[var(--color-text)]/5">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                    {t.close} {t.series}
                                                </button>
                                            </div>
                                            
                                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-8 md:gap-x-6 md:gap-y-12">
                                                {item.books.map((book: any) => {
                                                    return (
                                                        <div class="group relative flex flex-col items-center">
                                                            <button 
                                                                class="open-review-btn w-full aspect-[2/3] bg-slate-200 dark:bg-slate-800 rounded-xl overflow-hidden shadow-md mb-4 group-hover:shadow-2xl group-hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-[var(--color-project-accent-border)]"
                                                                data-item={JSON.stringify(book)}
                                                            >
                                                                {book.cover ? (
                                                                    <img src={urlFor(book.cover).width(300).url()} alt={book.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                                                ) : (
                                                                    <div class="w-full h-full flex items-center justify-center text-[10px] opacity-20 uppercase font-bold text-center p-4">{book.title}</div>
                                                                )}
                                                                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]" style="background-color: var(--color-project-accent-bg)">
                                                                    <span class="text-[10px] font-black uppercase tracking-widest px-3 py-2 border border-[var(--color-project-accent-border)] rounded-full text-[var(--color-text)]">{t.readReview}</span>
                                                                </div>
                                                            </button>
                                                            <h4 class="text-[8px] font-black uppercase tracking-widest mb-1" style="color: var(--color-project-accent)">Vol. {book.seriesOrder}</h4>
                                                            <h4 class="text-xs font-black text-center line-clamp-1 w-full px-2 opacity-70 group-hover:opacity-100 transition-opacity text-[var(--color-text)]">{book.title}</h4>
                                                        </div>
                                                    );
                                                })}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            );
                        }

                        return (
                            <div class="group relative flex flex-col items-center">
                                <button 
                                    class="open-review-btn w-full aspect-[2/3] bg-slate-200 dark:bg-slate-800 rounded-xl overflow-hidden shadow-md mb-4 group-hover:shadow-2xl group-hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-[var(--color-project-accent-border)]"
                                    data-item={JSON.stringify(item)}
                                >
                                    {item.cover ? (
                                        <img src={urlFor(item.cover).width(300).url()} alt={item.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center text-[10px] opacity-20 uppercase font-bold text-center p-4">{item.title}</div>
                                    )}
                                    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]" style="background-color: var(--color-project-accent-bg)">
                                        <span class="text-[10px] font-black uppercase tracking-widest px-3 py-2 border border-[var(--color-project-accent-border)] rounded-full text-[var(--color-text)]">{t.readReview}</span>
                                    </div>
                                </button>
                                <h4 class="text-xs font-black text-center line-clamp-1 w-full px-2 opacity-70 group-hover:opacity-100 transition-opacity text-[var(--color-text)]">{item.title}</h4>
                            </div>
                        );
                    })}
                </div>
            </div>
        )}

        {/* --- Shortlist --- */}
        {shortlist.length > 0 && (
            <div class="mb-20">
                <h3 class="text-xs font-black uppercase tracking-[0.3em] mb-10 flex items-center gap-4" style="color: var(--color-project-accent)">
                    <span>{t.shortlist}</span>
                    <span class="h-[1px] flex-1 bg-black/10 dark:bg-white/10"></span>
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-8 md:gap-x-6 md:gap-y-12">
                    {shortlist.map((item: any) => {
                        if (item.type === 'series') {
                            return (
                                <div class="series-container col-span-1 border-none bg-transparent p-0 transition-all duration-500" data-series-id={item.seriesName}>
                                    {/* --- Stack View --- */}
                                    <div class="series-stack-view group relative flex flex-col items-center">
                                        <button 
                                            class="open-series-btn relative w-full aspect-[2/3] transition-all duration-500 hover:-translate-y-2"
                                            data-series-name={item.seriesName}
                                        >
                                            <div class="absolute inset-0 bg-slate-300 dark:bg-slate-700 rounded-xl translate-x-3 -translate-y-3 opacity-40 shadow-sm transition-transform group-hover:translate-x-4 group-hover:-translate-y-4"></div>
                                            <div class="absolute inset-0 bg-slate-400 dark:bg-slate-600 rounded-xl translate-x-1.5 -translate-y-1.5 opacity-60 shadow-md transition-transform group-hover:translate-x-2 group-hover:-translate-y-2"></div>
                                            <div class="absolute inset-0 bg-slate-200 dark:bg-slate-800 rounded-xl overflow-hidden shadow-lg border border-black/5 dark:border-white/5 z-10 transition-transform group-hover:scale-[1.02] grayscale group-hover:grayscale-0 transition-all duration-500">
                                                {item.cover ? (
                                                    <img src={urlFor(item.cover).width(300).url()} alt={item.title} class="w-full h-full object-cover" />
                                                ) : (
                                                    <div class="w-full h-full flex items-center justify-center text-[10px] opacity-20 uppercase font-black">{item.seriesName}</div>
                                                )}
                                            </div>
                                            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center backdrop-blur-[2px] z-20 rounded-xl overflow-hidden" style="background-color: var(--color-project-accent-bg); border: 1px solid var(--color-project-accent-border)">
                                                <span class="text-[12px] font-black uppercase tracking-tight text-[var(--color-text)] mb-2">{item.books.length} Books</span>
                                                <span class="text-[8px] font-black uppercase tracking-widest text-[var(--color-text)] px-3 py-1.5 border border-[var(--color-project-accent-border)] rounded-full text-center mx-2">Expand Series</span>
                                            </div>
                                        </button>
                                        <h4 class="mt-4 text-[10px] font-black text-center uppercase tracking-widest" style="color: var(--color-project-accent)">{t.series}</h4>
                                        <h4 class="text-xs font-black text-center line-clamp-1 w-full px-2 opacity-50 group-hover:opacity-100 transition-opacity text-[var(--color-text)]">{item.seriesName}</h4>
                                    </div>

                                    {/* --- Expanded Shelf View --- */}
                                    <div class="series-expanded-view hidden opacity-0 scale-95 transition-all duration-500">
                                        <div class="relative bg-[var(--color-card-bg)] rounded-3xl p-8 md:p-12 border border-[var(--color-project-accent-border)] shadow-inner">
                                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                                                <div>
                                                    <h3 class="text-2xl md:text-3xl font-black text-[var(--color-text)] italic uppercase tracking-tight">
                                                        {item.seriesName}
                                                    </h3>
                                                    <p class="text-[10px] font-black uppercase tracking-[0.3em] mt-1" style="color: var(--color-project-accent)">
                                                        {item.books.length} {t.series} Books
                                                    </p>
                                                </div>
                                                <button class="close-series-btn flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-text)]/5 hover:bg-[var(--color-text)]/10 transition-all text-[10px] font-black uppercase tracking-widest text-[var(--color-text)] border border-[var(--color-text)]/5">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                    {t.close} {t.series}
                                                </button>
                                            </div>
                                            
                                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-8 md:gap-x-6 md:gap-y-12">
                                                {item.books.map((book: any) => {
                                                    return (
                                                        <div class="group relative flex flex-col items-center">
                                                            <div class="relative w-full aspect-[2/3] bg-slate-200 dark:bg-slate-800 rounded-xl overflow-hidden shadow-md mb-4 group-hover:shadow-2xl group-hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-[var(--color-project-accent-border)]">
                                                                {book.cover ? (
                                                                    <img src={urlFor(book.cover).width(300).url()} alt={book.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                                                ) : (
                                                                    <div class="w-full h-full flex items-center justify-center text-[10px] opacity-20 uppercase font-bold text-center p-4">{book.title}</div>
                                                                )}
                                                                {book.physicalCopy && (
                                                                    <div class="absolute top-2 right-2 flex items-center gap-1.5 px-2 py-1 rounded-full bg-white/90 dark:bg-black/80 border border-black/5 dark:border-white/10 z-10 backdrop-blur-sm" title={t.physical}>
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--color-project-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                                                        <span class="text-[8px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-300">{t.physical}</span>
                                                                    </div>
                                                                )}
                                                            </div>
                                                            <h4 class="text-[8px] font-black uppercase tracking-widest mb-1" style="color: var(--color-project-accent)">Vol. {book.seriesOrder}</h4>
                                                            <h4 class="text-xs font-black text-center line-clamp-1 w-full px-2 opacity-50 group-hover:opacity-100 transition-opacity text-[var(--color-text)]">{book.title}</h4>
                                                        </div>
                                                    );
                                                })}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            );
                        }

                        return (
                            <div class="group relative flex flex-col items-center">
                                <div class="relative w-full aspect-[2/3] bg-slate-200 dark:bg-slate-800 rounded-xl overflow-hidden shadow-md mb-4 group-hover:shadow-2xl group-hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-[var(--color-project-accent-border)] grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-500">
                                    {item.cover ? (
                                        <img src={urlFor(item.cover).width(300).url()} alt={item.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center text-[10px] opacity-20 uppercase font-bold text-center p-4">{item.title}</div>
                                    )}
                                    {item.physicalCopy && (
                                        <div class="absolute top-2 right-2 flex items-center gap-1.5 px-2 py-1 rounded-full bg-white/90 dark:bg-black/80 border border-black/5 dark:border-white/10 z-10 backdrop-blur-sm" title={t.physical}>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--color-project-accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                            <span class="text-[8px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-300">{t.physical}</span>
                                        </div>
                                    )}
                                </div>
                                <h4 class="text-xs font-black text-center line-clamp-1 w-full px-2 opacity-50 group-hover:opacity-100 transition-opacity text-[var(--color-text)]">{item.title}</h4>
                            </div>
                        );
                    })}
                </div>
            </div>
        )}
    </div> {/* end library-main-content (112) */}
    </div> {/* end flex gap-12 (110) */}
</div> {/* end library-container (100) */}

{/* --- Side Detail Panel --- */}
<aside id="review-panel" class="fixed top-[var(--header-height,60px)] right-0 h-[calc(100vh-var(--header-height,60px))] w-full lg:w-[450px] xl:w-[500px] z-[100] translate-x-full opacity-0 pointer-events-none transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] bg-[var(--color-bg)]/98 backdrop-blur-2xl border-l border-black/10 dark:border-white/20 flex flex-col" style="box-shadow: var(--panel-shadow)">
    <div class="flex-1 overflow-y-auto custom-scrollbar p-8 md:p-10 relative">
        <div id="panel-content">
            <div id="single-book-view" class="flex flex-col gap-10">
                <div id="modal-cover" class="w-full aspect-[2/3] max-w-[280px] mx-auto bg-slate-200 dark:bg-slate-800 rounded-3xl overflow-hidden shadow-2xl transform rotate-1"></div>
                <div class="flex-1">
                    <div id="modal-genres" class="flex flex-wrap gap-2 mb-6"></div>
                    <h3 id="modal-title" class="text-3xl font-black text-[var(--color-text)] mb-3 leading-tight tracking-tight italic uppercase"></h3>
                    <p id="modal-author" class="text-xs font-black uppercase tracking-[0.3em] mb-8" style="color: var(--color-project-accent)"></p>
                    
                    <div class="mb-10 bg-black/5 dark:bg-white/5 p-6 rounded-2xl border border-black/5 dark:border-white/5">
                        <div class="text-[8px] font-black uppercase tracking-[0.4em] text-slate-400 mb-4">{t.rating}</div>
                        <div id="modal-rating" class="flex gap-2 text-[var(--color-project-accent)]"></div>
                    </div>
                    
                    <div class="prose prose-slate dark:prose-invert max-w-none">
                        <p id="modal-review" class="text-lg leading-relaxed font-medium whitespace-pre-line text-[var(--color-text-dim)]"></p>
                    </div>
                </div>
            </div>

            <div id="series-books-view" class="hidden">
                <h3 id="modal-series-name" class="text-3xl font-black text-[var(--color-text)] mb-4 italic uppercase"></h3>
                <p class="text-[10px] font-black uppercase tracking-widest mb-10 flex items-center gap-4" style="color: var(--color-project-accent)">
                    <span>{t.series} Books</span>
                    <span class="h-[1px] flex-1 bg-black/5 dark:bg-white/5"></span>
                </p>
                <div id="series-grid" class="flex flex-col gap-4"></div>
            </div>
        </div>

        <button class="absolute top-8 right-8 p-3 rounded-full bg-[var(--color-text)]/10 hover:bg-[var(--color-text)]/20 transition-all close-panel-btn hover:rotate-90 group z-20 border border-[var(--color-text)]/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-text)] opacity-70 group-hover:opacity-100 transition-opacity"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <button id="modal-back-btn" class="hidden absolute top-6 left-6 flex items-center gap-2 px-5 py-2 rounded-full bg-[var(--color-text)]/5 hover:bg-[var(--color-text)]/10 transition-all border border-[var(--color-text)]/10 z-10">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-text)]"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                <span class="text-[8px] font-black uppercase tracking-widest text-[var(--color-text)]">Back</span>
        </button>
    </div>
</aside>
</section>

<script>
    function initLibrary() {
        const panel = document.getElementById('review-panel');
        if (!panel) return;

        // Teleport the panel to body to ensure fixed positioning works regardless of parent transforms
        if (panel.parentElement !== document.body) {
            document.body.appendChild(panel);
        }

        const closeBtns = document.querySelectorAll('.close-panel-btn');
        const openBtns = document.querySelectorAll('.open-review-btn');
        const openSeriesBtns = document.querySelectorAll('.open-series-btn');
        const libraryContainer = document.getElementById('library-container');
        const backBtn = document.getElementById('modal-back-btn');

        const singleView = document.getElementById('single-book-view');
        const seriesView = document.getElementById('series-books-view');
        const seriesGrid = document.getElementById('series-grid');
        const modalSeriesName = document.getElementById('modal-series-name');

        const modalTitle = document.getElementById('modal-title');
        const modalAuthor = document.getElementById('modal-author');
        const modalReview = document.getElementById('modal-review');
        const modalRating = document.getElementById('modal-rating');
        const modalGenres = document.getElementById('modal-genres');
        const modalCover = document.getElementById('modal-cover');

        function showBook(book: any, isFromSeries = false) {
            if (!singleView || !seriesView || !backBtn) return;

            singleView.classList.remove('hidden');
            seriesView.classList.add('hidden');
            backBtn.classList.toggle('hidden', !isFromSeries);

            if (modalTitle) modalTitle.textContent = book.title;
            if (modalAuthor) modalAuthor.textContent = book.author;
            const review = document.documentElement.lang === 'de' ? book.reviewDe : book.reviewEn;
            if (modalReview) modalReview.textContent = review || 'No thoughts recorded yet.';
            
            if (modalRating) {
                modalRating.innerHTML = '';
                for (let i = 1; i <= 5; i++) {
                    const star = document.createElement('span');
                    const isFilled = i <= (book.rating || 0);
                    star.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="${isFilled ? 'var(--color-project-accent)' : 'none'}" stroke="${isFilled ? 'var(--color-project-accent)' : 'currentColor'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                    `;
                    modalRating.appendChild(star);
                }
            }

            if (modalGenres) {
                modalGenres.innerHTML = '';
                (book.genres || []).forEach((genre: string) => {
                    const tag = document.createElement('span');
                    tag.className = 'text-[8px] font-black uppercase tracking-widest px-2 py-1 rounded bg-black/5 dark:bg-white/10 text-slate-500 dark:text-slate-400';
                    tag.textContent = genre;
                    modalGenres.appendChild(tag);
                });
            }
        }

        function openPanel() {
            if (!panel) return;
            panel.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
            panel.classList.add('translate-x-0', 'opacity-100');
            
            if (libraryContainer && window.innerWidth >= 1024) {
                const shiftWidth = window.innerWidth >= 1280 ? '500px' : '450px';
                libraryContainer.style.paddingRight = shiftWidth;
            }

            if (window.innerWidth < 1024) {
                panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function closePanel() {
            if (!panel) return;
            panel.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
            panel.classList.remove('translate-x-0', 'opacity-100');
            
            if (libraryContainer) {
                libraryContainer.style.paddingRight = '0';
            }
        }

        // Attach events
        openBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const item = JSON.parse((btn as HTMLElement).dataset.item || '{}');
                const coverUrl = btn.querySelector('img')?.src;
                showBook(item, false);
                if (modalCover) {
                modalCover.innerHTML = coverUrl ? `<img src="${coverUrl}" class="w-full h-full object-cover" />` : '<div class="w-full h-full flex items-center justify-center opacity-10 uppercase font-black">#</div>';
                }
                openPanel();
            });
        });

        openSeriesBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const container = btn.closest('.series-container');
                if (!container) return;

                document.querySelectorAll('.series-container.is-expanded').forEach(other => {
                    if (other !== container) {
                        other.classList.remove('is-expanded');
                        const otherExpanded = other.querySelector('.series-expanded-view');
                        const otherStack = other.querySelector('.series-stack-view');
                        if (otherExpanded) {
                            otherExpanded.classList.add('hidden', 'opacity-0', 'scale-95');
                        }
                        if (otherStack) {
                            otherStack.classList.remove('hidden');
                        }
                    }
                });

                const stackView = container.querySelector('.series-stack-view');
                const expandedView = container.querySelector('.series-expanded-view');

                if (stackView && expandedView) {
                    container.classList.add('is-expanded');
                    stackView.classList.add('hidden');
                    expandedView.classList.remove('hidden');
                    
                    requestAnimationFrame(() => {
                        expandedView.classList.remove('opacity-0', 'scale-95');
                    });

                    setTimeout(() => {
                        container.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 100);
                }
            });
        });

        document.querySelectorAll('.close-series-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const container = btn.closest('.series-container');
                const stackView = container?.querySelector('.series-stack-view');
                const expandedView = container?.querySelector('.series-expanded-view');

                if (container && stackView && expandedView) {
                    expandedView.classList.add('opacity-0', 'scale-95');
                    
                    setTimeout(() => {
                        expandedView.classList.add('hidden');
                        stackView.classList.remove('hidden');
                        container.classList.remove('is-expanded');
                    }, 500);
                }
            });
        });

        backBtn?.addEventListener('click', () => {
            singleView?.classList.add('hidden');
            closePanel();
        });

        closeBtns.forEach(btn => btn.addEventListener('click', closePanel));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });
    }

    // Initialize on load and on swap
    document.addEventListener('astro:page-load', initLibrary);
    // Cleanup on navigation to prevent duplicate panels in body
    document.addEventListener('astro:before-swap', () => {
        const panel = document.body.querySelector('#review-panel');
        if (panel) panel.remove();
    });
</script>

<style>
    .shadow-3xl {
        box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.5);
    }
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--color-project-accent-bg);
        border: 1px solid var(--color-project-accent-border);
        border-radius: 20px;
    }

    .series-container.is-expanded {
        grid-column: 1 / -1;
    }
</style>
