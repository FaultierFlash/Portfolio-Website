---
// src/components/ThemeToggle.astro
interface Props {
  id?: string;
  className?: string;
}
const { id = "theme-toggle", className = "" } = Astro.props;
---

<button id={id} class={`theme-toggle-btn ${className}`} aria-label="Switch theme">
  <svg
    class="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    ><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"
    ></line><line x1="12" y1="21" x2="12" y2="23"></line><line
      x1="4.22"
      y1="4.22"
      x2="5.64"
      y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
    ></line><line x1="1" y1="12" x2="3" y2="12"></line><line
      x1="21"
      y1="12"
      x2="23"
      y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
    ></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg
  >
  <svg
    class="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
  >
</button>

<style>
  .theme-toggle-btn,
  #theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;
    color: var(--color-text);
    position: relative;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .theme-toggle-btn:hover,
  #theme-toggle:hover {
    background-color: var(--color-project-accent-bg, rgba(255, 125, 26, 0.08));
    color: var(--color-project-accent, #FF7D1A);
  }

  .sun-icon,
  .moon-icon {
    height: 1.25rem;
    width: 1.25rem;
  }

  .sun-icon {
    display: none;
  }
  .moon-icon {
    display: block;
  }

  :global(html.dark) .sun-icon {
    display: block;
  }
  :global(html.dark) .moon-icon {
    display: none;
  }

  /* View Transitions Specific Styles */
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  :global(::view-transition-old(root)) {
    z-index: 1;
  }
  :global(::view-transition-new(root)) {
    z-index: 9999;
  }
</style>

<script>
  function setupThemeToggle() {
    const themeButtons = document.querySelectorAll(
      ".theme-toggle-btn, #theme-toggle",
    );
    const themeStorageKey = "theme";

    if (themeButtons.length === 0) return;

    const clickHandler = async () => {
      // Fallback for browsers without View Transitions
      if (!document.startViewTransition) {
        toggleTheme();
        return;
      }

      // Start the view transition
      const transition = document.startViewTransition(async () => {
        toggleTheme();
      });

      // Wait for the pseudo-elements to be created
      await transition.ready;

      // Calculate radius to cover the screen from the center
      const maxRadius = Math.hypot(window.innerWidth / 2, window.innerHeight / 2);
      const pauseRadius = maxRadius * 0.3;

      // Animate the circle clip-path from exact screen center (50% 50%)
      // 0% -> 30% (fast)
      // 30% -> 30% (pause)
      // 30% -> 100% (fast)
      document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at 50% 50%)`,
            `circle(${pauseRadius}px at 50% 50%)`,
            `circle(${pauseRadius}px at 50% 50%)`,
            `circle(${maxRadius}px at 50% 50%)`,
          ],
          offset: [
            0,
            0.35, // Reach 30% a bit slower for smoothness
            0.75, // Hold for longer (40% of total time)
            1.0,
          ],
          easing: "cubic-bezier(0.25, 0.1, 0.25, 1)", // Apply global fluid easing, effective for the moving parts
        },
        {
          duration: 1500, // Increased duration for better visibility
          pseudoElement: "::view-transition-new(root)",
        },
      );
    };

    function toggleTheme() {
      const htmlElement = document.documentElement;
      const isCurrentlyDark = htmlElement.classList.contains("dark");
      const newTheme = isCurrentlyDark ? "light" : "dark";

      htmlElement.classList.toggle("dark", newTheme === "dark");
      localStorage.setItem(themeStorageKey, newTheme);

      themeButtons.forEach((btn) => {
        btn.setAttribute(
          "aria-label",
          `Switch to ${newTheme === "dark" ? "light" : "dark"} theme`,
        );
      });
    }

    // Set initial aria-label
    const currentTheme =
      localStorage.getItem(themeStorageKey) ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");

    themeButtons.forEach((btn) => {
      if ((btn as any)._themeClickHandler) {
        btn.removeEventListener("click", (btn as any)._themeClickHandler);
      }
      btn.setAttribute(
        "aria-label",
        `Switch to ${currentTheme === "dark" ? "light" : "dark"} theme`,
      );
      (btn as any)._themeClickHandler = clickHandler;
      btn.addEventListener("click", clickHandler);
    });
  }

  // Lifecycle listeners
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupThemeToggle);
  } else {
    setupThemeToggle();
  }
  document.addEventListener("astro:page-load", setupThemeToggle);

  document.addEventListener("astro:before-swap", () => {
    const themeButtons = document.querySelectorAll(
      ".theme-toggle-btn, #theme-toggle",
    );
    themeButtons.forEach((btn) => {
      if ((btn as any)._themeClickHandler) {
        btn.removeEventListener("click", (btn as any)._themeClickHandler);
      }
    });
  });
</script>

