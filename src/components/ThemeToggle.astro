---
// src/components/ThemeToggle.astro
---

<button id="theme-toggle" aria-label="Theme wechseln">
  <svg
    class="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg
    class="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  #theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;
    color: var(--color-text);
  }

  #theme-toggle:hover {
    background-color: var(--color-border);
  }

  .sun-icon,
  .moon-icon {
    height: 1.25rem;
    width: 1.25rem;
  }

  /* Standardmäßig Sonnen-Symbol für Dark Mode */
  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  /* Im Dark-Mode das Mond-Symbol anzeigen */
  :global(.dark) .sun-icon {
    display: block;
  }

  :global(.dark) .moon-icon {
    display: none;
  }
</style>

<script>
  // Client-side JavaScript für den Theme-Wechsel
  document.addEventListener("DOMContentLoaded", () => {
    const themeToggle = document.getElementById("theme-toggle");

    if (themeToggle) {
      themeToggle.addEventListener("click", () => {
        // Aktuelles Theme abrufen und wechseln
        const isDark = document.documentElement.classList.contains("dark");
        const newTheme = isDark ? "light" : "dark";

        // Theme umschalten
        document.documentElement.classList.toggle("dark");

        // Theme in localStorage speichern
        localStorage.setItem("theme", newTheme);
      });
    }
  });
</script>
