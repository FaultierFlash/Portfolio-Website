---
// src/components/ThemeToggle.astro
---

<button id="theme-toggle" aria-label="Theme wechseln">
  <svg
    class="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg
    class="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  #theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;
    color: var(--color-text);
  }

  #theme-toggle:hover {
    background-color: var(--color-border);
  }

  .sun-icon,
  .moon-icon {
    height: 1.25rem;
    width: 1.25rem;
  }

  /* By default, moon icon is shown (implying light mode is active) */
  .sun-icon {
    display: none;
  }
  .moon-icon {
    display: block;
  }

  /* When dark mode is active, show sun icon */
  :global(html.dark) .sun-icon {
    /* More specific selector using html.dark */
    display: block;
  }
  :global(html.dark) .moon-icon {
    display: none;
  }
</style>

<script>
  // Store the click handler function to be able to remove it
  let themeToggleClickHandler = null;

  function setupThemeToggle() {
    const themeToggle = document.getElementById("theme-toggle");
    const htmlElement = document.documentElement;

    if (themeToggle) {
      // Remove existing listener if one was attached by this script instance
      if (themeToggleClickHandler) {
        themeToggle.removeEventListener("click", themeToggleClickHandler);
        console.log("ThemeToggle: Removed old click listener.");
      }

      // Define the new click handler
      themeToggleClickHandler = () => {
        const isDark = htmlElement.classList.contains("dark");
        const newTheme = isDark ? "light" : "dark";

        htmlElement.classList.toggle("dark", newTheme === "dark");
        localStorage.setItem("theme", newTheme);

        // Update ARIA label (BaseLayout might also do this, but good for component encapsulation)
        themeToggle.setAttribute(
          "aria-label",
          `Switch to ${newTheme === "dark" ? "light" : "dark"} theme`
        );
        console.log("ThemeToggle: Clicked! Theme set to", newTheme);
      };

      themeToggle.addEventListener("click", themeToggleClickHandler);
      console.log("ThemeToggle: Click listener (re-)attached.");

      // Set initial ARIA label based on current theme (ThemeScript.astro handles initial class)
      const initialTheme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      themeToggle.setAttribute(
        "aria-label",
        `Switch to ${initialTheme === "dark" ? "light" : "dark"} theme`
      );
    } else {
      console.log("ThemeToggle: Button not found.");
    }
  }

  // Run on initial load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupThemeToggle);
  } else {
    setupThemeToggle(); // If DOM already loaded
  }

  // Run on Astro page transitions
  document.addEventListener("astro:page-load", () => {
    console.log(
      "ThemeToggle: astro:page-load event triggered. Setting up theme toggle."
    );
    setupThemeToggle();
  });

  // Optional: Cleanup on astro:before-swap if the element might persist
  // and you want to be absolutely sure the listener is gone from the *old* instance.
  // However, if Astro always replaces the element, this might not be strictly necessary
  // as the old element and its listeners are discarded.
  document.addEventListener("astro:before-swap", () => {
    const themeToggle = document.getElementById("theme-toggle");
    if (themeToggle && themeToggleClickHandler) {
      themeToggle.removeEventListener("click", themeToggleClickHandler);
      console.log("ThemeToggle: Cleaned up listener on astro:before-swap.");
      themeToggleClickHandler = null; // Reset the stored handler
    }
  });
</script>
