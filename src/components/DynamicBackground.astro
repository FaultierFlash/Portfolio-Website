---
import TopographicRipple from './TopographicRipple.astro';

interface Props {
  effect?: 'none' | 'grid' | 'dots' | 'topography' | string | null;
  isAbsolute?: boolean;
  config?: {
    source: any;
    latitude?: number;
    longitude?: number;
    intensity?: number;
    scale?: number;
  };
}

const { effect = 'none', isAbsolute = false, config } = Astro.props;
---

{effect === 'topography' ? (
  <div class={`dynamic-background topography-wrapper ${isAbsolute ? 'is-absolute' : 'is-fixed'}`}>
    <TopographicRipple 
      source={config?.source}
      lat={config?.latitude}
      lng={config?.longitude}
      intensity={config?.intensity}
      scale={config?.scale}
    />
  </div>
) : (
  effect !== 'none' && effect && (
    <div class={`dynamic-background ${effect} ${isAbsolute ? 'is-absolute' : 'is-fixed'}`} aria-hidden="true"></div>
  )
)}

<style>
  .dynamic-background {
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-color: transparent;
  }

  .dynamic-background.is-fixed {
    position: fixed;
  }

  .dynamic-background.is-absolute {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .dynamic-background.grid {
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, var(--color-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
    opacity: 0.2;
    mask-image: radial-gradient(circle at center, black 60%, transparent 95%);
    -webkit-mask-image: radial-gradient(circle at center, black 60%, transparent 95%);
  }

  :global(.dark) .dynamic-background.grid {
    opacity: 0.4; 
  }

  .dynamic-background.dots {
    background-size: 20px 20px;
    background-image: radial-gradient(var(--color-text) 1px, transparent 1px);
    opacity: 0.15;
    mask-image: radial-gradient(circle at center, black 50%, transparent 90%);
    -webkit-mask-image: radial-gradient(circle at center, black 50%, transparent 90%);
  }

  :global(.dark) .dynamic-background.dots {
    opacity: 0.3;
  }
</style>
