---
// components/ProjectWheel/index.astro
// ... (rest of the component script remains the same)
import LetterDivider from "./LetterDivider.astro";
import ProjectSlice from "./ProjectSlice.astro";
import { sortProjects, groupProjectsByLetter, createWheelItems } from "./utils";

// Define the Project type
interface Project {
  title: string;
  description: string;
  image: any;
  url: string;
}

// You can pass in projects as a prop
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const sortedProjects = sortProjects(projects);
const groupedProjects = groupProjectsByLetter(sortedProjects);

// Calculate total number of projects
let totalProjects = 0;
Object.keys(groupedProjects).forEach((letter) => {
  totalProjects += groupedProjects[letter].length;
});

// Calculate angle for each section
const anglePerSection = 360 / totalProjects;

// Create wheel items from grouped projects
const wheelItems = createWheelItems(groupedProjects, anglePerSection);
---

<div class="project-wheel-container">
  <div id="wheelBox" class="wheel-box">
    <div class="wheel-outer-border"></div>
    <div id="projectWheel" class="project-wheel">
      {
        wheelItems.map((item) => {
          if (item.type === "divider") {
            return <LetterDivider letter={item.letter} angle={item.angle} />;
          } else {
            return (
              <ProjectSlice project={item} anglePerSection={anglePerSection} />
            );
          }
        })
      }
    </div>
    <div id="scrollTrack" class="scroll-track">
      <div id="scrollHandle" class="scroll-handle"></div>
    </div>
  </div>
</div>

<script>
  import { initializeWheel } from "./wheel";
  initializeWheel();
</script>

<style>
  /* Container for the whole wheel component */
  .project-wheel-container {
    position: relative;
    width: 100%;
    height: 100vh; /* Full viewport height */
    overflow: hidden;
    /* Padding to prevent touching edges */
    padding: 0 0; /* Keep padding */
    box-sizing: border-box; /* Ensure padding is included in width */
    margin: 0 auto; /* Center horizontally */
  }

  /* Box that centers and positions the wheel */
  .wheel-box {
    position: absolute;
    bottom: 0%;
    left: 50%;
    transform: translateX(-50%) translateY(50%);
    /* Keep width/height 0, its size is defined by positioned children */
    width: 0;
    height: 0;
    transition: transform 0.3s ease-out;
    margin: 0 auto;
  }

  /* Base styles for wheel elements */
  .wheel-outer-border,
  .project-wheel,
  .scroll-track {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    /* Use vw units for base size, significantly reduced */
  }

  .wheel-outer-border {
    /* Further reduced vw to give more space for padding */
    width: 75vw;
    height: 75vw;
    /* Max size constraints using vh and px */
    max-width: min(150vh, 1600px); /* Adjusted vh to match vw */
    max-height: min(150vh, 1600px);
    border: 2px solid var(--color-border);
    z-index: 1;
  }

  .project-wheel {
    /* Further reduced vw */
    width: 70vw; /* Slightly smaller than outer border */
    height: 70vw;
    /* Max size constraints using vh and px */
    max-width: min(140vh, 1500px); /* Adjusted vh to match vw */
    max-height: min(140vh, 1500px);
    z-index: 2;
    transform-origin: center center;
    transition: transform 0.3s ease;
  }

  .scroll-track {
    /* Further reduced vw */
    width: 75vw; /* Match outer border */
    height: 75vw;
    /* Max size constraints using vh and px */
    max-width: min(150vh, 1600px); /* Adjusted vh to match vw */
    max-height: min(150vh, 1600px);
    z-index: 5;
    pointer-events: none;
  }

  /* Scroll handle */
  .scroll-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    margin-left: -1rem;
    margin-top: -1rem;
    background-color: var(--color-primary);
    border: 3px solid white;
    border-radius: 50%;
    z-index: 10;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
    /* Initial position will be set precisely by JS after radius calculation */
    transform: translate(0px, 0px); /* Default to center, JS will fix */
  }
</style>
