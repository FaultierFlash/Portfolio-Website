---
// components/ProjectWheel/index.astro
// ... (rest of the component script remains the same)
// components/ProjectWheel/index.astro
// ... (rest of the component script remains the same)
import ProjectSlice from "./ProjectSlice.astro";
import { processProjects } from "./utils";

// Define the Project type
interface Project {
  title: string;
  description: string;
  image: any;
  url: string;
}

// You can pass in projects as a prop
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Process projects: assign angles (0, 120, 240, 360...)
const wheelItems = processProjects(projects);

// Configuration constant
const ANGLE_PER_SECTION = 120;
---

<div class="project-wheel-container">
  <div class="wheel-trigger-zone">
    <div id="wheelBox" class="wheel-box">
      {
        /* Removed Outer Border and Scroll Track for cleaner look per "seamless" request */
      }
      {/* If user wants them back, we can re-add. Focus on content. */}
      <div id="projectWheel" class="project-wheel">
        {/* STATIC BORDER RING: A continuous circle behind the slices */}
        <svg viewBox="0 0 100 100" class="static-border-ring">
          {/* Radius 49 matches the previous "Scale 0.98" of 50 */}
          <circle cx="50" cy="50" r="49" class="wheel-border-stroke"></circle>
        </svg>

        {
          wheelItems.map((item) => {
            return (
              <ProjectSlice
                project={item}
                anglePerSection={ANGLE_PER_SECTION}
              />
            );
          })
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { initializeWheel } from "./wheel";
  initializeWheel();
</script>

<style>
  /* Container for the whole wheel component */
  /* Container for the whole wheel component */
  .project-wheel-container {
    position: relative;
    width: 100%;
    /* We don't set height 100vh here, we let the page flow until key point? 
       Actually, to support the scroll logic, we usually need a defined height/spacer.
       But for now, sticking to the existing Overlay/Fixed pattern handled by JS. */
    height: 100vh;
    overflow: hidden;
    padding: 0;
    margin: 0 auto;
    /* Basic flex center if needed */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .wheel-box {
    position: fixed; /* Fixed by default? Or JS toggled? JS handles it. */
    /* Start at bottom of viewport. JS will animate translateY from 100vh (hidden) to 0 (shown). */
    bottom: 15vh; /* Centered roughly at start of footer (assuming footer ~30vh or user preference) */
    left: 50%;
    transform: translateX(-50%) translateY(100vh);
    width: 0;
    height: 0;
    /* transition: transform 0.3s ease-out;  <-- Remove transition for direct scroll control */
    margin: 0 auto;
    z-index: 1; /* Low z-index to stay behind other content (like Footer) */
  }

  /* When active class added by JS */
  :global(.wheel-active) .wheel-box {
    bottom: 0; /* Or handled by transform */
  }

  .project-wheel {
    /* Use reliable sizing */
    width: 80vw;
    height: 80vw;
    max-width: 1000px;
    max-height: 1000px;

    position: absolute;
    top: 50%;
    left: 50%;
    /* Centered on itself */
    transform-origin: center center;
    /* Initial state */
    transform: translate(-50%, -50%) rotate(0deg);
    /* No transition on rotate for direct scroll mapping */

    border-radius: 50%;
    /* visual debug guide: border: 1px dashed rgba(255,255,255,0.1); */
  }

  .static-border-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1; /* Slices start at Z-index 0/100, so this sits behind active ones? 
                 Wait, slices are managed by JS Z-index. 
                 Visible slices are Z >= 80. Hidden are Z=0.
                 We want this BEHIND slices? Or ON TOP of background but BEHIND images?
                 If Slices are absolute, they stack.
                 If this is Z=1, it is above Z=0 (hidden slices).
                 But below Z=80 (active slices).
                 This is perfect. It will be covered by the active slice's IMAGE if expanded,
                 but visible in the gaps. */
  }

  .wheel-border-stroke {
    fill: none;
    stroke: var(--color-border); /* Matches the previous border color */
    stroke-width: 0.5px;
    vector-effect: non-scaling-stroke;
    opacity: 0.8;
  }
</style>
