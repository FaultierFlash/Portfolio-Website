---
// src/components/ProjectWheel/index.astro
export interface WheelProjectItem {
  title: string;
  description: string;
  image: { src: string };
  url: string;
  externalUrl?: string | null;
  tags?: string[];
  accentColor?: string;
  slug?: string;
}

interface Props {
  projects: WheelProjectItem[];
  lang?: "en" | "de" | string;
}

const { projects = [], lang = "en" } = Astro.props;
const isDe = lang === "de";

const copy = isDe
  ? {
      eyebrow: "Interaktives Projekt-Archiv",
      heading: "Projekt-Rad",
      scrollHint: "Scrollen, Sektor wählen oder Pfeiltasten ↑↓ nutzen",
      exploreBtn: "Projekt entdecken",
      externalBtn: "Externe Seite",
      prevLabel: "Vorheriges Projekt",
      nextLabel: "Nächstes Projekt",
      allProjectsEyebrow: "Komplettübersicht",
      allProjectsTitle: "Alle Projekte im Überblick",
      projectLabel: "PROJEKT",
      ofLabel: "VON",
      defaultTag: "Projekt",
      defaultDesc: "Entdecke die technischen Details, Hintergründe und Ergebnisse dieses Projekts.",
    }
  : {
      eyebrow: "Interactive Project Archive",
      heading: "Project Wheel",
      scrollHint: "Scroll, click any slice, or use ↑↓ arrow keys",
      exploreBtn: "Explore Project",
      externalBtn: "External Site",
      prevLabel: "Previous Project",
      nextLabel: "Next Project",
      allProjectsEyebrow: "Full Directory",
      allProjectsTitle: "All Projects at a Glance",
      projectLabel: "PROJECT",
      ofLabel: "OF",
      defaultTag: "Project",
      defaultDesc: "Explore the engineering architecture, background, and results of this project.",
    };

const accentMap: Record<string, { main: string; bg: string; border: string }> = {
  primary: { main: "#FF7D1A", bg: "rgba(255, 125, 26, 0.14)", border: "rgba(255, 125, 26, 0.42)" },
  blue:    { main: "#3b82f6", bg: "rgba(59, 130, 246, 0.14)", border: "rgba(59, 130, 246, 0.42)" },
  green:   { main: "#22c55e", bg: "rgba(34, 197, 94, 0.14)",  border: "rgba(34, 197, 94, 0.42)" },
  purple:  { main: "#a855f7", bg: "rgba(168, 85, 247, 0.14)", border: "rgba(168, 85, 247, 0.42)" },
  rose:    { main: "#f43f5e", bg: "rgba(244, 63, 94, 0.14)",  border: "rgba(244, 63, 94, 0.42)" },
  gray:    { main: "#64748b", bg: "rgba(100, 116, 139, 0.14)", border: "rgba(100, 116, 139, 0.42)" },
};

const enrichedProjects = projects.map((p, index) => {
  const colorKey = p.accentColor && accentMap[p.accentColor] ? p.accentColor : "primary";
  const palette = accentMap[colorKey];
  return {
    ...p,
    index,
    numStr: String(index + 1).padStart(2, "0"),
    colorKey,
    accentMain: palette.main,
    accentBg: palette.bg,
    accentBorder: palette.border,
    tags: Array.isArray(p.tags) && p.tags.length > 0 ? p.tags : [copy.defaultTag],
    description: p.description || copy.defaultDesc,
  };
});

const count = enrichedProjects.length;
// Angular spacing between consecutive project slices on the wheel (never overlaps)
const stepAngle = count > 0 ? Math.min(55, 360 / Math.max(count, 6)) : 55;
const sliceWedgeDeg = Math.min(48, stepAngle - 4);

// Precompute SVG wedge geometry centered around +X axis (0 deg = 3 o'clock focal pointer)
const halfRad = ((sliceWedgeDeg * 0.5) * Math.PI) / 180;
const rOuter = 48.5;
const rInner = 16.5;
const x0Out = (50 + rOuter * Math.cos(-halfRad)).toFixed(3);
const y0Out = (50 + rOuter * Math.sin(-halfRad)).toFixed(3);
const x1Out = (50 + rOuter * Math.cos(halfRad)).toFixed(3);
const y1Out = (50 + rOuter * Math.sin(halfRad)).toFixed(3);
const x1In = (50 + rInner * Math.cos(halfRad)).toFixed(3);
const y1In = (50 + rInner * Math.sin(halfRad)).toFixed(3);
const x0In = (50 + rInner * Math.cos(-halfRad)).toFixed(3);
const y0In = (50 + rInner * Math.sin(-halfRad)).toFixed(3);

const annularWedgePath = `M ${x0In},${y0In} L ${x0Out},${y0Out} A ${rOuter},${rOuter} 0 0,1 ${x1Out},${y1Out} L ${x1In},${y1In} A ${rInner},${rInner} 0 0,0 ${x0In},${y0In} Z`;
const firstAccent = enrichedProjects[0] || { accentMain: "#FF7D1A", accentBg: "rgba(255,125,26,0.14)", accentBorder: "rgba(255,125,26,0.42)" };
---

<div
  id="pw-root"
  class="pw-root"
  data-count={count}
  data-step-angle={stepAngle}
  data-projects={JSON.stringify(enrichedProjects)}
  style={`--pw-accent: ${firstAccent.accentMain}; --pw-accent-bg: ${firstAccent.accentBg}; --pw-accent-border: ${firstAccent.accentBorder}; --pw-count: ${Math.max(1, count)};`}
>
  {/* 1. Sticky Scroll-Driven Wheel Runway */}
  <div id="pw-runway" class="pw-runway">
    <div class="pw-sticky-stage">
      <div class="pw-stage-grid">
        {/* LEFT COLUMN: Rotary Mechanical Project Drum */}
        <div class="pw-wheel-column">
          <div class="pw-wheel-viewport">
            <div class="pw-drum-wrapper">
              {/* Outer Technical Compass Ring */}
              <svg viewBox="0 0 100 100" class="pw-compass-svg" aria-hidden="true">
                <circle cx="50" cy="50" r="49.2" class="pw-compass-outer" />
                <circle cx="50" cy="50" r="15.8" class="pw-compass-inner" />
              </svg>

              {/* Rotating Wheel Surface */}
              <div id="pw-rotating-drum" class="pw-rotating-drum">
                {enrichedProjects.map((proj, idx) => {
                  const baseAngle = idx * stepAngle;
                  const clipId = `pw-clip-${idx}`;
                  return (
                    <div
                      class={`pw-slice ${idx === 0 ? "is-active" : ""}`}
                      data-index={idx}
                      data-base-angle={baseAngle}
                      style={`transform: rotate(${baseAngle}deg); --slice-accent: ${proj.accentMain};`}
                    >
                      <svg viewBox="0 0 100 100" class="pw-slice-svg">
                        <defs>
                          <clipPath id={clipId}>
                            <path d={annularWedgePath} />
                          </clipPath>
                        </defs>

                        {/* Clipped Project Image */}
                        <g clip-path={`url(#${clipId})`}>
                          <path d={annularWedgePath} class="pw-slice-backdrop" />
                          {proj.image?.src && (
                            <image
                              href={proj.image.src}
                              x="15"
                              y="8"
                              width="85"
                              height="84"
                              preserveAspectRatio="xMidYMid slice"
                              class="pw-slice-img"
                            />
                          )}
                          <path d={annularWedgePath} class="pw-slice-scrim" />
                        </g>

                        {/* Wedge Outline */}
                        <path d={annularWedgePath} class="pw-slice-border" />

                        {/* Hit Area */}
                        <path
                          d={annularWedgePath}
                          class="pw-slice-hit"
                          data-index={idx}
                          role="button"
                          tabindex="-1"
                          aria-label={proj.title}
                        />
                      </svg>

                      {/* Radial Spoke Label (sits along 0 deg horizontal axis of the slice) */}
                      <div class="pw-slice-label">
                        <span class="pw-slice-num">{proj.numStr}</span>
                        <span class="pw-slice-title">{proj.title}</span>
                      </div>
                    </div>
                  );
                })}
              </div>

              {/* Center Instrument Hub */}
              <div class="pw-center-hub">
                <span class="pw-hub-eyebrow">{copy.projectLabel}</span>
                <div class="pw-hub-counter">
                  <span id="pw-hub-active">01</span>
                  <span class="pw-hub-sep">/</span>
                  <span>{String(count).padStart(2, "0")}</span>
                </div>
                <span id="pw-hub-angle" class="pw-hub-angle">000°</span>
              </div>
            </div>

            {/* Active 3-o'clock Rim Pointer Reticle */}
            <div class="pw-pointer-reticle" aria-hidden="true">
              <div class="pw-pointer-line"></div>
              <svg viewBox="0 0 24 24" class="pw-pointer-arrow">
                <path d="M3 12L21 4V20L3 12Z" fill="var(--pw-accent)" />
              </svg>
            </div>
          </div>
        </div>

        {/* RIGHT COLUMN: Synchronized Active Project Showcase Card */}
        <div class="pw-detail-column">
          <div class="pw-detail-inner">
            {/* Top Header & Quick-Jump Pills */}
            <div class="pw-header-block">
              <div class="pw-eyebrow-row">
                <span class="pw-eyebrow-badge">
                  <span class="pw-pulse-dot"></span>
                  {copy.eyebrow}
                </span>
                <span class="pw-scroll-hint">{copy.scrollHint}</span>
              </div>

              {/* Quick-Jump Project Selector Pills */}
              <div class="pw-pills-nav" role="tablist" aria-label={copy.heading}>
                {enrichedProjects.map((proj, idx) => (
                  <button
                    type="button"
                    class={`pw-nav-pill ${idx === 0 ? "is-active" : ""}`}
                    data-target-index={idx}
                    role="tab"
                    aria-selected={idx === 0 ? "true" : "false"}
                  >
                    <span class="pw-pill-num">{proj.numStr}</span>
                    <span class="pw-pill-name">{proj.title}</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Active Project Showcase Card */}
            {enrichedProjects.length > 0 && (
              <article id="pw-active-card" class="pw-showcase-card">
                <a id="pw-card-image-link" href={enrichedProjects[0].url} class="pw-card-media group">
                  {enrichedProjects[0].image?.src ? (
                    <img
                      id="pw-card-img"
                      src={enrichedProjects[0].image.src}
                      alt={enrichedProjects[0].title}
                      class="pw-card-img"
                    />
                  ) : (
                    <div id="pw-card-img-fallback" class="pw-card-img-fallback">
                      <span>{enrichedProjects[0].title}</span>
                    </div>
                  )}
                  <div class="pw-card-media-overlay">
                    <span class="pw-media-cta">
                      {copy.exploreBtn} &rarr;
                    </span>
                  </div>
                  <div class="pw-card-index-badge">
                    <span id="pw-card-num">01</span>
                    <span class="opacity-50">/ {String(count).padStart(2, "0")}</span>
                  </div>
                </a>

                <div class="pw-card-body">
                  <div id="pw-card-tags" class="pw-tags-row">
                    {enrichedProjects[0].tags.map((tag: string) => (
                      <span class="pw-tag">#{tag}</span>
                    ))}
                  </div>

                  <h1 id="pw-card-title" class="pw-card-title">
                    {enrichedProjects[0].title}
                  </h1>

                  <p id="pw-card-desc" class="pw-card-desc">
                    {enrichedProjects[0].description}
                  </p>

                  <div class="pw-card-actions">
                    <div class="pw-primary-actions">
                      <a id="pw-explore-link" href={enrichedProjects[0].url} class="pw-btn-primary">
                        <span>{copy.exploreBtn}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                      </a>

                      <a
                        id="pw-external-link"
                        href={enrichedProjects[0].externalUrl || "#"}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`pw-btn-secondary ${enrichedProjects[0].externalUrl ? "" : "hidden"}`}
                      >
                        <span>{copy.externalBtn}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                      </a>
                    </div>

                    <div class="pw-step-controls">
                      <button
                        type="button"
                        id="pw-prev-btn"
                        class="pw-step-btn"
                        aria-label={copy.prevLabel}
                        disabled
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      </button>
                      <button
                        type="button"
                        id="pw-next-btn"
                        class="pw-step-btn"
                        aria-label={copy.nextLabel}
                        disabled={count <= 1}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                    </div>
                  </div>
                </div>
              </article>
            )}
          </div>
        </div>
      </div>

      {/* Bottom Scroll Progress Bar */}
      <div class="pw-progress-track" aria-hidden="true">
        <div id="pw-progress-fill" class="pw-progress-fill" style={`width: ${count > 1 ? 100 / count : 100}%;`}></div>
      </div>
    </div>
  </div>

  {/* 2. Scannable Directory Grid Below the Wheel */}
  <section class="pw-directory-section">
    <div class="pw-directory-header">
      <span class="pw-directory-eyebrow">{copy.allProjectsEyebrow}</span>
      <h2 class="pw-directory-title">{copy.allProjectsTitle}</h2>
    </div>

    <div class="pw-directory-grid">
      {enrichedProjects.map((proj) => (
        <a
          href={proj.url}
          class="pw-dir-card group"
          style={`--card-accent: ${proj.accentMain}; --card-accent-bg: ${proj.accentBg}; --card-accent-border: ${proj.accentBorder};`}
        >
          <div class="pw-dir-media">
            {proj.image?.src ? (
              <img src={proj.image.src} alt={proj.title} loading="lazy" class="pw-dir-img" />
            ) : (
              <div class="pw-dir-fallback">{proj.numStr}</div>
            )}
            <span class="pw-dir-badge">{proj.numStr}</span>
          </div>
          <div class="pw-dir-body">
            <div class="pw-dir-tags">
              {proj.tags.slice(0, 3).map((tag: string) => (
                <span class="pw-dir-tag">#{tag}</span>
              ))}
            </div>
            <h3 class="pw-dir-card-title">{proj.title}</h3>
            <p class="pw-dir-card-desc">{proj.description}</p>
            <span class="pw-dir-cta">
              {copy.exploreBtn} &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</div>

<script>
  import { escapeHtml } from "../../lib/html";

  let activeCleanup: (() => void) | null = null;

  function initProjectWheel() {
    if (activeCleanup) {
      activeCleanup();
      activeCleanup = null;
    }

    const root = document.getElementById("pw-root");
    const runway = document.getElementById("pw-runway");
    const drum = document.getElementById("pw-rotating-drum");
    if (!root || !runway || !drum) return;

    const count = parseInt(root.dataset.count || "0", 10);
    const stepAngle = parseFloat(root.dataset.stepAngle || "55");
    const projects: any[] = JSON.parse(root.dataset.projects || "[]");
    if (count <= 0 || projects.length === 0) return;

    const slices = Array.from(root.querySelectorAll<HTMLElement>(".pw-slice"));
    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>(".pw-nav-pill"));

    const hubActive = document.getElementById("pw-hub-active");
    const hubAngle = document.getElementById("pw-hub-angle");
    const progressFill = document.getElementById("pw-progress-fill");

    const card = document.getElementById("pw-active-card");
    const cardImgLink = document.getElementById("pw-card-image-link") as HTMLAnchorElement | null;
    const cardImg = document.getElementById("pw-card-img") as HTMLImageElement | null;
    const cardNum = document.getElementById("pw-card-num");
    const cardTags = document.getElementById("pw-card-tags");
    const cardTitle = document.getElementById("pw-card-title");
    const cardDesc = document.getElementById("pw-card-desc");
    const exploreLink = document.getElementById("pw-explore-link") as HTMLAnchorElement | null;
    const externalLink = document.getElementById("pw-external-link") as HTMLAnchorElement | null;
    const prevBtn = document.getElementById("pw-prev-btn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("pw-next-btn") as HTMLButtonElement | null;

    let currentActiveIdx = 0;

    function applyActiveProject(idx: number) {
      const clampedIdx = Math.max(0, Math.min(count - 1, idx));
      if (clampedIdx === currentActiveIdx) return;
      currentActiveIdx = clampedIdx;

      const proj = projects[clampedIdx];
      if (!proj) return;

      // Update CSS accent variables on root and documentElement
      root!.style.setProperty("--pw-accent", proj.accentMain);
      root!.style.setProperty("--pw-accent-bg", proj.accentBg);
      root!.style.setProperty("--pw-accent-border", proj.accentBorder);
      document.documentElement.style.setProperty("--color-project-accent", proj.accentMain);
      document.documentElement.style.setProperty("--color-project-accent-bg", proj.accentBg);
      document.documentElement.style.setProperty("--color-project-accent-border", proj.accentBorder);

      // Update slices & pills active state
      slices.forEach((s, i) => s.classList.toggle("is-active", i === clampedIdx));
      pills.forEach((p, i) => {
        const active = i === clampedIdx;
        p.classList.toggle("is-active", active);
        p.setAttribute("aria-selected", active ? "true" : "false");
      });

      if (hubActive) hubActive.textContent = proj.numStr;

      // Subtle card transition
      if (card) {
        card.classList.add("is-switching");
        setTimeout(() => card.classList.remove("is-switching"), 180);
      }

      if (cardImgLink) cardImgLink.href = proj.url;
      if (cardImg && proj.image?.src) {
        cardImg.src = proj.image.src;
        cardImg.alt = proj.title;
      }
      if (cardNum) cardNum.textContent = proj.numStr;
      if (cardTitle) cardTitle.textContent = proj.title;
      if (cardDesc) cardDesc.textContent = proj.description;
      if (exploreLink) exploreLink.href = proj.url;

      if (externalLink) {
        if (proj.externalUrl) {
          externalLink.href = proj.externalUrl;
          externalLink.classList.remove("hidden");
        } else {
          externalLink.classList.add("hidden");
        }
      }

      if (cardTags) {
        cardTags.innerHTML = (proj.tags || [])
          .map((tag: string) => `<span class="pw-tag">#${escapeHtml(tag)}</span>`)
          .join("");
      }

      if (prevBtn) prevBtn.disabled = clampedIdx <= 0;
      if (nextBtn) nextBtn.disabled = clampedIdx >= count - 1;
    }

    function updateFromScroll() {
      if (!runway || !drum) return;
      const rect = runway.getBoundingClientRect();
      const viewportH = window.innerHeight;
      const scrollableDist = Math.max(1, rect.height - viewportH);
      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / scrollableDist));

      const maxRotation = Math.max(0, (count - 1) * stepAngle);
      const currentDeg = progress * maxRotation;

      drum.style.transform = `rotate(${-currentDeg}deg)`;

      if (hubAngle) {
        hubAngle.textContent = `${String(Math.round(currentDeg)).padStart(3, "0")}°`;
      }

      if (progressFill) {
        const pct = count > 1 ? ((progress * (count - 1) + 1) / count) * 100 : 100;
        progressFill.style.width = `${Math.min(100, Math.max(0, pct))}%`;
      }

      const targetIdx = count > 1 ? Math.round(progress * (count - 1)) : 0;
      applyActiveProject(targetIdx);
    }

    function scrollToProjectIndex(idx: number) {
      if (!runway) return;
      const clamped = Math.max(0, Math.min(count - 1, idx));
      const runwayTop = runway.getBoundingClientRect().top + window.scrollY;
      const scrollableDist = Math.max(0, runway.offsetHeight - window.innerHeight);
      const targetProgress = count > 1 ? clamped / (count - 1) : 0;
      const targetScrollY = runwayTop + targetProgress * scrollableDist;

      window.scrollTo({
        top: targetScrollY,
        behavior: "smooth",
      });
    }

    // Click handlers for wheel slices
    const onSliceClick = (e: Event) => {
      const target = e.currentTarget as HTMLElement;
      const idx = parseInt(target.dataset.index || "0", 10);
      if (idx === currentActiveIdx) {
        const proj = projects[idx];
        if (proj?.url) window.location.href = proj.url;
      } else {
        scrollToProjectIndex(idx);
      }
    };

    const hitAreas = Array.from(root.querySelectorAll<HTMLElement>(".pw-slice-hit, .pw-slice-label"));
    hitAreas.forEach((el) => el.addEventListener("click", onSliceClick));

    // Click handlers for quick-jump pills
    const onPillClick = (e: Event) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const idx = parseInt(btn.dataset.targetIndex || "0", 10);
      scrollToProjectIndex(idx);
    };
    pills.forEach((pill) => pill.addEventListener("click", onPillClick));

    const onPrev = () => scrollToProjectIndex(currentActiveIdx - 1);
    const onNext = () => scrollToProjectIndex(currentActiveIdx + 1);
    prevBtn?.addEventListener("click", onPrev);
    nextBtn?.addEventListener("click", onNext);

    // Keyboard navigation when wheel runway is visible
    const onKeyDown = (e: KeyboardEvent) => {
      if (
        document.activeElement?.tagName === "INPUT" ||
        document.activeElement?.tagName === "TEXTAREA" ||
        document.getElementById("command-palette-modal")?.classList.contains("hidden") === false
      ) {
        return;
      }
      const rect = runway.getBoundingClientRect();
      const inStage = rect.top <= 80 && rect.bottom >= window.innerHeight * 0.6;
      if (!inStage) return;

      if (e.key === "ArrowRight" || e.key === "ArrowDown") {
        if (currentActiveIdx < count - 1) {
          e.preventDefault();
          scrollToProjectIndex(currentActiveIdx + 1);
        }
      } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
        if (currentActiveIdx > 0) {
          e.preventDefault();
          scrollToProjectIndex(currentActiveIdx - 1);
        }
      }
    };

    window.addEventListener("scroll", updateFromScroll, { passive: true });
    window.addEventListener("resize", updateFromScroll, { passive: true });
    window.addEventListener("keydown", onKeyDown);

    updateFromScroll();

    activeCleanup = () => {
      window.removeEventListener("scroll", updateFromScroll);
      window.removeEventListener("resize", updateFromScroll);
      window.removeEventListener("keydown", onKeyDown);
      hitAreas.forEach((el) => el.removeEventListener("click", onSliceClick));
      pills.forEach((pill) => pill.removeEventListener("click", onPillClick));
      prevBtn?.removeEventListener("click", onPrev);
      nextBtn?.removeEventListener("click", onNext);
    };
  }

  document.addEventListener("astro:page-load", initProjectWheel);
  document.addEventListener("astro:before-swap", () => {
    if (activeCleanup) {
      activeCleanup();
      activeCleanup = null;
    }
  });
</script>

<style>
  :global(main) {
    padding: 0 !important;
    max-width: 100% !important;
  }

  .pw-root {
    width: 100%;
    position: relative;
  }

  /* Tall scroll runway drives the sticky rotary stage smoothly */
  .pw-runway {
    position: relative;
    width: 100%;
    height: calc(100vh + (var(--pw-count, 4) - 1) * 68vh);
  }

  .pw-sticky-stage {
    position: sticky;
    top: var(--header-height, 60px);
    height: calc(100vh - var(--header-height, 60px));
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .pw-stage-grid {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
