---
interface Project {
  title: string;
  description: string;
  image: any;
  url: string;
  startAngle: number;
  endAngle: number;
}

interface Props {
  project: Project;
  anglePerSection: number;
}

const { project, anglePerSection } = Astro.props;
const safeId = project.title.replace(/\s+/g, "-").toLowerCase();

// ---------------------------------------------------------
// GEOMETRY LOGIC
// ---------------------------------------------------------

const halfAngle = anglePerSection / 2;
const startTheta = -halfAngle * (Math.PI / 180);
const endTheta = halfAngle * (Math.PI / 180);

const startX = 50 + 50 * Math.sin(startTheta);
const startY = 50 - 50 * Math.cos(startTheta);
const endX = 50 + 50 * Math.sin(endTheta);
const endY = 50 - 50 * Math.cos(endTheta);

const largeArcFlag = anglePerSection > 180 ? 1 : 0;

// WEDGE PATH (Closed shape: Center -> Start -> Arc -> End -> Center)
// Used for: Hit Area, Clips, Gaps (Background separation)
const wedgePathData = `M 50,50 L ${startX},${startY} A 50,50 0 ${largeArcFlag},1 ${endX},${endY} z`;



// Content Placement:
const placementAngle = 0;
const textRadius = 35;
const textX = 50 + textRadius * Math.sin((placementAngle * Math.PI) / 180);
const textY = 50 - textRadius * Math.cos((placementAngle * Math.PI) / 180);

const contentRotation = 0;
---

<div class="project-slice-container" data-original-angle={project.startAngle}>
  <a href={project.url} class="project-link">
    <svg viewBox="0 0 100 100" class="project-slice">
      <defs>
        <clipPath id={`slice-clip-${safeId}`}>
          <path d={wedgePathData}></path>
        </clipPath>
      </defs>

      {/* 1. HIT AREA (Bottom) */}
      <path d={wedgePathData} class="slice-hit-area" fill="transparent"></path>

      {
        /* 2. GAP LAYER (Separation)
          Uses WEDGE path to create separation on all sides (radial + rim).
          Stroke matches BG color.
      */
      }
      <path d={wedgePathData} class="slice-gap"></path>

      {/* 3. VISIBLE BORDER REMOVED - Handled by Static Ring in Parent */}

      {
        /* 4. IMAGE (Inset)
          Layered ON TOP to expand over border.
      */
      }
      <g class="image-group">
        <image
          href={project.image.src}
          x="0"
          y="0"
          width="100"
          height="100"
          preserveAspectRatio="xMidYMin slice"
          clip-path={`url(#slice-clip-${safeId})`}
          class="project-image"
          style={`--contentRotation: ${contentRotation}deg; transform-origin: 50px 50px;`}
          transform={`rotate(${contentRotation} 50 50)`}
        />
      </g>

      {/* 5. TEXT */}
      <g
        class="project-text-overlay"
        transform={`rotate(${contentRotation} ${textX} ${textY})`}
      >
        <text x={textX} y={textY} text-anchor="middle" class="project-title">
          {project.title}
        </text>
        <text
          x={textX}
          y={textY + 5}
          text-anchor="middle"
          class="project-description"
        >
          {project.description}
        </text>
      </g>
    </svg>
  </a>
</div>

<style>
  .project-slice-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    visibility: visible;
    opacity: 1;
  }

  .project-slice-container.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none !important;
  }

  /* Force low z-index managed by JS, but good default */
  .project-slice-container.hidden {
    z-index: -1 !important;
  }

  .project-link {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  .slice-hit-area {
    fill: transparent;
    stroke: none;
    pointer-events: auto;
    cursor: pointer;
  }

  .project-slice {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* LAYERS */

  .slice-gap {
    fill: none;
    stroke: var(--color-bg);
    stroke-width: 2px; /* Reduced from 4px */
    pointer-events: none;
  }

  /* .slice-border removed */

  .image-group {
    transform-origin: 50px 50px;
    transform: scale(0.94); /* Less inset than 0.92, closer to border */
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  .project-image {
    opacity: 0.8;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .project-text-overlay {
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    pointer-events: none;
  }

  /* HOVER STATES */

  /* Scale Image Group to 1.0 (Covers Rim Border) */
  .slice-hit-area:hover ~ .image-group {
    transform: scale(1.02); /* Expands just over the 0.98 border */
  }

  /* Brighten Image */
  .slice-hit-area:hover ~ .image-group .project-image {
    opacity: 1;
  }

  /* Show Text */
  .slice-hit-area:hover ~ .project-text-overlay {
    opacity: 1;
  }

  .project-title {
    font-size: 3.5px;
    font-weight: bold;
    fill: #ffffff;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    user-select: none;
  }

  .project-description {
    font-size: 2.5px;
    fill: #eeeeee;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    user-select: none;
  }

  @media (max-width: 768px) {
    .project-title {
      font-size: 4px;
    }
    .project-description {
      font-size: 3px;
    }
  }
</style>
