---
interface Project {
  title: string;
  description: string;
  image: any; // Assuming this has a .src property
  url: string;
  startAngle: number;
  endAngle: number;
  // midAngle: number; // This wasn't used in the original, recalculating
}

interface Props {
  project: Project;
  anglePerSection: number;
}

const { project, anglePerSection } = Astro.props;
const safeId = project.title.replace(/\s+/g, "-").toLowerCase();

// Calculate the mid-angle of the slice relative to the wheel's start (0 degrees = top)
const midAngle = project.startAngle + anglePerSection / 2;

// Calculate the distance from center for text placement (e.g., 60% -> 30 units in 100x100 box)
const textRadius = 30;
// Calculate text coordinates using the midAngle
// Note: SVG angles often start from the 3 o'clock position, but CSS rotate and this
// path definition start from 12 o'clock. We subtract 90 degrees to align calculations.
const textX = 50 + textRadius * Math.cos(((midAngle - 90) * Math.PI) / 180);
const textY = 50 + textRadius * Math.sin(((midAngle - 90) * Math.PI) / 180);

// Calculate endpoint for the arc path (relative to 12 o'clock)
const endX = 50 + 50 * Math.sin((anglePerSection * Math.PI) / 180);
const endY = 50 - 50 * Math.cos((anglePerSection * Math.PI) / 180);
const largeArcFlag = anglePerSection > 180 ? 1 : 0; // Handle angles > 180 if needed
const slicePathData = `M 50,50 L 50,0 A 50,50 0 ${largeArcFlag},1 ${endX},${endY} z`;
---

<div
  class="project-slice-container"
  style={`transform: rotate(${project.startAngle}deg)`}
>
  <a href={project.url} class="project-link">
    <svg viewBox="0 0 100 100" class="project-slice">
      <defs>
        <clipPath id={`slice-clip-${safeId}`}>
          {/* Path defines the slice shape starting from 12 o'clock */}
          <path d={slicePathData} style="fill:none;stroke:green;stroke-width:3"
          ></path>
        </clipPath>
      </defs>

      {/* Background slice shape */}
      <path
        d={slicePathData}
        style="fill:none;stroke:green;stroke-width:3"
        class="slice-shape"></path>

      {/* Project image clipped to slice shape */}
      <image
        href={project.image.src}
        x="0"
        y="0"
        width="100"
        height="100"
        preserveAspectRatio="xMidYMin slice"
        clip-path={`url(#slice-clip-${safeId})`}
        class="project-image"
      />

      {/* Text overlay - positioned in the middle of the slice */}
      {/* Added transform to keep text upright */}
      <g
        class="project-text-overlay"
        transform={`rotate(${-midAngle} ${textX} ${textY})`}
      >
        {/* Apply inverse rotation to text elements around their own anchor */}
        <text
          x={textX}
          y={textY}
          text-anchor="middle"
          class="project-title"
          transform={`rotate(${midAngle} ${textX} ${textY})`}
        >
          {project.title}
        </text>{/* Counter-rotate text */}
        <text
          x={textX}
          y={textY + 5}
          text-anchor="middle"
          class="project-description"
          transform={`rotate(${midAngle} ${textX} ${textY + 5})`}
        >
          {project.description}
        </text>
      </g>
    </svg>
  </a>
</div>

<style>
  /* ... (Keep existing styles) ... */

  .project-slice-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: center;
    pointer-events: none;
  }

  .project-link {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }

  .project-slice {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .slice-shape {
    fill: rgba(0, 0, 0, 0.3); /* Darker semi-transparent fill */
    stroke: var(--color-accent, #ff9800); /* Use accent color with fallback */
    stroke-width: 0.5;
  }

  .project-image {
    opacity: 0.6; /* Slightly less opaque image */
    transition: opacity 0.3s ease;
  }

  .project-text-overlay {
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease; /* Added transform transition */
    /* Ensure text is clickable if needed, though link covers it */
    pointer-events: none;
  }

  .project-link:hover .project-image,
  .project-link:focus .project-image {
    /* Added focus state */
    opacity: 0.3; /* Dim image more on hover/focus */
  }

  .project-link:hover .project-text-overlay,
  .project-link:focus .project-text-overlay {
    /* Added focus state */
    opacity: 1;
  }

  .project-title {
    font-size: 3.5px; /* Slightly larger base size */
    font-weight: bold;
    fill: #ffffff;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9); /* Enhanced shadow */
    /* Prevent text selection */
    user-select: none;
  }

  .project-description {
    font-size: 2.5px; /* Slightly larger base size */
    fill: #eeeeee; /* Slightly off-white */
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9); /* Enhanced shadow */
    /* Prevent text selection */
    user-select: none;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .project-title {
      font-size: 4px; /* Larger on mobile for readability */
    }

    .project-description {
      font-size: 3px; /* Larger on mobile */
    }
  }
  @media (max-width: 480px) {
    .project-title {
      font-size: 4.5px;
    }

    .project-description {
      font-size: 3.5px;
    }
  }
</style>
