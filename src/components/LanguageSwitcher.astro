---
// src/components/LanguageSwitcher.astro
const currentLocale = Astro.currentLocale || "de";
const currentPath = Astro.url.pathname;

// Pfad ohne Sprachpräfix extrahieren
function getPathWithoutLocale(path, locale) {
  if (path.startsWith(`/${locale}/`)) {
    return path.substring(locale.length + 2);
  }
  return path;
}

// Einfache manuelle URL-Generierung
const pathWithoutLocale = getPathWithoutLocale(currentPath, currentLocale);
const deUrl = `/de/${pathWithoutLocale === "/" ? "" : pathWithoutLocale}`;
const enUrl = `/en/${pathWithoutLocale === "/" ? "" : pathWithoutLocale}`;
---

<nav aria-label="Sprachauswahl | Language selection">
  <ul>
    <li>
      <a
        href={deUrl}
        aria-current={currentLocale === "de" ? "page" : undefined}
        hreflang="de"
        lang="de"
      >
        Deutsch
      </a>
    </li>
    <li>
      <a
        href={enUrl}
        aria-current={currentLocale === "en" ? "page" : undefined}
        hreflang="en"
        lang="en"
      >
        English
      </a>
    </li>
  </ul>
</nav>

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 0.5rem;
  }
  a[aria-current="page"] {
    font-weight: bold;
    text-decoration: none;
  }
</style>
