---
// src/components/LanguageSwitcher.astro
// No longer needs accentColor prop - reads from CSS custom property set by JS
const locales = ["de", "en"] as const;
type Locale = (typeof locales)[number];

const currentLocale = (Astro.currentLocale as Locale) || "de";
const currentPath = Astro.url.pathname;

const targetLocale: Locale = currentLocale === "de" ? "en" : "de";
const targetAbbreviation = targetLocale.toUpperCase();

function getPathWithoutLocale(path: string, locale: Locale): string {
  const prefix = `/${locale}`;
  if (path === prefix) return "/";
  if (path.startsWith(`${prefix}/`)) return path.substring(prefix.length);
  if (path === "/") return "/";
  return path;
}

const pathWithoutLocale = getPathWithoutLocale(currentPath, currentLocale);
const targetPathSegment =
  pathWithoutLocale === "/" ? "" : pathWithoutLocale.startsWith("/") ? pathWithoutLocale : `/${pathWithoutLocale}`;
const targetUrl = `/${targetLocale}${targetPathSegment}`;
---

<a
  href={targetUrl}
  class="language-switcher-button"
  aria-label={`Switch language to ${targetLocale === "de" ? "German" : "English"}`}
  hreflang={targetLocale}
  lang={targetLocale}
  title={`Switch to ${targetLocale === "de" ? "Deutsch" : "English"}`}
>
  {targetAbbreviation}
</a>

<style>
  .language-switcher-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    /* Solid accent color fill — vivid and project-specific */
    background-color: var(--color-project-accent, #FF7D1A);
    /* Text is always bright grey — independent of light/dark mode */
    color: #E5E7EB;
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    border: none;
    transition:
      background-color 0.5s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .language-switcher-button:hover,
  .language-switcher-button:focus {
    transform: scale(1.1);
    box-shadow: 0 0 14px var(--color-project-accent-border, rgba(255,125,26,0.6));
  }

  .language-switcher-button:focus-visible {
    outline: 2px solid var(--color-project-accent, #FF7D1A);
    outline-offset: 3px;
  }
</style>
