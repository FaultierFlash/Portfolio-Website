---
// src/layouts/BaseLayout.astro
import { useTranslations, type Locale } from "../i18n/utils";
import Header from "../components/Header.astro"; // New Header component
import Footer from "../components/Footer.astro"; // New Footer component
import ThemeScript from "../components/ThemeScript.astro";
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  hidePageScrollbar?: boolean;
}

const {
  title: propTitle,
  description: propDescription,
  hidePageScrollbar = false,
} = Astro.props;

const currentLocale = (Astro.currentLocale as Locale) || "de";
const t = useTranslations(currentLocale); // 't' function for translations

const pageTitle = propTitle || t("site.title");
const pageDescription =
  propDescription || t("site.description") || "Default site description.";

// --- Data needed by Header ---
// Project Pages Fetching (moved to Header, but BaseLayout needs to do it to pass to Header)
// Alternatively, Header could fetch its own data if it doesn't need `currentLocale` or `t` from BaseLayout for this.
// For now, keeping fetching logic here to pass down.
const allProjectFilesGlob = import.meta.glob("/src/pages/**/*.astro");
let projectPages: { href: string; text: string }[] = [];
if (allProjectFilesGlob) {
  const resolvedFiles = await Promise.all(
    Object.entries(allProjectFilesGlob).map(async ([filePath, resolver]) => {
      const langProjectRegex = new RegExp(
        `^/src/pages/${currentLocale}/(projects|projekte)/`,
        "i",
      );
      if (langProjectRegex.test(filePath)) {
        try {
          const projectModule = (await resolver()) as any;
          if (!projectModule.url) return null;
          const segments = filePath.split("/");
          const fileName = segments[segments.length - 1].replace(
            /\.(mdoc|md|astro)$/,
            "",
          );
          const projectTitle =
            projectModule.frontmatter?.navTitle ||
            projectModule.frontmatter?.title ||
            fileName
              .replace(/-/g, " ")
              .replace(/\b\w/g, (char) => char.toUpperCase());
          return { href: projectModule.url, text: projectTitle };
        } catch (e) {
          console.error("Error processing project file:", filePath, e);
          return null;
        }
      }
      return null;
    }),
  );
  projectPages = resolvedFiles
    .filter((p): p is { href: string; text: string } => p !== null)
    .sort((a, b) => a.text.localeCompare(b.text));
}

const navLinks = [
  { href: `/${currentLocale}/contact`, text: t("nav.contact") },
];
const homePath = `/${currentLocale}/`;
---

<!doctype html>
<html
  lang={currentLocale}
  dir="ltr"
  class={hidePageScrollbar ? "page-hides-scrollbar" : ""}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <ThemeScript />
    {/* Critical for preventing FOUC for theme */}
    <ViewTransitions />
  </head>
  <body>
    <Header
      currentLocale={currentLocale}
      t={t}
      homePath={homePath}
      navLinks={navLinks}
      projectPages={projectPages}
    />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      // BaseLayout's script is now only responsible for theme consistency application
      // after page transitions, as ThemeToggle.astro handles its own click events.
      // Menu and dropdown interactivity is now in Header.astro's script.

      function applyBaseLayoutThemeConsistency() {
        const themeToggleButton = document.querySelector(
          "#theme-toggle",
        ) as HTMLElement | null; // Query for the custom element
        const themeStorageKey = "theme";
        const htmlElement = document.documentElement;

        const currentTheme =
          localStorage.getItem(themeStorageKey) ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        htmlElement.classList.toggle("dark", currentTheme === "dark");

        if (themeToggleButton) {
          themeToggleButton.setAttribute(
            "aria-label",
            `Switch to ${currentTheme === "dark" ? "light" : "dark"} theme`,
          );
        }
        console.log(
          "BaseLayout: Applied theme consistency on page load/transition:",
          currentTheme,
        );
      }

      function reinitializeBaseLayoutForTheme() {
        console.log(
          "BaseLayout: astro:page-load triggered. Applying theme consistency.",
        );
        applyBaseLayoutThemeConsistency();
      }

      document.addEventListener(
        "astro:page-load",
        reinitializeBaseLayoutForTheme,
      );

      // No astro:before-swap cleanup needed in BaseLayout for theme, as ThemeToggle handles its own listeners,
      // and applyBaseLayoutThemeConsistency just reads state and sets attributes/classes.

      console.log(
        "BaseLayout Script: Initialized for theme consistency. Waiting for Astro lifecycle events.",
      );
    </script>
  </body>
</html>

<style is:global>
  html.page-hides-scrollbar {
    overflow-y: hidden !important;
  }
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    /* Basic font and color are now expected from global.css */
  }
  main {
    flex-grow: 1;
    padding: 2rem;
    /* Calculate top padding based on a CSS variable for header height, defined in global.css or Header.astro */
    padding-top: calc(var(--header-height, 60px) + 1rem);
  }
  body.no-scroll-mobile {
    /* Used by JS in Header.astro to prevent body scroll */
    @media (max-width: 768px) {
      overflow: hidden !important;
    }
  }
</style>
