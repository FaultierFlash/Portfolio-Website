---
// src/layouts/BaseLayout.astro
import { useTranslations, type Locale } from "../i18n/utils";
import Header from "../components/Header.astro"; // New Header component
import Footer from "../components/Footer.astro"; // New Footer component
import ThemeScript from "../components/ThemeScript.astro";
import DynamicBackground from "../components/DynamicBackground.astro"; // New background component
import { getProjects, getNotesSettings, getSocialsSettings, getTranslationOverrides } from "../lib/sanity";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hidePageScrollbar?: boolean;
  backgroundEffect?: string | null;
  topographyConfig?: any;
  solarConfig?: any;
  accentColor?: string;
  showFooter?: boolean;
}

const {
  title: propTitle,
  description: propDescription,
  image: propImage,
  hidePageScrollbar = false,
  backgroundEffect = "none",
  topographyConfig = null,
  solarConfig = null,
  accentColor = "primary",
  showFooter = true,
} = Astro.props;

const currentLocale = Astro.currentLocale as Locale;
const overrides = await getTranslationOverrides(currentLocale);
const t = useTranslations(currentLocale, overrides);

// Fallback values if not provided by the page
const brandName = "Marlon Müller";
const defaultTitle = t("site.title");
const defaultDescription = t("site.description");

const pageTitle = propTitle && propTitle !== defaultTitle && propTitle !== brandName
  ? `${propTitle} | ${brandName}`
  : defaultTitle;
const pageDescription = propDescription || defaultDescription;

// Color map for CSS custom property injection
const accentColorMap: Record<string, { main: string; bg: string; border: string }> = {
  primary: { main: '#FF7D1A', bg: 'rgba(255,125,26,0.15)', border: 'rgba(255,125,26,0.5)' },
  blue:    { main: '#3b82f6', bg: 'rgba(59,130,246,0.15)',  border: 'rgba(59,130,246,0.5)' },
  green:   { main: '#22c55e', bg: 'rgba(34,197,94,0.15)',   border: 'rgba(34,197,94,0.5)'  },
  purple:  { main: '#a855f7', bg: 'rgba(168,85,247,0.15)',  border: 'rgba(168,85,247,0.5)' },
  rose:    { main: '#f43f5e', bg: 'rgba(244,63,94,0.15)',   border: 'rgba(244,63,94,0.5)'  },
  gray:    { main: '#6b7280', bg: 'rgba(107,114,128,0.15)', border: 'rgba(107,114,128,0.5)'},
};
const resolvedAccent = accentColorMap[accentColor] || accentColorMap.primary;

// Set Netlify Edge CDN caching: fresh for 10 mins, stale-while-revalidate for 24 hours
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=600, stale-while-revalidate=86400'
);

// --- Data needed by Header & Layout (Fetched in parallel) ---
const [allSanityProjects, notesSettings, socials] = await Promise.all([
  getProjects(currentLocale),
  getNotesSettings(),
  getSocialsSettings(),
]);

let projectPages: { href: string; text: string }[] = (allSanityProjects || []).map((p: any) => ({
  href: `/${currentLocale}/projects/${p.slug.current}`,
  text: p.title
}));

const showNotes = notesSettings?.enabled === true;

const navLinks = [
  { href: `/${currentLocale}/library`, text: t("nav.library") },
  ...(showNotes ? [{ href: `/${currentLocale}/notes`, text: t("nav.notes") }] : []),
  { href: `/${currentLocale}/contact`, text: t("nav.contact") },
];
const homePath = `/${currentLocale}/`;

// SEO URL configurations
const siteUrl = "https://marlonmueller.eu";
const canonicalURL = `${siteUrl}${Astro.url.pathname}`;
const ogImage = propImage
  ? (propImage.startsWith("http") ? propImage : `${siteUrl}${propImage}`)
  : `${siteUrl}/og-image.jpg`;

const alternateLocale = currentLocale === "en" ? "de" : "en";
let alternatePathname = Astro.url.pathname;
if (alternatePathname.startsWith(`/${currentLocale}/`)) {
  alternatePathname = alternatePathname.replace(`/${currentLocale}/`, `/${alternateLocale}/`);
} else if (alternatePathname === `/${currentLocale}`) {
  alternatePathname = `/${alternateLocale}`;
}
const alternateURL = `${siteUrl}${alternatePathname}`;

const localeEnURL = currentLocale === "en" ? canonicalURL : alternateURL;
const localeDeURL = currentLocale === "de" ? canonicalURL : alternateURL;

// Structured Data (Schema.org JSON-LD)
const sameAsLinks = [
  socials?.github?.enabled ? socials.github.url : null,
  socials?.linkedin?.enabled ? socials.linkedin.url : null,
  socials?.instagram?.enabled ? socials.instagram.url : null,
  "https://odonatum.com",
  "https://odonatum.com/team/",
].filter(Boolean);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Marlon Müller",
  "url": "https://marlonmueller.eu",
  "image": ogImage,
  "jobTitle": currentLocale === "de" ? "Student der Ingenieurwissenschaften" : "Engineering Science Student",
  "description": currentLocale === "de"
    ? "Student der Ingenieurwissenschaften an der Technischen Universität München (TUM) und Mitgründer von Odonatum e.V."
    : "Engineering Science student at the Technical University of Munich (TUM) and co-founder of Odonatum e.V.",
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Technical University of Munich",
    "alternateName": "TUM",
    "url": "https://www.tum.de"
  },
  "memberOf": [
    {
      "@type": "Organization",
      "name": "Odonatum e.V.",
      "url": "https://odonatum.com"
    },
    {
      "@type": "Organization",
      "name": "Studienstiftung des deutschen Volkes",
      "url": "https://www.studienstiftung.de"
    }
  ],
  "knowsAbout": [
    "Engineering Science",
    "Bio-inspired Robotics",
    "UAV Design",
    "Flight Dynamics",
    "Hardware Prototyping",
    "Embedded Systems"
  ],
  "sameAs": sameAsLinks,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Marlon Müller",
  "url": "https://marlonmueller.eu",
  "inLanguage": ["en", "de"],
};

// Breadcrumb Schema
const pathSegmentsClean = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": currentLocale === "de" ? "Startseite" : "Home",
    "item": `${siteUrl}/${currentLocale}/`,
  }
];

if (pathSegmentsClean.length > 1) {
  let accumulatedPath = `/${currentLocale}`;
  for (let i = 1; i < pathSegmentsClean.length; i++) {
    const seg = pathSegmentsClean[i];
    accumulatedPath += `/${seg}`;
    const isLast = i === pathSegmentsClean.length - 1;
    let segName = seg.charAt(0).toUpperCase() + seg.slice(1);
    if (isLast && propTitle) {
      segName = propTitle;
    } else if (seg === "projects") {
      segName = currentLocale === "de" ? "Projekte" : "Projects";
    } else if (seg === "library") {
      segName = currentLocale === "de" ? "Bibliothek" : "Library";
    } else if (seg === "contact") {
      segName = currentLocale === "de" ? "Kontakt" : "Contact";
    } else if (seg === "cv") {
      segName = "CV";
    }
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": i + 1,
      "name": segName,
      "item": `${siteUrl}${accumulatedPath}`,
    });
  }
}

const breadcrumbSchema = breadcrumbItems.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems,
} : null;
---

<!doctype html>
<html
  lang={currentLocale}
  dir="ltr"
  class={hidePageScrollbar ? "page-hides-scrollbar" : ""}
  style={`--color-project-accent:${resolvedAccent.main};--color-project-accent-bg:${resolvedAccent.bg};--color-project-accent-border:${resolvedAccent.border}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preload Critical Fonts (Accelerates FCP & LCP) -->
    <link rel="preload" href="/fonts/raleway-v34-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/raleway-v34-latin-800.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Marlon Müller" />
    <meta name="keywords" content="Marlon Müller, TUM, Technical University of Munich, Technische Universität München, Engineering Science, Ingenieurwissenschaften, Odonatum, Circon, Photeia, Student, Portfolio" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marlon Müller" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={currentLocale === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={currentLocale === 'de' ? 'en_US' : 'de_DE'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical and Bilingual Alternate SEO Links -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={localeEnURL} />
    <link rel="alternate" hreflang="de" href={localeDeURL} />
    <link rel="alternate" hreflang="x-default" href={localeEnURL} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    
    <ThemeScript />
    {/* Critical for preventing FOUC for theme */}
    <ClientRouter />
    <script is:inline define:vars={{ accentColorMap: JSON.stringify(accentColorMap) }}>
      // Expose color map globally so homepage scroll JS can update the accent vars
      window.__accentColorMap = JSON.parse(accentColorMap);
    </script>
  </head>
  <body>
    <DynamicBackground 
      effect={backgroundEffect} 
      config={backgroundEffect === 'solar' ? solarConfig : topographyConfig} 
    />
    <Header
      currentLocale={currentLocale}
      t={t}
      homePath={homePath}
      navLinks={navLinks}
      projectPages={projectPages}
      accentColor={accentColor}
      socials={socials}
    />

    <main>
      <slot />
    </main>

    {showFooter && <Footer />}

    <CommandPalette
      currentLocale={currentLocale}
      projectPages={projectPages}
      navLinks={navLinks}
    />

    <script>
      // BaseLayout's script is now only responsible for theme consistency application
      // after page transitions, as ThemeToggle.astro handles its own click events.
      // Menu and dropdown interactivity is now in Header.astro's script.

      function applyBaseLayoutThemeConsistency() {
        const themeToggleButton = document.querySelector(
          "#theme-toggle",
        ) as HTMLElement | null; // Query for the custom element
        const themeStorageKey = "theme";
        const htmlElement = document.documentElement;

        const currentTheme =
          localStorage.getItem(themeStorageKey) ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        htmlElement.classList.toggle("dark", currentTheme === "dark");

        if (themeToggleButton) {
          themeToggleButton.setAttribute(
            "aria-label",
            `Switch to ${currentTheme === "dark" ? "light" : "dark"} theme`,
          );
        }
      }

      function reinitializeBaseLayoutForTheme() {
        applyBaseLayoutThemeConsistency();
      }

      document.addEventListener(
        "astro:page-load",
        reinitializeBaseLayoutForTheme,
      );
    </script>
  </body>
</html>

<style is:global>
  html.page-hides-scrollbar {
    overflow-y: hidden !important;
  }
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    /* Basic font and color are now expected from global.css */
  }
  main {
    flex-grow: 1;
    padding: 2rem;
    /* Calculate top padding based on a CSS variable for header height, defined in global.css or Header.astro */
    padding-top: calc(var(--header-height, 60px) + 1rem);
  }
  body.no-scroll-mobile {
    /* Used by JS in Header.astro to prevent body scroll */
    @media (max-width: 768px) {
      overflow: hidden !important;
    }
  }
</style>
