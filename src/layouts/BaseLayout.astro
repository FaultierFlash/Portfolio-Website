---
// src/layouts/BaseLayout.astro
import { useTranslations, type Locale } from "../i18n/utils";
import Header from "../components/Header.astro"; // New Header component
import Footer from "../components/Footer.astro"; // New Footer component
import ThemeScript from "../components/ThemeScript.astro";
import DynamicBackground from "../components/DynamicBackground.astro"; // New background component
import { getProjects, getNotesSettings, getSocialsSettings, getTranslationOverrides } from "../lib/sanity";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hidePageScrollbar?: boolean;
  backgroundEffect?: string | null;
  topographyConfig?: any;
  solarConfig?: any;
  accentColor?: string;
}

const {
  title: propTitle,
  description: propDescription,
  image: propImage,
  hidePageScrollbar = false,
  backgroundEffect = "none",
  topographyConfig = null,
  solarConfig = null,
  accentColor = "primary",
} = Astro.props;

const currentLocale = Astro.currentLocale as Locale;
const overrides = await getTranslationOverrides(currentLocale);
const t = useTranslations(currentLocale, overrides);

// Fallback values if not provided by the page
const defaultTitle = t("site.title");
const defaultDescription = t("site.description");

const pageTitle = propTitle && propTitle !== defaultTitle ? `${propTitle} | ${defaultTitle}` : defaultTitle;
const pageDescription = propDescription || defaultDescription;

// Color map for CSS custom property injection
const accentColorMap: Record<string, { main: string; bg: string; border: string }> = {
  primary: { main: '#FF7D1A', bg: 'rgba(255,125,26,0.15)', border: 'rgba(255,125,26,0.5)' },
  blue:    { main: '#3b82f6', bg: 'rgba(59,130,246,0.15)',  border: 'rgba(59,130,246,0.5)' },
  green:   { main: '#22c55e', bg: 'rgba(34,197,94,0.15)',   border: 'rgba(34,197,94,0.5)'  },
  purple:  { main: '#a855f7', bg: 'rgba(168,85,247,0.15)',  border: 'rgba(168,85,247,0.5)' },
  rose:    { main: '#f43f5e', bg: 'rgba(244,63,94,0.15)',   border: 'rgba(244,63,94,0.5)'  },
  gray:    { main: '#6b7280', bg: 'rgba(107,114,128,0.15)', border: 'rgba(107,114,128,0.5)'},
};
const resolvedAccent = accentColorMap[accentColor] || accentColorMap.primary;

// --- Data needed by Header ---
// Project Pages Fetching (moved to Header, but BaseLayout needs to do it to pass to Header)
// Alternatively, Header could fetch its own data if it doesn't need `currentLocale` or `t` from BaseLayout for this.
// For now, keeping fetching logic here to pass down.
// Fetch all available projects via Sanity CMS for the dropdown
const allSanityProjects = await getProjects(currentLocale);
let projectPages: { href: string; text: string }[] = allSanityProjects.map((p: any) => ({
  href: `/${currentLocale}/projects/${p.slug.current}`,
  text: p.title
}));

const notesSettings = await getNotesSettings();
const showNotes = notesSettings?.enabled === true;

const socials = await getSocialsSettings();

const navLinks = [
  { href: `/${currentLocale}/library`, text: t("nav.library") },
  ...(showNotes ? [{ href: `/${currentLocale}/notes`, text: t("nav.notes") }] : []),
  { href: `/${currentLocale}/contact`, text: t("nav.contact") },
];
const homePath = `/${currentLocale}/`;

// SEO URL configurations
const siteUrl = "https://marlonmueller.eu";
const canonicalURL = `${siteUrl}${Astro.url.pathname}`;
const ogImage = propImage
  ? (propImage.startsWith("http") ? propImage : `${siteUrl}${propImage}`)
  : `${siteUrl}/og-image.jpg`;

const alternateLocale = currentLocale === "en" ? "de" : "en";
let alternatePathname = Astro.url.pathname;
if (alternatePathname.startsWith(`/${currentLocale}/`)) {
  alternatePathname = alternatePathname.replace(`/${currentLocale}/`, `/${alternateLocale}/`);
} else if (alternatePathname === `/${currentLocale}`) {
  alternatePathname = `/${alternateLocale}`;
}
const alternateURL = `${siteUrl}${alternatePathname}`;

const localeEnURL = currentLocale === "en" ? canonicalURL : alternateURL;
const localeDeURL = currentLocale === "de" ? canonicalURL : alternateURL;
---

<!doctype html>
<html
  lang={currentLocale}
  dir="ltr"
  class={hidePageScrollbar ? "page-hides-scrollbar" : ""}
  style={`--color-project-accent:${resolvedAccent.main};--color-project-accent-bg:${resolvedAccent.bg};--color-project-accent-border:${resolvedAccent.border}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marlon Müller" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={currentLocale === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={currentLocale === 'de' ? 'en_US' : 'de_DE'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical and Bilingual Alternate SEO Links -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={localeEnURL} />
    <link rel="alternate" hreflang="de" href={localeDeURL} />
    <link rel="alternate" hreflang="x-default" href={localeEnURL} />
    
    <ThemeScript />
    {/* Critical for preventing FOUC for theme */}
    <ClientRouter />
    <script is:inline define:vars={{ accentColorMap: JSON.stringify(accentColorMap) }}>
      // Expose color map globally so homepage scroll JS can update the accent vars
      window.__accentColorMap = JSON.parse(accentColorMap);
    </script>
  </head>
  <body>
    <DynamicBackground 
      effect={backgroundEffect} 
      config={backgroundEffect === 'solar' ? solarConfig : topographyConfig} 
    />
    <Header
      currentLocale={currentLocale}
      t={t}
      homePath={homePath}
      navLinks={navLinks}
      projectPages={projectPages}
      accentColor={accentColor}
      socials={socials}
    />

    <main>
      <slot />
    </main>

    <Footer />

    <CommandPalette
      currentLocale={currentLocale}
      projectPages={projectPages}
      navLinks={navLinks}
    />

    <script>
      // BaseLayout's script is now only responsible for theme consistency application
      // after page transitions, as ThemeToggle.astro handles its own click events.
      // Menu and dropdown interactivity is now in Header.astro's script.

      function applyBaseLayoutThemeConsistency() {
        const themeToggleButton = document.querySelector(
          "#theme-toggle",
        ) as HTMLElement | null; // Query for the custom element
        const themeStorageKey = "theme";
        const htmlElement = document.documentElement;

        const currentTheme =
          localStorage.getItem(themeStorageKey) ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        htmlElement.classList.toggle("dark", currentTheme === "dark");

        if (themeToggleButton) {
          themeToggleButton.setAttribute(
            "aria-label",
            `Switch to ${currentTheme === "dark" ? "light" : "dark"} theme`,
          );
        }
        console.log(
          "BaseLayout: Applied theme consistency on page load/transition:",
          currentTheme,
        );
      }

      function reinitializeBaseLayoutForTheme() {
        console.log(
          "BaseLayout: astro:page-load triggered. Applying theme consistency.",
        );
        applyBaseLayoutThemeConsistency();
      }

      document.addEventListener(
        "astro:page-load",
        reinitializeBaseLayoutForTheme,
      );

      // No astro:before-swap cleanup needed in BaseLayout for theme, as ThemeToggle handles its own listeners,
      // and applyBaseLayoutThemeConsistency just reads state and sets attributes/classes.

      console.log(
        "BaseLayout Script: Initialized for theme consistency. Waiting for Astro lifecycle events.",
      );
    </script>
  </body>
</html>

<style is:global>
  html.page-hides-scrollbar {
    overflow-y: hidden !important;
  }
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    /* Basic font and color are now expected from global.css */
  }
  main {
    flex-grow: 1;
    padding: 2rem;
    /* Calculate top padding based on a CSS variable for header height, defined in global.css or Header.astro */
    padding-top: calc(var(--header-height, 60px) + 1rem);
  }
  body.no-scroll-mobile {
    /* Used by JS in Header.astro to prevent body scroll */
    @media (max-width: 768px) {
      overflow: hidden !important;
    }
  }
</style>
