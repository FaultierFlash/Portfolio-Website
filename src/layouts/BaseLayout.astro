---
// src/layouts/BaseLayout.astro
import { useTranslations, type Locale } from "../i18n/utils";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import ThemeScript from "../components/ThemeScript.astro";
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
// import { getCollection } from 'astro:content'; // Uncomment if using Astro Content Collections

interface Props {
  title?: string;
}

const { title: propTitle } = Astro.props;
const currentLocale = (Astro.currentLocale as Locale) || "de";
const t = useTranslations(currentLocale);

const pageTitle = propTitle || t("site.title");

// --- Fetch Project Pages ---
const allProjectFilesGlob = import.meta.glob("/src/pages/**/*.astro");

let projectPages = [];
if (allProjectFilesGlob) {
  const resolvedFiles = await Promise.all(
    Object.entries(allProjectFilesGlob).map(async ([filePath, resolver]) => {
      // filePath is like /src/pages/en/projects/my-project.astro
      // console.log(`Checking file: ${filePath} for locale: ${currentLocale}`); // DEBUG

      // Regex to match project files within the current locale's 'projects' or 'projekte' folder.
      // Ensures the path starts from /src/pages/ for specificity.
      // Example for 'de': /^\/src\/pages\/de\/(projects|projekte)\//i
      const langProjectRegex = new RegExp(
        `^/src/pages/${currentLocale}/(projects|projekte)/`, // Added ^ to anchor at the start of /src/pages
        "i"
      );
      // console.log(`Using regex: ${langProjectRegex}`); // DEBUG

      if (langProjectRegex.test(filePath)) {
        // console.log(`Regex test PASSED for: ${filePath}`); // DEBUG
        try {
          const projectModule = await resolver();
          // console.log(`Resolved module for ${filePath}:`, projectModule); // DEBUG

          const segments = filePath.split("/");
          const fileNameWithExtension = segments[segments.length - 1];
          const fileName = fileNameWithExtension.replace(
            /\.(mdoc|md|astro)$/,
            ""
          );

          const projectTitle =
            projectModule.frontmatter?.navTitle ||
            projectModule.frontmatter?.title ||
            fileName
              .replace(/-/g, " ")
              .replace(/\b\w/g, (char) => char.toUpperCase());

          if (!projectModule.url) {
            // console.warn(`File ${filePath} is missing a URL. It might be a partial, layout, or an endpoint.`); // DEBUG
            return null;
          }

          return {
            href: projectModule.url,
            text: projectTitle,
          };
        } catch (e) {
          // console.error(`Error resolving or processing ${filePath}:`, e); // DEBUG
          return null;
        }
      } else {
        // console.log(`Regex test FAILED for: ${filePath}`); // DEBUG
      }
      return null;
    })
  );
  projectPages = resolvedFiles
    .filter((page) => page !== null)
    .sort((a, b) => a.text.localeCompare(b.text));
}
// console.log(`Final project pages for locale ${currentLocale}:`, projectPages); // DEBUG

// --- Navigation Links ---
const navLinks = [
  { href: `/${currentLocale}/contact`, text: t("nav.contact") },
];

// --- Dynamic Path Display ---
const currentPathname = Astro.url.pathname;

function getPathWithoutLocale(path: string, locale: Locale): string {
  const localePrefix = `/${locale}`;
  if (path === localePrefix || path === `${localePrefix}/`) return "/";
  if (path.startsWith(`${localePrefix}/`))
    return path.substring(localePrefix.length);
  return path;
}

const basePath = getPathWithoutLocale(currentPathname, currentLocale);

let displayPathText;

if (basePath === "/") {
  displayPathText = t("nav.home");
} else if (basePath === "/contact" || basePath === "/contact/") {
  displayPathText = t("terminal.title");
} else if (basePath === "/projects" || basePath === "/projects/") {
  displayPathText = t("nav.projects");
} else if (basePath.startsWith("/projects/")) {
  const segments = basePath.split("/");
  let slugText = segments[segments.length - 1] || segments[segments.length - 2]; // Handle trailing slash
  slugText = slugText.replace(/-/g, " ").trim();
  displayPathText = slugText
    .split(" ")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
} else {
  const lastSegment = basePath.split("/").filter(Boolean).pop();
  if (lastSegment) {
    const potentialKey = `nav.${lastSegment.toLowerCase()}`;
    const translated = t(potentialKey);
    if (translated !== potentialKey && translated !== "") {
      // Ensure translation exists
      displayPathText = translated;
    } else {
      let segmentText = lastSegment.replace(/-/g, " ");
      displayPathText = segmentText
        .split(" ")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
    }
  } else {
    displayPathText = t("nav.home");
  }
}

const displayPath = `~/${displayPathText}`;
const homePath = `/${currentLocale}/`;
---

<!doctype html>
<html lang={currentLocale} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <ThemeScript />
    <ViewTransitions />
  </head>
  <body>
    <header class="top-bar">
      <div class="logo-area">
        <a href={homePath} aria-label={t("nav.logo.ariaLabel")}>{displayPath}</a
        >
      </div>

      <div class="navigation-container">
        <button
          class="hamburger-button"
          aria-label={t("nav.toggleMenu")}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>

        <nav
          class="navigation-area"
          id="mobile-menu"
          aria-label={t("nav.mainNavigation")}
        >
          <div class="desktop-links">
            {/* --- Projects Dropdown --- */}
            {
              projectPages && projectPages.length > 0 && (
                <div class="dropdown-wrapper">
                  <button
                    type="button"
                    class="dropdown-toggle nav-item"
                    aria-expanded="false"
                    aria-controls={`projects-submenu-${currentLocale}`}
                  >
                    {t("nav.projects")}
                    <svg
                      class="dropdown-arrow"
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      width="16"
                      height="16"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.23 8.29a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                  <ul
                    class="dropdown-menu"
                    id={`projects-submenu-${currentLocale}`}
                    aria-label={t("dropdown.projects.label")}
                  >
                    {projectPages.map((project) => (
                      <li>
                        <a href={project.href} class="nav-item dropdown-item">
                          {project.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
            {/* --- End of Projects Dropdown --- */}

            {
              navLinks.map((link) => (
                <a href={link.href} class="nav-item">
                  {link.text}
                </a>
              ))
            }
          </div>
          <div class="controls">
            <LanguageSwitcher />
            <ThemeToggle />
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      // Function to initialize all interactive elements
      function initializeInteractiveElements() {
        // --- Hamburger Menu & Dropdown Interactivity ---
        const hamburgerButton = document.querySelector(".hamburger-button");
        const mobileMenu = document.querySelector("#mobile-menu");
        const menuStateKey = "hamburgerMenuState";

        function openMainMenu() {
          if (!hamburgerButton || !mobileMenu) return;
          hamburgerButton.setAttribute("aria-expanded", "true");
          mobileMenu.classList.add("menu-open");
          hamburgerButton.classList.add("is-active");
          sessionStorage.setItem(menuStateKey, "open");
          document.body.classList.add("no-scroll-mobile");
        }

        function closeMainMenu() {
          if (!hamburgerButton || !mobileMenu) return;
          hamburgerButton.setAttribute("aria-expanded", "false");
          mobileMenu.classList.remove("menu-open");
          hamburgerButton.classList.remove("is-active");
          sessionStorage.setItem(menuStateKey, "closed");
          document.body.classList.remove("no-scroll-mobile");

          mobileMenu
            .querySelectorAll('.dropdown-toggle[aria-expanded="true"]')
            .forEach((toggle) => {
              toggle.setAttribute("aria-expanded", "false");
              const dropdownMenu = toggle.nextElementSibling;
              if (dropdownMenu) {
                dropdownMenu.classList.remove("open");
                dropdownMenu.style.maxHeight = null;
              }
              const arrow = toggle.querySelector(".dropdown-arrow");
              if (arrow) arrow.classList.remove("open");
            });
        }

        if (hamburgerButton && mobileMenu) {
          const savedState = sessionStorage.getItem(menuStateKey);
          if (savedState === "open" && window.innerWidth <= 768) {
            // openMainMenu(); // Optional: auto-reopen on mobile after lang switch
          } else {
            sessionStorage.setItem(menuStateKey, "closed");
          }

          hamburgerButton.addEventListener("click", () => {
            const isExpanded =
              hamburgerButton.getAttribute("aria-expanded") === "true";
            if (isExpanded) {
              closeMainMenu();
            } else {
              openMainMenu();
            }
          });

          const closeMenuOnOutsideClick = (event) => {
            if (mobileMenu.classList.contains("menu-open")) {
              if (
                !mobileMenu.contains(event.target) &&
                !hamburgerButton.contains(event.target)
              ) {
                closeMainMenu();
              }
            }
          };
          // Remove listener before adding to prevent duplicates if this script re-runs unexpectedly
          document.removeEventListener("click", closeMenuOnOutsideClick);
          document.addEventListener("click", closeMenuOnOutsideClick);

          mobileMenu.addEventListener("click", (event) => {
            const target = event.target.closest("a");
            if (target) {
              const isNavItem = target.classList.contains("nav-item");
              const isDropdownToggle =
                target.classList.contains("dropdown-toggle");
              const isInControls = target.closest(".controls");
              const isDropdownItem = target.classList.contains("dropdown-item");

              if (isNavItem && !isDropdownToggle && !isInControls) {
                if (window.innerWidth <= 768) closeMainMenu();
              }
              if (isDropdownItem) {
                if (window.innerWidth <= 768) closeMainMenu();
              }
            }
          });
        }

        // --- Dropdown Menu Logic ---
        document.querySelectorAll(".dropdown-wrapper").forEach((wrapper) => {
          const toggle = wrapper.querySelector(".dropdown-toggle");
          const menu = wrapper.querySelector(".dropdown-menu");
          const arrow = toggle ? toggle.querySelector(".dropdown-arrow") : null;

          if (!toggle || !menu) return;

          toggle.addEventListener("click", (event) => {
            event.stopPropagation();
            const isExpanded = toggle.getAttribute("aria-expanded") === "true";

            if (window.innerWidth > 768) {
              // Desktop: close other dropdowns
              document
                .querySelectorAll('.dropdown-toggle[aria-expanded="true"]')
                .forEach((otherToggle) => {
                  if (otherToggle !== toggle) {
                    otherToggle.setAttribute("aria-expanded", "false");
                    const otherMenu = otherToggle.nextElementSibling;
                    if (otherMenu) {
                      otherMenu.classList.remove("open");
                      otherMenu.style.maxHeight = null;
                    }
                    const otherArrow =
                      otherToggle.querySelector(".dropdown-arrow");
                    if (otherArrow) otherArrow.classList.remove("open");
                  }
                });
            }

            if (isExpanded) {
              toggle.setAttribute("aria-expanded", "false");
              menu.classList.remove("open");
              menu.style.maxHeight = null;
              if (arrow) arrow.classList.remove("open");
            } else {
              toggle.setAttribute("aria-expanded", "true");
              menu.classList.add("open");
              menu.style.maxHeight = menu.scrollHeight + "px";
              if (arrow) arrow.classList.add("open");
            }
          });

          const closeDropdownOnOutsideClick = (event) => {
            const isMobileMenuOpen =
              mobileMenu && mobileMenu.classList.contains("menu-open");
            if (
              toggle.getAttribute("aria-expanded") === "true" &&
              !wrapper.contains(event.target) &&
              (!isMobileMenuOpen || window.innerWidth > 768)
            ) {
              toggle.setAttribute("aria-expanded", "false");
              menu.classList.remove("open");
              menu.style.maxHeight = null;
              if (arrow) arrow.classList.remove("open");
            }
          };
          document.removeEventListener("click", closeDropdownOnOutsideClick);
          document.addEventListener("click", closeDropdownOnOutsideClick);

          menu.querySelectorAll(".dropdown-item").forEach((item) => {
            item.addEventListener("click", () => {
              if (window.innerWidth > 768) {
                // Desktop: close this dropdown
                toggle.setAttribute("aria-expanded", "false");
                menu.classList.remove("open");
                menu.style.maxHeight = null;
                if (arrow) arrow.classList.remove("open");
              }
              // On mobile, the main mobileMenu click listener handles closing the entire menu.
            });
          });
        });

        // --- Theme Toggle Logic ---
        const themeToggleButton = document.querySelector("theme-toggle");
        const themeStorageKey = "theme";
        const htmlElement = document.documentElement;

        function applyThemeClass(theme) {
          if (theme === "dark") {
            htmlElement.classList.add("dark");
          } else {
            htmlElement.classList.remove("dark");
          }
          if (themeToggleButton) {
            themeToggleButton.setAttribute(
              "aria-label",
              `Switch to ${theme === "dark" ? "light" : "dark"} theme`
            );
          }
        }

        if (themeToggleButton) {
          themeToggleButton.addEventListener("click", () => {
            const isCurrentlyDark = htmlElement.classList.contains("dark");
            const newTheme = isCurrentlyDark ? "light" : "dark";
            applyThemeClass(newTheme);
            localStorage.setItem(themeStorageKey, newTheme);
          });

          const initialTheme =
            localStorage.getItem(themeStorageKey) ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          if (themeToggleButton) {
            themeToggleButton.setAttribute(
              "aria-label",
              `Switch to ${initialTheme === "dark" ? "light" : "dark"} theme`
            );
          }
        }
      }

      document.addEventListener(
        "astro:page-load",
        initializeInteractiveElements
      );
    </script>
  </body>
</html>

<style is:global>
  body.no-scroll-mobile {
    @media (max-width: 768px) {
      overflow: hidden;
    }
  }
</style>

<style>
  /* --- Base Top Bar Styles --- */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.5rem;
    background-color: var(--color-bg, #fff);
    border-bottom: 1px solid var(--color-border, #e0e0e0);
    color: var(--color-text, #333);
    position: sticky;
    top: 0;
    z-index: 110; /* Stacking context for top bar */
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .logo-area a {
    color: var(--color-text, #333);
    text-decoration: none;
    font-family: "Raleway", monospace, sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
  }

  .navigation-container {
    display: flex;
    align-items: center;
  }

  /* --- Hamburger Button Styles --- */
  .hamburger-button {
    display: none;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    z-index: 1001; /* Above mobile menu panel */
    margin-left: 1rem;
    position: relative;
  }
  .hamburger-line {
    display: block;
    width: 25px;
    height: 3px;
    background-color: var(--color-text, #333);
    margin: 5px 0;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
  .hamburger-button.is-active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .hamburger-button.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger-button.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* --- Desktop Navigation Styles --- */
  .navigation-area {
    /* On desktop, this is part of the top-bar flow */
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .desktop-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-item {
    padding: 0.5rem 0.75rem;
    color: var(--color-text, #333);
    text-decoration: none;
    font-family: "Raleway", sans-serif;
    font-weight: 500;
    font-size: 1rem;
    border-radius: 4px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .nav-item:hover,
  .nav-item:focus-visible {
    color: var(--color-primary, #007bff);
    background-color: var(--color-bg-accent, rgba(0, 0, 0, 0.05));
  }
  .nav-item:focus-visible {
    outline: 2px solid var(--color-primary, #007bff);
    outline-offset: 2px;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-left: 0.75rem;
  }

  /* --- Dropdown Specific Styles --- */
  .dropdown-wrapper {
    position: relative; /* Needed for absolute positioning of the dropdown-menu */
  }
  .dropdown-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .dropdown-arrow {
    transition: transform 0.3s ease;
    width: 1em;
    height: 1em;
    fill: currentColor;
  }
  .dropdown-toggle[aria-expanded="true"] .dropdown-arrow {
    transform: rotate(180deg);
  }
  .dropdown-arrow.open {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    /* Desktop projects dropdown */
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    background-color: var(--color-bg-elevated, var(--color-bg, #fff));
    border: 1px solid var(--color-border, #e0e0e0);
    border-radius: 6px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
    z-index: 990; /* Ensures it's above most page content but below mobile menu */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px) scale(0.95);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s 0.2s linear,
      max-height 0.25s ease-out;
    max-height: 0;
    overflow: hidden;
  }
  .dropdown-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    transition-delay: 0s, 0s, 0s, 0s;
  }
  .dropdown-item {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
    border-radius: 0;
  }
  .dropdown-item:hover,
  .dropdown-item:focus-visible {
    background-color: var(--color-primary-light, rgba(0, 123, 255, 0.1));
    color: var(--color-primary-dark, var(--color-primary, #0056b3));
  }

  /* --- Mobile Menu Styles (Media Query) --- */
  @media (max-width: 768px) {
    .hamburger-button {
      display: block;
    }

    .navigation-area {
      /* The slide-out mobile menu panel */
      display: none;
      flex-direction: column;
      align-items: stretch;
      position: fixed;
      top: 0;
      right: 0;
      transform: translateX(100%);
      width: min(80vw, 320px);
      height: 100vh;
      background-color: var(--color-bg-elevated, var(--color-bg, #fff));
      border-left: 1px solid var(--color-border, #e0e0e0);
      padding: calc(var(--header-height, 60px) + 1rem) 0 0 0;
      box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
      z-index: 1000; /* High z-index for the panel itself */
      overflow-y: auto;
      transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .navigation-area.menu-open {
      display: flex;
      transform: translateX(0%);
    }

    .desktop-links {
      /* Container for links and dropdowns within mobile menu */
      flex-direction: column;
      width: 100%;
      gap: 0;
      align-items: stretch;
    }
    .nav-item,
    .dropdown-toggle {
      /* Full width items in mobile */
      width: 100%;
      padding: 1rem 1.5rem;
      border-radius: 0;
      border-bottom: 1px solid
        var(--color-border-subtle, var(--color-border, #eee));
      font-size: 1.1rem;
      justify-content: space-between;
    }
    .dropdown-wrapper:last-of-type > .dropdown-toggle,
    .nav-item:last-of-type {
      border-bottom: none;
    }
    .dropdown-wrapper + .controls > .dropdown-toggle {
      border-bottom: none;
    }

    .dropdown-menu {
      /* Accordion style for projects dropdown inside mobile menu */
      position: static; /* Overrides absolute for accordion behavior */
      border: none;
      box-shadow: none;
      border-radius: 0;
      width: 100%;
      background-color: var(--color-bg-accent-darker, rgba(0, 0, 0, 0.03));
      padding: 0;
      margin: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-in-out;
      /* z-index is inherited from .navigation-area, no need to set it higher here */
      border-top: 1px solid
        var(--color-border-subtle, var(--color-border, #eee));
    }
    .dropdown-menu.open {
      /* max-height is set by JS */
    }
    .dropdown-item {
      padding-left: 2.5rem;
      font-size: 1rem;
      border-bottom: 1px dashed var(--color-border-very-subtle, #f5f5f5);
    }
    .dropdown-menu li:last-child .dropdown-item {
      border-bottom: none;
    }

    .controls {
      flex-direction: row;
      justify-content: space-around;
      width: 100%;
      padding: 1.5rem;
      margin-top: auto;
      border-top: 1px solid var(--color-border, #e0e0e0);
      background-color: var(--color-bg-elevated, var(--color-bg, #fff));
    }
  }

  /* --- Base Layout Styles --- */
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    --header-height: 60px;
    background-color: var(--color-bg, #fff);
    color: var(--color-text, #333);
  }
  main {
    flex-grow: 1;
    padding: 2rem;
    padding-top: calc(var(--header-height) + 1rem);
    /* No z-index or position needed here unless specific content requires it,
       which could then conflict if not managed carefully. */
  }
</style>
