{
  "name": "portfolio-website",
  "type": "module",
  "version": "0.0.1",
  "description": "Portfolio website built with Astro and Sanity",
  "author": "FaultierFlash",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm ci --legacy-peer-deps --prefix personal-website && npm run build --prefix personal-website && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.3",
    "@sanity/client": "^8.2.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "jsonwebtoken": "^9.0.3",
    "marked": "^17.0.5",
    "nodemailer": "^9.0.5",
    "resend": "^4.8.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.24",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  }
}
